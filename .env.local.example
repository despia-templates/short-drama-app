# Required — the server refuses to boot without these two.
DSX_DATABASE_URL=postgres://localhost/shortdrama_dev
DSX_JWT_SECRET=change-me-local-only

# Optional — server-to-server caller key for internal routes (hosted lanes set a real one).
DSX_INTERNAL_KEY=change-me-local-only

# Optional — where the built site lives (the default).
DSX_SITE_DIR=dist

# Stripe web checkout (TEST-MODE keys from dashboard.stripe.com/test/apikeys).
# Leave unset and the Store shows the server's honest refusal instead of a payment sheet;
# nothing else in the app changes.
#STRIPE_KEY=sk_test_...
#STRIPE_PUBLISHABLE=pk_test_...
