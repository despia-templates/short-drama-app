<!-- Home — the storefront, built to the category reference measured live at 1440×900:
     an 80px transparent sticky nav floating over a 480px full-bleed hero, then the
     rails — Continue Watching · New Release · TOP (giant ranked numerals) · genre
     grids — over a link-column footer.

     Measured constants, not invented ones: gutter 77 · poster 3:4 at radius 16 · rail
     gap 18 · section head 24/700 at rgba(255,255,255,0.8) · card title 14 at 0.8 ·
     card meta 14 at 0.9 · brand red #FF2C55 · hero title 32/700 at 0.9.

     Hero type lives OUTSIDE the pager, bound to the resting page: a caption that
     restyles itself mid-swipe flickers. Hover is a REAL pointer affordance
     (on:hoverStart/End) — on touch it never fires and every card stays a plain link.
     No emoji anywhere: icons come from the shared catalog and have per-platform twins. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="home" url="/catalog/home" on:success="global.cacheHome = home.data"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="continue" url="/viewer/continue" ssr="false" needs="session"
         headers="dsx.variable.authHeaders" on:success="global.cacheContinue = continue.data"/>

    <variable as="heroPage">return 0</variable>
    <variable as="hovId">return ''</variable>   <!-- the card under the pointer -->
    <!-- the phone home's tab row (Popular · New · Ranking) — the category's own top-level
         switch. Wide viewports keep the measured desktop layout and never see it. -->
    <variable as="homeTab">return 'popular'</variable>

    <!-- ONE breakpoint vocabulary from the LIVE screen fact (dsx.screen.width is
         reactive — a computed variable re-derives as the window changes). -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read continueView, never continue.data, or the blank frame returns. -->
    <variable as="continueView" computed="true">
      if (continue.data != null) { return continue.data }
      return global.cacheContinue
    </variable>
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 86 }
      if (dsx.variable.bp == 'tablet') { return 40 }
      return 16
    </variable>
    <variable as="posterW" computed="true">
      if (dsx.variable.bp == 'desktop') { return 239 }
      if (dsx.variable.bp == 'tablet') { return 186 }
      return 150
    </variable>
    <!-- 3:4 is the measured category ratio (both references), not the 2:3 book ratio -->
    <variable as="posterH" computed="true">return Math.round(dsx.variable.posterW * 4 / 3)</variable>
    <variable as="heroH" computed="true">
      if (dsx.variable.bp == 'desktop') { return 480 }
      if (dsx.variable.bp == 'tablet') { return 420 }
      return Math.round(dsx.screen.height * 0.62)
    </variable>
    <variable as="heroTitleSize" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 28 }
      return 24
    </variable>
    <!-- section heads, re-measured against the reference set: flextv 28/700,
         my-drama 32/700, shortical 20/700. 24 was under all but one of them. -->
    <variable as="headSize" computed="true">return dsx.variable.wide ? 28 : 20</variable>
    <variable as="shelfCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 5 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <!-- TOP rail: the numeral overlaps the poster's leading edge -->
    <variable as="rankOvl" computed="true">return Math.round(dsx.variable.posterW * 0.36)</variable>
    <variable as="rankSize" computed="true">return Math.round(dsx.variable.posterH * 0.62)</variable>

    <!-- compound style lists are ONE computed value used as the WHOLE attribute
         (a bare {{ }} fragment beside other declarations is discarded — AGENTS.md) -->
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <!-- A RAIL TRACK IS NOT A PAGE SHELL. `width: 100%` caps the track at the scroller and
         the cards inside it eat the difference (measured: 150px posters rendered at 72.25px
         on a 375pt phone). The track is `max-content` and the gutter is its padding, so the
         first card lines up with the section head and the last one keeps a trailing margin;
         past 1440 the extra is split the way the shell's `margin: auto` splits it. -->
    <variable as="railShell" computed="true">
      const g = dsx.variable.gutter
      const over = dsx.screen.width - 1440
      const lead = g + (over > 0 ? Math.round(over / 2) : 0)
      return 'width: max-content; padding-left: ' + lead + 'px; padding-right: ' + lead + 'px'
    </variable>
    <variable as="heroInnerBox" computed="true">
      return dsx.variable.shell + '; height: 100%; justify-content: center; align-items: flex-start'
    </variable>
    <variable as="thumbShellBox" computed="true">
      return dsx.variable.shell + '; justify-content: flex-end; padding-bottom: 34px'
    </variable>
    <variable as="posterStyle" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; border-radius: 16px; object-fit: cover'
    </variable>
    <variable as="posterBox" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; justify-content: flex-end'
    </variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <!-- CONTENT SURVIVES A REVISIT. `<api cache>` is keyed by the per-MOUNT store
         (mount.ts makes a new ReactiveStore per component, and the api cache is a WeakMap
         over it), so leaving a tab and coming back refetches from zero and this screen
         painted EMPTY RAILS for 103ms on localhost — measured tap-to-content, and far
         worse on a real network. `global.*` is the app-wide store and outlives the frame,
         so the last good payload is the first paint while the fresh fetch runs underneath:
         stale-then-fresh, never blank. Every read below goes through `feed`, never
         `dsx.variable.homeView`, or the hole comes back. Upstream ask: PLAN.md §6.30. -->
    <variable as="homeView" computed="true">
      if (home.data != null) { return home.data }
      return global.cacheHome
    </variable>
    <!-- SOCIAL PROOF, formatted the way the category does it: my-drama runs "2.6M · 9.67"
         in the hero meta, flextv puts a play count on every card, ReelShort prints
         13.2M/115.5k on the detail. A catalogue with no numbers reads as an empty shelf.
         These are DEMO values (scripts/catalogue.mjs) — nothing here increments them. -->
    <variable as="heroTags" computed="true">
      const h = dsx.variable.heroShow
      if (h == null || h.tags == null) { return [] }
      return h.tags.slice(0, 5).map(t => ({ name: t }))
    </variable>
    <variable as="heroViews" computed="true">
      const h = dsx.variable.heroShow
      if (h == null || h.views == null || h.views < 1000) { return '' }
      if (h.views < 1000000) { return Math.round(h.views / 100) / 10 + 'K' }
      return Math.round(h.views / 100000) / 10 + 'M'
    </variable>
    <!-- THE FIRST VISIT HAD NO STATE. The app-wide stash (above) fixed REVISITS, but a cold
         first load has nothing to fall back to, so this screen painted section headings over
         empty rails until the fetch landed — the exact failure the stash comment describes,
         one case short. `empty` is real too: a fresh deployment with a seeded-but-unpublished
         catalogue reaches here with zero shows and used to render silent void. -->
    <variable as="phase" computed="true">
      const v = dsx.variable.homeView
      if (v != null) { return v.latest.length == 0 && v.hero.length == 0 ? 'empty' : 'ready' }
      if (home.error != null) { return 'error' }
      return 'loading'
    </variable>
    <variable as="skelRows" computed="true">return [0, 1, 2, 3, 4, 5]</variable>
    <variable as="heroShow" computed="true">
      if (dsx.variable.homeView == null) { return null }
      const p = Number(dsx.variable.heroPage)
      if (p < 0 || p >= dsx.variable.homeView.hero.length) { return null }
      return dsx.variable.homeView.hero[p]
    </variable>
    <variable as="heroCount" computed="true">
      if (dsx.variable.homeView == null) { return 0 }
      return dsx.variable.homeView.hero.length
    </variable>

    <!-- ONE computed list: `style="{{ chunk }}; extras"` discards the chunk (the linter
         now says so out loud — that is how this bug was found after shipping). -->
    <formula as="posterHover" id="item.id">
      const lift = dsx.variable.hovId == id ? 1.04 : 1
      return dsx.variable.posterStyle + '; transition: transform 0.22s ease; transform: scale(' + lift + ')'
    </formula>
    <formula as="shelfHover" id="item.id">
      const lift = dsx.variable.hovId == ('g-' + id) ? 1.03 : 1
      return 'width: 100%; aspect-ratio: 3/4; border-radius: 16px; object-fit: cover; transition: transform 0.22s ease; transform: scale(' + lift + ')'
    </formula>
    <formula as="metaLine" g="item.genre" n="item.episodes">
      return (g == null || g === '' ? 'Drama' : g) + '  |  Series' + (n > 0 ? '  |  EP ' + n : '')
    </formula>
    <formula as="rankColor" r="item.rank">
      if (r == 1) { return '#F6B63D' }
      if (r == 2) { return '#B9C5D8' }
      if (r == 3) { return '#CE8B5C' }
      return '#43434D'
    </formula>
<!-- COVERFLOW, the category's shape: the resting title is whole and the ones either side
         of it recede — measured off shortical (centre card at full opacity, neighbours dimmed
         and scaled down) rather than the border-only highlight this rail shipped with, which
         read as five equal thumbnails with one outlined. Scale and opacity both move, because
         a border alone does not survive against busy poster art. -->
    <formula as="coverCell" r="item.rank">
      const on = r - 1 == Number(dsx.variable.heroPage)
      return 'width: 78px; height: 104px; border-radius: 8px; object-fit: cover; '
        + 'border: 2px solid ' + (on ? '#FFFFFF' : 'rgba(255,255,255,0.14)') + '; '
        + 'opacity: ' + (on ? '1' : '0.55') + '; '
        + 'transform: scale(' + (on ? 1.1 : 0.92) + '); '
        + 'transition: opacity 0.24s ease, border-color 0.24s ease, transform 0.24s ease'
    </formula>
        <formula as="topBadge" r="item.rank" f="item.featured">
      if (r == 1) { return 'Trending' }
      if (f) { return 'Hot' }
      return ''
    </formula>

    <!-- THE WIDE HERO IS A CAROUSEL, NOT A SWIPE SURFACE. `<pager>` advances by drag, which
         is a touch affordance: on a 1440px window with a mouse there is nothing to tell a
         reader the hero holds five titles, and dragging a full-bleed image reads as a
         mis-click. Every reference carousel in the category (my-drama, shortical, flextv)
         ships chevrons on the wide lane and only the wide lane. These wrap, so the control
         is never a dead end at either end of the set. -->
    <action as="heroPrev">
      const n = dsx.variable.heroCount
      if (n < 2) { return }
      const p = Number(dsx.variable.heroPage)
      dsx.variable.heroPage = p <= 0 ? n - 1 : p - 1
    </action>
    <action as="heroNext">
      const n = dsx.variable.heroCount
      if (n < 2) { return }
      const p = Number(dsx.variable.heroPage)
      dsx.variable.heroPage = p >= n - 1 ? 0 : p + 1
    </action>

    <!-- THE ROOT CARRIES ITS SIZE AS ATTRIBUTES, not CSS. `min-height: {{ screen.height }}px`
         on the root and `flex: 1; min-height: 0` on the scroller are web spellings, and the
         native renderers drop an unmapped declaration per-declaration — so on iOS the screen
         and its scroller had no box, and the app rendered near-blank with real data behind it
         (measured on an iPhone 17 Pro simulator). `grow` is the cross-platform twin: the
         catalog's own "fill available space" word, honoured by every renderer. PLAN.md §6.43. -->
    <style as="screen" background="#000000" alignItems="stretch" grow="true"/>
    <style as="scroller" alignItems="stretch" grow="true"/>
    <style as="page" spacing="0" paddingBottom="0" alignItems="stretch" grow="width"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="44" grow="width"/>

    <style as="phoneBar" paddingV="12" alignItems="center" spacing="12"/>
    <style as="tabRow" spacing="22" alignItems="flex-end" paddingBottom="4"/>
    <style as="tabCol" spacing="5" alignItems="center"/>
    <style as="tabTxt" fontSize="16" fontWeight="bold" tracking="-0.2"/>
    <style as="tabDash" width="18" height="3" radius="2"/>
    <style as="rankRow" spacing="12" alignItems="center" paddingV="10"/>
    <style as="rankBig" fontWeight="heavy" fontSize="24" width="34" textAlign="center"/>
    <style as="rankTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="rankMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="rankPlay" background="rgba(255,44,85,0.14)" radius="16" paddingH="14" paddingV="8" fontSize="12" fontWeight="semibold" color="#FF2C55"/>
    <style as="logoBox" background="#FF2C55" radius="8" alignItems="center" width="29" height="29"/>
    <style as="wordmark" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>

    <style as="heroBlock" spacing="16" alignItems="flex-start"/>
    <style as="heroTagRow" spacing="6" alignItems="center"/>
    <style as="tagSoft" background="rgba(255,233,168,0.10)" radius="4" paddingH="9" paddingV="4" fontSize="12" color="#FFE9A8"/>
    <style as="heroMeta" spacing="6" alignItems="center"/>
    <style as="metaTxt" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.62)"/>
    <style as="heroTitle" fontWeight="bold" color="rgba(255,255,255,0.9)" lineLimit="2" tracking="-0.5"/>
    <style as="heroPills" spacing="8" alignItems="center"/>
    <style as="pillHot" background="#FF2C55" radius="13" paddingH="12" paddingV="5" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="pillTag" background="rgba(255,255,255,0.14)" radius="13" paddingH="12" paddingV="5" fontSize="12" fontWeight="medium" color="rgba(255,255,255,0.92)"/>
    <style as="heroSyn" fontSize="14" color="rgba(255,255,255,0.72)" lineLimit="2" lineSpacing="4"/>
    <style as="playPill" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" spacing="9" alignItems="center"/>
    <style as="playLabel" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="thumbRow" spacing="14" alignItems="center"/>
    <style as="heroArrow" width="44" height="44" radius="22" alignItems="center"
           background="rgba(18,18,20,0.55)"/>
    <style as="heroPhoneBlock" spacing="14" alignItems="center" paddingLeading="24" paddingTrailing="24" paddingBottom="24"/>
    <style as="heroPhoneTitle" fontWeight="bold" color="#FFFFFF" lineLimit="2" textAlign="center" tracking="-0.4"/>
    <style as="dashRow" spacing="5" alignItems="center" paddingTop="4"/>

    <style as="sectionHead" alignItems="center"/>
    <style as="sectionTitle" fontWeight="bold" color="rgba(255,255,255,0.8)" tracking="-0.3"/>
    <style as="viewAll" fontSize="14" color="#FFFFFF"/>
    <style as="viewAllRow" spacing="4" alignItems="center"/>
    <style as="rail" spacing="18" alignItems="flex-start"/>

    <style as="card" spacing="8" alignItems="stretch"/>
    <style as="shelfMore" spacing="4" alignItems="center"/>
    <style as="shelfMoreLabel" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.5)"/>
    <style as="cardTitle" fontSize="14" color="rgba(255,255,255,0.8)" lineLimit="1"/>
    <style as="cardMeta" fontSize="14" color="rgba(255,255,255,0.9)" lineLimit="1"/>
    <style as="badge" background="#FF2C55" radius="4" paddingH="8" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeDark" background="rgba(0,0,0,0.72)" radius="4" paddingH="8" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeWrap" paddingLeading="10" paddingTop="10" alignItems="flex-start" zIndex="1"/>
    <style as="hovPanel" spacing="9" alignItems="flex-start" paddingH="14" paddingBottom="14"/>
    <style as="hovSyn" fontSize="12" color="rgba(255,255,255,0.86)" lineLimit="3" lineSpacing="2"/>
    <style as="hovPlay" background="#FFFFFF" radius="15" paddingH="14" paddingV="7" spacing="6" alignItems="center"/>
    <style as="hovPlayLabel" fontSize="12" fontWeight="bold" color="#111111"/>

    <style as="rankNum" fontWeight="heavy"/>
    <style as="resumeTrack" background="rgba(255,255,255,0.22)" radius="2"/>
    <style as="resumeFill" background="#FF2C55" radius="2"/>

    <style as="footer" alignItems="stretch" spacing="26" paddingTop="40" paddingBottom="34"/>
    <style as="footCols" spacing="70" alignItems="flex-start"/>
    <style as="footBrand" spacing="12" alignItems="flex-start"/>
    <style as="footCopy" fontSize="12" color="rgba(255,255,255,0.45)" lineSpacing="3"/>
    <style as="footCol" spacing="12" alignItems="flex-start"/>
    <style as="footHead" fontSize="14" fontWeight="bold" color="#FFFFFF" tracking="0.3"/>
    <style as="footLink" fontSize="14" color="rgba(255,255,255,0.55)"/>

    <style as="skelBlock" background="#141419" radius="12"/>
    <style as="errCard" background="#141419" radius="16" spacing="10" paddingH="18" paddingV="20" alignItems="center"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="10" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <!-- OFFLINE DEMO SEED (native test lanes only — the component gates itself; Article 7:
       `global.demoSeeded` lights the pill in the phone bar below) -->
  <DemoSeed/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <!-- the nav rides INSIDE the scroll so the hero art runs under it (measured:
           nav 80px transparent sticky, hero top edge at y≈-8) -->
      <TopNav active="home" overArt="true" visible-if="dsx.variable.wide"/>

      <hstack class="phoneBar" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.wide == false">
        <vstack class="logoBox" style="justify-content: center">
          <image icon="play.fill" iconSize="14" color="#FFFFFF" a11yHidden="true"/>
        </vstack>
        <SearchOverlay pill="true"/>
        <image icon="person.crop.circle" iconSize="23" color="#FFFFFF" a11yLabel="Profile" a11yTrait="button"
               on:tap="dsx.module.route.reset({ path: '/profile' })"/>
      </hstack>

      <!-- the tab row: text tabs with a brand-red dash under the active one -->
      <hstack class="tabRow" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.wide == false">
        <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'popular'" a11yTrait="button" a11yLabel="Popular">
          <text value="Popular" class="tabTxt"
                color="{{ dsx.variable.homeTab == 'popular' ? '#FFFFFF' : 'rgba(255,255,255,0.5)' }}"/>
          <stack class="tabDash" style="align-self: center" background="{{ dsx.variable.homeTab == 'popular' ? '#FF2C55' : 'rgba(0,0,0,0)' }}"/>
        </vstack>
        <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'new'" a11yTrait="button" a11yLabel="New">
          <text value="New" class="tabTxt"
                color="{{ dsx.variable.homeTab == 'new' ? '#FFFFFF' : 'rgba(255,255,255,0.5)' }}"/>
          <stack class="tabDash" style="align-self: center" background="{{ dsx.variable.homeTab == 'new' ? '#FF2C55' : 'rgba(0,0,0,0)' }}"/>
        </vstack>
        <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'ranking'" a11yTrait="button" a11yLabel="Ranking">
          <text value="Ranking" class="tabTxt"
                color="{{ dsx.variable.homeTab == 'ranking' ? '#FFFFFF' : 'rgba(255,255,255,0.5)' }}"/>
          <stack class="tabDash" style="align-self: center" background="{{ dsx.variable.homeTab == 'ranking' ? '#FF2C55' : 'rgba(0,0,0,0)' }}"/>
        </vstack>
        <spacer/>
      
        <spacer/>
        <text value="offline demo" visible-if="global.demoSeeded == true"
              background="rgba(246,182,61,0.14)" color="#F6B63D" fontSize="11" fontWeight="semibold"
              radius="9" paddingH="8" paddingV="3"
              a11yLabel="Offline demo data — no server is connected"/>
      </hstack>

      <!-- LOADING: the real shape, not a spinner — a hero band and one rail of poster cells,
           so the page does not resize under the viewer when the catalogue lands. -->
      <vstack visible-if="dsx.variable.phase == 'loading'" alignItems="stretch" spacing="18"
              style="{{ dsx.variable.shell }}" paddingTop="24">
        <stack class="skelBlock" style="width: 100%; height: {{ dsx.variable.heroH }}px"/>
        <stack class="skelBlock" style="width: 180px; height: 22px"/>
        <grid bind="dsx.variable.skelRows" key="index" columns="{{ dsx.variable.shelfCols }}" spacing="18" scroll="false">
          <vstack spacing="8" alignItems="stretch">
            <stack class="skelBlock" style="width: 100%; aspect-ratio: 3/4"/>
            <stack class="skelBlock" style="width: 70%; height: 13px"/>
          </vstack>
        </grid>
      </vstack>

      <vstack class="section" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.phase == 'empty'">
        <vstack class="errCard">
          <image icon="rectangle.stack.fill" iconSize="30" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
          <text value="No series are live yet." fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
          <text value="Published series appear here as they go live." fontSize="13" color="rgba(255,255,255,0.55)"/>
        </vstack>
      </vstack>

      <!-- ============ HERO · wide ============ -->
      <vstack visible-if="dsx.variable.wide && heroShow != null && dsx.variable.phase == 'ready'" style="width: 100%; margin-top: -64px" alignItems="stretch">
        <zstack>
          <pager bind="dsx.variable.homeView.hero" key="id" height="{{ dsx.variable.heroH }}" dots="false" value="dsx.variable.heroPage">
            <image src="{{ item.hero }}" contentFit="cover" a11yLabel="{{ item.title }}"
                   style="width: 100%; height: {{ dsx.variable.heroH }}px; object-fit: cover"/>
          </pager>
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; pointer-events: none; background: linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.6) 32%, rgba(0,0,0,0) 62%), linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0.5) 82%, #000000 100%)">
            <vstack style="{{ dsx.variable.heroInnerBox }}">
              <vstack class="heroBlock" style="max-width: 560px; pointer-events: auto">
                <text value="{{ heroShow == null ? '' : heroShow.title }}" class="heroTitle" fontSize="{{ dsx.variable.heroTitleSize }}"/>
                <hstack class="heroPills">
                  <text value="Hot" class="pillHot" visible-if="heroShow != null && heroShow.featured"/>
                  <text value="{{ heroShow == null ? '' : heroShow.genre }}" class="pillTag"/>
                  <text value="EP 1–{{ heroShow == null ? '' : heroShow.free_until }} Free" class="pillTag"/>
                </hstack>
                <hstack class="heroTagRow" visible-if="dsx.variable.heroTags.length > 0">
                  <list bind="dsx.variable.heroTags" key="name" axis="horizontal" scroll="false" spacing="6">
                    <text value="{{ item.name }}" class="tagSoft" a11yTrait="button"
                          a11yLabel="Browse {{ item.name }}" href="/browse/{{ item.name }}"/>
                  </list>
                </hstack>
                <hstack class="heroMeta" visible-if="dsx.variable.heroViews != ''">
                  <image icon="play.fill" iconSize="13" color="rgba(255,255,255,0.55)" a11yHidden="true"/>
                  <text value="{{ dsx.variable.heroViews }}" class="metaTxt"
                        a11yLabel="{{ dsx.variable.heroViews }} views"/>
                  <text value="·" class="metaTxt" a11yHidden="true"/>
                  <image icon="star.fill" iconSize="12" color="#F6B63D" a11yHidden="true"/>
                  <text value="{{ heroShow == null ? '' : heroShow.rating }}" class="metaTxt"
                        a11yLabel="rated {{ heroShow == null ? '' : heroShow.rating }} out of 10"/>
                </hstack>
                <text value="{{ heroShow == null ? '' : heroShow.synopsis }}" class="heroSyn"/>
                <hstack class="playPill" a11yGroup="true" a11yTrait="button" a11yLabel="Play {{ heroShow == null ? '' : heroShow.title }}"
                        on:tap="dsx.module.route.push({ path: '/watch/' + (heroShow == null ? '' : heroShow.id) + '/1' })">
                  <image icon="play.fill" iconSize="14" color="#111111" a11yHidden="true"/>
                  <text value="Play" class="playLabel"/>
                </hstack>
              </vstack>
            </vstack>
          </vstack>
          <!-- the thumb rail drives the pager (value= is two-way) -->
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; justify-content: flex-end; pointer-events: none">
            <hstack style="{{ dsx.variable.thumbShellBox }}">
              <hstack class="thumbRow" style="pointer-events: auto; z-index: 3">
                <vstack class="heroArrow" visible-if="dsx.variable.heroCount > 1" on:tap="dsx.action.heroPrev()"
                        a11yGroup="true" a11yTrait="button" a11yLabel="Previous feature">
                  <image icon="chevron.left" iconSize="17" color="rgba(255,255,255,0.92)" a11yHidden="true"/>
                </vstack>
                <!-- THE STRIP IS A DESKTOP AFFORDANCE. At 1000px it costs 546px beside a
                     560px copy column in a 920px stage, and the synopsis box measured a 4px
                     overlap with the first cell — one longer line and the text runs under the
                     posters. Tablet keeps the chevrons, which is what the references do at
                     this width; the copy never has to yield. -->
                <list bind="dsx.variable.homeView.hero" key="id" axis="horizontal" scroll="false" spacing="10"
                      visible-if="dsx.variable.bp == 'desktop'">
                  <image src="{{ item.poster }}" contentFit="cover" a11yLabel="Feature {{ item.title }}" a11yTrait="button"
                         on:tap="dsx.variable.heroPage = item.rank - 1"
                         style="{{ coverCell }}"/>
                </list>
                <vstack class="heroArrow" visible-if="dsx.variable.heroCount > 1" on:tap="dsx.action.heroNext()"
                        a11yGroup="true" a11yTrait="button" a11yLabel="Next feature">
                  <image icon="chevron.right" iconSize="17" color="rgba(255,255,255,0.92)" a11yHidden="true"/>
                </vstack>
              </hstack>
            </hstack>
          </vstack>
        </zstack>
      </vstack>

      <!-- ============ HERO · phone ============ -->
      <vstack visible-if="dsx.variable.wide == false && dsx.variable.homeTab == 'popular' && heroShow != null" style="width: 100%" alignItems="stretch">
        <zstack>
          <!-- the PHONE hero reads the tall asset: this frame is 0.75:1 and the wide one is
               3:1, so `cover` on a single 16:9 file either loses the sides here or magnifies
               the subject into the desktop band -->
          <pager bind="dsx.variable.homeView.hero" key="id" height="{{ dsx.variable.heroH }}" dots="false" value="dsx.variable.heroPage">
            <image src="{{ item.hero_tall == null || item.hero_tall == '' ? item.hero : item.hero_tall }}"
                   contentFit="cover" a11yLabel="{{ item.title }}"
                   style="width: 100%; height: {{ dsx.variable.heroH }}px; object-fit: cover"/>
          </pager>
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; justify-content: flex-end; align-items: center; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.62) 76%, #000000 100%)">
            <vstack class="heroPhoneBlock" style="pointer-events: auto">
              <text value="{{ heroShow == null ? '' : heroShow.title }}" class="heroPhoneTitle" fontSize="{{ dsx.variable.heroTitleSize }}"/>
              <text value="{{ heroShow == null ? '' : heroShow.genre }}" class="pillTag"/>
              <hstack class="playPill" style="min-width: 210px; justify-content: center" a11yGroup="true" a11yTrait="button"
                      a11yLabel="Play {{ heroShow == null ? '' : heroShow.title }}"
                      on:tap="dsx.module.route.push({ path: '/watch/' + (heroShow == null ? '' : heroShow.id) + '/1' })">
                <image icon="play.fill" iconSize="14" color="#111111" a11yHidden="true"/>
                <text value="Play" class="playLabel"/>
              </hstack>
              <hstack class="dashRow" a11yHidden="true">
                <list bind="dsx.variable.homeView.hero" key="id" axis="horizontal" scroll="false" spacing="5">
                  <stack height="4" radius="2"
                         background="{{ item.rank - 1 == Number(dsx.variable.heroPage) ? '#FFFFFF' : 'rgba(255,255,255,0.35)' }}"
                         width="{{ item.rank - 1 == Number(dsx.variable.heroPage) ? 26 : 13 }}"/>
                </list>
              </hstack>
            </vstack>
          </vstack>
        </zstack>
      </vstack>

      <!-- ============ Continue Watching ============ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' && (dsx.variable.wide || dsx.variable.homeTab == 'popular') && dsx.variable.continueView != null && dsx.variable.continueView.items.length > 0">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="Continue Watching" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.continueView.items" key="episode" axis="horizontal" scroll="false" spacing="18">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/watch/{{ item.show }}/{{ item.idx }}" a11yGroup="true" a11yLabel="Continue {{ item.title }}, episode {{ item.idx }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ dsx.variable.posterStyle }}"/>
                  <!-- the EP pill lives TOP-left, the zone the key art keeps clear; the
                       art's own title is bottom-left and the two collided when this sat
                       at the foot of the poster (measured on the desktop rail) -->
                  <vstack class="badgeWrap" style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; pointer-events: none">
                    <text value="EP {{ item.idx }}" class="badgeDark"/>
                  </vstack>
                  <vstack style="{{ dsx.variable.posterBox }}">
                    <stack class="resumeTrack" style="width: {{ dsx.variable.posterW }}px; height: 3px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px">
                      <stack class="resumeFill" style="width: {{ item.pct }}%; height: 3px"/>
                    </stack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="EP.{{ item.idx }} / EP.{{ item.eps }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ New Release ============ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' && (dsx.variable.wide || dsx.variable.homeTab == 'popular')">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="New Release" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
          <spacer/>
          <hstack class="viewAllRow" href="/browse" a11yGroup="true" a11yLabel="View all new releases">
            <text value="View all" class="viewAll"/>
            <image icon="chevron.right" iconSize="12" color="#FFFFFF" a11yHidden="true"/>
          </hstack>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.homeView.latest" key="id" axis="horizontal" scroll="false" spacing="18">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/watch/{{ item.id }}/1"
                      on:hoverStart="dsx.variable.hovId = item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}, {{ item.episodes }} episodes">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ posterHover }}"/>
                  <vstack class="badgeWrap" style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; pointer-events: none">
                    <text value="New" class="badge" visible-if="item.rank <= 2"/>
                  </vstack>
                  <vstack visible-if="dsx.variable.hovId == item.id"
                          style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; border-radius: 16px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.04); transition: transform 0.22s ease; z-index: 2">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <hstack class="hovPlay" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Play {{ item.title }}">
                        <image icon="play.fill" iconSize="11" color="#111111" a11yHidden="true"/>
                        <text value="Play" class="hovPlayLabel"/>
                      </hstack>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ TOP · ranked numerals ============ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' && (dsx.variable.wide || dsx.variable.homeTab == 'popular')">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="TOP" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
          <spacer/>
          <image icon="flame.fill" iconSize="16" color="#FF2C55" a11yHidden="true"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.homeView.trending" key="id" axis="horizontal" scroll="false" spacing="12">
              <vstack class="card" style="width: {{ dsx.variable.posterW + dsx.variable.rankOvl }}px" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Number {{ item.rank }}, {{ item.title }}">
                <zstack>
                  <hstack spacing="0" alignItems="flex-start">
                    <stack style="width: {{ dsx.variable.rankOvl }}px; height: 2px"/>
                    <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ dsx.variable.posterStyle }}"/>
                  </hstack>
                  <vstack style="width: 100%; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; align-items: flex-start; pointer-events: none">
                    <text value="{{ item.rank }}" class="rankNum" color="{{ rankColor }}"
                          style="font-size: {{ dsx.variable.rankSize }}px; line-height: 0.76; font-weight: 900; letter-spacing: -7px; text-shadow: 0 6px 22px rgba(0,0,0,0.85)"/>
                  </vstack>
                  <vstack class="badgeWrap" style="width: 100%; height: {{ dsx.variable.posterH }}px; padding-left: {{ dsx.variable.rankOvl + 10 }}px; pointer-events: none">
                    <text value="{{ topBadge }}" class="badge" visible-if="topBadge != ''"/>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch" style="padding-left: {{ dsx.variable.rankOvl }}px">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ genre shelves ============ -->
      <list bind="dsx.variable.homeView.shelves" key="genre" scroll="false" spacing="0"
            visible-if="dsx.variable.phase == 'ready' && (dsx.variable.wide || dsx.variable.homeTab == 'popular')">
        <vstack class="section">
          <!-- VIEW ALL — the affordance every shelf on ReelShort carries, and the reason
               Browse exists: a genre rail shows a handful, and the eleventh title had
               nowhere to live. Only the GENRE shelves get it, because only they have an
               exact destination; a "View all" on New Release would land on an unfiltered
               grid whose heading says something else. -->
          <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
            <text value="{{ item.genre }}" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
            <spacer/>
            <hstack class="shelfMore" href="/browse/{{ item.genre }}" a11yGroup="true" a11yTrait="button"
                    a11yLabel="View all {{ item.genre }} series">
              <text value="View all" class="shelfMoreLabel"/>
              <image icon="chevron.right" iconSize="10" color="rgba(255,255,255,0.5)" a11yHidden="true"/>
            </hstack>
          </hstack>
          <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
            <grid bind="item.items" key="id" columns="{{ dsx.variable.shelfCols }}" spacing="18" scroll="false">
              <vstack class="card" href="/watch/{{ item.id }}/1"
                      on:hoverStart="dsx.variable.hovId = 'g-' + item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ shelfHover }}"/>
                  <vstack visible-if="dsx.variable.hovId == 'g-' + item.id"
                          style="width: 100%; height: 100%; justify-content: flex-end; border-radius: 16px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.03); transition: transform 0.22s ease; z-index: 2">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <hstack class="hovPlay" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Play {{ item.title }}">
                        <image icon="play.fill" iconSize="11" color="#111111" a11yHidden="true"/>
                        <text value="Play" class="hovPlayLabel"/>
                      </hstack>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </grid>
          </vstack>
        </vstack>
      </list>

      <!-- ============ NEW · phone tab ============ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' && dsx.variable.wide == false && dsx.variable.homeTab == 'new'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <grid bind="dsx.variable.homeView.latest" key="id" columns="3" spacing="12" scroll="false">
            <vstack class="card" href="/show/{{ item.id }}" a11yGroup="true" a11yLabel="{{ item.title }}">
              <zstack>
                <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                       style="width: 100%; aspect-ratio: 3/4; border-radius: 10px; object-fit: cover"/>
                <vstack class="badgeWrap" style="width: 100%; height: 100%; pointer-events: none">
                  <text value="New" class="badge" visible-if="item.rank <= 4"/>
                </vstack>
              </zstack>
              <vstack spacing="2" alignItems="stretch">
                <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <text value="EP {{ item.episodes }}" class="cardMeta"/>
              </vstack>
            </vstack>
          </grid>
        </vstack>
      </vstack>

      <!-- ============ RANKING · phone tab: the ranked list ============ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' && dsx.variable.wide == false && dsx.variable.homeTab == 'ranking'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <list bind="dsx.variable.homeView.trending" key="id" scroll="false" spacing="0">
            <hstack class="rankRow" href="/show/{{ item.id }}" a11yGroup="true"
                    a11yLabel="Number {{ item.rank }}, {{ item.title }}"
                    style="border-bottom: 1px solid rgba(255,255,255,0.05)">
              <text value="{{ item.rank }}" class="rankBig" color="{{ rankColor }}"/>
              <!-- the ONE origin for Show's shared flight (a match id names one rect per
                   frame — the linter refuses a second even in a runtime-exclusive tab):
                   the ranked thumb flying into the 9:16 stage is the flight worth having,
                   and sharedMode="clip" on the far end reconciles the ratios -->
              <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                     shared="poster-{{ item.id }}"
                     style="width: 62px; height: 83px; border-radius: 8px; object-fit: cover"/>
              <vstack spacing="4" alignItems="stretch" style="flex: 1; min-width: 0">
                <text value="{{ item.title }}" class="rankTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <text value="{{ metaLine }}" class="rankMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <hstack spacing="6" alignItems="center" visible-if="item.rank <= 3">
                  <image icon="flame.fill" iconSize="11" color="#F6B63D" a11yHidden="true"/>
                  <text value="Trending now" class="rankMeta" color="#F6B63D"/>
                </hstack>
              </vstack>
              <text value="Watch" class="rankPlay"/>
            </hstack>
          </list>
        </vstack>
      </vstack>

      <!-- only when there is nothing to show — a failed refresh over a painted stash is silent -->
      <vstack class="section" style="{{ dsx.variable.shell }}" visible-if="home.error != null && dsx.variable.homeView == null">
        <vstack class="errCard">
          <text value="The catalogue is unavailable." fontSize="14" color="#FFFFFF"/>
          <button label="Retry" class="retryBtn" on:tap="home.refresh()"/>
        </vstack>
      </vstack>

      <!-- ============ footer ============ -->
      <vstack class="footer" visible-if="dsx.variable.wide" style="border-top: 1px solid rgba(255,255,255,0.08); margin-top: 44px">
        <hstack class="footCols" style="{{ dsx.variable.shell }}">
          <vstack class="footBrand" style="flex: 1">
            <hstack spacing="10" alignItems="center">
              <vstack class="logoBox" style="justify-content: center">
                <image icon="play.fill" iconSize="14" color="#FFFFFF" a11yHidden="true"/>
              </vstack>
              <text value="ShortDrama" class="wordmark"/>
            </hstack>
            <text value="© 2026 Short Drama — the Despia DSX flagship template.
One source. Native on iOS, Android, web and desktop." class="footCopy"/>
          </vstack>
          <vstack class="footCol">
            <text value="BROWSE" class="footHead"/>
            <text value="Home" class="footLink" href="/"/>
            <text value="Discover" class="footLink" href="/discover"/>
            <text value="My List" class="footLink" href="/list"/>
          </vstack>
          <vstack class="footCol">
            <text value="EARN" class="footHead"/>
            <text value="Rewards" class="footLink" href="/rewards"/>
            <text value="Daily check-in" class="footLink" href="/rewards"/>
            <text value="Spin the wheel" class="footLink" href="/rewards"/>
          </vstack>
          <vstack class="footCol">
            <text value="ACCOUNT" class="footHead"/>
            <text value="Wallet" class="footLink" href="/profile"/>
            <text value="Manage this app" class="footLink" href="/admin"/>
          </vstack>
        </hstack>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="home" visible-if="dsx.variable.wide == false"/>
</vstack>
