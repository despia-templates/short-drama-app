<!-- Home — TWO LANES, ONE SCREEN.

     THE PHONE LANE is the founder's reference app, built 1:1 to docs/design/reference-ui-spec.md
     §1 and §2 (measured off 390×847 screenshots): a search field carrying a trending title with
     the gold crown beside it · a text tab strip (Hot · New · Picks · Ranking) with a 2pt rule
     under the active label · "Trending Now" over a 3-column grid of 2:3 covers wearing the HOT /
     NEW badge, the ORIGINAL mark and the play count · a New tab that opens on the "Coming soon"
     rail (panel cards with an inline Remind Me) over the "New Titles" list · the coming-soon
     sheet (§2a) and, NESTED over it, the notification-permission sheet (§2b). Every number is
     the spec's, every colour a named tone (Components/parts/Theme.dsx).

     THE WIDE LANE (tablet and desktop) keeps the category reference measured live at 1440×900:
     a 64px transparent nav floating over a 480px full-bleed hero, then the rails — Continue
     Watching · New Release · TOP (giant ranked numerals) · genre grids — over a link-column
     footer. The phone reference is a phone; the wide reference is the web the category ships.

     REMIND ME is the one flow on this screen that reaches past the app: Core/Notify asks for
     the permission the §2b checkbox stands for, Core/LocalPush schedules the one-shot at the
     premiere on the two lanes that can, and server/reminders.dsx keeps the row that survives a
     reinstall. Each lane says exactly which halves it managed (the `remindNote`), never a
     success it did not earn — the web facet of `send` is a page timer that dies with the tab,
     so a nine-day premiere is never armed there (dsx.config.json `_remind_note`). -->
<!-- min-height rides the :web suffix: it is the BODY-HEIGHT mechanism of the web page
     (the .dsx-frame pads the safe areas and flexes its child), while a native route frame
     already proposes exactly the SAFE region — window height forced 34pt of content under
     the home indicator. The screen class's grow="true" is the cross-platform fill. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="home" url="/catalog/home" on:success="dsx.action.homeLanded()"/>
    <!-- the seam owns the token (<AuthSeam/> at the foot of this file); every authenticated
         read is gated on `global.auth.ok` and carries `global.auth.headers` — docs/auth.md -->
    <api as="continue" url="/viewer/continue" ssr="false"
         auto="global.auth.ok == true" headers="global.auth.headers"
         on:success="global.cacheContinue = global.auth.ok == true ? continue.data : null"/>

    <variable as="heroPage">return 0</variable>
    <variable as="hovId">return ''</variable>   <!-- the card under the pointer (wide lane) -->
    <!-- the phone home's tab strip: Hot · New · Picks · Ranking (spec §1 row 2) -->
    <variable as="homeTab">return 'hot'</variable>
    <variable as="toast">return ''</variable>

    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the last good
         payload lives in the app-wide store and is the FIRST PAINT while the refetch runs. -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <!-- a DEVICE viewer (no account yet) is the web-home link-banner audience; an account viewer
         has nothing to link and the banner self-hides -->
    <variable as="isDevice" computed="true">return global.auth != null &amp;&amp; global.auth.kind == 'device'</variable>
    <variable as="continueView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (continue.data != null) { return continue.data }
      return global.cacheContinue
    </variable>

    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <!-- THE HOVER REVEAL IS A DESKTOP AFFORDANCE — `wide` includes TABLET, a touch surface
         that happens to be roomy; the engine gates on:hoverStart on a real pointer, and a
         poster that turns into a wall of synopsis under a finger reads as a tap gone wrong -->
    <variable as="hoverReveal" computed="true">return dsx.variable.bp == 'desktop'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 86 }
      if (dsx.variable.bp == 'tablet') { return 40 }
      return 14
    </variable>
    <variable as="posterW" computed="true">
      if (dsx.variable.bp == 'desktop') { return 239 }
      if (dsx.variable.bp == 'tablet') { return 186 }
      return 150
    </variable>
    <!-- 3:4 is the measured category ratio on the WIDE lane; the phone lane is 2:3 (spec §1) -->
    <variable as="posterH" computed="true">return Math.round(dsx.variable.posterW * 4 / 3)</variable>
    <variable as="heroH" computed="true">
      if (dsx.variable.bp == 'desktop') { return 480 }
      return 420
    </variable>
    <variable as="heroTitleSize" computed="true">return dsx.variable.bp == 'desktop' ? 32 : 28</variable>
    <variable as="headSize" computed="true">return 28</variable>
    <variable as="shelfCols" computed="true">return dsx.variable.bp == 'desktop' ? 5 : 4</variable>
    <variable as="rankOvl" computed="true">return Math.round(dsx.variable.posterW * 0.36)</variable>
    <variable as="rankSize" computed="true">return Math.round(dsx.variable.posterH * 0.62)</variable>

    <!-- compound style lists are ONE computed value used as the WHOLE attribute
         (a bare {{ }} fragment beside other declarations is discarded — AGENTS.md) -->
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <!-- A RAIL TRACK IS NOT A PAGE SHELL: `max-content` with the gutter as its padding, or
         the cards eat the difference (measured, AGENTS.md) -->
    <variable as="railShell" computed="true">
      const g = dsx.variable.gutter
      const over = dsx.screen.width - 1440
      const lead = g + (over > 0 ? Math.round(over / 2) : 0)
      return 'width: max-content; padding-left: ' + lead + 'px; padding-right: ' + lead + 'px'
    </variable>
    <variable as="heroInnerBox" computed="true">
      return dsx.variable.shell + '; height: 100%; justify-content: center; align-items: flex-start'
    </variable>
    <variable as="thumbShellBox" computed="true">
      return dsx.variable.shell + '; justify-content: flex-end; padding-bottom: 34px'
    </variable>
    <variable as="posterStyle" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; border-radius: 16px; object-fit: cover'
    </variable>
    <variable as="posterBox" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; justify-content: flex-end'
    </variable>
    <variable as="homeView" computed="true">
      if (home.data != null) { return home.data }
      return global.cacheHome
    </variable>
    <!-- THE FIRST VISIT HAD NO STATE: a cold load has nothing to fall back to, so the phase
         drives skeletons; `empty` is a real state too (a seeded-but-unpublished catalogue) -->
    <variable as="phase" computed="true">
      const v = dsx.variable.homeView
      if (v != null) { return v.latest.length == 0 && v.hero.length == 0 ? 'empty' : 'ready' }
      if (home.error != null) { return 'error' }
      return 'loading'
    </variable>
    <variable as="skelRows" computed="true">return [0, 1, 2, 3, 4, 5]</variable>
    <!-- the grid the Hot tab draws: hot-first then by play count (server/catalog.dsx). A
         payload stashed before the field existed has no `grid`, so the older rails stand in -->
    <variable as="gridRows" computed="true">
      const v = dsx.variable.homeView
      if (v == null) { return [] }
      if (v.grid != null) { return v.grid }
      return v.latest
    </variable>
    <variable as="pickRows" computed="true">
      const v = dsx.variable.homeView
      if (v == null) { return [] }
      if (v.picks != null) { return v.picks }
      return v.hero
    </variable>
    <variable as="soonRows" computed="true">
      const v = dsx.variable.homeView
      if (v == null) { return [] }
      if (v.comingSoon == null) { return [] }
      return v.comingSoon
    </variable>
    <variable as="newRows" computed="true">
      const v = dsx.variable.homeView
      if (v == null) { return [] }
      if (v.newTitles == null) { return [] }
      return v.newTitles
    </variable>
    <!-- THE SEARCH HINT IS A TRENDING TITLE (spec §1), never the word "Search". It rotates
         per landing — the catalogue advances an app-wide index every time it lands, so each
         visit to Home offers the next hot title — rather than on a timer the markup has no
         word for. -->
    <variable as="searchHint" computed="true">
      const rows = dsx.variable.gridRows
      if (rows.length == 0) { return 'Search dramas' }
      const i = global.searchHintIdx == null ? 0 : Number(global.searchHintIdx)
      return rows[i % rows.length].title
    </variable>
    <variable as="heroTags" computed="true">
      const h = dsx.variable.heroShow
      if (h == null || h.tags == null) { return [] }
      return h.tags.slice(0, 5).map(t => ({ name: t }))
    </variable>
    <variable as="heroViews" computed="true">
      const h = dsx.variable.heroShow
      if (h == null || h.views == null || h.views < 1000) { return '' }
      return compactCount(h.views)
    </variable>
    <variable as="heroShow" computed="true">
      if (dsx.variable.homeView == null) { return null }
      const p = Number(dsx.variable.heroPage)
      if (p < 0 || p >= dsx.variable.homeView.hero.length) { return null }
      return dsx.variable.homeView.hero[p]
    </variable>
    <variable as="heroCount" computed="true">
      if (dsx.variable.homeView == null) { return 0 }
      return dsx.variable.homeView.hero.length
    </variable>

    <!-- ONE computed list: `style="{{ chunk }}; extras"` discards the chunk (AGENTS.md) -->
    <formula as="posterHover" id="item.id">
      const lift = (dsx.variable.hoverReveal && dsx.variable.hovId == id) ? 1.04 : 1
      return dsx.variable.posterStyle + '; transition: transform 0.22s ease; transform: scale(' + lift + ')'
    </formula>
    <formula as="shelfHover" id="item.id">
      const lift = (dsx.variable.hoverReveal && dsx.variable.hovId == ('g-' + id)) ? 1.03 : 1
      return 'width: 100%; aspect-ratio: 3/4; border-radius: 16px; object-fit: cover; transition: transform 0.22s ease; transform: scale(' + lift + ')'
    </formula>
    <formula as="metaLine" g="item.genre" n="item.episodes">
      return (g == null || g === '' ? 'Drama' : g) + '  |  Series' + (n > 0 ? '  |  EP ' + n : '')
    </formula>
    <formula as="rankColor" r="item.rank">
      if (r == 1) { return '#F6B63D' }
      if (r == 2) { return '#B9C5D8' }
      if (r == 3) { return '#CE8B5C' }
      return '#43434D'
    </formula>
    <!-- coverflow: the resting title is whole and the ones either side recede (measured
         off the category reference; scale and opacity both move) -->
    <formula as="coverCell" r="item.rank">
      const on = r - 1 == Number(dsx.variable.heroPage)
      return 'width: 78px; height: 104px; border-radius: 8px; object-fit: cover; '
        + 'border: 2px solid ' + (on ? '#FFFFFF' : 'rgba(255,255,255,0.14)') + '; '
        + 'opacity: ' + (on ? '1' : '0.55') + '; '
        + 'transform: scale(' + (on ? 1.1 : 0.92) + '); '
        + 'transition: opacity 0.24s ease, border-color 0.24s ease, transform 0.24s ease'
    </formula>
    <formula as="topBadge" r="item.rank" f="item.featured">
      if (r == 1) { return 'Trending' }
      if (f) { return 'Hot' }
      return ''
    </formula>

    <!-- A REAL payload retires the offline-demo degradation (Article 7): the chip drops the
         moment the origin answers. The search hint advances with every landing. -->
    <!-- the rail's honest line (which halves of Remind Me this lane managed) lands here -->
    <action as="note" text="text">
      dsx.variable.toast = text
    </action>

    <action as="homeLanded">
      global.cacheHome = home.data
      global.demoSeeded = false
      const i = global.searchHintIdx == null ? 0 : Number(global.searchHintIdx)
      global.searchHintIdx = i + 1
    </action>

    <action as="heroPrev">
      const n = dsx.variable.heroCount
      if (n < 2) { return }
      const p = Number(dsx.variable.heroPage)
      dsx.variable.heroPage = p <= 0 ? n - 1 : p - 1
    </action>
    <action as="heroNext">
      const n = dsx.variable.heroCount
      if (n < 2) { return }
      const p = Number(dsx.variable.heroPage)
      dsx.variable.heroPage = p >= n - 1 ? 0 : p + 1
    </action>


    <!-- THE ROOT CARRIES ITS SIZE AS ATTRIBUTES, not CSS: `grow` is the cross-platform twin
         of the web's flex fill (PLAN.md §6.43). -->
    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch" grow="true"/>
    <style as="page" spacing="0" paddingBottom="0" alignItems="stretch" grow="width"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="44" grow="width"/>

    <!-- ── the phone lane (spec §1, §2) ── -->
    <style as="searchRow" paddingTop="8" paddingBottom="8" paddingLeading="14" paddingTrailing="14" spacing="12" alignItems="center"/>
    <style as="tabTrack" spacing="20" alignItems="flex-end" paddingLeading="14" paddingTrailing="14" paddingTop="6" paddingBottom="2"/>
    <!-- `width="fit"`: the column HUGS its label (the catalog's hug primitive) on every lane —
         inside a horizontal scroll the native row otherwise proposed each column a share of
         the viewport and truncated "Picks" to "Pic…" (measured on the iPhone 17 Pro) -->
    <style as="tabCol" spacing="6" alignItems="stretch" width="fit"/>
    <style as="tabTxt" fontSize="17" fontWeight="semibold" lineLimit="1"/>
    <style as="tabRule" height="2" radius="1"/>
    <style as="block" spacing="16" alignItems="stretch" paddingTop="24" grow="width"/>
    <style as="h2" fontSize="22" fontWeight="bold" color="#FFFFFF" tracking="-0.3" paddingLeading="14" paddingTrailing="14"/>
    <style as="gridWrap" paddingLeading="14" paddingTrailing="14" alignItems="stretch"/>
    <style as="railTrack" spacing="8" alignItems="flex-start"/>
    <style as="footRow" spacing="4" alignItems="center" zIndex="2"/>
    <style as="markRow" spacing="2" alignItems="center"/>
    <!-- 10pt: the spec's measure for the ORIGINAL mini badge (§1), the one size under the
         ramp's 11 the reference declares -->
    <style as="markTxt" fontSize="10" fontWeight="bold" color="#FFFFFF" textCase="uppercase" lineLimit="1"/>
    <style as="scrim" gradient="rgba(0,0,0,0)|rgba(0,0,0,0.6)" gradientDir="vertical" height="56" zIndex="1"/>
    <style as="badge" background="#E0342C" radius="4" paddingH="6" paddingV="2" fontSize="11" fontWeight="bold" color="#FFFFFF" zIndex="2"/>
    <style as="countRow" spacing="2" alignItems="center"/>
    <style as="countTxt" fontSize="12" fontWeight="semibold" color="#FFFFFF" lineLimit="1"/>
    <style as="countTxtSm" fontSize="11" fontWeight="semibold" color="#FFFFFF" lineLimit="1"/>
    <style as="newList" paddingLeading="14" paddingTrailing="14" alignItems="stretch"/>
    <style as="newRow" spacing="12" alignItems="flex-start"/>
    <style as="newCol" spacing="6" alignItems="stretch"/>
    <style as="newTitle" fontSize="16" fontWeight="bold" color="#FFFFFF" lineLimit="1"/>
    <style as="chipRow" spacing="6" alignItems="center"/>
    <style as="chip" background="#2C2C2E" radius="6" paddingH="8" paddingV="4" fontSize="12" color="#FFFFFF" lineLimit="1"/>
    <style as="newSyn" fontSize="13" color="#8E8E93" lineLimit="2" lineSpacing="5"/>
    <style as="rankRow" spacing="12" alignItems="center" paddingV="10"/>
    <style as="rankBig" fontWeight="heavy" fontSize="24" width="34" textAlign="center"/>
    <style as="rankTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="rankMeta" fontSize="13" color="#8E8E93"/>
    <style as="rankPlay" background="#2C2C2E" radius="8" paddingH="14" paddingV="8" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="emptyTab" fontSize="15" color="#8E8E93" textAlign="center" paddingV="40"/>
    <!-- the toast: card fill, radius 10, 13 ink, padding 10×14 (spec −1) -->
    <style as="toastRow" background="#1C1C1E" radius="10" paddingH="14" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="13" color="#FFFFFF" lineSpacing="3"/>

    <!-- ── the wide lane (the category web reference at 1440×900) ── -->
    <style as="heroBlock" spacing="16" alignItems="flex-start"/>
    <style as="heroTagRow" spacing="6" alignItems="center"/>
    <style as="tagSoft" background="rgba(255,233,168,0.10)" radius="4" paddingH="9" paddingV="4" fontSize="12" color="#FFE9A8"/>
    <style as="heroMeta" spacing="6" alignItems="center"/>
    <style as="metaTxt" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.62)"/>
    <style as="heroTitle" fontWeight="bold" color="rgba(255,255,255,0.9)" lineLimit="2" tracking="-0.5"/>
    <style as="heroPills" spacing="8" alignItems="center"/>
    <style as="pillHot" background="#E0342C" radius="13" paddingH="12" paddingV="5" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="pillTag" background="rgba(255,255,255,0.14)" radius="13" paddingH="12" paddingV="5" fontSize="12" fontWeight="medium" color="rgba(255,255,255,0.92)"/>
    <style as="heroSyn" fontSize="14" color="rgba(255,255,255,0.72)" lineLimit="2" lineSpacing="4"/>
    <style as="playPill" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" spacing="9" alignItems="center"/>
    <style as="playLabel" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="thumbRow" spacing="14" alignItems="center"/>
    <style as="heroArrow" width="44" height="44" radius="22" alignItems="center" alignY="center" background="rgba(18,18,20,0.55)"/>
    <style as="sectionHead" alignItems="center"/>
    <style as="sectionTitle" fontWeight="bold" color="rgba(255,255,255,0.8)" tracking="-0.3"/>
    <style as="viewAll" fontSize="14" color="#FFFFFF"/>
    <style as="viewAllRow" spacing="4" alignItems="center"/>
    <style as="rail" spacing="18" alignItems="flex-start"/>
    <style as="card" spacing="8" alignItems="stretch"/>
    <style as="shelfMore" spacing="4" alignItems="center"/>
    <style as="shelfMoreLabel" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.5)"/>
    <style as="cardTitle" fontSize="14" color="rgba(255,255,255,0.8)" lineLimit="1"/>
    <style as="cardMeta" fontSize="14" color="rgba(255,255,255,0.9)" lineLimit="1"/>
    <style as="badgeWide" background="#E0342C" radius="4" paddingH="8" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeDark" background="rgba(0,0,0,0.72)" radius="4" paddingH="8" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeWrap" paddingLeading="10" paddingTop="10" alignItems="flex-start" zIndex="1"/>
    <style as="hovPanel" spacing="9" alignItems="flex-start" paddingH="14" paddingBottom="14"/>
    <style as="hovSyn" fontSize="12" color="rgba(255,255,255,0.86)" lineLimit="3" lineSpacing="2"/>
    <style as="hovPlay" background="#FFFFFF" radius="15" paddingH="14" paddingV="7" spacing="6" alignItems="center"/>
    <style as="hovPlayLabel" fontSize="12" fontWeight="bold" color="#111111"/>
    <style as="rankNum" fontWeight="heavy"/>
    <style as="resumeTrack" background="rgba(255,255,255,0.22)" radius="2"/>
    <style as="resumeFill" background="#E0342C" radius="2"/>
    <style as="footer" alignItems="stretch" spacing="26" paddingTop="40" paddingBottom="34"/>
    <style as="footCols" spacing="70" alignItems="flex-start"/>
    <style as="footBrand" spacing="12" alignItems="flex-start"/>
    <style as="footCopy" fontSize="12" color="rgba(255,255,255,0.45)" lineSpacing="3"/>
    <style as="footCol" spacing="12" alignItems="flex-start"/>
    <style as="footHead" fontSize="14" fontWeight="bold" color="#FFFFFF" tracking="0.3"/>
    <style as="footLink" fontSize="14" color="rgba(255,255,255,0.55)"/>
    <style as="logoBox" background="#E0342C" radius="8" alignItems="center" width="29" height="29"/>
    <style as="wordmark" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>
    <style as="skelBlock" background="#141414" radius="6"/>
    <style as="errCard" background="#141414" radius="12" spacing="10" paddingH="18" paddingV="20" alignItems="center"/>
    <style as="retryBtn" background="#FFFFFF" radius="12" paddingH="20" paddingV="12" fontSize="15" fontWeight="semibold" color="#000000"/>
  </head>

  <!-- THE PRESENTATION PLANE, FIRST: this screen reads its own computeds on the next line -->
  <Theme/>
  <!-- OFFLINE DEMO SEED (native test lanes only — the component gates itself; Article 7) -->
  <DemoSeed/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <!-- the wide nav rides INSIDE the scroll so the hero art runs under it; zIndex ON THE
           MOUNT TAG lifts the instance above the pulled-under hero on native (AGENTS.md) -->
      <TopNav active="home" overArt="true" zIndex="50" visible-if="dsx.variable.wide"/>

      <!-- ══════════════════════════ PHONE · the search row (spec §1.1) ══════════════════ -->
      <hstack class="searchRow" visible-if="dsx.variable.wide == false">
        <SearchOverlay pill="true" placeholder="{{ dsx.variable.searchHint }}" grow="width"/>
        <image icon="crown.fill" iconSize="22" color="{{ crownGold() }}" a11yLabel="Membership" a11yTrait="button"
               on:tap="dsx.module.route.push({ path: membershipPath() })"/>
      </hstack>

      <!-- ══════════════════════════ PHONE · the tab strip (spec §1.2) ═══════════════════
           text tabs, 17 semibold, ink / ink-3, a 2pt rule the width of the active label, 6pt
           under it; the strip scrolls sideways the day a fifth tab arrives -->
      <scroll axis="horizontal" indicators="false" visible-if="dsx.variable.wide == false">
        <hstack class="tabTrack" style="width: max-content">
          <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'hot'" a11yTrait="button"
                  a11yLabel="Hot{{ dsx.variable.homeTab == 'hot' ? ', selected' : '' }}">
            <text value="Hot" class="tabTxt" color="{{ dsx.variable.homeTab == 'hot' ? ink() : ink3() }}"/>
            <stack class="tabRule" background="{{ dsx.variable.homeTab == 'hot' ? ink() : 'rgba(0,0,0,0)' }}"/>
          </vstack>
          <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'new'" a11yTrait="button"
                  a11yLabel="New{{ dsx.variable.homeTab == 'new' ? ', selected' : '' }}">
            <text value="New" class="tabTxt" color="{{ dsx.variable.homeTab == 'new' ? ink() : ink3() }}"/>
            <stack class="tabRule" background="{{ dsx.variable.homeTab == 'new' ? ink() : 'rgba(0,0,0,0)' }}"/>
          </vstack>
          <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'picks'" a11yTrait="button"
                  a11yLabel="Picks{{ dsx.variable.homeTab == 'picks' ? ', selected' : '' }}">
            <text value="Picks" class="tabTxt" color="{{ dsx.variable.homeTab == 'picks' ? ink() : ink3() }}"/>
            <stack class="tabRule" background="{{ dsx.variable.homeTab == 'picks' ? ink() : 'rgba(0,0,0,0)' }}"/>
          </vstack>
          <vstack class="tabCol" on:tap="dsx.variable.homeTab = 'ranking'" a11yTrait="button"
                  a11yLabel="Ranking{{ dsx.variable.homeTab == 'ranking' ? ', selected' : '' }}">
            <text value="Ranking" class="tabTxt" color="{{ dsx.variable.homeTab == 'ranking' ? ink() : ink3() }}"/>
            <stack class="tabRule" background="{{ dsx.variable.homeTab == 'ranking' ? ink() : 'rgba(0,0,0,0)' }}"/>
          </vstack>
          <text value="offline demo" visible-if="global.demoSeeded == true"
                background="rgba(246,182,61,0.14)" color="#F6B63D" fontSize="11" fontWeight="semibold"
                radius="9" paddingH="8" paddingV="3" a11yLabel="Offline demo data — no server is connected"/>
        </hstack>
      </scroll>

      <!-- WEB HOME LINK BANNER — the founder wants aggression here: a device viewer on the web (the
           weakest durability plane) gets a persistent nudge to link an account. Native keeps the
           per-screen card instead. LinkPrompt self-hides for an account viewer. -->
      <vstack class="gridWrap" paddingTop="12" visible-if="dsx.variable.isDevice &amp;&amp; os == 'web'">
        <LinkPrompt variant="banner" icon="bookmark.fill"
                    title="Keep your list and coins on your account"
                    note="Sign in to keep everything you save here on any device."/>
      </vstack>

      <!-- LOADING: the real shape, so the page does not resize under the viewer -->
      <vstack visible-if="dsx.variable.phase == 'loading'" alignItems="stretch" spacing="16" class="gridWrap" paddingTop="24">
        <stack class="skelBlock" style="width: 160px; height: 22px" visible-if="dsx.variable.wide == false"/>
        <stack class="skelBlock" style="width: 100%; height: {{ dsx.variable.heroH }}px" visible-if="dsx.variable.wide"/>
        <grid bind="dsx.variable.skelRows" key="index" columns="{{ dsx.variable.wide ? dsx.variable.shelfCols : 3 }}" spacing="{{ dsx.variable.wide ? 18 : 7 }}" scroll="false">
          <vstack spacing="6" alignItems="stretch">
            <stack class="skelBlock" style="width: 100%; aspect-ratio: {{ dsx.variable.wide ? '3/4' : '2/3' }}"/>
            <stack class="skelBlock" style="width: 70%; height: 13px"/>
          </vstack>
        </grid>
      </vstack>

      <vstack class="block gridWrap" visible-if="dsx.variable.phase == 'empty'">
        <vstack class="errCard">
          <image icon="rectangle.stack.fill" iconSize="30" color="{{ ink3() }}" a11yHidden="true"/>
          <text value="No series are live yet." fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
          <text value="Published series appear here as they go live." fontSize="13" color="#8E8E93"/>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ PHONE · HOT (spec §1.3–4) ═══════════════════════════ -->
      <vstack class="block" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide == false &amp;&amp; dsx.variable.homeTab == 'hot'">
        <text value="Trending Now" class="h2"/>
        <vstack class="gridWrap">
          <grid bind="dsx.variable.gridRows" key="id" columns="3" spacing="7" scroll="false">
            <CoverCard id="{{ item.id }}" title="{{ item.title }}" genre="{{ item.genre }}" cover="{{ item.cover }}"
                       hot="{{ item.hot }}" isNew="{{ item.isNew }}" original="{{ item.original }}" views="{{ item.views }}"
                       path="/watch/{{ item.id }}/1"/>
          </grid>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ PHONE · NEW (spec §2) ═══════════════════════════════ -->
      <vstack class="block" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide == false &amp;&amp; dsx.variable.homeTab == 'new' &amp;&amp; dsx.variable.soonRows.length > 0">
        <text value="Coming soon" class="h2"/>
        <!-- the rail and its two sheets are ONE part, shared with the Member Points tab
             (Components/parts/ComingSoonRail.dsx); the toast it raises is this screen's -->
        <ComingSoonRail rows="{{ dsx.variable.soonRows }}" variant="home" gutter="14" on:note="dsx.action.note()"/>
      </vstack>

      <vstack class="block" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide == false &amp;&amp; dsx.variable.homeTab == 'new'">
        <text value="New Titles" class="h2"/>
        <text value="Nothing new this week — check back soon." class="emptyTab" visible-if="dsx.variable.newRows.length == 0"/>
        <vstack class="newList">
          <list bind="dsx.variable.newRows" key="id" scroll="false" spacing="16">
            <hstack class="newRow" href="/show/{{ item.id }}" a11yGroup="true" a11yLabel="{{ item.title }}, {{ item.genre }}">
              <!-- 81×127, radius 6, the same three overlays as the grid cell -->
              <zstack style="width: 81px; height: 127px; position: relative; border-radius: 6px; overflow: hidden">
                <image src="{{ item.cover }}" contentFit="cover" a11yHidden="true" width="81" height="127" radius="6"
                       style="width: 81px; height: 127px; object-fit: cover"/>
                <stack class="scrim" a11yHidden="true"
                       style="position: absolute; left: 0; right: 0; bottom: 0; height: 56px; background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%); pointer-events: none"/>
                <text value="{{ item.hot ? 'HOT' : 'NEW' }}" class="badge" a11yHidden="true" visible-if="item.hot || item.isNew"
                      style="position: absolute; top: 6px; right: 6px"/>
                <!-- AN 81pt POSTER CANNOT HOLD BOTH BOTTOM OVERLAYS at the spec's sizes (the mark
                     alone is ~60pt), so when the title is an ORIGINAL the count takes the top-left
                     corner — the one the NEW badge leaves free — and only a title without the
                     mark keeps the count bottom-right as §1 draws it. Measured, not preferred. -->
                <hstack class="markRow" visible-if="item.original" a11yHidden="true"
                        style="position: absolute; left: 5px; bottom: 5px">
                  <image icon="play.fill" iconSize="9" color="#FFFFFF" a11yHidden="true"/>
                  <text value="ORIGINAL" class="markTxt" style="white-space: nowrap"/>
                </hstack>
                <hstack class="countRow" visible-if="item.views >= 1000 &amp;&amp; item.original == false" a11yHidden="true"
                        style="position: absolute; right: 5px; bottom: 5px">
                  <image icon="flame.fill" iconSize="10" color="#FFFFFF" a11yHidden="true"/>
                  <text value="{{ compactCount(item.views) }}" class="countTxtSm" style="white-space: nowrap"/>
                </hstack>
                <hstack class="countRow" visible-if="item.views >= 1000 &amp;&amp; item.original" a11yHidden="true"
                        style="position: absolute; left: 5px; top: 5px">
                  <image icon="flame.fill" iconSize="10" color="#FFFFFF" a11yHidden="true"/>
                  <text value="{{ compactCount(item.views) }}" class="countTxtSm" style="white-space: nowrap"/>
                </hstack>
              </zstack>
              <vstack class="newCol" style="flex: 1; min-width: 0">
                <text value="{{ item.title }}" class="newTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <hstack class="chipRow" style="overflow: hidden; white-space: nowrap">
                  <list bind="item.chips" key="name" axis="horizontal" scroll="false" spacing="6">
                    <text value="{{ item.name }}" class="chip" style="white-space: nowrap"/>
                  </list>
                </hstack>
                <text value="{{ item.synopsis }}" class="newSyn"
                      style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
              </vstack>
            </hstack>
          </list>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ PHONE · PICKS — the operator's featured set ══════════ -->
      <vstack class="block" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide == false &amp;&amp; dsx.variable.homeTab == 'picks'">
        <text value="Editor's Picks" class="h2"/>
        <vstack class="gridWrap">
          <grid bind="dsx.variable.pickRows" key="id" columns="3" spacing="7" scroll="false">
            <CoverCard id="{{ item.id }}" title="{{ item.title }}" genre="{{ item.genre }}" cover="{{ item.cover }}"
                       hot="{{ item.hot }}" isNew="{{ item.isNew }}" original="{{ item.original }}" views="{{ item.views }}"
                       path="/watch/{{ item.id }}/1"/>
          </grid>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ PHONE · RANKING — the top ten by play count ═════════ -->
      <vstack class="block" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide == false &amp;&amp; dsx.variable.homeTab == 'ranking'">
        <text value="Top 10" class="h2"/>
        <vstack class="newList">
          <list bind="dsx.variable.gridRows" key="id" scroll="false" spacing="0">
            <hstack class="rankRow" href="/show/{{ item.id }}" a11yGroup="true" visible-if="item.rank <= 10"
                    a11yLabel="Number {{ item.rank }}, {{ item.title }}"
                    style="border-bottom: 1px solid rgba(255,255,255,0.12)">
              <text value="{{ item.rank }}" class="rankBig" color="{{ rankColor }}"/>
              <!-- the ONE origin for Show's shared flight (a match id names one rect per frame) -->
              <image src="{{ item.cover }}" contentFit="cover" a11yHidden="true" shared="poster-{{ item.id }}"
                     width="62" height="93" radius="6" style="width: 62px; height: 93px; border-radius: 6px; object-fit: cover"/>
              <vstack spacing="4" alignItems="stretch" style="flex: 1; min-width: 0">
                <text value="{{ item.title }}" class="rankTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <text value="{{ metaLine }}" class="rankMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <hstack spacing="4" alignItems="center" visible-if="item.views >= 1000">
                  <image icon="flame.fill" iconSize="11" color="{{ crownGold() }}" a11yHidden="true"/>
                  <text value="{{ compactCount(item.views) }}" class="rankMeta" color="{{ crownGold() }}"/>
                </hstack>
              </vstack>
              <text value="Watch" class="rankPlay"/>
            </hstack>
          </list>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ WIDE · HERO ═════════════════════════════════════════ -->
      <vstack visible-if="dsx.variable.wide &amp;&amp; heroShow != null &amp;&amp; dsx.variable.phase == 'ready'" style="width: 100%; margin-top: -64px" alignItems="stretch">
        <zstack>
          <pager bind="dsx.variable.homeView.hero" key="id" height="{{ dsx.variable.heroH }}" dots="false" value="dsx.variable.heroPage">
            <image src="{{ item.hero }}" contentFit="cover" a11yLabel="{{ item.title }}"
                   style="width: 100%; height: {{ dsx.variable.heroH }}px; object-fit: cover"/>
          </pager>
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; pointer-events: none; background: linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.6) 32%, rgba(0,0,0,0) 62%), linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0.5) 82%, #000000 100%)">
            <vstack style="{{ dsx.variable.heroInnerBox }}">
              <vstack class="heroBlock" style="max-width: 560px; pointer-events: auto">
                <text value="{{ heroShow == null ? '' : heroShow.title }}" class="heroTitle" fontSize="{{ dsx.variable.heroTitleSize }}"/>
                <hstack class="heroPills">
                  <text value="HOT" class="pillHot" visible-if="heroShow != null &amp;&amp; heroShow.hot"/>
                  <text value="{{ heroShow == null ? '' : heroShow.genre }}" class="pillTag"/>
                </hstack>
                <hstack class="heroTagRow" visible-if="dsx.variable.heroTags.length > 0">
                  <list bind="dsx.variable.heroTags" key="name" axis="horizontal" scroll="false" spacing="6">
                    <text value="{{ item.name }}" class="tagSoft" a11yTrait="button"
                          a11yLabel="Browse {{ item.name }}" href="/browse/{{ item.name }}"/>
                  </list>
                </hstack>
                <hstack class="heroMeta" visible-if="dsx.variable.heroViews != ''">
                  <image icon="flame.fill" iconSize="13" color="rgba(255,255,255,0.55)" a11yHidden="true"/>
                  <text value="{{ dsx.variable.heroViews }}" class="metaTxt" a11yLabel="{{ dsx.variable.heroViews }} views"/>
                  <text value="·" class="metaTxt" a11yHidden="true"/>
                  <image icon="star.fill" iconSize="12" color="#F6B63D" a11yHidden="true"/>
                  <text value="{{ heroShow == null ? '' : heroShow.rating }}" class="metaTxt"
                        a11yLabel="rated {{ heroShow == null ? '' : heroShow.rating }} out of 10"/>
                </hstack>
                <text value="{{ heroShow == null ? '' : heroShow.synopsis }}" class="heroSyn"/>
                <hstack class="playPill" a11yGroup="true" a11yTrait="button" a11yLabel="Play {{ heroShow == null ? '' : heroShow.title }}"
                        on:tap="dsx.module.route.push({ path: '/watch/' + (heroShow == null ? '' : heroShow.id) + '/1' })">
                  <image icon="play.fill" iconSize="14" color="#111111" a11yHidden="true"/>
                  <text value="Play" class="playLabel"/>
                </hstack>
              </vstack>
            </vstack>
          </vstack>
          <!-- the thumb rail drives the pager; its two chevrons stay PHYSICAL because a pager's
               page order does not turn with the reading direction (PLAN.md §6.103) -->
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; justify-content: flex-end; pointer-events: none">
            <hstack style="{{ dsx.variable.thumbShellBox }}">
              <hstack class="thumbRow" style="pointer-events: auto; z-index: 3">
                <vstack class="heroArrow" visible-if="dsx.variable.heroCount > 1" on:tap="dsx.action.heroPrev()"
                        a11yGroup="true" a11yTrait="button" a11yLabel="Previous feature">
                  <image icon="chevron.left" iconSize="17" color="rgba(255,255,255,0.92)" a11yHidden="true"/>
                </vstack>
                <list bind="dsx.variable.homeView.hero" key="id" axis="horizontal" scroll="false" spacing="10"
                      visible-if="dsx.variable.bp == 'desktop'">
                  <image src="{{ item.poster }}" contentFit="cover" a11yLabel="Feature {{ item.title }}" a11yTrait="button"
                         on:tap="dsx.variable.heroPage = item.rank - 1" style="{{ coverCell }}"/>
                </list>
                <vstack class="heroArrow" visible-if="dsx.variable.heroCount > 1" on:tap="dsx.action.heroNext()"
                        a11yGroup="true" a11yTrait="button" a11yLabel="Next feature">
                  <image icon="chevron.right" iconSize="17" color="rgba(255,255,255,0.92)" a11yHidden="true"/>
                </vstack>
              </hstack>
            </hstack>
          </vstack>
        </zstack>
      </vstack>

      <!-- ══════════════════════════ WIDE · Continue Watching ════════════════════════════ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide &amp;&amp; dsx.variable.continueView != null &amp;&amp; dsx.variable.continueView.items.length > 0">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="Continue Watching" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.continueView.items" key="episode" axis="horizontal" scroll="false" spacing="18">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/watch/{{ item.show }}/{{ item.idx }}" a11yGroup="true" a11yLabel="Continue {{ item.title }}, episode {{ item.idx }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ dsx.variable.posterStyle }}"/>
                  <vstack class="badgeWrap" style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; pointer-events: none">
                    <text value="EP {{ item.idx }}" class="badgeDark"/>
                  </vstack>
                  <vstack style="{{ dsx.variable.posterBox }}">
                    <stack class="resumeTrack" style="width: {{ dsx.variable.posterW }}px; height: 3px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px">
                      <stack class="resumeFill" style="width: {{ Math.round(dsx.variable.posterW * item.pct / 100) }}px; height: 3px"/>
                    </stack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="EP.{{ item.idx }} / EP.{{ item.eps }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ══════════════════════════ WIDE · New Release ══════════════════════════════════ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="New Release" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
          <spacer/>
          <hstack class="viewAllRow" href="/browse" a11yGroup="true" a11yLabel="View all new releases">
            <text value="View all" class="viewAll"/>
            <image icon="chevron.forward" iconSize="12" color="#FFFFFF" a11yHidden="true"/>
          </hstack>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.homeView.latest" key="id" axis="horizontal" scroll="false" spacing="18">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/watch/{{ item.id }}/1"
                      on:hoverStart="dsx.variable.hovId = item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}, {{ item.episodes }} episodes">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ posterHover }}"/>
                  <vstack class="badgeWrap" style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; pointer-events: none">
                    <text value="{{ item.hot ? 'HOT' : 'NEW' }}" class="badgeWide" visible-if="item.hot || item.isNew"/>
                  </vstack>
                  <vstack visible-if="dsx.variable.hoverReveal &amp;&amp; dsx.variable.hovId == item.id"
                          style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; border-radius: 16px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.04); transition: transform 0.22s ease; z-index: 2">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <hstack class="hovPlay" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Play {{ item.title }}">
                        <image icon="play.fill" iconSize="11" color="#111111" a11yHidden="true"/>
                        <text value="Play" class="hovPlayLabel"/>
                      </hstack>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ══════════════════════════ WIDE · TOP · ranked numerals ════════════════════════ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="TOP" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
          <spacer/>
          <image icon="flame.fill" iconSize="16" color="{{ hotRed() }}" a11yHidden="true"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="dsx.variable.homeView.trending" key="id" axis="horizontal" scroll="false" spacing="12">
              <vstack class="card" style="width: {{ dsx.variable.posterW + dsx.variable.rankOvl }}px" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Number {{ item.rank }}, {{ item.title }}">
                <zstack>
                  <hstack spacing="0" alignItems="flex-start">
                    <stack style="width: {{ dsx.variable.rankOvl }}px; height: 2px"/>
                    <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ dsx.variable.posterStyle }}"/>
                  </hstack>
                  <vstack style="width: 100%; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; align-items: flex-start; pointer-events: none">
                    <text value="{{ item.rank }}" class="rankNum" color="{{ rankColor }}"
                          style="font-size: {{ dsx.variable.rankSize }}px; line-height: 0.76; font-weight: 900; letter-spacing: -7px; text-shadow: 0 6px 22px rgba(0,0,0,0.85)"/>
                  </vstack>
                  <vstack class="badgeWrap" style="width: 100%; height: {{ dsx.variable.posterH }}px; padding-left: {{ dsx.variable.rankOvl + 10 }}px; pointer-events: none">
                    <text value="{{ topBadge }}" class="badgeWide" visible-if="topBadge != ''"/>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch" style="padding-left: {{ dsx.variable.rankOvl }}px">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ══════════════════════════ WIDE · genre shelves ════════════════════════════════ -->
      <list bind="dsx.variable.homeView.shelves" key="genre" scroll="false" spacing="0"
            visible-if="dsx.variable.phase == 'ready' &amp;&amp; dsx.variable.wide">
        <vstack class="section">
          <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
            <text value="{{ item.genre }}" class="sectionTitle" fontSize="{{ dsx.variable.headSize }}"/>
            <spacer/>
            <hstack class="shelfMore" href="/browse/{{ item.genre }}" a11yGroup="true" a11yTrait="button"
                    a11yLabel="View all {{ item.genre }} series">
              <text value="View all" class="shelfMoreLabel"/>
              <image icon="chevron.forward" iconSize="10" color="rgba(255,255,255,0.5)" a11yHidden="true"/>
            </hstack>
          </hstack>
          <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
            <grid bind="item.items" key="id" columns="{{ dsx.variable.shelfCols }}" spacing="18" scroll="false">
              <vstack class="card" href="/watch/{{ item.id }}/1"
                      on:hoverStart="dsx.variable.hovId = 'g-' + item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true" style="{{ shelfHover }}"/>
                  <vstack visible-if="dsx.variable.hoverReveal &amp;&amp; dsx.variable.hovId == 'g-' + item.id"
                          style="width: 100%; height: 100%; justify-content: flex-end; border-radius: 16px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.03); transition: transform 0.22s ease; z-index: 2">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <hstack class="hovPlay" href="/watch/{{ item.id }}/1" a11yGroup="true" a11yLabel="Play {{ item.title }}">
                        <image icon="play.fill" iconSize="11" color="#111111" a11yHidden="true"/>
                        <text value="Play" class="hovPlayLabel"/>
                      </hstack>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="4" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ metaLine }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </grid>
          </vstack>
        </vstack>
      </list>

      <!-- only when there is nothing to show — a failed refresh over a painted stash is silent -->
      <vstack class="block gridWrap" visible-if="home.error != null &amp;&amp; dsx.variable.homeView == null">
        <vstack class="errCard">
          <text value="The catalogue is unavailable." fontSize="15" color="#FFFFFF"/>
          <button label="Retry" class="retryBtn" on:tap="home.refresh()"/>
        </vstack>
      </vstack>

      <!-- ══════════════════════════ WIDE · footer ═══════════════════════════════════════ -->
      <vstack class="footer" visible-if="dsx.variable.wide" style="border-top: 1px solid rgba(255,255,255,0.12); margin-top: 44px">
        <hstack class="footCols" style="{{ dsx.variable.shell }}">
          <vstack class="footBrand" style="flex: 1">
            <hstack spacing="10" alignItems="center">
              <vstack class="logoBox" style="justify-content: center">
                <image icon="play.fill" iconSize="14" color="#FFFFFF" a11yHidden="true"/>
              </vstack>
              <text value="ShortDrama" class="wordmark"/>
            </hstack>
            <text value="© 2026 Short Drama — the Despia DSX flagship template.
One source. Native on iOS, Android, web and desktop." class="footCopy"/>
          </vstack>
          <vstack class="footCol">
            <text value="BROWSE" class="footHead"/>
            <text value="Home" class="footLink" href="/"/>
            <text value="Explore" class="footLink" href="/discover"/>
            <text value="My List" class="footLink" href="/list"/>
          </vstack>
          <vstack class="footCol">
            <text value="EARN" class="footHead"/>
            <text value="Rewards" class="footLink" href="/rewards"/>
            <text value="Daily check-in" class="footLink" href="/rewards"/>
            <text value="Spin the wheel" class="footLink" href="/rewards"/>
          </vstack>
          <vstack class="footCol">
            <text value="ACCOUNT" class="footHead"/>
            <text value="My Page" class="footLink" href="/profile"/>
            <text value="Manage this app" class="footLink" href="/admin"/>
          </vstack>
        </hstack>
      </vstack>

    </vstack>
  </scroll>

  <!-- the toast: a snackbar row between the scroll and the bar, where one belongs on every
       lane with no positioning to degrade; tap the ✕ to dismiss -->
  <hstack class="toastRow" visible-if="dsx.variable.toast != ''" style="margin: 8px 14px">
    <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
    <image icon="xmark" iconSize="12" color="{{ ink3() }}" on:tap="dsx.variable.toast = ''"
           a11yLabel="Dismiss message" a11yTrait="button"/>
  </hstack>

  <TabBar active="home" visible-if="dsx.variable.wide == false"/>
  <!-- THE SEAM. One mount per screen, at the foot of the root; its sheet portals out of
       the layout, so a zero-height child here cannot disturb any chrome. -->
  <AuthSeam/>
</vstack>
