<!-- Home — the storefront, styled to the category standard the ReelShort-class web apps
     set: a full-bleed cinematic hero with a left-anchored title block and a poster
     thumb-rail selector (wide) or centered title + dash indicators (phone), then the
     rails — Continue Watching · New Release (with pointer hover-cards) · TOP with the
     giant ranked numerals — then genre grids and the storefront footer.

     Hero type lives OUTSIDE the pager, bound to the resting page: a caption that
     restyles itself mid-swipe flickers; binding the resting index keeps the type still
     while the art moves. Hover is a REAL pointer affordance (on:hoverStart/End) — on
     touch it simply never fires, and every card stays a plain link (Article 7). -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="home" url="/catalog/home"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="continue" url="/viewer/continue" ssr="false" needs="session"
         headers="dsx.variable.authHeaders"/>

    <variable as="heroPage">return 0</variable>
    <variable as="hovId">return ''</variable>   <!-- the card under the pointer (desktop hover-info) -->

    <!-- ONE breakpoint vocabulary, derived from the LIVE screen fact (dsx.screen.width
         is reactive — a computed variable re-derives as the window changes). -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 24 }
      return 16
    </variable>
    <variable as="posterW" computed="true">
      if (dsx.variable.bp == 'desktop') { return 196 }
      if (dsx.variable.bp == 'tablet') { return 156 }
      return 148
    </variable>
    <variable as="posterH" computed="true">return Math.round(dsx.variable.posterW * 1.5)</variable>
    <variable as="heroH" computed="true">
      if (dsx.variable.bp == 'desktop') { return Math.round(Math.min(700, dsx.screen.height * 0.74)) }
      if (dsx.variable.bp == 'tablet') { return 460 }
      return Math.round(dsx.screen.height * 0.56)
    </variable>
    <variable as="heroTitleSize" computed="true">
      if (dsx.variable.bp == 'desktop') { return 34 }
      if (dsx.variable.bp == 'tablet') { return 28 }
      return 24
    </variable>
    <variable as="shelfCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <!-- TOP-rail geometry: the ranked numeral overlaps the poster's leading edge -->
    <variable as="rankOvl" computed="true">return Math.round(dsx.variable.posterW * 0.34)</variable>
    <variable as="rankSize" computed="true">return Math.round(dsx.variable.posterH * 0.56)</variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1400px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <variable as="railShell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1400px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px'
    </variable>
    <variable as="posterStyle" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; border-radius: 8px'
    </variable>
    <variable as="posterBox" computed="true">
      return 'width: ' + dsx.variable.posterW + 'px; height: ' + dsx.variable.posterH + 'px; justify-content: flex-end'
    </variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <!-- COMPOUND style lists must be ONE computed value used as the WHOLE style
         attribute: `style="{{ chunk }}; extras"` silently drops the chunk (the parser
         splits on ';' first, and a colon-less fragment is discarded — only the
         whole-attribute spelling gets the declaration-list door). -->
    <variable as="heroInnerBox" computed="true">
      return dsx.variable.shell + '; height: 100%; justify-content: center; align-items: flex-start'
    </variable>
    <variable as="thumbShellBox" computed="true">
      return dsx.variable.shell + '; justify-content: flex-end; padding-bottom: 30px'
    </variable>
    <variable as="heroShow" computed="true">
      if (home.data == null) { return null }
      const p = Number(dsx.variable.heroPage)
      if (p < 0 || p >= home.data.hero.length) { return null }
      return home.data.hero[p]
    </variable>

    <formula as="metaLine" g="item.genre" n="item.episodes">
      return (g == null || g === '' ? 'Drama' : g) + '  |  Series' + (n > 0 ? '  |  EP ' + n : '')
    </formula>
    <formula as="rankColor" r="item.rank">
      if (r == 1) { return '#F6B63D' }
      if (r == 2) { return '#B9C5D8' }
      if (r == 3) { return '#CE8B5C' }
      return '#43434D'
    </formula>
    <formula as="topBadge" r="item.rank" f="item.featured">
      if (r == 1) { return 'Trending' }
      if (f) { return 'Hot' }
      return ''
    </formula>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="30" paddingBottom="16" alignItems="stretch" grow="width"/>

    <style as="phoneBar" paddingV="10" alignItems="center" spacing="9"/>
    <style as="logoBox" background="#FF2D55" radius="8" alignItems="center" width="27" height="27"/>
    <style as="logoGlyph" fontSize="12" fontWeight="heavy" color="#FFFFFF"/>
    <style as="wordmark" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>

    <style as="heroBlock" spacing="13" alignItems="flex-start"/>
    <style as="heroTitle" fontWeight="bold" color="#FFFFFF" lineLimit="2" tracking="-0.5"/>
    <style as="heroPills" spacing="8" alignItems="center"/>
    <style as="pillHot" background="#FF2D55" radius="13" paddingH="11" paddingV="5" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="pillTag" background="rgba(255,255,255,0.14)" radius="13" paddingH="11" paddingV="5" fontSize="12" fontWeight="medium" color="rgba(255,255,255,0.92)"/>
    <style as="heroSyn" fontSize="15" color="rgba(255,255,255,0.72)" lineLimit="2" lineSpacing="4"/>
    <style as="playWhite" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="thumbRow" spacing="10" alignItems="center"/>
    <style as="heroPhoneBlock" spacing="12" alignItems="center" paddingLeading="24" paddingTrailing="24" paddingBottom="22"/>
    <style as="heroPhoneTitle" fontWeight="bold" color="#FFFFFF" lineLimit="2" textAlign="center" tracking="-0.4"/>
    <style as="dashRow" spacing="5" alignItems="center" paddingTop="4"/>

    <style as="section" spacing="14" alignItems="stretch" grow="width"/>
    <style as="sectionHead" alignItems="flex-end"/>
    <style as="sectionTitle" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="viewAll" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="rail" spacing="14" alignItems="flex-start" paddingTrailing="16"/>

    <style as="card" spacing="8" alignItems="stretch"/>
    <style as="cardTitle" fontSize="15" fontWeight="medium" color="rgba(255,255,255,0.95)" lineLimit="1"/>
    <style as="cardMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="badge" background="#FF2D55" radius="4" paddingH="7" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeDark" background="rgba(0,0,0,0.72)" radius="4" paddingH="7" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeWrap" paddingLeading="8" paddingTop="8" alignItems="flex-start" zIndex="1"/>
    <style as="epWrap" paddingLeading="8" paddingBottom="10" alignItems="flex-start" zIndex="1"/>
    <style as="hovPanel" spacing="8" alignItems="flex-start" paddingH="12" paddingBottom="12"/>
    <style as="hovSyn" fontSize="12" color="rgba(255,255,255,0.86)" lineLimit="3" lineSpacing="2"/>
    <style as="hovPlay" background="#FFFFFF" radius="15" paddingH="14" paddingV="7" fontSize="12" fontWeight="bold" color="#111111"/>

    <style as="rankNum" fontWeight="heavy"/>
    <style as="resumeTrack" background="rgba(255,255,255,0.22)" radius="2"/>
    <style as="resumeFill" background="#FF2D55" radius="2"/>

    <style as="footer" alignItems="stretch" spacing="26" paddingTop="34" paddingBottom="30"/>
    <style as="footCols" spacing="60" alignItems="flex-start"/>
    <style as="footBrand" spacing="10" alignItems="flex-start"/>
    <style as="footCopy" fontSize="12" color="rgba(255,255,255,0.45)" lineSpacing="3"/>
    <style as="footCol" spacing="11" alignItems="flex-start"/>
    <style as="footHead" fontSize="15" fontWeight="bold" color="#FFFFFF" tracking="0.3"/>
    <style as="footLink" fontSize="13" color="rgba(255,255,255,0.55)"/>

    <style as="errCard" background="#17171C" radius="14" spacing="9" paddingH="16" paddingV="18" alignItems="center"/>
    <style as="retryBtn" background="#FF2D55" radius="20" paddingH="18" paddingV="10" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <TopNav active="home" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <!-- phone title bar (wide viewports carry <TopNav> instead) -->
      <hstack class="phoneBar" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.wide == false">
        <vstack class="logoBox" style="justify-content: center">
          <text value="▶" class="logoGlyph" a11yHidden="true"/>
        </vstack>
        <text value="ShortDrama" class="wordmark"/>
        <spacer/>
        <image icon="magnifyingglass" iconSize="21" color="#FFFFFF" href="/search" a11yLabel="Search"/>
        <image icon="person.crop.circle" iconSize="23" color="#FFFFFF" href="/profile" a11yLabel="Profile"/>
      </hstack>

      <!-- ============ HERO · wide: full-bleed art, left title block, thumb rail ============ -->
      <vstack visible-if="dsx.variable.wide && heroShow != null" style="width: 100%" alignItems="stretch">
        <zstack>
          <pager bind="home.data.hero" key="id" height="{{ dsx.variable.heroH }}" dots="false" value="dsx.variable.heroPage">
            <image src="{{ item.hero }}" contentFit="cover" a11yLabel="{{ item.title }}"
                   style="width: 100%; height: {{ dsx.variable.heroH }}px"/>
          </pager>
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; pointer-events: none; background: linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 30%, rgba(0,0,0,0) 60%), linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.55) 82%, #000000 100%)">
            <vstack style="{{ dsx.variable.heroInnerBox }}">
              <vstack class="heroBlock" style="max-width: 560px; pointer-events: auto">
                <text value="{{ heroShow == null ? '' : heroShow.title }}" class="heroTitle" fontSize="{{ dsx.variable.heroTitleSize }}"/>
                <hstack class="heroPills">
                  <text value="Hot" class="pillHot" visible-if="heroShow != null && heroShow.featured"/>
                  <text value="{{ heroShow == null ? '' : heroShow.genre }}" class="pillTag"/>
                  <text value="EP 1–{{ heroShow == null ? '' : heroShow.free_until }} Free" class="pillTag"/>
                </hstack>
                <text value="{{ heroShow == null ? '' : heroShow.synopsis }}" class="heroSyn"/>
                <button label="▶   Play" class="playWhite"
                        on:tap="dsx.module.route.push({ path: '/watch/' + (heroShow == null ? '' : heroShow.id) + '/1' })"/>
              </vstack>
            </vstack>
          </vstack>
          <!-- the thumb rail: tapping a poster drives the pager (value= is two-way) -->
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; justify-content: flex-end; pointer-events: none">
            <hstack style="{{ dsx.variable.thumbShellBox }}">
              <hstack class="thumbRow" style="pointer-events: auto">
                <list bind="home.data.hero" key="id" axis="horizontal" scroll="false" spacing="10">
                  <image src="{{ item.poster }}" contentFit="cover" a11yLabel="Feature {{ item.title }}" a11yTrait="button"
                         on:tap="dsx.variable.heroPage = item.rank - 1"
                         style="width: 72px; height: 102px; border-radius: 8px; border: 2px solid {{ item.rank - 1 == Number(dsx.variable.heroPage) ? '#FFFFFF' : 'rgba(255,255,255,0.14)' }}; transition: border-color 0.2s, transform 0.2s; transform: scale({{ item.rank - 1 == Number(dsx.variable.heroPage) ? 1.06 : 1 }})"/>
                </list>
              </hstack>
            </hstack>
          </vstack>
        </zstack>
      </vstack>

      <!-- ============ HERO · phone: centered title over full-bleed art, dash dots ============ -->
      <vstack visible-if="dsx.variable.wide == false && heroShow != null" style="width: 100%; margin-top: -10px" alignItems="stretch">
        <zstack>
          <pager bind="home.data.hero" key="id" height="{{ dsx.variable.heroH }}" dots="false" value="dsx.variable.heroPage">
            <image src="{{ item.hero }}" contentFit="cover" a11yLabel="{{ item.title }}"
                   style="width: 100%; height: {{ dsx.variable.heroH }}px"/>
          </pager>
          <vstack style="width: 100%; height: {{ dsx.variable.heroH }}px; justify-content: flex-end; align-items: center; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 42%, rgba(0,0,0,0.62) 78%, #000000 100%)">
            <vstack class="heroPhoneBlock" style="pointer-events: auto">
              <text value="{{ heroShow == null ? '' : heroShow.title }}" class="heroPhoneTitle" fontSize="{{ dsx.variable.heroTitleSize }}"/>
              <text value="{{ heroShow == null ? '' : heroShow.genre }}" class="pillTag"/>
              <button label="▶   Play" class="playWhite" style="min-width: 210px"
                      on:tap="dsx.module.route.push({ path: '/watch/' + (heroShow == null ? '' : heroShow.id) + '/1' })"/>
              <hstack class="dashRow" a11yHidden="true">
                <list bind="home.data.hero" key="id" axis="horizontal" scroll="false" spacing="5">
                  <stack height="4" radius="2"
                         background="{{ item.rank - 1 == Number(dsx.variable.heroPage) ? '#FFFFFF' : 'rgba(255,255,255,0.35)' }}"
                         width="{{ item.rank - 1 == Number(dsx.variable.heroPage) ? 26 : 13 }}"/>
                </list>
              </hstack>
            </vstack>
          </vstack>
        </zstack>
      </vstack>

      <!-- ============ Continue Watching ============ -->
      <vstack class="section" visible-if="continue.data != null && continue.data.items.length > 0">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="Continue Watching" class="sectionTitle" fontSize="{{ dsx.variable.wide ? 24 : 20 }}"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="continue.data.items" key="episode" axis="horizontal" scroll="false" spacing="14">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/watch/{{ item.show }}/{{ item.idx }}" a11yGroup="true" a11yLabel="Continue {{ item.title }}, episode {{ item.idx }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                         style="{{ dsx.variable.posterStyle }}"/>
                  <vstack class="epWrap" style="{{ dsx.variable.posterBox }}">
                    <text value="EP {{ item.idx }}" class="badgeDark"/>
                  </vstack>
                  <vstack style="{{ dsx.variable.posterBox }}">
                    <stack class="resumeTrack" style="width: {{ dsx.variable.posterW }}px; height: 3px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px">
                      <stack class="resumeFill" style="width: {{ item.pct }}%; height: 3px"/>
                    </stack>
                  </vstack>
                </zstack>
                <vstack spacing="3" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle"/>
                  <text value="EP.{{ item.idx }} / EP.{{ item.eps }}" class="cardMeta"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ New Release · hover reveals the info card on a real pointer ============ -->
      <vstack class="section">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="New Release" class="sectionTitle" fontSize="{{ dsx.variable.wide ? 24 : 20 }}"/>
          <spacer/>
          <text value="View all ›" class="viewAll" href="/search"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="home.data.latest" key="id" axis="horizontal" scroll="false" spacing="14">
              <vstack class="card" style="width: {{ dsx.variable.posterW }}px" href="/show/{{ item.id }}"
                      on:hoverStart="dsx.variable.hovId = item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}, {{ item.episodes }} episodes">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                         style="{{ dsx.variable.posterStyle }}; transition: transform 0.22s ease; transform: scale({{ dsx.variable.hovId == item.id ? 1.04 : 1 }})"/>
                  <vstack class="badgeWrap" style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; pointer-events: none">
                    <text value="New" class="badge" visible-if="item.rank <= 2"/>
                  </vstack>
                  <vstack visible-if="dsx.variable.hovId == item.id"
                          style="width: {{ dsx.variable.posterW }}px; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; border-radius: 8px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.04); transition: transform 0.22s ease">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <text value="▶  Play" class="hovPlay" href="/watch/{{ item.id }}/1" a11yLabel="Play {{ item.title }}"/>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="3" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle"/>
                  <text value="{{ metaLine }}" class="cardMeta"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ TOP · the ranked-numeral rail ============ -->
      <vstack class="section">
        <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
          <text value="TOP" class="sectionTitle" fontSize="{{ dsx.variable.wide ? 24 : 20 }}"/>
          <spacer/>
          <image icon="flame.fill" iconSize="15" color="#FF2D55" a11yHidden="true"/>
        </hstack>
        <scroll axis="horizontal" indicators="false">
          <hstack class="rail" style="{{ dsx.variable.railShell }}">
            <list bind="home.data.trending" key="id" axis="horizontal" scroll="false" spacing="10">
              <vstack class="card" style="width: {{ dsx.variable.posterW + dsx.variable.rankOvl }}px" href="/show/{{ item.id }}" a11yGroup="true" a11yLabel="Number {{ item.rank }}, {{ item.title }}">
                <zstack>
                  <hstack spacing="0" alignItems="flex-start">
                    <stack style="width: {{ dsx.variable.rankOvl }}px; height: 2px"/>
                    <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                           style="{{ dsx.variable.posterStyle }}"/>
                  </hstack>
                  <vstack style="width: 100%; height: {{ dsx.variable.posterH }}px; justify-content: flex-end; align-items: flex-start; pointer-events: none">
                    <text value="{{ item.rank }}" class="rankNum" color="{{ rankColor }}"
                          style="font-size: {{ dsx.variable.rankSize }}px; line-height: 0.78; font-weight: 900; letter-spacing: -6px; text-shadow: 0 6px 22px rgba(0,0,0,0.85)"/>
                  </vstack>
                  <vstack class="badgeWrap" style="width: 100%; height: {{ dsx.variable.posterH }}px; padding-left: {{ dsx.variable.rankOvl + 8 }}px; pointer-events: none">
                    <text value="{{ topBadge }}" class="badge" visible-if="topBadge != ''"/>
                  </vstack>
                </zstack>
                <vstack spacing="3" alignItems="stretch" style="padding-left: {{ dsx.variable.rankOvl }}px">
                  <text value="{{ item.title }}" class="cardTitle"/>
                  <text value="{{ metaLine }}" class="cardMeta"/>
                </vstack>
              </vstack>
            </list>
          </hstack>
        </scroll>
      </vstack>

      <!-- ============ genre shelves · the grid sections ============ -->
      <list bind="home.data.shelves" key="genre" scroll="false" spacing="30">
        <vstack class="section">
          <hstack class="sectionHead" style="{{ dsx.variable.shell }}">
            <text value="{{ item.genre }}" class="sectionTitle" fontSize="{{ dsx.variable.wide ? 24 : 20 }}"/>
          </hstack>
          <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
            <grid bind="item.items" key="id" columns="{{ dsx.variable.shelfCols }}" spacing="14" scroll="false">
              <vstack class="card" href="/show/{{ item.id }}"
                      on:hoverStart="dsx.variable.hovId = 'g-' + item.id" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}">
                <zstack>
                  <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                         style="width: 100%; aspect-ratio: 2/3; border-radius: 8px; object-fit: cover; transition: transform 0.22s ease; transform: scale({{ dsx.variable.hovId == 'g-' + item.id ? 1.03 : 1 }})"/>
                  <vstack visible-if="dsx.variable.hovId == 'g-' + item.id"
                          style="width: 100%; height: 100%; justify-content: flex-end; border-radius: 8px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.88) 100%); transform: scale(1.03); transition: transform 0.22s ease">
                    <vstack class="hovPanel">
                      <text value="{{ item.synopsis }}" class="hovSyn"/>
                      <text value="▶  Play" class="hovPlay" href="/watch/{{ item.id }}/1" a11yLabel="Play {{ item.title }}"/>
                    </vstack>
                  </vstack>
                </zstack>
                <vstack spacing="3" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle"/>
                  <text value="{{ metaLine }}" class="cardMeta"/>
                </vstack>
              </vstack>
            </grid>
          </vstack>
        </vstack>
      </list>

      <vstack style="{{ dsx.variable.shell }}" visible-if="home.error != null">
        <vstack class="errCard">
          <text value="The catalogue is unavailable." fontSize="13" color="#FFFFFF"/>
          <button label="Retry" class="retryBtn" on:tap="home.refresh()"/>
        </vstack>
      </vstack>

      <!-- ============ footer · wide storefront chrome ============ -->
      <vstack class="footer" visible-if="dsx.variable.wide" style="border-top: 1px solid rgba(255,255,255,0.08); margin-top: 26px">
        <hstack class="footCols" style="{{ dsx.variable.shell }}">
          <vstack class="footBrand" style="flex: 1">
            <hstack spacing="9" alignItems="center">
              <vstack class="logoBox" style="justify-content: center">
                <text value="▶" class="logoGlyph" a11yHidden="true"/>
              </vstack>
              <text value="ShortDrama" class="wordmark"/>
            </hstack>
            <text value="© 2026 Short Drama — the Despia DSX flagship template.
One source. Native on iOS, Android, web and desktop." class="footCopy"/>
          </vstack>
          <vstack class="footCol">
            <text value="BROWSE" class="footHead"/>
            <text value="Home" class="footLink" href="/"/>
            <text value="Discover" class="footLink" href="/discover"/>
            <text value="Search" class="footLink" href="/search"/>
          </vstack>
          <vstack class="footCol">
            <text value="EARN" class="footHead"/>
            <text value="Rewards" class="footLink" href="/rewards"/>
            <text value="Daily check-in" class="footLink" href="/rewards"/>
            <text value="Spin the wheel" class="footLink" href="/rewards"/>
          </vstack>
          <vstack class="footCol">
            <text value="ACCOUNT" class="footHead"/>
            <text value="My List" class="footLink" href="/list"/>
