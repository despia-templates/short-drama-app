<!-- Discover — the For-You feed: full-screen vertical swipe over trailers (EP 1 of each
     live show), muted autoplay, one tap to the full episode. The pager carries only the
     VIDEO pages; the caption overlay lives OUTSIDE, bound to the resting page — the same
     shape as the home hero: a caption bound to the resting index stays still while the
     art moves. Only the resting page's video is active, so a fling never plays three
     soundtracks at once. -->
<vstack background="#000000" alignItems="stretch" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="feed" url="/catalog/discover" on:success="global.cacheDiscover = feed.data"/>

    <variable as="page">return 0</variable>
    <variable as="activeShow">return ''</variable>
    <!-- Does the RESTING clip have frames? The transport binding is the one instrument
         that cannot race: `buffering=` is ACTIVE-GUARDED by the renderer ("an inactive
         pager preload must never overwrite the shared active clip's bindings"), so
         exactly one clip writes it and no event ordering is involved. null = no clip has
         spoken yet · true = the resting clip is still buffering · false = frames on
         glass, lift the cover. The fade is 180ms, not the 450ms it started at: with the
         page server-rendered the clip requests at ~75ms and is ready almost immediately,
         so a long dissolve stopped reading as a reveal and started reading as a ghost —
         two images visibly superimposed. (Event-based designs were abandoned unproven:
         the probe used to condemn them was itself sampling the WRONG pager — Home's hero
         track during the route swap — a reminder that a failing measurement needs the
         same scrutiny as a passing one.) -->
    <variable as="buf">return null</variable>
    <variable as="muted">return true</variable>
    <!-- a 9:16 feed stretched across a desktop window is a phone layout in a big frame;
         wide viewports get a centered column at the height's own aspect instead -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read feedView, never feed.data, or the blank frame returns. -->
    <variable as="feedView" computed="true">
      if (feed.data != null) { return feed.data }
      return global.cacheDiscover
    </variable>
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <!-- The stage is ONE interpolated number fed to the catalog's maxWidth, not a CSS
         chunk spliced into style= — a dynamic multi-property style string applies only
         sometimes, which left the caption full-bleed while the video centred. -->
    <variable as="stageMax" computed="true">
      if (dsx.variable.bp == 'phone') { return 4096 }
      return Math.round(Math.min(460, dsx.screen.height * 0.52))
    </variable>
    <!-- The stage leaves room for the chrome above or below it: an 80px TopNav when wide,
         the 70px TabBar on phone (both measured). The bar used to OVERLAY the stage, which
         bought nothing — it paints opaque black, so no video was ever visible behind it —
         and cost this screen a whole class of bug: as a child of the stage's zstack the bar
         inherited the stage's grid column, and while `dsx.screen.*` settles after a tab
         switch that column computed 362, so the bar shrank 375 → 362 → 375 in ~60ms.
         Chrome is a sibling of the stage now, exactly as on every other screen. -->
    <variable as="chromeH" computed="true">return dsx.variable.wide ? 80 : 70</variable>
    <variable as="stageH" computed="true">
      return dsx.screen.height - dsx.variable.chromeH
    </variable>

    <variable as="card" computed="true">
      if (dsx.variable.feedView == null) { return null }
      const p = Number(dsx.variable.page)
      if (p < 0 || p >= dsx.variable.feedView.cards.length) { return null }
      return dsx.variable.feedView.cards[p]
    </variable>


    <formula as="fadeFx" show="item.show">
      const lifted = dsx.variable.activeShow == show && dsx.variable.buf === false
      return 'width: 100%; height: ' + dsx.variable.stageH + 'px; object-fit: cover; z-index: 1; pointer-events: none; opacity: ' + (lifted ? 0 : 1) + '; transition: opacity 0.18s ease'
    </formula>

    <action as="rest">
      const c = dsx.variable.card
      if (c == null) { return }
      dsx.variable.activeShow = c.show
    </action>



    <style as="caption" paddingLeading="16" paddingTrailing="16" paddingBottom="20" spacing="8" alignItems="flex-start"/>
    <style as="capGenre" fontSize="11" fontWeight="semibold" color="#F7C948" tracking="0.8" textCase="uppercase"/>
    <style as="capTitle" fontSize="22" fontWeight="bold" color="#FFFFFF" lineLimit="2" tracking="-0.3"/>
    <style as="capSyn" fontSize="13" color="rgba(255,255,255,0.72)" lineLimit="2" lineSpacing="2"/>
    <style as="capCta" spacing="10" alignItems="center" paddingTop="2"/>
    <style as="watchBtn" background="#FFFFFF" radius="22" paddingH="20" paddingV="11" spacing="8" alignItems="center"/>
    <style as="watchLabel" fontSize="13" fontWeight="bold" color="#111111"/>
    <style as="soundBtn" background="rgba(255,255,255,0.16)" radius="20" paddingH="12" paddingV="11" alignItems="center"/>
    <style as="statusWrap" alignItems="center" paddingV="40" spacing="10"/>
    <style as="retryBtn" background="#FF2C55" radius="22" paddingH="20" paddingV="11" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <TopNav active="discover" visible-if="dsx.variable.wide"/>

  <zstack>
    <!-- WIDTH IS THE VIEWPORT'S, NOT A CAPTURED FACT. `dsx.screen.width` is read once at
         mount, so sizing a full-bleed layer from it pins the feed to whatever the window
         was then — on a desktop pane the video ran 959px while the pager stayed 697px.
         Widths are percentages; only the page HEIGHT needs a real number. -->
    <pager axis="vertical" ignoreSafeArea="true" bind="dsx.variable.feedView.cards" key="show"
           value="dsx.variable.page" dots="false" on:change="dsx.action.rest()"
           height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto">
      <zstack>
        <!-- the art is the FIRST paint: a feed that opens onto a black hole and then pops
             a bright video reads as a glitch; opening onto the key art reads as intent.
             The TALL HERO, never the poster: a 3:4 poster carries its title BAKED at
             card size, and covered into an 812px stage that type renders gigantic and
             collides with the real caption — measured as the "flash" itself. The tall
             hero is type-free and authored for exactly this frame. -->
        <image src="{{ item.hero_tall == null || item.hero_tall == '' ? item.poster : item.hero_tall }}"
               contentFit="cover" a11yHidden="true"
               height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
               style="width: 100%; height: {{ dsx.variable.stageH }}px; object-fit: cover"/>
        <video src="{{ item.video }}" active="{{ item.show == dsx.variable.activeShow }}"
               muted="{{ dsx.variable.muted }}" loop="true" gravity="fill" buffering="dsx.variable.buf"
               height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; z-index: 1"
               on:appear="dsx.action.rest()"/>
        <!-- the fade COVER: same art, above the clip (z ties break by document order, and
             the outer chrome's z2 still wins), lifting only when this page's clip reports
             frames — the last place a cut could hide -->
        <image src="{{ item.hero_tall == null || item.hero_tall == '' ? item.poster : item.hero_tall }}"
               contentFit="cover" a11yHidden="true"
               height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
               style="{{ fadeFx }}"/>
      </zstack>
    </pager>

    <!-- the loading stage is its OWN LAYER (a stage-tall child inside the flex-end caption
         column would fight the spacer): shimmer ground + brand spinner where the video
         will land, so the tab switch opens onto something designed, never a black hole -->
    <vstack visible-if="dsx.variable.feedView == null && feed.error == null"
            height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
            style="width: 100%; margin-left: auto; margin-right: auto; align-items: center; justify-content: center; background: radial-gradient(120% 70% at 50% 30%, #17171C 0%, #0A0A0E 70%)">
      <vstack spacing="14" alignItems="center">
        <spinner color="#FF2C55"/>
        <text value="Loading the feed…" fontSize="13" color="rgba(255,255,255,0.6)"/>
      </vstack>
    </vstack>

    <!-- explicit z ABOVE the clip: the video carries z-index:1 to cover its poster, and a
         positioned child's z competes across the whole outer zstack — without this the
         gradient, caption and tab bar all vanished under the video (measured; the same
         stacking law as AGENTS.md's transformed-sibling rule) -->
    <vstack height="{{ dsx.variable.stageH }}"
            maxWidth="{{ dsx.variable.stageMax }}" style="z-index: 2; width: 100%; margin-left: auto; margin-right: auto; justify-content: flex-end; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 52%, rgba(0,0,0,0.86) 100%)">
      <spacer/>
      <vstack class="caption" visible-if="card != null">
        <text value="{{ card == null ? '' : card.genre }}" class="capGenre"/>
        <text value="{{ card == null ? '' : card.title }}" class="capTitle" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
        <text value="{{ card == null ? '' : card.synopsis }}" class="capSyn" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
        <hstack class="capCta" style="pointer-events: auto">
          <hstack class="watchBtn" a11yGroup="true" a11yTrait="button" a11yLabel="Watch the full episode"
                  on:tap="if (card != null) { dsx.module.route.push({ path: '/watch/' + card.show + '/1' }) }">
            <image icon="play.fill" iconSize="13" color="#111111" a11yHidden="true"/>
            <text value="Watch Full Episode" class="watchLabel"/>
          </hstack>
          <vstack class="soundBtn" style="transition: background-color 0.15s ease"
                  on:tap="dsx.variable.muted = !dsx.variable.muted"
                  a11yLabel="{{ dsx.variable.muted ? 'Unmute' : 'Mute' }}" a11yTrait="button">
            <image icon="{{ dsx.variable.muted ? 'speaker.slash.fill' : 'waveform' }}" iconSize="16" color="#FFFFFF" a11yHidden="true"/>
          </vstack>
        </hstack>
      </vstack>
      <vstack class="statusWrap" style="pointer-events: auto"
              visible-if="dsx.variable.feedView != null && dsx.variable.feedView.cards.length == 0">
        <image icon="play.rectangle.fill" iconSize="34" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
        <text value="Nothing to preview yet" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
        <text value="Trailers appear here as shows go live." fontSize="13" color="rgba(255,255,255,0.55)"/>
        <button label="Browse the catalogue" class="retryBtn" on:tap="dsx.module.route.reset({ path: '/' })"/>
      </vstack>
      <!-- error takes the screen only when there is NOTHING to show: with the stash painted,
           a failed REFRESH must not throw a dead end over good content (the viewer keeps
           watching; the next refresh fixes it silently) -->
      <vstack class="statusWrap" visible-if="feed.error != null && dsx.variable.feedView == null" style="pointer-events: auto">
        <text value="The feed is unavailable." fontSize="13" color="#FFFFFF"/>
        <button label="Retry" class="retryBtn" on:tap="feed.refresh()"/>
      </vstack>
    </vstack>

  </zstack>

  <TabBar active="foryou" visible-if="dsx.variable.wide == false"/>
</vstack>
