<!-- My List — the personal center's library page. Wide viewports get the two-column
     center (sidebar + content grid, the ReelShort-class shape); phones get the stacked
     rails over the tab bar. Empty states ship with the lists — an empty rail with no
     words is a bug report waiting to happen. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="favs" url="/viewer/list" ssr="false" needs="session" headers="dsx.variable.authHeaders" on:success="global.cacheFavs = favs.data"/>
    <api as="continue" url="/viewer/continue" ssr="false" needs="session" headers="dsx.variable.authHeaders" on:success="global.cacheContinue = continue.data"/>

    <variable as="hovId">return ''</variable>

    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read favsView, never favs.data, or the blank frame returns. -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read continueView, never continue.data, or the blank frame returns. -->
    <variable as="continueView" computed="true">
      if (continue.data != null) { return continue.data }
      return global.cacheContinue
    </variable>
    <variable as="favsView" computed="true">
      if (favs.data != null) { return favs.data }
      return global.cacheFavs
    </variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <!-- signed-out is its own state: the personal reads never resolve without a session,
         and an empty-guard on data != null hides the empty copy in exactly that case —
         two headings over void, indistinguishable from a bug -->
    <variable as="signedOut" computed="true">return session.error != null</variable>
    <!-- A FAILED READ IS NOT A SLOW READ. This tested data-nullness only, and neither
         `favs.error` nor `continue.error` was read anywhere in the file — so a failed
         /viewer/list skeletoned FOREVER with no message and no retry. The error lane now
         wins over the loading lane, and (as everywhere else) only claims the screen when
         there is nothing cached to show. -->
    <variable as="listFailed" computed="true">
      if (dsx.variable.signedOut) { return false }
      const broke = favs.error != null || continue.error != null
      return broke && dsx.variable.favsView == null && dsx.variable.continueView == null
    </variable>
    <variable as="listLoading" computed="true">
      if (dsx.variable.signedOut || dsx.variable.listFailed) { return false }
      return dsx.variable.favsView == null || dsx.variable.continueView == null
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="cols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 5 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 86 }
      if (dsx.variable.bp == 'tablet') { return 40 }
      return 16
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <!-- a rail track is `max-content` with the gutter as its padding: `width: 100%` (the
         page-shell recipe) caps the track at the scroller and the cards eat the difference. -->
    <variable as="railShell" computed="true">
      const g = dsx.variable.gutter
      const over = dsx.screen.width - 1440
      const lead = g + (over > 0 ? Math.round(over / 2) : 0)
      return 'width: max-content; padding-left: ' + lead + 'px; padding-right: ' + lead + 'px'
    </variable>

    <formula as="histFx" ep="item.episode">
      const on = dsx.variable.hovId == ('h-' + ep)
      return 'width: 132px; height: 198px; border-radius: 8px; object-fit: cover; transition: transform 0.22s ease; transform: scale(' + (on ? 1.04 : 1) + ')'
    </formula>
    <formula as="favFx" id="item.show">
      const on = dsx.variable.hovId == ('f-' + id)
      return 'width: 100%; aspect-ratio: 3/4; border-radius: 8px; object-fit: cover; transition: transform 0.22s ease; transform: scale(' + (on ? 1.03 : 1) + ')'
    </formula>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="22" paddingTop="20" paddingBottom="24" alignItems="stretch"/>
    <style as="split" spacing="26" alignItems="flex-start"/>
    <style as="content" spacing="20" alignItems="stretch"/>

    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="crumbRow" spacing="7" alignItems="center"/>

    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="section" spacing="12" alignItems="stretch"/>
    <style as="sectionTitle" fontSize="17" fontWeight="bold" color="#FFFFFF" tracking="-0.2"/>
    <style as="empty" fontSize="13" color="rgba(255,255,255,0.45)"/>

    <style as="rail" spacing="12" alignItems="flex-start"/>
    <style as="card" spacing="7" alignItems="stretch"/>
    <style as="cardTitle" fontSize="15" fontWeight="medium" color="rgba(255,255,255,0.95)" lineLimit="1"/>
    <style as="cardMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="badgeDark" background="rgba(0,0,0,0.72)" radius="4" paddingH="7" paddingV="3" fontSize="11" fontWeight="semibold" color="#FFFFFF"/>
    <style as="badgeWrap" paddingLeading="7" paddingBottom="9" alignItems="flex-start"/>
    <style as="resumeTrack" background="rgba(255,255,255,0.22)"/>
    <style as="resumeFill" background="#FF2C55"/>
    <style as="signCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="24" alignItems="center"/>
    <style as="signBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <TopNav active="list" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page" style="{{ dsx.variable.shell }}">

      <hstack class="crumbRow" visible-if="dsx.variable.wide">
        <text value="Personal Center" class="crumb" a11yTrait="button"
              on:tap="dsx.module.route.reset({ path: '/profile' })"/>
        <text value="/" class="crumb"/>
        <text value="My list" class="crumbOn"/>
      </hstack>

      <hstack class="split">
        <PersonalNav active="list" visible-if="dsx.variable.wide"/>

        <vstack class="content" style="flex: 1; min-width: 0">
          <text value="My List" class="h1" visible-if="dsx.variable.wide == false"/>

          <vstack class="signCard" visible-if="dsx.variable.signedOut">
            <image icon="person.crop.circle" iconSize="34" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            <text value="Your list lives on your account" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
            <text value="Sign in and everything you save or start watching lands here." class="empty" textAlign="center"/>
            <button label="Reload" class="signBtn" on:tap="session.refresh()"/>
          </vstack>

          <vstack spacing="20" alignItems="stretch" visible-if="dsx.variable.listLoading">
            <Skeleton height="20" radius="6"/>
            <Skeleton height="198" radius="8"/>
            <Skeleton height="20" radius="6"/>
            <Skeleton height="160" radius="8"/>
          </vstack>

          <vstack class="signCard" visible-if="dsx.variable.listFailed">
            <text value="Your list is unavailable." class="sectionTitle"/>
            <text value="Check your connection and try again." class="empty"/>
            <button label="Retry" class="signBtn" on:tap="favs.refresh(); continue.refresh()"/>
          </vstack>

          <!-- history / continue watching -->
          <vstack class="section" visible-if="dsx.variable.signedOut == false && dsx.variable.listLoading == false && dsx.variable.listFailed == false">
            <text value="History" class="sectionTitle"/>
            <text class="empty" visible-if="dsx.variable.continueView != null && dsx.variable.continueView.items.length == 0"
                  value="Nothing in progress yet — start a show from Home."/>
            <scroll axis="horizontal" indicators="false">
              <hstack class="rail" style="{{ dsx.variable.railShell }}">
                <list bind="dsx.variable.continueView.items" key="episode" axis="horizontal" scroll="false" spacing="12">
                  <vstack class="card" style="width: 132px" href="/watch/{{ item.show }}/{{ item.idx }}"
                          on:hoverStart="dsx.variable.hovId = 'h-' + item.episode" on:hoverEnd="dsx.variable.hovId = ''"
                          a11yGroup="true" a11yLabel="Continue {{ item.title }}, episode {{ item.idx }}">
                    <zstack>
                      <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                             style="{{ histFx }}"/>
                      <!-- top-left: the key art keeps that corner clear and carries its own
                           title at the foot of the poster -->
                      <vstack class="badgeWrap" style="width: 132px; height: 198px; pointer-events: none">
                        <text value="EP {{ item.idx }}" class="badgeDark"/>
                      </vstack>
                      <vstack style="width: 132px; height: 198px; justify-content: flex-end">
                        <stack class="resumeTrack" style="width: 132px; height: 3px; border-radius: 0 0 8px 8px">
                          <stack class="resumeFill" style="width: {{ Math.round(132 * item.pct / 100) }}px; height: 3px"/>
                        </stack>
                      </vstack>
                    </zstack>
                    <vstack spacing="2" alignItems="stretch">
                      <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                      <text value="EP.{{ item.idx }} / EP.{{ item.eps }}" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                    </vstack>
                  </vstack>
                </list>
              </hstack>
            </scroll>
          </vstack>

          <!-- favorites -->
          <vstack class="section" visible-if="dsx.variable.signedOut == false && dsx.variable.listLoading == false && dsx.variable.listFailed == false">
            <text value="My list" class="sectionTitle"/>
            <text class="empty" visible-if="dsx.variable.favsView != null && dsx.variable.favsView.items.length == 0"
                  value="Tap My List on any show to keep it here."/>
            <grid bind="dsx.variable.favsView.items" key="show" columns="{{ dsx.variable.cols }}" spacing="14" scroll="false">
              <vstack class="card" href="/show/{{ item.show }}"
                      on:hoverStart="dsx.variable.hovId = 'f-' + item.show" on:hoverEnd="dsx.variable.hovId = ''"
                      a11yGroup="true" a11yLabel="{{ item.title }}">
                <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                       style="{{ favFx }}"/>
                <vstack spacing="2" alignItems="stretch">
                  <text value="{{ item.title }}" class="cardTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ item.genre }}  |  Series" class="cardMeta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                </vstack>
              </vstack>
            </grid>
          </vstack>
        </vstack>
      </hstack>
    </vstack>
  </scroll>
  <TabBar active="list" visible-if="dsx.variable.wide == false"/>
</vstack>
