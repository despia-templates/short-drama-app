<!-- Notices — the viewer's inbox for operator announcements (the notice entity: written
     only through the Manage surface, broadcast to everyone, public-read). A pushed
     utility screen: back bar, the list, and honest states. No read receipts — a
     per-viewer receipt is a write per notice per viewer, and this inbox does not earn
     that; the operator's reach is the point, not tracking. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <expects variable="nav"/>
    <api as="inbox" url="/social/notices" on:success="global.cacheInbox = inbox.data"/>

    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read inboxView, never inbox.data, or the blank frame returns. -->
    <variable as="inboxView" computed="true">
      if (inbox.data != null) { return inbox.data }
      return global.cacheInbox
    </variable>
    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="gutter" computed="true">return gutterOf(dsx.variable.bp)</variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 760)</variable>
    <variable as="phase" computed="true">
      if (inbox.error != null) { return 'error' }
      if (dsx.variable.inboxView == null) { return 'loading' }
      if (dsx.variable.inboxView.rows.length == 0) { return 'empty' }
      return 'content'
    </variable>

    <formula as="rowIcon" kind="item.kind">
      return kind == 'banner' ? 'star.fill' : 'bell.fill'
    </formula>
    <formula as="rowDate" at="item.at">
      if (at == null) { return '' }
      return shortDate(at)
    </formula>

    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/profile' }) }
    </action>

    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <!-- NO paddingTop on `page`: it would push <TopNav>, the global bar, off y=0 (see the
         same note in Store.dsx). The 12px moves onto the content below the bar. -->
    <style as="page" spacing="16" paddingBottom="32" alignItems="stretch"/>
    <style as="head" alignItems="center" spacing="12"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>

    <style as="card" background="#141419" radius="12" paddingH="16" paddingV="4" spacing="0" alignItems="stretch"/>
    <style as="row" spacing="12" alignItems="flex-start" paddingV="14"/>
    <style as="rowBadge" background="rgba(255,44,85,0.14)" radius="18" width="36" height="36" alignItems="center"/>
    <style as="rowTitle" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="rowBody" fontSize="13" color="rgba(255,255,255,0.6)" lineSpacing="3"/>
    <style as="rowMeta" fontSize="11" color="rgba(255,255,255,0.4)"/>

    <style as="stateCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="24" alignItems="center"/>
    <style as="stateTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="stateBody" fontSize="13" color="rgba(255,255,255,0.45)" textAlign="center" lineSpacing="3"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <!-- the design vocabulary (breakpoints, gutters, shells, palette) registers here.
       FIRST CHILD, always: the block registers on instantiate, and this screen reads its
       own `wide` computed on the very next line. See Components/parts/Theme.dsx. -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx). The mount is what fires app_open,
       once per session however many screens mount it. -->
  <Analytics/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">
      <TopNav active="" visible-if="dsx.variable.wide"/>

      <vstack style="{{ dsx.variable.shell }}" spacing="16" alignItems="stretch" paddingTop="12">
        <hstack class="head">
          <image icon="chevron.backward" iconSize="20" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button"/>
          <text value="Notifications" class="h1"/>
          <spacer/>
        </hstack>

        <vstack spacing="12" alignItems="stretch" visible-if="dsx.variable.phase == 'loading'">
          <Skeleton height="64" radius="12"/>
          <Skeleton height="64" radius="12"/>
          <Skeleton height="64" radius="12"/>
        </vstack>

        <vstack class="stateCard" visible-if="dsx.variable.phase == 'empty'">
          <image icon="bell.fill" iconSize="30" color="rgba(255,255,255,0.3)" a11yHidden="true"/>
          <text value="Nothing yet" class="stateTitle"/>
          <text value="Announcements about new series and events land here." class="stateBody"/>
        </vstack>

        <vstack class="stateCard" visible-if="dsx.variable.phase == 'error'">
          <text value="Notifications could not be loaded." class="stateTitle"/>
          <button label="Retry" class="retryBtn" on:tap="inbox.refresh()"/>
        </vstack>

        <vstack class="card" visible-if="dsx.variable.phase == 'content'">
          <list bind="dsx.variable.inboxView.rows" key="id" scroll="false" spacing="0">
            <hstack class="row" style="border-bottom: 1px solid rgba(255,255,255,0.05)">
              <vstack class="rowBadge" style="justify-content: center">
                <image icon="{{ rowIcon }}" iconSize="15" color="{{ brand() }}" a11yHidden="true"/>
              </vstack>
              <vstack spacing="4" alignItems="stretch" style="flex: 1; min-width: 0">
                <text value="{{ item.title }}" class="rowTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                <text value="{{ item.message }}" class="rowBody" visible-if="item.message != ''"/>
                <text value="{{ rowDate }}" class="rowMeta"/>
              </vstack>
            </hstack>
          </list>
        </vstack>
      </vstack>
    </vstack>
  </scroll>
  <!-- NO TAB BAR: /notices is a PUSHED route, and on the phone lane a push TRANSFORMS the
       whole frame — global chrome inside it would slide in with the page, which is exactly
       what a global bar must never do. A pushed screen is therefore full-bleed with a back
       affordance (UIKit calls this hidesBottomBarWhenPushed; every reference short-drama app
       agrees). The tab roots keep their bar and swap instantly, so it never moves there
       either. Wide viewports crossfade instead of pushing, so <TopNav> — painted identically
       by both frames over an opaque under-frame — composites STILL (PLAN.md §6.26). -->
</vstack>
