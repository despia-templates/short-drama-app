<!-- Profile — the personal center. Wide viewports get the two-column center (sidebar +
     balance strip + Transaction History); phones get the reference stack: identity ·
     ONE gold VIP surface · wallet card · grouped menu · ledger.

     FUNNEL ROLE: this screen is where the viewer checks what they own and is offered the
     one upgrade that ends coin math forever. Exactly one gold surface (the VIP card) —
     gold everywhere is gold nowhere. Buying is /store, earning is /rewards, and both are
     one tap from here because the wallet is the reason people open this screen.

     Honest numbers: a wallet that has not answered renders an em dash, never a zero — a
     '0' on a screen about money is a claim, and while loading it is a false one. Signed
     out, the screen says so and offers the reload; it never renders headings over void. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <!-- THE SEAM, NOT A SESSION BLOCK. <AuthSeam> (mounted at the foot of this file) owns
         the token; every authenticated read here is gated on `global.auth.ok` and carries
         `global.auth.headers`. `auto=` is re-evaluated whenever its read set changes, so
         these fire the moment a sign-in lands and stop the moment a sign-out drops it —
         no needs= edge, no per-screen authHeaders copy, no session block. docs/auth.md. -->
    <api as="wallet" url="/wallet/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWallet = global.auth.ok == true ? wallet.data : null"/>
    <api as="ledger" url="/wallet/ledger" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheLedger = global.auth.ok == true ? ledger.data : null"/>

    <variable as="toast">return ''</variable>

    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read walletView, never wallet.data, or the blank frame returns. -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read ledgerView, never ledger.data, or the blank frame returns. -->
    <!-- SIGNED OUT IS A PERSON, NOT A 404. This used to read `session.error != null` — the
         app defined its own logged-out state as a static JSON file failing to load, which is
         why the card below offered "Reload session". Now it is the seam's own answer, with
         `authKnown` separating "no account" from "we have not asked yet" so no screen flashes
         a sign-in card for the frame before the seam resolves. -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <variable as="authKnown" computed="true">return global.auth != null &amp;&amp; global.auth.state != null</variable>
    <variable as="signedOut" computed="true">
      return dsx.variable.authKnown &amp;&amp; dsx.variable.signedIn == false
    </variable>
    <!-- THE VIEWER-SCOPED STASHES ARE VIEWER-SCOPED. `global.cache*` outlives the mount so a
         tab revisit paints stale-then-fresh (PLAN.md §6.30) — which means a signed-out frame
         would otherwise read the previous viewer's balance straight out of it. The seam nulls
         these five on sign-out; this guard is the second half, so the answer is right on the
         frame the token drops rather than one action later (docs/auth.md). -->
    <variable as="ledgerView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (ledger.data != null) { return ledger.data }
      return global.cacheLedger
    </variable>
    <variable as="walletView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (wallet.data != null) { return wallet.data }
      return global.cacheWallet
    </variable>
    <variable as="uid" computed="true">
      if (dsx.variable.signedIn == false) { return '' }
      const s = global.auth.sub
      return s == null ? '' : String(s).slice(0, 8)
    </variable>
    <!-- `wallet.error` was read nowhere: a failed /wallet/state left an em dash beside
         "Coins" forever, which reads as "you have none" rather than "we could not ask".
         The em dash stays the WAITING answer (PersonalNav's rule — never a fake 0); a
         FAILURE now says so and offers the retry. -->
    <variable as="walletFailed" computed="true">
      return dsx.variable.signedOut == false && wallet.error != null && dsx.variable.walletView == null
    </variable>
    <variable as="coins" computed="true">
      return dsx.variable.walletView == null ? null : dsx.variable.walletView.coins
    </variable>
    <variable as="bonus" computed="true">
      return dsx.variable.walletView == null ? null : dsx.variable.walletView.bonus
    </variable>
    <variable as="isVip" computed="true">
      if (dsx.variable.walletView == null) { return false }
      return dsx.variable.walletView.vip === true
    </variable>
    <variable as="vipUntil" computed="true">
      if (dsx.variable.walletView == null || dsx.variable.walletView.vipUntil == null) { return '' }
      return shortDate(dsx.variable.walletView.vipUntil)
    </variable>
    <variable as="vipLine" computed="true">
      if (dsx.variable.isVip == false) { return 'Every episode, no coin math, no ads.' }
      if (dsx.variable.vipUntil == '') { return 'Every episode unlocked.' }
      return 'Every episode unlocked until ' + dsx.variable.vipUntil + '.'
    </variable>
    <variable as="ledgerPhase" computed="true">
      if (dsx.variable.signedOut) { return 'signedout' }
      if (ledger.error != null) { return 'error' }
      if (dsx.variable.ledgerView == null) { return 'loading' }
      if (dsx.variable.ledgerView.rows.length == 0) { return 'empty' }
      return 'content'
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <!-- THE LANGUAGE PICKER'S ROWS, from the one list that also gates the build
         (Theme.dsx `languageRows()`). Computed rather than plain because the first row's
         label follows the active locale, so it re-derives with every switch. -->
    <variable as="langRows" computed="true">return languageRows()</variable>
    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="gutter" computed="true">return gutterOf(dsx.variable.bp)</variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 1440)</variable>

    <formula as="rowSign" amt="item.amount">
      if (amt > 0) { return '+' + amt }
      return '' + amt
    </formula>
    <formula as="rowLabel" src="item.source">
      if (src == 'checkin') { return 'Daily check-in' }
      if (src == 'spin') { return 'Spin the wheel' }
      if (src == 'task') { return 'Task reward' }
      if (src == 'ad') { return 'Rewarded ad' }
      if (src == 'unlock') { return 'Episode unlocked' }
      if (src == 'pack') { return 'Coin pack' }
      if (src == 'vip') { return 'VIP bonus' }
      return src
    </formula>

    <action as="planBought">
      wallet.refresh()
      ledger.refresh()
    </action>
    <action as="planFailed" message="message">
      dsx.variable.toast = message
    </action>
    <!-- THE PICKER ALREADY WROTE `global.locale` through its own bind seam by the time
         this fires; the job left is to REMEMBER it. The device row carries the empty tag
         and DELETES the cookie rather than storing an empty one, because "no choice" and
         "chose nothing" have to read the same on the next launch — a stored empty string
         would pin the ladder to a decision the viewer never made. -->
    <action as="localePicked" tag="value">
      if (tag == null) { return }
      if (tag == '') {
        dsx.cookie.uiLocale = null
        return
      }
      // { value, days } is the durable spelling (dev@e213cbac, §6.100 resolved): the jar
      // is the one plane every lane and the server share, and 365 days is a preference,
      // not a session. A bare string would still be a session cookie on every lane.
      dsx.cookie.uiLocale = { value: tag, days: 365 }
    </action>

    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="22" paddingTop="20" paddingBottom="24" alignItems="stretch"/>
    <style as="split" spacing="26" alignItems="flex-start"/>
    <style as="content" spacing="14" alignItems="stretch"/>

    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="crumbRow" spacing="7" alignItems="center"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>

    <style as="card" background="#141419" radius="12" paddingH="16" paddingV="16" spacing="14" alignItems="stretch"/>
    <style as="cardTight" background="#141419" radius="12" paddingH="16" paddingV="12" spacing="4" alignItems="stretch"/>
    <style as="cardFlush" background="#141419" radius="12" paddingH="16" paddingV="4" spacing="0" alignItems="stretch"/>

    <style as="stripRow" alignItems="center" spacing="16"/>
    <style as="stripCap" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="stripNum" fontSize="15" fontWeight="bold" color="#FFFFFF"/>

    <style as="idRow" alignItems="center" spacing="12"/>
    <style as="avatar" background="#232329" radius="22" width="44" height="44" alignItems="center"/>
    <style as="who" spacing="4"/>
    <style as="whoName" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="whoNote" fontSize="11" color="rgba(255,255,255,0.42)" lineSpacing="2"/>
    <style as="vipChip" background="#F6B63D" radius="10" paddingH="8" paddingV="4" fontSize="11" fontWeight="bold" color="#2A1D04"/>

    <!-- the one gold surface -->
    <style as="vipCard" radius="14" paddingH="16" paddingV="16" spacing="4" alignItems="flex-start"/>
    <style as="vipTitle" fontSize="16" fontWeight="bold" color="#2A1D04"/>
    <style as="vipSub" fontSize="12" color="rgba(42,29,4,0.75)"/>
    <style as="vipGo" background="#2A1D04" radius="18" paddingH="16" paddingV="8" fontSize="13" fontWeight="semibold" color="#F7E3AE"/>

    <style as="stats" spacing="12" alignItems="stretch"/>
    <style as="stat" background="#1E1E24" radius="10" paddingV="12" spacing="4" alignItems="center"/>
    <style as="statNum" fontSize="22" fontWeight="bold"/>
    <style as="statCap" fontSize="11" color="rgba(255,255,255,0.5)"/>
    <style as="topupBtn" background="#FF2C55" radius="21" paddingV="12" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="earnBtn" background="rgba(255,255,255,0.1)" radius="21" paddingV="12" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="note" fontSize="11" color="rgba(255,255,255,0.4)" lineSpacing="2"/>

    <style as="h2" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="ledgerRow" alignItems="center" paddingV="12"/>
    <style as="ledgerCol" spacing="2" alignItems="stretch"/>
    <style as="ledgerTitle" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="ledgerMeta" fontSize="11" color="rgba(255,255,255,0.42)"/>
    <style as="amount" fontSize="13" fontWeight="semibold"/>
    <style as="empty" fontSize="13" color="rgba(255,255,255,0.45)"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>

    <style as="toastRow" background="rgba(246,182,61,0.12)" radius="10" paddingH="12" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="13" fontWeight="medium" color="#F6B63D" lineSpacing="3"/>
    <style as="menuRow" alignItems="center" paddingV="12" spacing="11"/>
    <style as="menuLabel" fontSize="13" color="#FFFFFF"/>
    <style as="menuNote" fontSize="12" color="rgba(255,255,255,0.42)"/>
    <style as="menuValue" fontSize="12" color="rgba(255,255,255,0.42)"/>
  </head>

  <!-- the design vocabulary (breakpoints, gutters, shells, palette) registers here.
       FIRST CHILD, always: the block registers on instantiate, and this screen reads its
       own `wide` computed on the very next line. See Components/parts/Theme.dsx. -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx). The mount is what fires app_open,
       once per session however many screens mount it. -->
  <Analytics/>
  <TopNav active="profile" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page" style="{{ dsx.variable.shell }}">

      <hstack class="crumbRow" visible-if="dsx.variable.wide">
        <text value="Personal Center" class="crumb"/>
        <text value="/" class="crumb"/>
        <text value="Wallet" class="crumbOn"/>
      </hstack>

      <hstack class="split">
        <PersonalNav active="wallet" visible-if="dsx.variable.wide"
                     uid="{{ dsx.variable.uid }}" coins="{{ dsx.variable.coins }}"
                     bonus="{{ dsx.variable.bonus }}" vip="{{ dsx.variable.isVip }}"/>

        <vstack class="content" style="flex: 1; min-width: 0">
          <text value="Profile" class="h1" visible-if="dsx.variable.wide == false"/>


          <!-- signed out: one shared card, and its button now signs you IN. It used to say
               "Reload session" and re-fetch a missing file, because the state it announced
               was that file 404ing rather than a person without an account. -->
          <SignInCard visible-if="dsx.variable.signedOut"
                      title="You are browsing as a guest"
                      note="Coins, VIP, your list and your history live on an account, so they follow you to another device. The catalogue is open either way."/>

          <!-- phone identity (the sidebar carries this on wide) -->
          <vstack class="card" visible-if="dsx.variable.wide == false && dsx.variable.signedOut == false && dsx.variable.walletFailed == false">
            <hstack class="idRow">
              <vstack class="avatar" style="justify-content: center">
                <image icon="person.crop.circle" iconSize="22" color="rgba(255,255,255,0.62)" a11yHidden="true"/>
              </vstack>
              <vstack class="who" style="flex: 1; min-width: 0">
                <text value="Viewer" class="whoName"/>
                <text value="{{ dsx.variable.uid == '' ? 'Local session' : 'UID ' + dsx.variable.uid }}" class="whoNote"/>
              </vstack>
              <text value="VIP" class="vipChip" visible-if="dsx.variable.isVip"/>
            </hstack>
          </vstack>

          <!-- THE gold surface. It raises the PLANS SHEET, not a route: a price list is an
               interruption, and the viewer should land back on their wallet the moment
               they decide either way. <PlansSheet> owns the tiers, the checkout and the
               settle-recovery; this card is just its trigger (passed as children). -->
          <!-- A GUEST SEES THE OFFER TOO. It used to be hidden when signed out, which was
               right when there was no way to sign in — hiding the funnel beat sending a
               viewer at a checkout that would 401. Now <PlansSheet> raises the sign-in sheet
               on a guest tap, which is also the shape App Store 3.1.2 asks for: a
               subscription surface lets a current subscriber sign in or restore. -->
          <PlansSheet vip="{{ dsx.variable.isVip }}" vipUntil="{{ dsx.variable.vipUntil }}"
                      on:purchased="dsx.action.planBought()" on:failed="dsx.action.planFailed()">
            <vstack class="vipCard"
                    a11yLabel="{{ dsx.variable.isVip ? 'Your VIP membership' : 'Go VIP' }}"
                    style="background: linear-gradient(150deg, #F7E3AE 0%, #E8C77A 55%, #DDB35E 100%)">
              <hstack spacing="10" alignItems="center" style="width: 100%">
                <image icon="crown.fill" iconSize="20" color="#2A1D04" a11yHidden="true"/>
                <vstack spacing="2" style="flex: 1; min-width: 0">
                  <text value="{{ dsx.variable.isVip ? 'VIP is active' : 'Go VIP' }}" class="vipTitle"/>
                  <text value="{{ dsx.variable.vipLine }}" class="vipSub"/>
                </vstack>
                <!-- "Add days" rather than "Manage", for two reasons that happen to agree.
                     (1) It is TRUE: nothing renews and there is nothing to cancel, so the
                     only thing this chip can do for a viewer who already has VIP is buy
                     more days onto the pass they hold — which is exactly what
                     `vipTermLine()` tells them three lines further down. "Manage" promised
                     a settings screen that does not exist. (2) `Manage` is also the Manage
                     surface's own h1, and one literal is one key: translating the chip
                     would have retitled an operator screen this README calls deliberately
                     English, in twelve languages, from a Profile edit. -->
                <text value="{{ dsx.variable.isVip ? 'Add days' : 'See plans' }}" class="vipGo"/>
              </hstack>
            </vstack>
          </PlansSheet>

          <vstack class="card" visible-if="dsx.variable.walletFailed">
            <text value="Your wallet is unavailable." class="vipTitle"/>
            <text value="Balances and VIP status could not be read. Nothing has been spent." class="note"/>
            <button label="Retry" class="retryBtn" on:tap="wallet.refresh()"/>
          </vstack>

          <!-- wallet: phone card (wide gets the strip below) -->
          <vstack class="card" visible-if="dsx.variable.wide == false && dsx.variable.signedOut == false">
            <hstack class="stats">
              <vstack class="stat" style="flex: 1">
                <text value="{{ dsx.variable.coins == null ? '—' : dsx.variable.coins }}" class="statNum" color="{{ coin() }}"/>
                <text value="Coins" class="statCap"/>
              </vstack>
              <vstack class="stat" style="flex: 1">
                <text value="{{ dsx.variable.bonus == null ? '—' : dsx.variable.bonus }}" class="statNum" color="#FFFFFF"/>
                <!-- was "Bonus · 7-day". Purchased currency may not expire (App Store
                     3.1.1), and the server stopped expiring anything this pass — so the
                     label was promising a rule the app does not apply. -->
                <text value="Bonus" class="statCap"/>
              </vstack>
            </hstack>
            <hstack spacing="10" alignItems="stretch">
              <button label="Get Coins" class="topupBtn" style="flex: 1; white-space: nowrap"
                      on:tap="dsx.module.route.push({ path: '/store' })" a11yLabel="Get coins — open the store"/>
              <button label="Earn free" class="earnBtn" style="flex: 1; white-space: nowrap"
                      on:tap="dsx.module.route.reset({ path: '/rewards' })" a11yLabel="Earn free coins in Rewards"/>
            </hstack>
          </vstack>

          <!-- balance strip (wide) -->
          <vstack class="cardTight" visible-if="dsx.variable.wide && dsx.variable.signedOut == false">
            <hstack class="stripRow">
              <hstack spacing="7" alignItems="center">
                <text value="Coins:" class="stripCap"/>
                <image icon="dollarsign.circle.fill" iconSize="15" color="{{ coin() }}" a11yHidden="true"/>
                <text value="{{ dsx.variable.coins == null ? '—' : dsx.variable.coins }}" class="stripNum"/>
              </hstack>
              <text value="|" class="stripCap"/>
              <hstack spacing="7" alignItems="center">
                <text value="Bonus:" class="stripCap"/>
                <image icon="dollarsign.circle.fill" iconSize="15" color="{{ coin() }}" a11yHidden="true"/>
                <text value="{{ dsx.variable.bonus == null ? '—' : dsx.variable.bonus }}" class="stripNum"/>
              </hstack>
              <spacer/>
              <!-- The 7-day expiry claim is gone: it was never implemented, and for coins
                   bought with money it is not permitted — App Store 3.1.1, verbatim, "Any
                   credits or in-game currencies purchased via in-app purchase may not
                   expire." Earned coins now keep the same promise as bought ones. -->
              <text value="Coins never expire — bought or earned" class="note"/>
            </hstack>
          </vstack>

          <!-- ledger, with all five states -->
          <vstack class="cardTight" visible-if="dsx.variable.signedOut == false">
            <text value="Transaction History" class="h2" paddingV="8"/>
            <vstack spacing="10" alignItems="stretch" visible-if="dsx.variable.ledgerPhase == 'loading'" paddingV="8">
              <Skeleton height="18" radius="6"/>
              <Skeleton height="18" radius="6"/>
              <Skeleton height="18" radius="6"/>
            </vstack>
            <text class="empty" visible-if="dsx.variable.ledgerPhase == 'empty'" paddingV="8"
                  value="No activity yet — your first check-in, unlock or purchase lands here."/>
            <vstack spacing="10" alignItems="flex-start" visible-if="dsx.variable.ledgerPhase == 'error'" paddingV="8">
              <text class="empty" value="The ledger could not be loaded."/>
              <button label="Retry" class="retryBtn" on:tap="ledger.refresh()"/>
            </vstack>
            <list bind="dsx.variable.ledgerView.rows" key="id" scroll="false" spacing="0" visible-if="dsx.variable.ledgerPhase == 'content'">
              <hstack class="ledgerRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)">
                <vstack class="ledgerCol" style="flex: 1; min-width: 0">
                  <text value="{{ rowLabel }}" class="ledgerTitle" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <!-- THE LAST EXPIRY PROMISE IN THE APP, AND IT WAS THE LIVE ONE. This read
                       `…{{ item.expires == null ? '' : ' · expires in 7 days' }}` — a second
                       hole appended to the first — so every ledger row whose payload carried
                       an `expires` key rendered "Bonus coins · expires in 7 days". App Store
                       3.1.1, verbatim: "Any credits or in-game currencies purchased via in-app
                       purchase may not expire", and `bonus` is NOT a purely-granted bucket (a
                       coin pack's "+5% free" is credited there by settleOrder), so the line
                       was promising an expiry on money someone paid for.
                       Nothing on the server expires any more — the field is off the entity,
                       off all three grants, and `ledgerRows` names the payload's fields so a
                       legacy column in an already-deployed database cannot reach the screen
                       (migration.sql is additive and never drops). This clause was therefore
                       already unreachable, and deleting it rather than leaving it is the
                       point: an unreachable promise is one payload change from being a live
                       one, and no gate would have caught it.
                       AND IT WAS UNTRANSLATABLE. Two holes is a CONCATENATION, so neither
                       branch was ever a rendered form the seam could look up (scripts/
                       strings.mjs ternaryLiterals names this very line as its worked
                       example). One hole over two bare literals IS translatable, so "Coins"
                       and "Bonus coins" now hit the table in all thirteen locales. -->
                  <text value="{{ item.kind == 'bonus' ? 'Bonus coins' : 'Coins' }}" class="ledgerMeta"/>
                </vstack>
                <text value="{{ rowSign }}" class="amount" color="{{ item.amount > 0 ? coin() : brand() }}"/>
              </hstack>
            </list>
          </vstack>

          <!-- lanes note + settings -->
          <vstack class="cardTight" visible-if="dsx.variable.signedOut == false">
            <text value="Purchases ride Stripe on the web and the RevenueCat store lane in the iOS and Android apps — one wallet either way. Identity rides your provider in production; this build mints a local session (Account, below)." class="note" paddingV="8"/>
          </vstack>
          <!-- THE MENU IS NOT GATED ON A SESSION. It used to be, so a guest saw a screen with
               one card on it and no way anywhere — including no way to the Account page,
               where signing in lives. Every row here works without an account; the ones that
               need one say so when you arrive. -->
          <vstack class="cardFlush">
            <!-- RESET, not href. /list is a TAB ROOT: it mounts the tab bar, and `href` pushes,
                 so this row slid a second copy of My List over Profile with its own bar riding
                 in on the transform — the founder's rule ("a push is only for pages with no
                 menu bar that go back via a back button"), and PLAN.md 6.29's reasoning from
                 the product side. Nothing is lost by dropping the anchor here: a row inside a
                 grouped card is not a link a crawler or a cmd-click wants, unlike the desktop
                 footer, and the a11y contract is already carried by a11yGroup + a11yLabel.
                 The chevron stays, because the destination IS forward from here. -->
            <hstack class="menuRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)"
                    on:tap="dsx.module.route.reset({ path: '/list' })"
                    a11yTrait="button" a11yGroup="true" a11yLabel="My list and history">
              <image icon="bookmark.fill" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
              <text value="My List &amp; History" class="menuLabel" style="flex: 1"/>
              <image icon="chevron.forward" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            </hstack>
            <hstack class="menuRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)" href="/notices"
                    a11yGroup="true" a11yLabel="Notifications">
              <image icon="bell.fill" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
              <text value="Notifications" class="menuLabel" style="flex: 1"/>
              <image icon="chevron.forward" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            </hstack>
            <hstack class="menuRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)"
                    on:tap="dsx.module.route.reset({ path: '/rewards' })" a11yGroup="true" a11yTrait="button" a11yLabel="Rewards">
              <image icon="gift.fill" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
              <text value="Rewards" class="menuLabel" style="flex: 1"/>
              <image icon="chevron.forward" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            </hstack>
            <!-- ══ LANGUAGE, AND WHAT THE ROW IS ALLOWED TO PROMISE ═════════════════
                 Two different things hide behind that one word, and only one of them is
                 reachable — so the row does one and names the other.

                 · UI LANGUAGE is real now. DSX localisation is gettext-shaped: the app is
                   written in English, the ENGLISH SOURCE STRING IS THE KEY, and the kernel
                   resolves it at the display points (a text value, a button label, a field
                   placeholder). A locale is a flat `Strings.<tag>.json` at the app root that
                   the build folds into the registry. So this template did not have to
                   convert a single literal — it had to ship a table. `Strings.es.json`
                   carries all 208 viewer strings (node scripts/strings.mjs reports the
                   coverage, and the Manage surface stays English on purpose). Switching is
                   ONE STATE WRITE: `global.locale`, and every live display string
                   re-resolves, static markup included.

                 · CONTENT LANGUAGE — the dubbed audio and the subtitle track — is still
                   unreachable: `<video>` can select neither a rendition nor a track
                   (PLAN.md §6.36), so a picker for it would change nothing about what plays.
                   The note says so rather than implying this row covers it.

                 THE ROW ONLY OFFERS A LOCALE THE BUILD ACTUALLY CARRIES, which is the whole
                 reason the earlier version refused to render a picker at all: "a dropdown
                 that switches to Spanish and returns a half-Spanish app is the same defect
                 as the priced quality ladder Phase 1 deleted." That objection is answered by
                 coverage, not by argument — `npm run verify` fails the build if any viewer
                 string is missing from a shipped table, so a half-locale cannot reach a
                 release. Add a language by adding the file and its row in Theme.dsx
                 `languageRows()`; verify refuses a row whose table the build did not fold.

                 WHY A `<picker>` AND NOT THIRTEEN CHIPS. Two languages fit in a chip row;
                 thirteen do not, and a hand-built list of stacks would be a menu that is
                 not a menu — no keyboard model, no VoiceOver rotor, no platform sheet. The
                 framework ships the real control, so this is one: `<picker>` is a genuine
                 `<select>` on web and the system menu on iOS and Android. Its rows are DATA
                 (Theme.dsx `languageRows()`), which is also why the endonyms never enter the
                 string corpus — nothing here needs translating, and nothing here can be
                 translated (§6.98).

                 THE FIRST ROW IS THE DEVICE, and it is the app's real default. The kernel
                 ladder is `global.locale` → device language → en, so an app that has never
                 been switched is already following the device; writing a language at boot to
                 make the control look decided would DESTROY that step. Picking the device row
                 clears the choice and hands the ladder back. -->
            <vstack class="menuRow" spacing="9" alignItems="stretch"
                    style="border-bottom: 1px solid rgba(255,255,255,0.05)">
              <hstack spacing="11" alignItems="center">
                <image icon="globe" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
                <vstack spacing="2" style="flex: 1" grow="width" alignItems="stretch">
                  <text value="Language" class="menuLabel"/>
                  <text value="The app's own words. Audio and subtitle tracks are a separate control the renderer cannot offer yet." class="menuNote"/>
                </vstack>
              </hstack>
              <!-- CAPPED, because a menu is not a paragraph. The card runs to 910px on a
                   1440 desktop and a `<select>` stretched across all of it reads as a text
                   field; 320 is the phone width the control was designed at, and the phone
                   lane (326 available) is unaffected. Attribute AND CSS: the attribute is
                   the cross-platform twin, the declaration is what the web sheet reads. -->
              <picker bind="global.locale" optionsKey="dsx.variable.langRows"
                      maxWidth="320" style="max-width: 320px"
                      a11yLabel="App language" on:change="dsx.action.localePicked()"/>
            </vstack>
            <hstack class="menuRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)" href="/admin"
                    a11yGroup="true" a11yLabel="Manage this app — operator surface">
              <image icon="gearshape" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
              <text value="Manage this app" class="menuLabel" style="flex: 1"/>
              <text value="operator" class="menuValue" color="{{ coin() }}"/>
              <image icon="chevron.forward" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            </hstack>
            <!-- ACCOUNT IS THE LAST ROW, and it is the one a store reviewer looks for: sign
                 in, sign out, restore purchases, terms, privacy, and DELETE ACCOUNT — two
                 taps from the tab bar (App Store 5.1.1(v) wants deletion findable in-app,
                 never behind a support ticket). The value column says which side of the
                 session you are on, so the row answers before it is tapped. -->
            <hstack class="menuRow" href="/account" a11yGroup="true"
                    a11yLabel="Account — sign in or out, restore purchases, terms, privacy, and delete your account">
              <image icon="person.crop.circle" iconSize="15" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
              <vstack spacing="2" style="flex: 1" alignItems="stretch">
                <text value="Account" class="menuLabel"/>
                <text value="Sign in or out · restore purchases · terms &amp; privacy · delete account" class="menuNote"/>
              </vstack>
              <text value="{{ dsx.variable.signedIn ? 'signed in' : 'guest' }}" class="menuValue"/>
              <image icon="chevron.forward" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
            </hstack>
          </vstack>
        </vstack>
      </hstack>
    </vstack>
  </scroll>

  <!-- THE TOAST LIVES OUTSIDE THE SCROLL. It used to sit inline near the top of the page, so
       a viewer who had scrolled down to the pack they wanted and pressed Buy got their answer
       rendered off-screen above them — measured on /store at 1440, where the refusal
       "Payments are not configured on this deployment" landed 200px out of view. A status
       message has to reach the person who caused it.
       As a SIBLING of the scroll it pins to the bottom of the screen on every renderer with
       no positioning at all: web and native both lay it out after the scroll and before the
       tab bar, which is where a snackbar belongs anyway. No `position: absolute`, so nothing
       to degrade. -->
  <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
    <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
    <image icon="xmark" iconSize="12" color="{{ gold() }}" on:tap="dsx.variable.toast = ''"
           a11yLabel="Dismiss message" a11yTrait="button"/>
  </hstack>
  <TabBar active="profile" visible-if="dsx.variable.wide == false"/>
  <!-- THE SEAM. One mount per screen, at the foot of the root where a zero-height child
       cannot disturb the chrome; its sheet portals out of the layout anyway. -->
  <AuthSeam/>
</vstack>
