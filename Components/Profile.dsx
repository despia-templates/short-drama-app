<!-- Profile — wallet, VIP state, the ledger, and the seams that are honest about their
     lane: auth is the local dev session (a provider in production), purchases and push
     ride the native apps. The operator's door to Manage lives at the bottom.
 -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="ledger" url="/wallet/ledger" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>

    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 24 }
      return 16
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: ' + 720 + 'px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>

    <formula as="rowSign" amt="item.amount">
      if (amt > 0) { return '+' + amt }
      return '' + amt
    </formula>
    <formula as="rowLabel" src="item.source">
      if (src == 'checkin') { return 'Daily check-in' }
      if (src == 'spin') { return 'Spin the wheel' }
      if (src == 'task') { return 'Task reward' }
      if (src == 'unlock') { return 'Episode unlocked' }
      if (src == 'pack') { return 'Coin pack' }
      return src
    </formula>

    <style as="screen" background="#08070C" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="14" paddingTop="4" paddingBottom="20" alignItems="stretch"/>

    <style as="head" alignItems="center" paddingBottom="2"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>

    <style as="card" background="#15141C" radius="16" paddingH="16" paddingV="16" spacing="14" alignItems="stretch"/>
    <style as="cardTight" background="#15141C" radius="16" paddingH="16" paddingV="14" spacing="4" alignItems="stretch"/>
    <style as="cardFlush" background="#15141C" radius="16" paddingH="16" paddingV="2" spacing="0" alignItems="stretch"/>
    <style as="idRow" alignItems="center" spacing="12"/>
    <style as="avatar" background="#221F2B" radius="21" alignItems="center" paddingV="10" paddingH="10"/>
    <style as="who" spacing="2"/>
    <style as="whoName" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="whoNote" fontSize="11" color="rgba(255,255,255,0.42)" lineSpacing="1"/>
    <style as="tier" fontSize="11" fontWeight="bold" radius="9" paddingH="9" paddingV="4"/>

    <style as="stats" spacing="10" alignItems="stretch"/>
    <style as="stat" background="#1B1926" radius="12" paddingV="12" spacing="3" alignItems="center"/>
    <style as="statNum" fontSize="22" fontWeight="bold"/>
    <style as="statCap" fontSize="11" color="rgba(255,255,255,0.5)"/>
    <style as="note" fontSize="11" color="rgba(255,255,255,0.4)" lineSpacing="2"/>

    <style as="h2" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="ledgerRow" alignItems="center" paddingV="11"/>
    <style as="ledgerCol" spacing="2"/>
    <style as="ledgerTitle" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="ledgerMeta" fontSize="11" color="rgba(255,255,255,0.42)"/>
    <style as="amount" fontSize="13" fontWeight="semibold"/>
    <style as="empty" fontSize="13" color="rgba(255,255,255,0.45)"/>

    <style as="settingRow" alignItems="center" paddingV="13"/>
    <style as="settingLabel" fontSize="13" color="#FFFFFF"/>
    <style as="settingValue" fontSize="12" color="rgba(255,255,255,0.42)"/>
  </head>

  <TopNav active="profile" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page" style="{{ dsx.variable.shell }}">
      <hstack class="head">
        <text value="Profile" class="h1"/>
      </hstack>

      <!-- identity + wallet -->
      <vstack class="card">
        <hstack class="idRow">
          <vstack class="avatar">
            <image icon="person.crop.circle" iconSize="22" color="rgba(255,255,255,0.62)" a11yHidden="true"/>
          </vstack>
          <vstack class="who" style="flex: 1">
            <text value="Guest viewer" class="whoName"/>
            <text value="Local dev session — production signs in through your identity provider" class="whoNote"/>
          </vstack>
          <text value="{{ wallet.data != null && wallet.data.vip ? 'VIP' : 'FREE' }}" class="tier"
                color="{{ wallet.data != null && wallet.data.vip ? '#08070C' : 'rgba(255,255,255,0.75)' }}"
                background="{{ wallet.data != null && wallet.data.vip ? '#F7C948' : '#221F2B' }}"/>
        </hstack>

        <hstack class="stats">
          <vstack class="stat" style="flex: 1">
            <text value="{{ wallet.data == null ? '—' : wallet.data.coins }}" class="statNum" color="#F7C948"/>
            <text value="Coins" class="statCap"/>
          </vstack>
          <vstack class="stat" style="flex: 1">
            <text value="{{ wallet.data == null ? '—' : wallet.data.bonus }}" class="statNum" color="#FFFFFF"/>
            <text value="Bonus · 7-day" class="statCap"/>
          </vstack>
          <vstack class="stat" style="flex: 1" href="/rewards" a11yLabel="Open Rewards to earn coins">
            <image icon="gift.fill" iconSize="19" color="#FF2D55" a11yHidden="true"/>
            <text value="Earn more" class="statCap"/>
          </vstack>
        </hstack>

        <text value="Coin packs and VIP are purchased in the iOS and Android apps through RevenueCat; web checkout is on the template roadmap." class="note"/>
      </vstack>

      <!-- ledger -->
      <vstack class="cardTight">
        <text value="Recent activity" class="h2"/>
        <text class="empty" visible-if="ledger.data != null && ledger.data.rows.length == 0" value="No activity yet."/>
        <list bind="ledger.data.rows" key="id" scroll="false" spacing="0">
          <hstack class="ledgerRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)">
            <vstack class="ledgerCol" style="flex: 1">
              <text value="{{ rowLabel }}" class="ledgerTitle"/>
              <text value="{{ item.kind == 'bonus' ? 'Bonus coins' : 'Coins' }}{{ item.expires == null ? '' : ' · expires in 7 days' }}" class="ledgerMeta"/>
            </vstack>
            <text value="{{ rowSign }}" class="amount" color="{{ item.amount > 0 ? '#F7C948' : '#FF2D55' }}"/>
          </hstack>
        </list>
      </vstack>

      <!-- settings -->
      <vstack class="cardFlush">
        <hstack class="settingRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)">
          <text value="Notifications" class="settingLabel" style="flex: 1"/>
          <text value="native apps" class="settingValue"/>
        </hstack>
        <hstack class="settingRow" style="border-bottom: 1px solid rgba(255,255,255,0.05)">
          <text value="Content language" class="settingLabel" style="flex: 1"/>
          <text value="English" class="settingValue"/>
        </hstack>
        <hstack class="settingRow" href="/admin" a11yLabel="Manage this app — operator surface">
          <text value="Manage this app" class="settingLabel" style="flex: 1"/>
          <text value="operator" class="settingValue" color="#F7C948"/>
          <image icon="chevron.right" iconSize="12" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
        </hstack>
      </vstack>
    </vstack>
  </scroll>
  <TabBar active="profile" visible-if="dsx.variable.wide == false"/>
</vstack>
