<!-- Rewards — the two lanes a short-drama app actually monetises on, in the category's
     own order: SELL first (VIP subscription tiers, then coin packs), EARN second (daily
     check-in streak, the wheel, capped rewarded ads, tasks).

     Every number is a SERVER fact — the tiers, the pack table, the streak curve, the ad
     cap and reward all arrive in /rewards/state, so an operator changes price without a
     build and the client can never invent an entitlement. Buttons only ASK.

     Purchases ride the native store lane (RevenueCat); on web the buy buttons name that
     honestly rather than pretending. Rewarded ads are AdMob on native, server-verified
     before a coin is granted — the web lane says so and offers the other earn paths. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="state" url="/rewards/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="checkinCall" url="/rewards/checkin" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="spinCall" url="/rewards/spin" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="claimCall" url="/rewards/task" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="adCall" url="/rewards/ad" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="toast">return ''</variable>
    <variable as="tier">return 'monthly'</variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>

    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 86 }
      if (dsx.variable.bp == 'tablet') { return 40 }
      return 16
    </variable>
    <variable as="vipCols" computed="true">return dsx.variable.bp == 'phone' ? 1 : 3</variable>
    <variable as="packCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 4 }
      if (dsx.variable.bp == 'tablet') { return 3 }
      return 2
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1100px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <variable as="balance" computed="true">
      if (wallet.data == null) { return 0 }
      return wallet.data.coins + wallet.data.bonus
    </variable>
    <variable as="adLabel" computed="true">
      if (state.data == null) { return 'Watch an ad' }
      if (state.data.adsLeft <= 0) { return 'Daily ad limit reached' }
      return 'Watch an ad  ·  +' + state.data.adReward
    </variable>

    <formula as="dayState" i="item.i">
      if (state.data == null) { return 'future' }
      const pos = state.data.streak % 7
      const donePos = state.data.checkedToday ? (pos == 0 ? 7 : pos) : pos
      if (i < donePos) { return 'done' }
      if (i == donePos && !state.data.checkedToday) { return 'next' }
      return 'future'
    </formula>
    <formula as="dayColor" st="dayState">
      if (st == 'done') { return 'rgba(255,44,85,0.22)' }
      if (st == 'next') { return '#FF2C55' }
      return '#1E1E24'
    </formula>
    <formula as="checkinLabel">
      if (state.data == null) { return 'Check in' }
      if (state.data.checkedToday) { return 'Checked in — come back tomorrow' }
      return 'Check in  ·  +' + state.data.nextReward
    </formula>

    <action as="checkin">
      const r = await checkinCall.send({})
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins — day ' + r.data.streak; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Check-in failed' }
    </action>
    <action as="spin">
      const r = await spinCall.send({})
      if (r.ok) { dsx.variable.toast = 'The wheel lands on ' + r.data.prize + ' bonus coins'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'No spin left' }
    </action>
    <action as="claim" task="item.id">
      const r = await claimCall.send({ task: task })
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Not yet' }
    </action>
    <action as="watchAd">
      const r = await adCall.send({})
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins · ' + r.data.left + ' left today'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'No ad available' }
    </action>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="0" paddingTop="18" paddingBottom="30" alignItems="stretch"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="34"/>

    <style as="head" alignItems="center" paddingBottom="2"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="balancePill" background="rgba(255,255,255,0.08)" radius="16" paddingH="12" paddingV="7" spacing="6" alignItems="center"/>
    <style as="balanceNum" fontSize="14" fontWeight="semibold" color="#F6B63D"/>
    <style as="toastLine" fontSize="13" fontWeight="medium" color="#F6B63D" lineSpacing="3"/>
    <style as="sectionTitle" fontSize="24" fontWeight="bold" color="rgba(255,255,255,0.8)" tracking="-0.3"/>
    <style as="sellCard" background="#141419" radius="14" paddingH="18" paddingV="18" spacing="12" alignItems="center"/>
    <style as="sellTitle" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="sellNote" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="sectionNote" fontSize="13" color="rgba(255,255,255,0.45)"/>

    <!-- VIP -->

    <!-- coin packs -->

    <!-- earn -->
    <style as="card" background="#141419" radius="14" paddingH="16" paddingV="16" spacing="13" alignItems="stretch"/>
    <style as="cardHead" alignItems="center"/>
    <style as="h2" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="streakRow" spacing="5" alignItems="center"/>
    <style as="streakPill" fontSize="12" fontWeight="semibold" color="#F6B63D"/>
    <style as="dayCell" spacing="3" alignItems="center" paddingV="9" radius="9"/>
    <style as="dayAmt" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="dayNum" fontSize="11" color="rgba(255,255,255,0.5)"/>
    <style as="cta" radius="24" paddingV="14" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="ctaWide" radius="24" paddingV="14" paddingH="24" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="wheelWrap" alignItems="center" spacing="12"/>
    <style as="wheelLabel" fontSize="15" fontWeight="bold" color="#FFFFFF" background="rgba(0,0,0,0.8)" paddingH="11" paddingV="6" radius="14"/>
    <style as="taskRow" alignItems="center" spacing="12"/>
    <style as="taskCol" spacing="2"/>
    <style as="taskTitle" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="taskMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="claimBtn" radius="18" paddingH="18" paddingV="11" fontSize="13" fontWeight="semibold"/>
    <style as="note" fontSize="12" color="rgba(255,255,255,0.42)" lineSpacing="3"/>
  </head>

  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">
      <TopNav active="rewards" visible-if="dsx.variable.wide"/>

      <vstack style="{{ dsx.variable.shell }}" alignItems="stretch" paddingTop="14">
        <hstack class="head">
          <text value="Rewards" class="h1"/>
          <spacer/>
          <hstack class="balancePill" visible-if="wallet.data != null">
            <image icon="dollarsign.circle.fill" iconSize="15" color="#F6B63D" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }}" class="balanceNum"/>
          </hstack>
        </hstack>
        <text value="{{ dsx.variable.toast }}" class="toastLine" visible-if="dsx.variable.toast != ''" paddingTop="10"/>
      </vstack>

      <!-- the SELL lane lives on /store; this screen is EARN only -->
      <vstack class="section">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <hstack class="sellCard" on:tap="dsx.module.route.push({ path: '/store' })"
                  a11yGroup="true" a11yTrait="button" a11yLabel="Open the store to buy coins or VIP">
            <vstack spacing="4" style="flex: 1; min-width: 0">
              <text value="Get coins or go VIP" class="sellTitle"/>
              <text value="Buy a coin pack, or unlock every series with VIP." class="sellNote"/>
            </vstack>
            <image icon="chevron.right" iconSize="14" color="rgba(255,255,255,0.45)" a11yHidden="true"/>
          </hstack>
        </vstack>
      </vstack>

      <!-- ═══ LANE 3 — earn it free ═══ -->
      <vstack class="section">
        <vstack style="{{ dsx.variable.shell }}" spacing="4" alignItems="flex-start">
          <text value="Earn free coins" class="sectionTitle"/>
          <text value="Check in daily, spin the wheel, watch a short ad, finish tasks." class="sectionNote"/>
        </vstack>

        <vstack style="{{ dsx.variable.shell }}" spacing="14" alignItems="stretch">
          <!-- daily check-in -->
          <vstack class="card">
            <hstack class="cardHead">
              <text value="Daily check-in" class="h2"/>
              <spacer/>
              <hstack class="streakRow" a11yGroup="true" a11yLabel="{{ state.data == null ? 0 : state.data.streak }} day streak">
                <image icon="flame.fill" iconSize="14" color="#F6B63D" a11yHidden="true"/>
                <text value="{{ state.data == null ? 0 : state.data.streak }} day streak" class="streakPill"/>
              </hstack>
            </hstack>
            <grid bind="state.data.days" key="id" columns="7" spacing="5" scroll="false">
              <vstack class="dayCell" background="{{ dayColor }}">
                <image icon="checkmark" iconSize="12" color="#FFFFFF" visible-if="dayState == 'done'" a11yHidden="true"/>
                <text value="+{{ item.reward }}" class="dayAmt" visible-if="dayState != 'done'"/>
                <text value="D{{ item.i + 1 }}" class="dayNum"/>
              </vstack>
            </grid>
            <button label="{{ checkinLabel }}" class="cta"
                    background="{{ state.data != null && state.data.checkedToday ? '#26262C' : '#FF2C55' }}"
                    on:tap="dsx.action.checkin()"/>
          </vstack>

          <!-- rewarded ads: the capped lane -->
          <vstack class="card">
            <hstack class="cardHead">
              <text value="Watch ads, earn coins" class="h2"/>
              <spacer/>
              <text value="{{ state.data == null ? 0 : state.data.adsToday }}/{{ state.data == null ? 10 : state.data.adCap }} today" class="taskMeta"/>
            </hstack>
            <button label="{{ dsx.variable.adLabel }}" class="cta"
                    background="{{ state.data != null && state.data.adsLeft > 0 ? '#FF2C55' : '#26262C' }}"
                    on:tap="dsx.action.watchAd()"/>
            <text value="Rewarded ads play in the iOS and Android apps (AdMob), and the server verifies the view before granting a coin. On the web this button grants the same reward through the test lane so the cap and ledger stay honest." class="note"/>
          </vstack>

          <!-- spin -->
          <vstack class="card">
            <vstack class="wheelWrap">
              <text value="Spin the wheel" class="h2"/>
              <zstack>
                <stack style="width: 132px; height: 132px; border-radius: 66px; background: conic-gradient(#FF2C55 0deg 45deg, #1E1E24 45deg 90deg, #F6B63D 90deg 135deg, #1E1E24 135deg 180deg, #FF2C55 180deg 225deg, #1E1E24 225deg 270deg, #F6B63D 270deg 315deg, #1E1E24 315deg 360deg)"/>
                <vstack style="width: 132px; height: 132px; align-items: center; justify-content: center">
                  <text value="10–100" class="wheelLabel"/>
                </vstack>
              </zstack>
              <button label="{{ state.data != null && state.data.freeSpinLeft ? 'Spin — 1 free today' : 'No spin left today' }}"
                      class="ctaWide"
                      background="{{ state.data != null && state.data.freeSpinLeft ? '#FF2C55' : '#26262C' }}"
                      on:tap="dsx.action.spin()"/>
            </vstack>
          </vstack>

          <!-- tasks -->
          <vstack class="card">
            <text value="Tasks" class="h2"/>
            <list bind="state.data.tasks" key="id" scroll="false" spacing="14">
              <hstack class="taskRow">
                <vstack class="taskCol" style="flex: 1">
                  <text value="{{ item.title }}" class="taskTitle"/>
                  <text value="{{ item.progress }}/{{ item.target }} · +{{ item.reward }} bonus" class="taskMeta"/>
                </vstack>
                <button label="{{ item.claimed ? 'Claimed' : 'Claim' }}" class="claimBtn"
                        color="{{ item.claimed ? 'rgba(255,255,255,0.4)' : '#FFFFFF' }}"
                        background="{{ item.claimed ? '#26262C' : '#FF2C55' }}"
                        on:tap="dsx.action.claim()"/>
              </hstack>
            </list>
          </vstack>
        </vstack>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="vip" visible-if="dsx.variable.wide == false"/>
</vstack>
