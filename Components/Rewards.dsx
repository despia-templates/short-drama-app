<!-- Rewards — the earn loop: check-in streak, one free spin, daily tasks. Every number on
     this screen is a SERVER fact (the curve, the prize table, the caps all arrive in
     /rewards/state); the buttons only ask. The rewarded-ads slot is present and honestly
     disabled on web — AdMob rewarded is a native-lane capability (spec §5 degradation).
     -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="state" url="/rewards/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="checkinCall" url="/rewards/checkin" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="spinCall" url="/rewards/spin" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="claimCall" url="/rewards/task" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="toast">return ''</variable>
    <variable as="spinning">return false</variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 24 }
      return 16
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: ' + 720 + 'px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>

    <formula as="dayState" i="item.i">
      if (state.data == null) { return 'future' }
      const pos = state.data.streak % 7
      const donePos = state.data.checkedToday ? (pos == 0 ? 7 : pos) : pos
      if (i < donePos) { return 'done' }
      if (i == donePos && !state.data.checkedToday) { return 'next' }
      return 'future'
    </formula>
    <formula as="dayColor" st="dayState">
      if (st == 'done') { return 'rgba(255,45,85,0.22)' }
      if (st == 'next') { return '#FF2D55' }
      return '#1B1926'
    </formula>
    <formula as="checkinLabel">
      if (state.data == null) { return 'Check in' }
      if (state.data.checkedToday) { return 'Checked in — come back tomorrow' }
      return 'Check in  ·  +' + state.data.nextReward
    </formula>

    <action as="checkin">
      const r = await checkinCall.send({})
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins — day ' + r.data.streak; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.error == null ? 'Check-in failed' : r.error.message }
    </action>
    <action as="spin">
      dsx.variable.spinning = true
      const r = await spinCall.send({})
      dsx.variable.spinning = false
      if (r.ok) { dsx.variable.toast = 'The wheel lands on ' + r.data.prize + ' bonus coins!'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.error == null ? 'No spin left' : r.error.message }
    </action>
    <action as="claim" task="item.id">
      const r = await claimCall.send({ task: task })
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.error == null ? 'Not yet' : r.error.message }
    </action>

    <style as="screen" background="#08070C" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="14" paddingTop="4" paddingBottom="20" alignItems="stretch"/>

    <style as="head" alignItems="center" paddingBottom="2"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="balancePill" background="rgba(255,255,255,0.08)" radius="15" paddingH="11" paddingV="6" spacing="6" alignItems="center"/>
    <style as="balanceNum" fontSize="13" fontWeight="semibold" color="#F7C948"/>
    <style as="balanceSub" fontSize="12" color="rgba(255,255,255,0.55)"/>
    <style as="toastLine" fontSize="13" fontWeight="medium" color="#F7C948"/>

    <style as="card" background="#15141C" radius="16" paddingH="16" paddingV="16" spacing="13" alignItems="stretch"/>
    <style as="cardTight" background="#15141C" radius="16" paddingH="16" paddingV="16" spacing="7" alignItems="stretch"/>
    <style as="cardHead" alignItems="center"/>
    <style as="h2" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="streakPill" fontSize="12" fontWeight="semibold" color="#F7C948"/>

    <style as="dayCell" spacing="3" alignItems="center" paddingV="9" radius="9"/>
    <style as="dayAmt" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="dayNum" fontSize="11" color="rgba(255,255,255,0.5)"/>

    <style as="cta" radius="22" paddingV="12" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="ctaWide" radius="22" paddingV="12" paddingH="22" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="wheelWrap" alignItems="center" spacing="12"/>
    <style as="wheelLabel" fontSize="15" fontWeight="bold" color="#FFFFFF" background="rgba(8,7,12,0.8)" paddingH="11" paddingV="6" radius="14"/>

    <style as="taskRow" alignItems="center" spacing="12"/>
    <style as="taskCol" spacing="2"/>
    <style as="taskTitle" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="taskMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="claimBtn" radius="15" paddingH="15" paddingV="7" fontSize="13" fontWeight="semibold"/>
    <style as="note" fontSize="12" color="rgba(255,255,255,0.46)" lineSpacing="2"/>
  </head>

  <TopNav active="rewards" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page" style="{{ dsx.variable.shell }}">

      <hstack class="head">
        <text value="Rewards" class="h1"/>
        <spacer/>
        <hstack class="balancePill" visible-if="wallet.data != null">
          <image icon="bitcoinsign.circle.fill" iconSize="14" color="#F7C948" a11yHidden="true"/>
          <text value="{{ wallet.data == null ? 0 : wallet.data.coins + wallet.data.bonus }}" class="balanceNum"/>
          <text value="coins" class="balanceSub"/>
        </hstack>
      </hstack>

      <text value="{{ dsx.variable.toast }}" class="toastLine" visible-if="dsx.variable.toast != ''"/>

      <!-- check-in streak -->
      <vstack class="card">
        <hstack class="cardHead">
          <text value="Daily check-in" class="h2"/>
          <spacer/>
          <text value="🔥 {{ state.data == null ? 0 : state.data.streak }} day streak" class="streakPill"/>
        </hstack>
        <grid bind="state.data.days" key="id" columns="7" spacing="5" scroll="false">
          <vstack class="dayCell" background="{{ dayColor }}">
            <text value="{{ dayState == 'done' ? '✓' : '+' + item.reward }}" class="dayAmt"/>
            <text value="D{{ item.i + 1 }}" class="dayNum"/>
          </vstack>
        </grid>
        <button label="{{ checkinLabel }}" class="cta"
                background="{{ state.data != null && state.data.checkedToday ? '#221F2B' : '#FF2D55' }}"
                on:tap="dsx.action.checkin()"/>
      </vstack>

      <!-- spin the wheel -->
      <vstack class="card">
        <vstack class="wheelWrap">
          <text value="Spin the wheel" class="h2"/>
          <zstack>
            <stack style="width: 132px; height: 132px; border-radius: 66px; background: conic-gradient(#FF2D55 0deg 45deg, #1B1926 45deg 90deg, #F7C948 90deg 135deg, #1B1926 135deg 180deg, #FF2D55 180deg 225deg, #1B1926 225deg 270deg, #F7C948 270deg 315deg, #1B1926 315deg 360deg)"/>
            <vstack style="width: 132px; height: 132px; align-items: center; justify-content: center">
              <text value="10–100" class="wheelLabel"/>
            </vstack>
          </zstack>
          <button label="{{ state.data != null && state.data.freeSpinLeft ? 'Spin — 1 free today' : 'No spin left today' }}"
                  class="ctaWide"
                  background="{{ state.data != null && state.data.freeSpinLeft ? '#FF2D55' : '#221F2B' }}"
                  on:tap="dsx.action.spin()"/>
        </vstack>
      </vstack>

      <!-- tasks -->
      <vstack class="card">
        <text value="Tasks" class="h2"/>
        <list bind="state.data.tasks" key="id" scroll="false" spacing="14">
          <hstack class="taskRow">
            <vstack class="taskCol" style="flex: 1">
              <text value="{{ item.title }}" class="taskTitle"/>
              <text value="{{ item.progress }}/{{ item.target }} · +{{ item.reward }} bonus" class="taskMeta"/>
            </vstack>
            <button label="{{ item.claimed ? 'Claimed' : 'Claim' }}" class="claimBtn"
                    color="{{ item.claimed ? 'rgba(255,255,255,0.4)' : '#FFFFFF' }}"
                    background="{{ item.claimed ? '#221F2B' : '#FF2D55' }}"
                    on:tap="dsx.action.claim()"/>
          </hstack>
        </list>
      </vstack>

      <!-- rewarded ads: a native-lane capability, named rather than faked -->
      <vstack class="cardTight">
        <hstack class="cardHead">
          <text value="Watch ads, earn coins" class="h2"/>
          <spacer/>
          <text value="0/10 today" class="taskMeta"/>
        </hstack>
        <text value="Rewarded ads run in the iOS and Android apps (AdMob, verified server-side before any coin is granted). On the web, earn through check-ins, tasks and the wheel." class="note"/>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="rewards" visible-if="dsx.variable.wide == false"/>
</vstack>
