<!-- Rewards — the EARN lane, and a TAB ROOT now (docs/design/reference-ui-spec.md §8: the
     fourth tab, with a callout above its icon showing the coins a viewer can claim). Four
     earn mechanics in the category's own order — the daily check-in, the Watch Mission, the
     capped rewarded ad, the wheel and the tasks — restyled to the reference's tokens (§0):
     black ground, #1C1C1E cards at radius 12, 17 semibold card titles, 13 secondary copy,
     48pt white primary buttons. Gold is the membership's job and appears here only on the
     one door that opens it.

     FUNNEL ROLE: retention. Every mechanic pays small and daily, which is what makes
     tomorrow's open worth it; the screen sells nothing except through the labelled doors.

     EVERY NUMBER IS A SERVER FACT. The streak curve, the ad cap, the wheel's prize table and
     the watch-mission milestones all arrive in /rewards/state and /engage/watch/state, so an
     operator changes the economy without a build and the client can never invent an
     entitlement. Buttons only ASK — and a button with nothing to ask for is disabled in its
     ACTION, not just grey.

     THE WATCH MISSION IS COUNTED SERVER-SIDE (server/engage.dsx watchTick): the player sends
     heartbeats, the server counts wall-clock time between them and grants at 5 · 10 · 20 · 30
     minutes up to the daily cap. This card only READS that state — it has no claim button
     because there is nothing for the client to claim; the grant already landed the moment
     the boundary was crossed.

     THE CLAIMABLE TOTAL is one arithmetic in the global library (Theme.dsx rewardsClaimable):
     this screen prints it and the tab bar's callout binds the same function over the
     app-wide stash, so the two never disagree.

     Signed out, this screen says so ONCE and shows nothing else. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <!-- the seam owns the token (<AuthSeam/> at the foot of this file); every authenticated
         read is gated on `global.auth.ok` and carries `global.auth.headers` — docs/auth.md -->
    <api as="state" url="/rewards/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheRewards = global.auth.ok == true ? state.data : null"/>
    <api as="wallet" url="/wallet/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWallet = global.auth.ok == true ? wallet.data : null"/>
    <!-- the Watch Mission's read: the same shape a heartbeat answers (server/engage.dsx
         watchState), bound DEFENSIVELY — a deployment without the route leaves the card out -->
    <api as="watch" url="/engage/watch/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWatch = global.auth.ok == true ? watch.data : null"/>
    <api as="checkinCall" url="/rewards/checkin" method="POST" auto="false" headers="global.auth.headers"/>
    <api as="spinCall" url="/rewards/spin" method="POST" auto="false" headers="global.auth.headers"/>
    <!-- 2.5.18 wants a report-this-ad affordance that REACHES someone. The route landed with
         the UGC safety pass and takes the {lane, creative} shape AdGate already emits. -->
    <api as="adReportCall" url="/social/report/ad" method="POST" auto="false" headers="global.auth.headers"/>
    <api as="claimCall" url="/rewards/task" method="POST" auto="false" headers="global.auth.headers"/>

    <variable as="toast">return ''</variable>
    <variable as="wheelTurn">return 0</variable>     <!-- accumulated rotation, degrees -->
    <variable as="spinning">return false</variable>
    <variable as="wheelResult">return ''</variable>  <!-- the hub label after a landing -->
    <variable as="trackBox">return {}</variable>     <!-- the mission bar's measured box -->

    <!-- signed out is the seam's answer, not a 404 on a static file (docs/auth.md) -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <variable as="authKnown" computed="true">return global.auth != null &amp;&amp; global.auth.state != null</variable>
    <variable as="signedOut" computed="true">
      return dsx.variable.authKnown &amp;&amp; dsx.variable.signedIn == false
    </variable>
    <!-- stale-then-fresh (PLAN.md §6.30): the api cache dies with the mount, so the last good
         payload lives app-wide and is the FIRST PAINT while the refetch runs. Viewer-scoped
         stashes never survive the viewer (docs/auth.md). -->
    <variable as="walletView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (wallet.data != null) { return wallet.data }
      return global.cacheWallet
    </variable>
    <variable as="stateView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (state.data != null) { return state.data }
      return global.cacheRewards
    </variable>
    <variable as="watchView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (watch.data != null) { return watch.data }
      return global.cacheWatch
    </variable>
    <!-- ENTITLEMENT, read from the wallet — never assumed, never remembered. It switches the
         ad lane off (VIP is sold as "no ads", so it has to BE no ads) and stops the door
         below pitching a pass the viewer already holds. Unknown resolves to false. -->
    <variable as="isVip" computed="true">
      if (dsx.variable.walletView == null) { return false }
      return dsx.variable.walletView.vip === true
    </variable>
    <variable as="phase" computed="true">
      if (dsx.variable.signedOut) { return 'signedout' }
      if (state.error != null &amp;&amp; dsx.variable.stateView == null) { return 'error' }
      if (dsx.variable.stateView == null) { return 'loading' }
      return 'content'
    </variable>

    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 1100)</variable>
    <variable as="balance" computed="true">
      if (dsx.variable.walletView == null) { return null }
      return dsx.variable.walletView.coins + dsx.variable.walletView.bonus
    </variable>
    <!-- the one number the tab bar's callout also shows (Theme.dsx rewardsClaimable) -->
    <variable as="claimable" computed="true">return rewardsClaimable(dsx.variable.stateView, dsx.variable.isVip)</variable>
    <variable as="canCheckin" computed="true">
      return dsx.variable.stateView != null &amp;&amp; dsx.variable.stateView.checkedToday == false
    </variable>
    <variable as="canSpin" computed="true">
      return dsx.variable.stateView != null &amp;&amp; dsx.variable.stateView.freeSpinLeft &amp;&amp; dsx.variable.spinning == false
    </variable>
    <variable as="spinLabel" computed="true">
      if (dsx.variable.spinning) { return 'Spinning…' }
      if (dsx.variable.canSpin) { return 'Spin — 1 free today' }
      return 'No spin left today'
    </variable>
    <variable as="streakCount" computed="true">
      return dsx.variable.stateView == null ? 0 : dsx.variable.stateView.streak
    </variable>
    <!-- ── the Watch Mission facts, each defensive against an absent route ── -->
    <variable as="hasWatch" computed="true">
      return dsx.variable.watchView != null &amp;&amp; dsx.variable.watchView.milestones != null
    </variable>
    <variable as="watchMinutes" computed="true">
      if (dsx.variable.watchView == null) { return 0 }
      return Math.floor(Number(dsx.variable.watchView.watchedSeconds) / 60)
    </variable>
    <variable as="watchGranted" computed="true">
      if (dsx.variable.watchView == null) { return 0 }
      return Number(dsx.variable.watchView.grantedToday)
    </variable>
    <variable as="watchCap" computed="true">
      if (dsx.variable.watchView == null) { return 0 }
      return Number(dsx.variable.watchView.dailyCap)
    </variable>
    <variable as="watchDone" computed="true">
      if (dsx.variable.watchView == null) { return false }
      return dsx.variable.watchView.capReached == true
    </variable>
    <!-- the last milestone's minute mark is the bar's full length -->
    <variable as="watchGoalSeconds" computed="true">
      if (dsx.variable.hasWatch == false) { return 1800 }
      const ms = dsx.variable.watchView.milestones
      if (ms.length == 0) { return 1800 }
      return Number(ms[ms.length - 1].minutes) * 60
    </variable>
    <variable as="watchFrac" computed="true">
      if (dsx.variable.watchView == null) { return 0 }
      const f = Number(dsx.variable.watchView.watchedSeconds) / dsx.variable.watchGoalSeconds
      if (f > 1) { return 1 }
      if (f < 0) { return 0 }
      return f
    </variable>
    <!-- A PROGRESS FILL IS COMPUTED PX OFF A MEASURED TRACK, never `width: N%` — the native
         bridge drops non-100 percent lengths silently (AGENTS.md, upstream #281) -->
    <variable as="watchFillW" computed="true">
      const b = dsx.variable.trackBox
      if (b == null || b.width == null) { return 0 }
      return Math.round(b.width * dsx.variable.watchFrac)
    </variable>
    <!-- THE SELL DOOR, which must not sell what the viewer already owns -->
    <variable as="sellTitle" computed="true">
      if (dsx.variable.isVip) { return 'Get coins' }
      return 'Get coins or go VIP'
    </variable>
    <variable as="sellNote" computed="true">
      if (dsx.variable.isVip) { return 'Your VIP pass already covers every unlock — coins are for when it ends.' }
      return 'Buy a coin pack, or unlock every series with a membership.'
    </variable>
    <variable as="spinRange" computed="true">
      if (dsx.variable.stateView == null || dsx.variable.stateView.spinPrizes == null) { return '' }
      const p = dsx.variable.stateView.spinPrizes
      return p[0] + '–' + p[p.length - 1]
    </variable>
    <!-- the wheel's whole look is ONE computed string; the transition is ALWAYS declared so
         the server's answer cannot snap the wheel mid-ride. wheelTurn only changes in `spin`. -->
    <variable as="wheelFx" computed="true">
      const a = accent()
      const b = sheetCell()
      const c = gold()
      const ring = 'conic-gradient(' + a + ' 0deg 45deg, ' + b + ' 45deg 90deg, ' + c + ' 90deg 135deg, ' + b + ' 135deg 180deg, ' + a + ' 180deg 225deg, ' + b + ' 225deg 270deg, ' + c + ' 270deg 315deg, ' + b + ' 315deg 360deg)'
      return 'width: 132px; height: 132px; border-radius: 66px; background: ' + ring + '; transform: rotate(' + dsx.variable.wheelTurn + 'deg); transition: transform 2.4s cubic-bezier(0.16, 0.8, 0.18, 1)'
    </variable>

    <formula as="dayState" i="item.i">
      if (dsx.variable.stateView == null) { return 'future' }
      const pos = dsx.variable.stateView.streak % 7
      const donePos = dsx.variable.stateView.checkedToday ? (pos == 0 ? 7 : pos) : pos
      if (i < donePos) { return 'done' }
      if (i == donePos &amp;&amp; !dsx.variable.stateView.checkedToday) { return 'next' }
      return 'future'
    </formula>
    <!-- done = the accent wash, next = gold (the coin about to land), future = a chip -->
    <formula as="dayColor" st="dayState">
      if (st == 'done') { return 'rgba(74,223,180,0.18)' }
      if (st == 'next') { return gold() }
      return sheetCell()
    </formula>
    <formula as="dayInk" st="dayState">
      if (st == 'next') { return stage() }
      if (st == 'done') { return accent() }
      return ink()
    </formula>
    <formula as="checkinLabel">
      if (dsx.variable.stateView == null) { return 'Check in' }
      if (dsx.variable.stateView.checkedToday) { return 'Checked in — come back tomorrow' }
      return 'Check in'
    </formula>
    <!-- a milestone chip: reached paints the accent, the rest the chip -->
    <formula as="msBg" reached="item.reached">
      return reached ? 'rgba(74,223,180,0.18)' : sheetCell()
    </formula>
    <formula as="msInk" reached="item.reached">
      return reached ? accent() : ink3()
    </formula>

    <!-- disabled means DISABLED: the guard is in the action, the grey is just its face -->
    <action as="checkin">
      if (dsx.variable.canCheckin == false) { return }
      const r = await checkinCall.send({})
      if (r.ok) {
        dsx.variable.toast = '+' + r.data.reward + ' bonus coins — day ' + r.data.streak
        state.refresh()
        wallet.refresh()
      }
      else { dsx.variable.toast = r.data != null &amp;&amp; r.data.message != null ? r.data.message : 'Check-in failed' }
    </action>

    <!-- The wheel SPINS the moment it is asked (2.4s of eased rotation), the server answers
         during the ride, and the hub shows the landing. NOT A LOOT BOX, and it must stay that
         way: `spinWheel` (server/engage.dsx) refuses a second spin the same day and never
         debits a wallet — nothing sells a spin. The moment a "spin again for 50 coins" button
         exists, App Store 3.1.1 wants the odds published BEFORE the purchase; the prize table
         already travels in /rewards/state (`spinPrizes`, `spinOdds`). -->
    <action as="spin">
      if (dsx.variable.canSpin == false) { return }
      dsx.variable.spinning = true
      dsx.variable.wheelResult = ''
      dsx.variable.wheelTurn = Number(dsx.variable.wheelTurn) + 1890
      const r = await spinCall.send({})
      if (r.ok) {
        dsx.variable.wheelResult = '+' + r.data.prize
        dsx.variable.toast = 'The wheel lands on ' + r.data.prize + ' bonus coins'
        state.refresh()
        wallet.refresh()
      } else {
        dsx.variable.toast = r.data != null &amp;&amp; r.data.message != null ? r.data.message : 'No spin left'
      }
      dsx.variable.spinning = false
    </action>

    <action as="claim" task="item.id" done="item.claimed">
      if (done) { return }
      const r = await claimCall.send({ task: task })
      if (r.ok) { dsx.variable.toast = '+' + r.data.reward + ' bonus coins'; state.refresh(); wallet.refresh() }
      else { dsx.variable.toast = r.data != null &amp;&amp; r.data.message != null ? r.data.message : 'Not yet' }
    </action>

    <!-- the ad lane lives in <AdGate>; this screen only reacts to its outcome -->
    <action as="adGranted" reward="reward" left="left">
      dsx.variable.toast = '+' + reward + ' bonus coins · ' + left + ' left today'
      state.refresh()
      wallet.refresh()
    </action>
    <action as="adFailed" message="message">
      dsx.variable.toast = message
    </action>
    <!-- the report seam (App Store 2.5.18): the creative is hidden locally either way, and
         the toast says which of the two things actually happened -->
    <action as="adReported" lane="lane" creative="creative">
      dsx.variable.toast = 'Ad hidden for this session.'
      const r = await adReportCall.send({ lane: lane, creative: creative })
      if (r.ok) {
        dsx.variable.toast = 'Reported, and hidden for this session.'
        return
      }
      const msg = r.data == null || r.data.message == null ? '' : r.data.message
      dsx.variable.toast = msg === ''
        ? 'Ad hidden for this session. The report could not be filed.'
        : 'Ad hidden for this session. ' + msg
    </action>
    <!-- a tab root is entered laterally; the store is a pushed page and the membership page
         is the crown's destination (Theme.dsx membershipPath) -->
    <action as="openStore">dsx.module.route.push({ path: '/store' })</action>
    <action as="openMembership">dsx.module.route.push({ path: membershipPath() })</action>

    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="0" paddingBottom="32" alignItems="stretch"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="24"/>

    <style as="head" alignItems="center" spacing="12" paddingTop="12" paddingBottom="4"/>
    <style as="h1" fontSize="22" fontWeight="bold" color="#FFFFFF"/>
    <style as="claimPill" background="rgba(74,223,180,0.16)" radius="14" paddingH="10" paddingV="6" spacing="4" alignItems="center"/>
    <style as="claimTxt" fontSize="13" fontWeight="semibold" color="#4ADFB4"/>
    <style as="balancePill" background="#1C1C1E" radius="16" paddingH="12" paddingV="8" spacing="6" alignItems="center"/>
    <style as="balanceNum" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="toastRow" background="#1C1C1E" radius="10" paddingH="14" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="13" fontWeight="medium" color="#FFFFFF" lineSpacing="3"/>
    <style as="sectionTitle" fontSize="22" fontWeight="bold" color="#FFFFFF"/>
    <style as="sectionNote" fontSize="13" color="#8E8E93" lineSpacing="3"/>

    <style as="card" background="#1C1C1E" radius="12" paddingH="16" paddingV="16" spacing="14" alignItems="stretch"/>
    <style as="cardHead" alignItems="center" spacing="12"/>
    <style as="h2" fontSize="17" fontWeight="semibold" color="#FFFFFF"/>
    <style as="note" fontSize="13" color="#8E8E93" lineSpacing="3"/>
    <style as="streakRow" spacing="6" alignItems="center"/>
    <style as="streakPill" fontSize="12" fontWeight="semibold" color="#F6B63D"/>
    <style as="dayCell" spacing="4" alignItems="center" paddingV="8" radius="8"/>
    <style as="dayAmt" fontSize="12" fontWeight="semibold"/>
    <style as="dayNum" fontSize="11" color="#8E8E93"/>
    <!-- the reference's button: 48pt, radius 12, ink fill, 17 semibold on black. ONE class;
         the fill and the ink are interpolated attributes, because a class name is resolved
         at compile time and cannot follow a runtime value. -->
    <style as="btn" radius="12" minHeight="48" paddingV="14" fontSize="17" fontWeight="semibold"/>
    <style as="missionRow" spacing="14" alignItems="center"/>
    <style as="missionTile" width="44" height="44" radius="10" background="#2C2C2E" alignItems="center"/>
    <style as="track" background="#2C2C2E" radius="3" height="6" alignItems="flex-start"/>
    <style as="fill" background="#4ADFB4" radius="3" height="6"/>
    <style as="msChip" radius="6" paddingV="8" spacing="2" alignItems="center"/>
    <style as="msMin" fontSize="13" fontWeight="semibold"/>
    <style as="msCoins" fontSize="12"/>
    <style as="factRow" alignItems="center" spacing="8"/>
    <style as="factLabel" fontSize="13" color="#8E8E93"/>
    <style as="factValue" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="wheelWrap" alignItems="center" spacing="12"/>
    <style as="wheelLabel" fontSize="15" fontWeight="bold" color="#FFFFFF" background="rgba(0,0,0,0.8)" paddingH="12" paddingV="6" radius="14"/>
    <style as="taskRow" alignItems="center" spacing="12"/>
    <style as="taskCol" spacing="2" alignItems="stretch"/>
    <style as="taskTitle" fontSize="15" color="#FFFFFF"/>
    <style as="taskMeta" fontSize="13" color="#8E8E93"/>
    <style as="claimBtn" radius="10" paddingH="16" minHeight="44" fontSize="13" fontWeight="semibold"/>
    <style as="doorCard" background="#1C1C1E" radius="12" paddingH="16" paddingV="16" spacing="12" alignItems="center"/>
    <style as="doorTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="doorNote" fontSize="13" color="#8E8E93" lineSpacing="3"/>
    <style as="vipDoor" background="#3B3410" radius="12" paddingH="16" paddingV="14" spacing="12" alignItems="center"/>
    <style as="vipDoorTxt" fontSize="15" fontWeight="semibold" color="#F6B63D"/>
    <style as="signCard" background="#1C1C1E" radius="12" spacing="10" paddingH="16" paddingV="24" alignItems="center"/>
    <style as="signBtn" background="#FFFFFF" radius="12" minHeight="48" paddingH="20" paddingV="14" fontSize="15" fontWeight="semibold" color="#000000"/>
    <style as="empty" fontSize="13" color="#8E8E93"/>
  </head>

  <!-- the design vocabulary registers here. FIRST CHILD, always (Components/parts/Theme.dsx). -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx) -->
  <Analytics/>
  <scroll class="scroller" grow="true" style="flex: 1; min-height: 0">
    <vstack class="page">
      <TopNav active="rewards" visible-if="dsx.variable.wide"/>

      <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
        <!-- a TAB ROOT has no back chevron: it is entered laterally and never pushed -->
        <hstack class="head">
          <text value="Rewards" class="h1"/>
          <hstack class="claimPill" visible-if="dsx.variable.claimable > 0"
                  a11yGroup="true" a11yLabel="{{ dsx.variable.claimable }} coins to claim">
            <text value="+{{ dsx.variable.claimable }}" class="claimTxt"/>
            <text value="to claim" class="claimTxt"/>
          </hstack>
          <spacer/>
          <hstack class="balancePill" visible-if="dsx.variable.balance != null"
                  on:tap="dsx.action.openStore()" a11yGroup="true" a11yTrait="button"
                  a11yLabel="{{ dsx.variable.balance }} coins — get more in the store">
            <image icon="dollarsign.circle.fill" iconSize="15" color="{{ coin() }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }}" class="balanceNum"/>
          </hstack>
        </hstack>
      </vstack>

      <!-- signed out: one honest card, nothing else -->
      <vstack class="section" visible-if="dsx.variable.phase == 'signedout'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <SignInCard icon="gift.fill"
                      title="Rewards belong to an account"
                      note="Streaks, spins and coins need somewhere to land. Sign in and start earning — nothing here costs money."/>
        </vstack>
      </vstack>

      <vstack class="section" visible-if="dsx.variable.phase == 'loading'">
        <vstack style="{{ dsx.variable.shell }}" spacing="14" alignItems="stretch">
          <Skeleton height="180" radius="12"/>
          <Skeleton height="140" radius="12"/>
          <Skeleton height="140" radius="12"/>
        </vstack>
      </vstack>

      <vstack class="section" visible-if="dsx.variable.phase == 'error'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="signCard">
            <text value="Rewards are unavailable right now." fontSize="15" color="#FFFFFF"/>
            <text value="Your balance is safe — this screen just could not load its state." class="empty" textAlign="center"/>
            <button label="Retry" class="signBtn" on:tap="state.refresh()"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- ═══ EARN ═══ -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" spacing="14" alignItems="stretch">

          <!-- daily check-in -->
          <vstack class="card">
            <hstack class="cardHead">
              <text value="Daily check-in" class="h2" grow="width" style="flex: 1"/>
              <hstack class="streakRow" a11yGroup="true" a11yLabel="{{ dsx.variable.streakCount }} day streak">
                <image icon="flame.fill" iconSize="14" color="{{ gold() }}" a11yHidden="true"/>
                <text value="{{ dsx.variable.streakCount }}" class="streakPill"/>
                <text value="day streak" class="streakPill"/>
              </hstack>
            </hstack>
            <grid bind="dsx.variable.stateView.days" key="id" columns="7" spacing="6" scroll="false">
              <vstack class="dayCell" background="{{ dayColor }}" style="transition: background-color 0.3s ease">
                <image icon="checkmark" iconSize="12" color="{{ accent() }}" visible-if="dayState == 'done'" a11yHidden="true"/>
                <text value="+{{ item.reward }}" class="dayAmt" color="{{ dayInk }}" visible-if="dayState != 'done'"/>
                <text value="D{{ item.i + 1 }}" class="dayNum" color="{{ dayState == 'next' ? stage() : ink3() }}"/>
              </vstack>
            </grid>
            <button label="{{ checkinLabel }}" class="btn"
                    background="{{ dsx.variable.canCheckin ? ink() : sheetCell() }}"
                    color="{{ dsx.variable.canCheckin ? stage() : ink3() }}"
                    on:tap="dsx.action.checkin()"/>
          </vstack>

          <!-- the Watch Mission: read-only progress over a server count (see the header) -->
          <vstack class="card" visible-if="dsx.variable.hasWatch">
            <hstack class="missionRow">
              <vstack class="missionTile" style="justify-content: center">
                <image icon="timer" iconSize="24" color="{{ accent() }}" a11yHidden="true"/>
              </vstack>
              <vstack spacing="3" grow="width" style="flex: 1; min-width: 0" alignItems="stretch">
                <text value="Watch Mission" class="h2"/>
                <text value="{{ dsx.variable.watchDone ? 'Today’s mission is complete — come back tomorrow.' : 'Earn bonus coins as you watch. Every milestone lands on its own.' }}" class="note"/>
              </vstack>
            </hstack>
            <!-- the bar: a measured track, a computed-px fill -->
            <hstack class="track" measure="dsx.variable.trackBox" style="width: 100%"
                    a11yLabel="{{ dsx.variable.watchMinutes }} minutes watched today">
              <stack class="fill" width="{{ dsx.variable.watchFillW }}" style="width: {{ dsx.variable.watchFillW }}px; transition: width 0.4s ease"/>
            </hstack>
            <!-- a <grid> sizes its DIRECT children, so four milestones share the width -->
            <grid bind="dsx.variable.watchView.milestones" key="id" columns="4" spacing="8" scroll="false">
              <vstack class="msChip" background="{{ msBg }}">
                <hstack spacing="2" alignItems="center">
                  <text value="{{ item.minutes }}" class="msMin" color="{{ msInk }}"/>
                  <text value="min" class="msMin" color="{{ msInk }}"/>
                </hstack>
                <text value="+{{ item.coins }}" class="msCoins" color="{{ msInk }}"/>
              </vstack>
            </grid>
            <hstack class="factRow">
              <text value="Minutes watched today" class="factLabel" grow="width" style="flex: 1"/>
              <text value="{{ dsx.variable.watchMinutes }}" class="factValue"/>
            </hstack>
            <hstack class="factRow">
              <text value="Coins earned today" class="factLabel" grow="width" style="flex: 1"/>
              <text value="{{ dsx.variable.watchGranted }} / {{ dsx.variable.watchCap }}" class="factValue"/>
            </hstack>
          </vstack>

          <!-- rewarded ads: the capped lane. The component owns the PLATFORM decision, the
               creative and the App Store 2.5.18 ad chrome; this screen owns the server facts
               and the outcome. `vip=` keeps a sold benefit true: a member is shown no ad. -->
          <AdGate left="{{ dsx.variable.stateView == null ? 0 : dsx.variable.stateView.adsLeft }}"
                  today="{{ dsx.variable.stateView == null ? 0 : dsx.variable.stateView.adsToday }}"
                  cap="{{ dsx.variable.stateView == null ? 10 : dsx.variable.stateView.adCap }}"
                  reward="{{ dsx.variable.stateView == null ? 15 : dsx.variable.stateView.adReward }}"
                  vip="{{ dsx.variable.isVip }}"
                  on:granted="dsx.action.adGranted()"
                  on:failed="dsx.action.adFailed()"
                  on:reported="dsx.action.adReported()"/>

          <!-- spin -->
          <vstack class="card">
            <vstack class="wheelWrap">
              <text value="Spin the wheel" class="h2"/>
              <zstack>
                <stack style="{{ dsx.variable.wheelFx }}"/>
                <!-- explicit z: the wheel carries a transform, and a transformed sibling
                     paints ABOVE later plain siblings (AGENTS.md) -->
                <vstack zIndex="1" style="z-index: 1; width: 132px; height: 132px; align-items: center; justify-content: center">
                  <text value="{{ dsx.variable.wheelResult != '' ? dsx.variable.wheelResult : dsx.variable.spinRange }}"
                        class="wheelLabel"
                        a11yLabel="{{ dsx.variable.wheelResult != '' ? 'You won ' + dsx.variable.wheelResult + ' bonus coins' : 'Prizes from ' + dsx.variable.spinRange + ' coins' }}"/>
                </vstack>
              </zstack>
              <button label="{{ dsx.variable.spinLabel }}" class="btn" paddingH="24"
                      background="{{ dsx.variable.canSpin ? ink() : sheetCell() }}"
                      color="{{ dsx.variable.canSpin ? stage() : ink3() }}"
                      on:tap="dsx.action.spin()"/>
            </vstack>
          </vstack>

          <!-- tasks -->
          <vstack class="card">
            <text value="Tasks" class="h2"/>
            <list bind="dsx.variable.stateView.tasks" key="id" scroll="false" spacing="14">
              <hstack class="taskRow">
                <vstack class="taskCol" grow="width" style="flex: 1; min-width: 0">
                  <text value="{{ item.title }}" class="taskTitle" lineLimit="1" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
                  <text value="{{ item.progress }}/{{ item.target }} · +{{ item.reward }}" class="taskMeta"/>
                </vstack>
                <button label="{{ item.claimed ? 'Claimed' : 'Claim' }}" class="claimBtn"
                        color="{{ item.claimed ? '#8E8E93' : '#000000' }}"
                        background="{{ item.claimed ? '#2C2C2E' : '#FFFFFF' }}"
                        on:tap="dsx.action.claim()"/>
              </hstack>
            </list>
          </vstack>

          <!-- the doors to the SELL lane: coins on /store, the pass on the membership page.
               The gold door is hidden from a member — a pass is not sold to its holder. -->
          <hstack class="doorCard" on:tap="dsx.action.openStore()"
                  a11yGroup="true" a11yTrait="button" a11yLabel="{{ dsx.variable.sellTitle }}">
            <vstack spacing="4" grow="width" style="flex: 1; min-width: 0" alignItems="stretch">
              <text value="{{ dsx.variable.sellTitle }}" class="doorTitle"/>
              <text value="{{ dsx.variable.sellNote }}" class="doorNote"/>
            </vstack>
            <image icon="chevron.forward" iconSize="14" color="{{ ink3() }}" a11yHidden="true"/>
          </hstack>
          <hstack class="vipDoor" visible-if="dsx.variable.isVip == false" on:tap="dsx.action.openMembership()"
                  a11yGroup="true" a11yTrait="button" a11yLabel="Unlock unlimited watching — see the membership plans">
            <image icon="crown.fill" iconSize="16" color="{{ gold() }}" a11yHidden="true"/>
            <text value="Unlock Unlimited Watching" class="vipDoorTxt" grow="width" style="flex: 1"/>
            <image icon="chevron.forward" iconSize="14" color="{{ gold() }}" a11yHidden="true"/>
          </hstack>
        </vstack>
      </vstack>

    </vstack>
  </scroll>

  <!-- THE TOAST LIVES OUTSIDE THE SCROLL, pinned at the foot on every renderer -->
  <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
    <text value="{{ dsx.variable.toast }}" class="toastLine" grow="width" style="flex: 1"/>
    <image icon="xmark" iconSize="12" color="{{ ink3() }}" on:tap="dsx.variable.toast = ''"
           a11yLabel="Dismiss message" a11yTrait="button"/>
  </hstack>
  <TabBar active="rewards" visible-if="dsx.variable.wide == false"/>
  <AuthSeam/>
</vstack>
