<!-- Search — the category-standard search face: one big rounded bar, the "Hot Movie"
     ranked panel while the query is empty, a poster grid once it isn't. The query runs
     server-side (/catalog/search) so the storefront and any agent share one seam. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="home" url="/catalog/home"/>
    <api as="searchCall" url="/catalog/search" method="POST" auto="false"/>

    <variable as="q">return ''</variable>
    <variable as="results">return null</variable>
    <variable as="searching">return false</variable>

    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 24 }
      return 16
    </variable>
    <variable as="cols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <variable as="hotCols" computed="true">return dsx.variable.bp == 'desktop' ? 2 : 1</variable>
    <variable as="statusMsg" computed="true">
      if (dsx.variable.searching) { return 'Searching…' }
      const r = dsx.variable.results
      if (r != null && r.length == 0) { return 'Nothing matches “' + dsx.variable.q + '” — try a genre like Romance or Revenge.' }
      return ''
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1000px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>

    <formula as="hotRank" r="item.rank">
      if (r == 1 || r == 2) { return '#F6B63D' }
      return 'rgba(255,255,255,0.35)'
    </formula>

    <action as="goSearch">
      const term = dsx.variable.q
      if (term == null || term === '') { dsx.variable.results = null; return }
      dsx.variable.searching = true
      const r = await searchCall.send({ q: term })
      dsx.variable.searching = false
      if (r.ok) { dsx.variable.results = r.data.items }
    </action>
    <action as="resetSearch">
      dsx.variable.q = ''
      dsx.variable.results = null
    </action>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="24" paddingTop="18" paddingBottom="24" alignItems="stretch"/>

    <style as="barWrap" alignItems="stretch"/>
    <style as="bar" background="#1C1C22" radius="26" paddingLeading="20" paddingTrailing="8" paddingV="4" spacing="10" alignItems="center"/>
    <style as="goBtn" background="#FF2D55" radius="20" paddingH="16" paddingV="10" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>

    <style as="panel" background="#141419" radius="16" paddingH="20" paddingV="18" spacing="14" alignItems="stretch"/>
    <style as="panelHead" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="hotRow" spacing="12" alignItems="center" paddingV="6"/>
    <style as="hotNum" fontSize="24" fontWeight="heavy"/>
    <style as="hotCol" spacing="5" alignItems="flex-start"/>
    <style as="hotTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF" lineLimit="1"/>
    <style as="hotPills" spacing="6" alignItems="center"/>
    <style as="hotPill" background="rgba(255,255,255,0.1)" radius="9" paddingH="8" paddingV="3" fontSize="11" color="rgba(255,255,255,0.75)"/>
    <style as="trendBadge" background="#FF2D55" radius="4" paddingH="6" paddingV="2" fontSize="11" fontWeight="bold" color="#FFFFFF"/>

    <style as="grid" alignItems="stretch"/>
    <style as="card" spacing="8" alignItems="stretch"/>
    <style as="cardTitle" fontSize="15" fontWeight="medium" color="rgba(255,255,255,0.95)" lineLimit="1"/>
    <style as="cardMeta" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="statusLine" fontSize="13" color="rgba(255,255,255,0.55)" textAlign="center" paddingV="10"/>
  </head>

  <TopNav active="search" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <hstack style="{{ dsx.variable.shell }}" spacing="10" alignItems="center" visible-if="dsx.variable.wide == false">
        <image icon="chevron.left" iconSize="20" color="#FFFFFF" href="/" a11yLabel="Back to home"/>
        <text value="Search" fontSize="17" fontWeight="bold" color="#FFFFFF"/>
      </hstack>

      <!-- the bar -->
      <vstack class="barWrap" style="{{ dsx.variable.shell }}">
        <hstack class="bar">
          <image icon="magnifyingglass" iconSize="18" color="rgba(255,255,255,0.55)" a11yHidden="true"/>
          <textfield bind="dsx.variable.q" placeholder="Search anything you like"
                     color="#FFFFFF" style="flex: 1" on:submit="dsx.action.goSearch()"/>
          <image icon="xmark" iconSize="15" color="rgba(255,255,255,0.5)" visible-if="dsx.variable.q != ''"
                 on:tap="dsx.action.resetSearch()" a11yLabel="Clear search" a11yTrait="button"/>
          <button label="Search" class="goBtn" on:tap="dsx.action.goSearch()"/>
        </hstack>
      </vstack>

      <!-- Hot Movie — while nothing is searched -->
      <vstack style="{{ dsx.variable.shell }}" visible-if="dsx.variable.results == null" alignItems="stretch">
        <vstack class="panel">
          <text value="Hot Movie" class="panelHead"/>
          <grid bind="home.data.trending" key="id" columns="{{ dsx.variable.hotCols }}" spacing="4" scroll="false">
            <hstack class="hotRow" href="/show/{{ item.id }}" a11yGroup="true" a11yLabel="Number {{ item.rank }}, {{ item.title }}">
              <zstack>
                <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                       style="width: 58px; height: 82px; border-radius: 6px"/>
                <vstack style="width: 58px; height: 82px; justify-content: flex-end; align-items: flex-start; pointer-events: none">
                  <text value="{{ item.rank }}" class="hotNum" color="{{ hotRank }}"
                        style="line-height: 0.8; text-shadow: 0 2px 8px rgba(0,0,0,0.8); padding-left: 3px"/>
                </vstack>
              </zstack>
              <vstack class="hotCol" style="flex: 1">
                <hstack spacing="7" alignItems="center">
                  <text value="TRENDING" class="trendBadge" visible-if="item.rank <= 3"/>
                  <text value="{{ item.title }}" class="hotTitle"/>
                </hstack>
                <hstack class="hotPills">
                  <text value="{{ item.genre }}" class="hotPill"/>
                  <text value="Series" class="hotPill"/>
                  <text value="EP {{ item.episodes }}" class="hotPill" visible-if="item.episodes > 0"/>
                </hstack>
              </vstack>
              <image icon="chevron.right" iconSize="13" color="rgba(255,255,255,0.3)" a11yHidden="true"/>
            </hstack>
          </grid>
        </vstack>
      </vstack>

      <!-- results -->
      <vstack style="{{ dsx.variable.shell }}" visible-if="dsx.variable.results != null" alignItems="stretch" spacing="14">
        <text value="{{ dsx.variable.statusMsg }}" class="statusLine" visible-if="dsx.variable.statusMsg != ''"/>
        <grid bind="dsx.variable.results" key="id" columns="{{ dsx.variable.cols }}" spacing="14" scroll="false">
          <vstack class="card" href="/show/{{ item.id }}" a11yGroup="true" a11yLabel="{{ item.title }}">
            <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                   style="width: 100%; aspect-ratio: 2/3; border-radius: 8px; object-fit: cover"/>
            <vstack spacing="3" alignItems="stretch">
              <text value="{{ item.title }}" class="cardTitle"/>
              <text value="{{ item.genre }}  |  Series{{ item.episodes > 0 ? '  |  EP ' + item.episodes : '' }}" class="cardMeta"/>
            </vstack>
          </vstack>
        </grid>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="home" visible-if="dsx.variable.wide == false"/>
</vstack>
