<!-- Show — the series page in the shape the category actually ships (measured on the
     reference watch/detail page at 1440×900): a portrait key-art stage on the LEFT and
     the detail panel on the RIGHT — breadcrumb, title, plot, tag pills, actions, and the
     numbered EPISODE GRID beside the art rather than a screen below it. Short episodes
     mean the episode list is the primary navigation, so it belongs next to the content,
     never under a scroll.

     Measured constants: panel 416 wide · grid 6 columns at 6px · cell 64×46 radius 8 on
     rgba(255,255,255,0.1) · title 20/700 at 0.9 · plot head 16/400 · tag pills 14 at
     rgba(255,255,255,0.1)/0.7 · stage 9:16.

     Entitlement is ALWAYS the server's opinion: `epLocked` reads /wallet/state, so a lock
     badge is never a client guess. Phones fall back to the stacked layout — a two-column
     detail on a 375pt screen is a desktop layout in a phone's clothes. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <!-- the router publishes nav.canPop / nav.depth; back reads it -->
    <expects variable="nav"/>
    <api as="detail" url="/catalog/show/{{ vars.id }}"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="favs" url="/viewer/list" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="fav" url="/viewer/favorite" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="favTouched">return ''</variable>

    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <variable as="show" computed="true">
      if (detail.data == null) { return null }
      return detail.data.show
    </variable>
    <variable as="favOn" computed="true">
      if (dsx.variable.favTouched != '') { return dsx.variable.favTouched == 'y' }
      if (favs.data == null) { return false }
      return favs.data.items.filter(x => x.show == vars.id).length > 0
    </variable>
    <variable as="freeCount" computed="true">
      if (detail.data == null) { return 0 }
      return detail.data.episodes.filter(e => e.free).length
    </variable>
    <variable as="phase" computed="true">
      if (detail.error != null) { return 'error' }
      if (detail.data == null) { return 'loading' }
      return 'content'
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 86 }
      if (dsx.variable.bp == 'tablet') { return 40 }
      return 16
    </variable>
    <!-- the stage is a real 9:16 portrait, capped by the viewport height (the reference
         runs 461×820 in a 900pt window) -->
    <variable as="stageW" computed="true">
      if (dsx.variable.bp == 'desktop') { return Math.round(Math.min(461, (dsx.screen.height - 150) * 9 / 16)) }
      if (dsx.variable.bp == 'tablet') { return 320 }
      return 220
    </variable>
    <variable as="stageH" computed="true">return Math.round(dsx.variable.stageW * 16 / 9)</variable>
    <variable as="epCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 6 }
      return 5
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>
    <variable as="stageBox" computed="true">
      return 'width: ' + dsx.variable.stageW + 'px; height: ' + dsx.variable.stageH + 'px; border-radius: 12px; object-fit: cover'
    </variable>
    <variable as="stageOverlayBox" computed="true">
      return 'width: ' + dsx.variable.stageW + 'px; height: ' + dsx.variable.stageH + 'px; justify-content: flex-end; border-radius: 12px; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.85) 100%)'
    </variable>

    <formula as="epLocked" free="item.free" epid="item.id">
      if (free) { return false }
      if (wallet.data == null) { return true }
      return !wallet.data.unlocked.includes(epid)
    </formula>

    <!-- The canonical back (writing-an-app.md §5): POP when there is history, REPLACE
         when the screen was deep-linked, so a dismiss never teleports home and never
         stacks a second copy of where you came from. Back is never href — href pushes. -->
    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/' }) }
    </action>
    <action as="toggleFav">
      const r = await fav.send({ show: vars.id })
      if (r.ok) { dsx.variable.favTouched = r.data.favorite ? 'y' : 'n' }
    </action>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="0" paddingBottom="40" alignItems="stretch"/>
    <style as="split" spacing="0" alignItems="flex-start" paddingTop="26"/>

    <style as="stageCol" alignItems="center" spacing="14"/>
    <style as="stageCap" spacing="6" alignItems="flex-start" paddingH="16" paddingBottom="16"/>
    <style as="stageEp" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="stageFree" fontSize="12" color="rgba(255,255,255,0.7)"/>

    <style as="panel" spacing="16" alignItems="stretch"/>
    <style as="crumbRow" spacing="7" alignItems="center"/>
    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.45)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="title" fontWeight="bold" color="rgba(255,255,255,0.9)" lineLimit="3" lineSpacing="6"/>
    <style as="plotHead" fontSize="16" color="rgba(255,255,255,0.9)"/>
    <style as="plotBody" fontSize="14" color="rgba(255,255,255,0.6)" lineSpacing="5"/>
    <style as="tagRow" spacing="8" alignItems="center"/>
    <style as="tag" background="rgba(255,255,255,0.1)" radius="16" paddingH="16" paddingV="7" fontSize="14" color="rgba(255,255,255,0.7)"/>
    <style as="ctaRow" spacing="12" alignItems="center"/>
    <style as="playWhite" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" spacing="9" alignItems="center"/>
    <style as="playLabel" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="favBtn" background="rgba(255,255,255,0.1)" radius="24" paddingH="18" paddingV="13" spacing="8" alignItems="center"/>
    <style as="favLabel" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>

    <style as="statRow" spacing="30" alignItems="center" paddingV="12"/>
    <style as="statCol" spacing="5" alignItems="center"/>
    <style as="statCap" fontSize="12" color="rgba(255,255,255,0.6)"/>

    <style as="gridHead" alignItems="center" paddingTop="4"/>
    <style as="gridRange" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="gridAllRow" spacing="4" alignItems="center"/>
    <style as="gridAll" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="epCell" radius="8" alignItems="center" height="46" background="rgba(255,255,255,0.1)"/>
    <style as="epNum" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="skeleton" background="#141419" radius="12"/>
    <style as="section" spacing="14" alignItems="stretch"/>
    <style as="errCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="20" alignItems="center"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="backBtn" background="rgba(255,255,255,0.1)" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="phoneBar" spacing="12" alignItems="center" paddingV="12"/>
    <style as="phoneBarTitle" fontSize="16" fontWeight="semibold" color="#FFFFFF"/>
    <style as="phoneHero" spacing="16" alignItems="flex-start"/>
    <style as="phoneMeta" spacing="10" alignItems="flex-start"/>
  </head>

  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <TopNav active="" visible-if="dsx.variable.wide"/>

      <vstack class="section" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.phase == 'error'" paddingTop="26">
        <vstack class="errCard">
          <text value="This series could not be loaded." fontSize="14" color="#FFFFFF"/>
          <text value="The link may be stale, or the catalogue is briefly unavailable." class="gridAll" textAlign="center"/>
          <hstack spacing="10" alignItems="center">
            <button label="Retry" class="retryBtn" on:tap="detail.refresh()"/>
            <button label="Back" class="backBtn" on:tap="dsx.action.goBack()"/>
          </hstack>
        </vstack>
      </vstack>

      <!-- the split (stage | panel) is the WIDE layout; the phone block below carries the
           whole story on its own, so this row mounts only wide -->
      <hstack class="split" style="{{ dsx.variable.shell }}" alignItems="flex-start"
              visible-if="dsx.variable.wide && dsx.variable.phase != 'error'">

        <!-- ===== the key-art stage (left) ===== -->
        <vstack class="stageCol" style="flex: 1; min-width: 0">
          <!-- while the detail loads, the stage is its own silhouette — an <image src="">
               is a broken-image glyph in a 461x820 frame -->
          <stack class="skeleton" visible-if="show == null"
                 style="width: {{ dsx.variable.stageW }}px; height: {{ dsx.variable.stageH }}px"/>
          <zstack visible-if="show != null">
            <image src="{{ show == null ? '' : show.poster }}" contentFit="cover" a11yHidden="true"
                   shared="poster-{{ vars.id }}" sharedMode="clip" style="{{ dsx.variable.stageBox }}"/>
            <vstack style="{{ dsx.variable.stageOverlayBox }}">
              <vstack class="stageCap">
                <text value="EP 1 — {{ detail.data == null ? '' : detail.data.episodes.length }} episodes" class="stageEp"/>
                <text value="EP 1–{{ show == null ? '' : show.free_until }} free to watch" class="stageFree"/>
              </vstack>
            </vstack>
          </zstack>
          <hstack class="playWhite" a11yGroup="true" a11yTrait="button" a11yLabel="Play episode 1"
                  on:tap="dsx.module.route.push({ path: '/watch/' + vars.id + '/1' })">
            <image icon="play.fill" iconSize="14" color="#111111" a11yHidden="true"/>
            <text value="Play EP 1" class="playLabel"/>
          </hstack>
        </vstack>

        <!-- ===== the detail panel + EPISODE GRID (right) ===== -->
        <vstack class="panel" style="width: 456px; min-width: 456px; padding-left: 40px">
          <!-- back POPS (goBack: pop-or-replace); an href here would push a second Home
               under every tap — the exact trap the comment above goBack names -->
          <hstack class="crumbRow">
            <text value="Home" class="crumb" on:tap="dsx.action.goBack()" a11yTrait="button" a11yLabel="Back to Home"/>
            <text value="/" class="crumb"/>
            <text value="{{ show == null ? '' : show.title }}" class="crumbOn" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px"/>
          </hstack>

          <text value="{{ show == null ? '' : show.title }}" class="title" fontSize="20"
                style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden"/>

          <vstack spacing="8" alignItems="flex-start">
            <text value="Plot" class="plotHead"/>
            <text value="{{ show == null ? '' : show.synopsis }}" class="plotBody"/>
          </vstack>

          <hstack class="tagRow">
            <text value="{{ show == null ? '' : show.genre }}" class="tag"/>
            <text value="Series" class="tag"/>
            <text value="EP 1–{{ show == null ? '' : show.free_until }} Free" class="tag"/>
          </hstack>

          <hstack class="ctaRow">
            <hstack class="favBtn" on:tap="dsx.action.toggleFav()" a11yGroup="true" a11yTrait="button" a11yLabel="Toggle My List">
              <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="17"
                     color="{{ dsx.variable.favOn ? '#FF2C55' : '#FFFFFF' }}" a11yHidden="true"/>
              <text value="{{ dsx.variable.favOn ? 'Saved' : 'My List' }}" class="favLabel"/>
            </hstack>
            <hstack class="favBtn" on:tap="dsx.module.route.push({ path: '/store' })"
                    a11yGroup="true" a11yTrait="button" a11yLabel="Your coins — get more in the store">
              <image icon="dollarsign.circle.fill" iconSize="17" color="#F6B63D" a11yHidden="true"/>
              <text value="{{ wallet.data == null ? 0 : wallet.data.coins + wallet.data.bonus }}" class="favLabel"/>
            </hstack>
          </hstack>

          <hstack class="gridHead" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px">
            <text value="1 - {{ detail.data == null ? '' : detail.data.episodes.length }}" class="gridRange"/>
            <spacer/>
            <text value="{{ dsx.variable.freeCount }} free" class="gridAll"/>
          </hstack>

          <stack class="skeleton" visible-if="detail.loading" style="height: 160px"/>
          <grid bind="detail.data.episodes" key="id" columns="{{ dsx.variable.epCols }}" spacing="6" scroll="false">
            <vstack class="epCell" style="position: relative; justify-content: center" href="/watch/{{ vars.id }}/{{ item.idx }}"
                    a11yLabel="Episode {{ item.idx }}{{ epLocked ? ', locked' : '' }}">
              <text value="{{ item.idx }}" class="epNum"/>
              <image icon="lock.fill" iconSize="8" color="rgba(255,255,255,0.55)" visible-if="epLocked"
                     a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
            </vstack>
          </grid>
        </vstack>
      </hstack>

      <!-- ===== phone: back bar · compact hero (art + facts + Play) · plot · grid ===== -->
      <vstack style="{{ dsx.variable.shell }}" spacing="16" alignItems="stretch"
              visible-if="dsx.variable.wide == false && dsx.variable.phase != 'error'">
        <!-- a deep-linked phone has no TopNav: the back bar is the only way out -->
        <hstack class="phoneBar">
          <image icon="chevron.left" iconSize="20" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button"/>
          <text value="{{ show == null ? 'Details' : show.title }}" class="phoneBarTitle"
                style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0"/>
        </hstack>

        <vstack spacing="16" alignItems="stretch" visible-if="dsx.variable.phase == 'loading'">
          <Skeleton height="165" radius="12"/>
          <Skeleton height="46" radius="8"/>
          <Skeleton height="120" radius="8"/>
        </vstack>

        <vstack spacing="18" alignItems="stretch" visible-if="dsx.variable.phase == 'content'">
          <hstack class="phoneHero">
            <image src="{{ show == null ? '' : show.poster }}" contentFit="cover" a11yHidden="true"
                   style="width: 110px; height: 147px; border-radius: 10px; object-fit: cover"/>
            <vstack class="phoneMeta" style="flex: 1; min-width: 0">
              <text value="{{ show == null ? '' : show.title }}" class="title" fontSize="20"
                    style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
              <hstack class="tagRow">
                <text value="{{ show == null ? '' : show.genre }}" class="tag"/>
                <text value="EP 1–{{ show == null ? '' : show.free_until }} Free" class="tag"/>
              </hstack>
              <hstack class="playWhite" style="padding-left: 24px; padding-right: 24px" a11yGroup="true" a11yTrait="button"
                      a11yLabel="Play episode 1"
                      on:tap="dsx.module.route.push({ path: '/watch/' + vars.id + '/1' })">
                <image icon="play.fill" iconSize="13" color="#111111" a11yHidden="true"/>
                <text value="Play EP 1" class="playLabel"/>
              </hstack>
            </vstack>
          </hstack>
          <text value="{{ show == null ? '' : show.synopsis }}" class="plotBody"/>
          <hstack class="gridHead" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px">
            <text value="1 - {{ detail.data == null ? '' : detail.data.episodes.length }}" class="gridRange"/>
            <spacer/>
            <text value="{{ dsx.variable.freeCount }} free" class="gridAll"/>
          </hstack>
          <!-- the cell is the grid's DIRECT child (a wrapper loses the column width); this
               grid is deliberately DUPLICATED from the wide panel — an inline <component>
               does not render on web yet (PLAN.md §6.12), so the two copies stay in sync
               by hand until file-component extraction is worth its own state plumbing -->
          <grid bind="detail.data.episodes" key="id" columns="{{ dsx.variable.epCols }}" spacing="6" scroll="false">
            <vstack class="epCell" style="position: relative; justify-content: center" href="/watch/{{ vars.id }}/{{ item.idx }}"
                    a11yLabel="Episode {{ item.idx }}{{ epLocked ? ', locked' : '' }}">
              <text value="{{ item.idx }}" class="epNum"/>
              <image icon="lock.fill" iconSize="8" color="rgba(255,255,255,0.55)" visible-if="epLocked"
                     a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
            </vstack>
          </grid>
        </vstack>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="" visible-if="dsx.variable.wide == false"/>
</vstack>
