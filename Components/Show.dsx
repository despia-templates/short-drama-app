<!-- Show — the series page in the category's "All Episodes" shape: full-bleed key art
     with the title block on the scrim, white Play pill + My List, then the episode
     thumb grid with lock badges. Entitlement is ALWAYS the server's opinion: `epLocked`
     reads /wallet/state, so a lock badge is never a client guess. -->
<vstack class="screen" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <api as="detail" url="/catalog/show/{{ vars.id }}"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="favs" url="/viewer/list" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="fav" url="/viewer/favorite" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="favTouched">return ''</variable>

    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <variable as="show" computed="true">
      if (detail.data == null) { return null }
      return detail.data.show
    </variable>
    <variable as="favOn" computed="true">
      if (dsx.variable.favTouched != '') { return dsx.variable.favTouched == 'y' }
      if (favs.data == null) { return false }
      return favs.data.items.filter(x => x.show == vars.id).length > 0
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">
      const w = dsx.screen.width
      if (w >= 1120) { return 'desktop' }
      if (w >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <variable as="artH" computed="true">
      if (dsx.variable.bp == 'desktop') { return 460 }
      if (dsx.variable.bp == 'tablet') { return 380 }
      return 300
    </variable>
    <variable as="epCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <variable as="gutter" computed="true">
      if (dsx.variable.bp == 'desktop') { return 32 }
      if (dsx.variable.bp == 'tablet') { return 24 }
      return 16
    </variable>
    <variable as="shell" computed="true">
      const g = dsx.variable.gutter
      return 'width: 100%; max-width: 1400px; margin-left: auto; margin-right: auto; padding-left: ' + g + 'px; padding-right: ' + g + 'px'
    </variable>

    <!-- one computed list for the scrim (compound styles: whole-attribute only) -->
    <variable as="artScrimBox" computed="true">
      return dsx.variable.shell + '; height: ' + dsx.variable.artH + 'px; justify-content: space-between; background: linear-gradient(90deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0) 70%), linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 25%, rgba(0,0,0,0.6) 78%, #000000 100%)'
    </variable>

    <formula as="epLocked" free="item.free" epid="item.id">
      if (free) { return false }
      if (wallet.data == null) { return true }
      return !wallet.data.unlocked.includes(epid)
    </formula>

    <action as="toggleFav">
      const r = await fav.send({ show: vars.id })
      if (r.ok) { dsx.variable.favTouched = r.data.favorite ? 'y' : 'n' }
    </action>

    <style as="screen" background="#000000" alignItems="stretch"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="20" paddingBottom="24" alignItems="stretch"/>

    <style as="artScrim" paddingBottom="26" paddingTop="14" spacing="12" alignItems="flex-start"/>
    <style as="backBtn" background="rgba(0,0,0,0.55)" radius="17" paddingH="12" paddingV="7" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="titleBlock" spacing="11" alignItems="flex-start"/>
    <style as="title" fontWeight="bold" color="#FFFFFF" lineLimit="2" tracking="-0.5"/>
    <style as="pillRow" spacing="8" alignItems="center"/>
    <style as="pillHot" background="#FF2D55" radius="13" paddingH="11" paddingV="5" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="pillTag" background="rgba(255,255,255,0.14)" radius="13" paddingH="11" paddingV="5" fontSize="12" fontWeight="medium" color="rgba(255,255,255,0.92)"/>
    <style as="meta" fontSize="13" color="rgba(255,255,255,0.62)"/>
    <style as="ctaRow" spacing="12" alignItems="center"/>
    <style as="playWhite" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="favBtn" background="rgba(255,255,255,0.12)" radius="24" paddingH="16" paddingV="12"/>
    <style as="synopsis" fontSize="15" color="rgba(255,255,255,0.66)" lineSpacing="5"/>

    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="crumbRow" spacing="7" alignItems="center" paddingTop="14"/>

    <style as="epHead" alignItems="flex-end" paddingTop="6"/>
    <style as="epTitle" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="epCount" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="epCard" spacing="7" alignItems="stretch"/>
    <style as="epNum" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="epName" fontSize="12" color="rgba(255,255,255,0.5)" lineLimit="1"/>
    <style as="freeChip" background="rgba(0,0,0,0.72)" radius="4" paddingH="6" paddingV="2" fontSize="11" fontWeight="semibold" color="#F7C948"/>
    <style as="lockChip" background="rgba(0,0,0,0.72)" radius="4" paddingH="6" paddingV="3"/>
    <style as="chipWrap" paddingLeading="7" paddingTop="7" alignItems="flex-start" zIndex="1"/>
    <style as="skeleton" background="#141419" radius="12"/>
  </head>

  <TopNav active="home" visible-if="dsx.variable.wide"/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <!-- key art + title block -->
      <zstack>
        <image src="{{ show == null ? '' : show.hero }}" contentFit="cover" a11yHidden="true"
               style="width: 100%; height: {{ dsx.variable.artH }}px"/>
        <vstack class="artScrim" style="{{ dsx.variable.artScrimBox }}">
          <text value="‹  Back" class="backBtn" href="/" a11yLabel="Back to home" visible-if="dsx.variable.wide == false"/>
          <hstack class="crumbRow" visible-if="dsx.variable.wide">
            <text value="Home" class="crumb" href="/"/>
            <text value="/" class="crumb"/>
            <text value="{{ show == null ? '' : show.title }}" class="crumbOn"/>
          </hstack>
          <vstack class="titleBlock">
            <text value="{{ show == null ? '' : show.title }}" class="title" fontSize="{{ dsx.variable.wide ? 34 : 24 }}"/>
            <hstack class="pillRow">
              <text value="Hot" class="pillHot" visible-if="show != null && show.featured"/>
              <text value="{{ show == null ? '' : show.genre }}" class="pillTag"/>
              <text value="Series" class="pillTag"/>
            </hstack>
            <text value="{{ detail.data == null ? '' : detail.data.episodes.length }} Episodes   |   EP 1–{{ show == null ? '' : show.free_until }} Free   |   then 60 🪙 each" class="meta"/>
            <hstack class="ctaRow">
              <button label="▶   Play EP 1" class="playWhite"
                      on:tap="dsx.module.route.push({ path: '/watch/' + vars.id + '/1' })"/>
              <hstack class="favBtn" on:tap="dsx.action.toggleFav()" a11yLabel="Toggle My List" a11yTrait="button" spacing="7" alignItems="center">
                <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="17"
                       color="{{ dsx.variable.favOn ? '#FF2D55' : '#FFFFFF' }}" a11yHidden="true"/>
                <text value="{{ dsx.variable.favOn ? 'Saved' : 'My List' }}" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
              </hstack>
            </hstack>
          </vstack>
        </vstack>
      </zstack>

      <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
        <text value="{{ show == null ? '' : show.synopsis }}" class="synopsis" style="max-width: 760px"/>
      </vstack>

      <!-- all episodes -->
      <vstack spacing="14" alignItems="stretch">
        <hstack class="epHead" style="{{ dsx.variable.shell }}">
          <text value="{{ show == null ? '' : show.title }} — All Episodes" class="epTitle" fontSize="{{ dsx.variable.wide ? 22 : 17 }}"/>
          <spacer/>
          <text value="{{ detail.data == null ? '' : detail.data.episodes.length }} Episodes" class="epCount"/>
        </hstack>
        <stack class="skeleton" visible-if="detail.loading" style="height: 160px; margin: 0 16px"/>
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <grid bind="detail.data.episodes" key="id" columns="{{ dsx.variable.epCols }}" spacing="14" scroll="false">
            <vstack class="epCard" href="/watch/{{ vars.id }}/{{ item.idx }}"
                    a11yGroup="true" a11yLabel="Episode {{ item.idx }}{{ epLocked ? ', locked' : '' }}">
              <zstack>
                <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                       style="width: 100%; aspect-ratio: 2/3; border-radius: 8px; object-fit: cover; filter: brightness({{ epLocked ? 0.55 : 1 }})"/>
                <vstack class="chipWrap" style="width: 100%; height: 100%; pointer-events: none">
                  <text value="FREE" class="freeChip" visible-if="item.free"/>
                  <hstack class="lockChip" visible-if="epLocked">
                    <image icon="lock.fill" iconSize="9" color="rgba(255,255,255,0.85)" a11yHidden="true"/>
                  </hstack>
                </vstack>
              </zstack>
              <vstack spacing="2" alignItems="stretch">
                <text value="EP {{ item.idx }}" class="epNum"/>
                <text value="{{ item.title }}" class="epName"/>
              </vstack>
            </vstack>
          </grid>
        </vstack>
      </vstack>

    </vstack>
  </scroll>
  <TabBar active="home" visible-if="dsx.variable.wide == false"/>
</vstack>
