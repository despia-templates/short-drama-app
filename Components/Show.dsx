<!-- Show — the series page in the shape the category actually ships (measured on the
     reference watch/detail page at 1440×900): a portrait key-art stage on the LEFT and
     the detail panel on the RIGHT — breadcrumb, title, plot, tag pills, actions, and the
     numbered EPISODE GRID beside the art rather than a screen below it. Short episodes
     mean the episode list is the primary navigation, so it belongs next to the content,
     never under a scroll.

     Measured constants: panel 416 wide · grid 6 columns at 6px · cell 64×46 radius 8 on
     rgba(255,255,255,0.1) · title 20/700 at 0.9 · plot head 16/400 · tag pills 14 at
     rgba(255,255,255,0.1)/0.7 · stage 9:16.

     Entitlement is ALWAYS the server's opinion: `epLocked` reads /wallet/state, so a lock
     badge is never a client guess. Phones fall back to the stacked layout — a two-column
     detail on a 375pt screen is a desktop layout in a phone's clothes. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <!-- the router publishes nav.canPop / nav.depth; back reads it -->
    <expects variable="nav"/>
    <api as="detail" url="/catalog/show/{{ vars.id }}" on:success="dsx.action.detailLanded()"/>
    <!-- the seam owns the token (<AuthSeam/> at the foot of this file); every authenticated
         read is gated on `global.auth.ok` and carries `global.auth.headers` — docs/auth.md -->
    <api as="wallet" url="/wallet/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWallet = global.auth.ok == true ? wallet.data : null"/>
    <api as="favs" url="/viewer/list" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheFavs = global.auth.ok == true ? favs.data : null"/>
    <api as="fav" url="/viewer/favorite" method="POST" auto="false" headers="global.auth.headers"/>
    <!-- the basket, priced by the server (one BULK_OFF, server-side) and re-quoted after a
         purchase so the offer can never advertise something already owned -->
    <api as="offer" url="/wallet/series/{{ vars.id }}" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers"/>
    <api as="buySeries" url="/wallet/unlockseries" method="POST" auto="false" headers="global.auth.headers"/>

    <variable as="favTouched">return ''</variable>
    <variable as="lastViewed">return ''</variable>   <!-- the show the funnel has reported -->
    <variable as="buyingSeries">return false</variable>
    <variable as="seriesToast">return ''</variable>

    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read walletView, never wallet.data, or the blank frame returns. -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read favsView, never favs.data, or the blank frame returns. -->
    <!-- stale-then-fresh, ID-GUARDED. The stash is the LAST show viewed, so it may
         belong to a different one: returning it blindly would paint show B's art and
         episode grid under show A's title for a frame — a worse lie than a blank. The
         guard means back-and-forth to the player is instant (same id) while a NEW show
         still shows its skeleton, which is honest: it is genuinely different content.
         (PLAN.md §6.30 — the api cache dies with the mount.) -->
    <variable as="detailView" computed="true">
      if (detail.data != null) { return detail.data }
      const cached = global.cacheShow
      if (cached == null || cached.show == null) { return null }
      return cached.show.id == vars.id ? cached : null
    </variable>
    <!-- signed in is the seam, and a viewer-scoped stash never survives the viewer -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <variable as="favsView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (favs.data != null) { return favs.data }
      return global.cacheFavs
    </variable>
    <variable as="walletView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (wallet.data != null) { return wallet.data }
      return global.cacheWallet
    </variable>
    <variable as="show" computed="true">
      if (dsx.variable.detailView == null) { return null }
      return dsx.variable.detailView.show
    </variable>
    <variable as="favOn" computed="true">
      if (dsx.variable.favTouched != '') { return dsx.variable.favTouched == 'y' }
      if (dsx.variable.favsView == null) { return false }
      return dsx.variable.favsView.items.filter(x => x.show == vars.id).length > 0
    </variable>
    <variable as="freeCount" computed="true">
      if (dsx.variable.detailView == null) { return 0 }
      return dsx.variable.detailView.episodes.filter(e => e.free).length
    </variable>
    <!-- `empty` is a real state here: Admin can publish a show before its first episode
         exists, and this screen then rendered a range that read "1 - 0" over a grid with
         nothing in it. A series with no episodes is not a broken page, so it says so and
         offers the way out rather than showing a Play button that cannot play. -->
    <variable as="phase" computed="true">
      if (detail.error != null) { return 'error' }
      if (dsx.variable.detailView == null) { return 'loading' }
      return dsx.variable.detailView.episodes.length == 0 ? 'empty' : 'content'
    </variable>

    <!-- the shared breakpoint vocabulary (see Components/App.dsx for the rationale) -->
    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="gutter" computed="true">return gutterOf(dsx.variable.bp)</variable>
    <!-- the stage is a real 9:16 portrait, capped by the viewport height (the reference
         runs 461×820 in a 900pt window) -->
    <variable as="stageW" computed="true">
      if (dsx.variable.bp == 'desktop') { return Math.round(Math.min(461, (dsx.screen.height - 150) * 9 / 16)) }
      if (dsx.variable.bp == 'tablet') { return 320 }
      return 220
    </variable>
    <variable as="stageH" computed="true">return Math.round(dsx.variable.stageW * 16 / 9)</variable>
    <variable as="stageArt" computed="true">
      const sh = dsx.variable.show
      if (sh == null) { return '' }
      if (sh.hero_tall == null || sh.hero_tall === '') { return sh.poster }
      return sh.hero_tall
    </variable>
    <variable as="epCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 6 }
      return 5
    </variable>
    <variable as="showViews" computed="true">
      const d = dsx.variable.detailView
      if (d == null || d.show == null || d.show.views == null || d.show.views < 1000) { return '' }
      const v = d.show.views
      return compactCount(v)
    </variable>
    <!-- The tags a show carries, each a real destination. `flow` wraps rather than scrolls:
         a title with six tags on a 416px panel must not hide three of them off-screen. -->
    <variable as="showTags" computed="true">
      const d = dsx.variable.detailView
      if (d == null || d.show == null || d.show.tags == null) { return [] }
      return d.show.tags.map(t => ({ name: t }))
    </variable>
    <!-- the offer is worth showing only when there is something to sell: a VIP, a fully
         unlocked series and a free-to-the-end series all return remaining 0 and the whole
         card stands down rather than advertising "unlock 0 episodes" -->
    <variable as="bulkLabel" computed="true">
      if (dsx.variable.buyingSeries) { return 'Unlocking…' }
      const o = offer.data
      return o == null ? 'Unlock the series' : 'Unlock for ' + o.price + ' coins'
    </variable>
    <variable as="bulkOn" computed="true">
      return offer.data != null && offer.data.remaining > 0
    </variable>
    <variable as="relCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 6 }
      if (dsx.variable.bp == 'tablet') { return 4 }
      return 3
    </variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 1440)</variable>
    <variable as="stageBox" computed="true">
      return 'width: ' + dsx.variable.stageW + 'px; height: ' + dsx.variable.stageH + 'px; border-radius: 12px; object-fit: cover'
    </variable>
    <variable as="stageOverlayBox" computed="true">
      return 'width: ' + dsx.variable.stageW + 'px; height: ' + dsx.variable.stageH + 'px; justify-content: flex-end; border-radius: 12px; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.85) 100%)'
    </variable>

    <formula as="epLocked" free="item.free" epid="item.id">
      if (free) { return false }
      if (dsx.variable.walletView == null) { return true }
      return !dsx.variable.walletView.unlocked.includes(epid)
    </formula>

    <!-- The canonical back (writing-an-app.md §5): POP when there is history, REPLACE
         when the screen was deep-linked, so a dismiss never teleports home and never
         stacks a second copy of where you came from. Back is never href — href pushes. -->
    <!-- the stash AND the funnel step, in one place. `on:success` used to hold the stash
         inline; the detail arriving is also the moment this screen was genuinely VIEWED
         (a mount alone is not — the router seeds a root frame under a deep link). -->
    <!-- THE EMIT SHELL (Components/parts/Analytics.dsx). Four lines, and they are copied
         rather than shared because a `<functions global="true">` body is the EXPRESSION
         tier: dsx.log, dsx.module.* and a global write are all silent no-ops there, measured
         (PLAN.md §6.94). The POLICY is not copied — analyticsBlocked and analyticsSink are
         pure expressions and live in that one file. -->
    <action as="track" inputs="name, props">
      if (analyticsBlocked()) { return }
      if (analyticsSink() != '') { dsx.module.posthog.capture({ event: name, properties: props }) }
      else { dsx.log('funnel', name, props) }
    </action>

    <action as="detailLanded">
      global.cacheShow = detail.data
      if (detail.data == null) { return }
      // ONCE PER SHOW. This block refetches (stale-then-fresh, §6.30) and every refetch is an
      // on:success, so an unguarded emit reports a second view for a screen the viewer never
      // left. The guard is the SHOW id, not a boolean: a route param change re-uses this
      // mount, and show B genuinely is a second view.
      if (dsx.variable.lastViewed == vars.id) { return }
      dsx.variable.lastViewed = vars.id
      dsx.action.track({ name: 'show_detail_viewed', props: { show: vars.id, episodes: detail.data.episodes.length, freeUntil: detail.data.show.free_until } })
    </action>
    <action as="buyWholeSeries">
      if (dsx.variable.buyingSeries) { return }
      // NO SIGN-IN GATE ON MONEY. Most revenue in this category never signs in, so a gate
      // here is a revenue bug wearing a safety costume. `auth="required"` verifies a TOKEN,
      // it does not ask who holds it — an anonymous session satisfies it unchanged, and the
      // subject Postgres derives from that token owns the purchase exactly as a named one
      // would. Sign-in is the UPSELL AFTER the purchase ("keep what you bought on another
      // device"), never the toll in front of it.
      dsx.variable.buyingSeries = true
      const quoted = offer.data == null ? 0 : offer.data.price
      dsx.action.track({ name: 'unlock_attempted', props: { show: vars.id, price: quoted, kind: 'series' } })
      const r = await buySeries.send({ show: vars.id })
      dsx.variable.buyingSeries = false
      if (r.ok !== true) {
        // a declared rejection lands on r.data.message; r.error is transport only (AGENTS.md)
        dsx.variable.seriesToast = r.data == null ? 'That did not go through.' : r.data.message
        return
      }
      dsx.action.track({ name: 'unlock_succeeded', props: { show: vars.id, spent: r.data.spent, episodes: r.data.unlocked, kind: 'series' } })
      dsx.variable.seriesToast = 'Unlocked ' + r.data.unlocked + ' episodes — saved ' + r.data.saved + ' coins'
      wallet.refresh()
      offer.refresh()
    </action>
    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/' }) }
    </action>
    <action as="toggleFav">
      if (dsx.variable.signedIn == false) {
        dsx.module.route.push({ path: '/auth/signin' })
        return
      }
      const r = await fav.send({ show: vars.id })
      if (r.ok) { dsx.variable.favTouched = r.data.favorite ? 'y' : 'n' }
    </action>

    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <style as="page" spacing="0" paddingBottom="40" alignItems="stretch"/>
    <style as="split" spacing="0" alignItems="flex-start" paddingTop="26"/>

    <style as="stageCol" alignItems="center" spacing="14"/>
    <style as="stageCap" spacing="6" alignItems="flex-start" paddingH="16" paddingBottom="16"/>
    <style as="stageEp" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="stageFree" fontSize="12" color="rgba(255,255,255,0.7)"/>

    <style as="panel" spacing="16" alignItems="stretch"/>
    <style as="crumbRow" spacing="7" alignItems="center"/>
    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.45)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="title" fontWeight="bold" color="rgba(255,255,255,0.9)" lineLimit="3" lineSpacing="6"/>
    <style as="plotHead" fontSize="16" color="rgba(255,255,255,0.9)"/>
    <style as="plotBody" fontSize="14" color="rgba(255,255,255,0.6)" lineSpacing="5"/>
    <style as="tagRow" spacing="8" alignItems="center"/>
    <style as="relSection" spacing="12" alignItems="stretch" paddingTop="10"/>
    <style as="sectionTitle" fontSize="17" fontWeight="bold" color="#FFFFFF" tracking="-0.2"/>
    <style as="relCard" spacing="6" alignItems="stretch"/>
    <style as="relTitle" fontSize="13" color="rgba(255,255,255,0.85)" lineLimit="1"/>
    <style as="metaRow" spacing="6" alignItems="center" paddingTop="2"/>
    <style as="metaTxt" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.6)"/>
    <style as="bulkCard" background="#1C1C1E" radius="14" spacing="10" paddingH="16" paddingV="14" alignItems="stretch"/>
    <style as="bulkTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF" lineLimit="2"/>
    <style as="bulkWas" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="bulkBtn" background="#F6B63D" radius="22" paddingH="18" paddingV="11" fontSize="14" fontWeight="bold" color="#3A2A08"/>
    <style as="bulkReceipt" background="#1C1C1E" radius="10" spacing="8" alignItems="center" paddingH="14" paddingV="10"/>
    <style as="bulkNote" fontSize="12" color="rgba(255,255,255,0.6)"/>
    <style as="tagFlow" alignItems="flex-start"/>
    <style as="tagSoft" background="rgba(255,233,168,0.10)" radius="4" paddingH="10" paddingV="5" fontSize="13" color="#FFE9A8"/>
    <style as="tag" background="rgba(255,255,255,0.1)" radius="16" paddingH="16" paddingV="7" fontSize="14" color="rgba(255,255,255,0.7)"/>
    <style as="ctaRow" spacing="12" alignItems="center"/>
    <style as="playWhite" background="#FFFFFF" radius="24" paddingH="34" paddingV="13" spacing="9" alignItems="center"/>
    <style as="playLabel" fontSize="15" fontWeight="bold" color="#111111"/>
    <style as="favBtn" background="rgba(255,255,255,0.1)" radius="24" paddingH="18" paddingV="13" spacing="8" alignItems="center"/>
    <style as="favLabel" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>

    <style as="statRow" spacing="30" alignItems="center" paddingV="12"/>
    <style as="statCol" spacing="5" alignItems="center"/>
    <style as="statCap" fontSize="12" color="rgba(255,255,255,0.6)"/>

    <style as="gridHead" alignItems="center" paddingTop="4"/>
    <style as="gridRange" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="gridAllRow" spacing="4" alignItems="center"/>
    <style as="gridAll" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="epCell" radius="8" alignItems="center" height="46" background="rgba(255,255,255,0.1)"/>
    <style as="epNum" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="skeleton" background="#141419" radius="12"/>
    <style as="section" spacing="14" alignItems="stretch"/>
    <style as="errCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="20" alignItems="center"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="backBtn" background="rgba(255,255,255,0.1)" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="phoneBar" spacing="12" alignItems="center" paddingV="12"/>
    <style as="phoneBarTitle" fontSize="16" fontWeight="semibold" color="#FFFFFF"/>
    <style as="phoneHero" spacing="16" alignItems="flex-start"/>
    <style as="phoneMeta" spacing="10" alignItems="flex-start"/>
  </head>

  <!-- the design vocabulary (breakpoints, gutters, shells, palette) registers here.
       FIRST CHILD, always: the block registers on instantiate, and this screen reads its
       own `wide` computed on the very next line. See Components/parts/Theme.dsx. -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx). The mount is what fires app_open,
       once per session however many screens mount it. -->
  <Analytics/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">

      <TopNav active="" visible-if="dsx.variable.wide"/>

      <vstack class="section" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.phase == 'empty'" paddingTop="26">
        <vstack class="errCard">
          <image icon="rectangle.stack.fill" iconSize="30" color="rgba(255,255,255,0.35)" a11yHidden="true"/>
          <text value="{{ show == null ? 'This series' : show.title }} has no episodes yet." fontSize="14" color="#FFFFFF"/>
          <text value="It is published but nothing has gone live on it." class="gridAll" textAlign="center"/>
          <hstack spacing="10" alignItems="center">
            <button label="Browse series" class="retryBtn" on:tap="dsx.module.route.reset({ path: '/browse' })"/>
            <button label="Back" class="backBtn" on:tap="dsx.action.goBack()"/>
          </hstack>
        </vstack>
      </vstack>

      <vstack class="section" style="{{ dsx.variable.shell }}" visible-if="dsx.variable.phase == 'error'" paddingTop="26">
        <vstack class="errCard">
          <text value="This series could not be loaded." fontSize="14" color="#FFFFFF"/>
          <text value="The link may be stale, or the catalogue is briefly unavailable." class="gridAll" textAlign="center"/>
          <hstack spacing="10" alignItems="center">
            <button label="Retry" class="retryBtn" on:tap="detail.refresh()"/>
            <button label="Back" class="backBtn" on:tap="dsx.action.goBack()"/>
          </hstack>
        </vstack>
      </vstack>

      <!-- the split (stage | panel) is the WIDE layout; the phone block below carries the
           whole story on its own, so this row mounts only wide -->
      <hstack class="split" style="{{ dsx.variable.shell }}" alignItems="flex-start"
              visible-if="dsx.variable.wide && dsx.variable.phase != 'error' && dsx.variable.phase != 'empty'">

        <!-- ===== the key-art stage (left) ===== -->
        <vstack class="stageCol" style="flex: 1; min-width: 0">
          <!-- while the detail loads, the stage is its own silhouette — an <image src="">
               is a broken-image glyph in a 461x820 frame -->
          <stack class="skeleton" visible-if="show == null"
                 style="width: {{ dsx.variable.stageW }}px; height: {{ dsx.variable.stageH }}px"/>
          <!-- THE STAGE IS 9:16 AND THE POSTER IS 3:4, so `cover` cropped a quarter of the
               width — and the poster BAKES its title, so what the reader saw was
               "y Cold Campus Prince" (measured: a 422x750 frame around 360x480 art). The
               generator's own header records this class of bug being fixed once already
               when the poster was 2:3 in a 3:4 frame.
               `hero_tall` is the asset authored for exactly this: no baked type, subject in
               the upper third, so a crop takes background and nothing else. The title is
               real text in the panel beside it, where it is selectable and reachable by a
               screen reader. `poster` remains the fallback for a row seeded before the
               tall art existed. -->
          <zstack visible-if="show != null">
            <image src="{{ dsx.variable.stageArt }}" contentFit="cover" a11yHidden="true"
                   shared="poster-{{ vars.id }}" sharedMode="clip" style="{{ dsx.variable.stageBox }}"/>
            <vstack style="{{ dsx.variable.stageOverlayBox }}">
              <vstack class="stageCap">
                <text value="EP 1 — {{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.episodes.length }} episodes" class="stageEp"/>
                <text value="EP 1–{{ show == null ? '' : show.free_until }} free to watch" class="stageFree"/>
              </vstack>
            </vstack>
          </zstack>
          <hstack class="playWhite" a11yGroup="true" a11yTrait="button" a11yLabel="Play episode 1"
                  on:tap="dsx.module.route.push({ path: '/watch/' + vars.id + '/1' })">
            <image icon="play.fill" iconSize="14" color="#111111" a11yHidden="true"/>
            <text value="Play EP 1" class="playLabel"/>
          </hstack>
        </vstack>

        <!-- ===== the detail panel + EPISODE GRID (right) ===== -->
        <vstack class="panel" style="width: 456px; min-width: 456px; padding-left: 40px">
          <!-- back POPS (goBack: pop-or-replace); an href here would push a second Home
               under every tap — the exact trap the comment above goBack names -->
          <hstack class="crumbRow">
            <text value="Home" class="crumb" on:tap="dsx.action.goBack()" a11yTrait="button" a11yLabel="Back to Home"/>
            <text value="/" class="crumb"/>
            <text value="{{ show == null ? '' : show.title }}" class="crumbOn" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px"/>
          </hstack>

          <text value="{{ show == null ? '' : show.title }}" class="title" fontSize="20"
                style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden"/>

          <vstack spacing="8" alignItems="flex-start">
            <text value="Plot" class="plotHead"/>
            <text value="{{ show == null ? '' : show.synopsis }}" class="plotBody"/>
          </vstack>

          <hstack class="tagRow">
            <text value="{{ show == null ? '' : show.genre }}" class="tag" a11yTrait="button"
                  a11yLabel="Browse all {{ show == null ? '' : show.genre }} series"
                  href="/browse/{{ show == null ? '' : show.genre }}"/>
            <text value="EP 1–{{ show == null ? '' : show.free_until }} Free" class="tag"/>
          </hstack>
          <flow class="tagFlow" bind="dsx.variable.showTags" key="name" spacing="8" lineSpacing="8"
                visible-if="dsx.variable.showTags.length > 0">
            <text value="{{ item.name }}" class="tagSoft" a11yTrait="button"
                  a11yLabel="Browse {{ item.name }}" href="/browse/{{ item.name }}"/>
          </flow>

          <hstack class="metaRow" visible-if="dsx.variable.showViews != ''">
            <image icon="play.fill" iconSize="13" color="rgba(255,255,255,0.5)" a11yHidden="true"/>
            <text value="{{ dsx.variable.showViews }}" class="metaTxt"
                  a11yLabel="{{ dsx.variable.showViews }} views"/>
            <text value="·" class="metaTxt" a11yHidden="true"/>
            <image icon="star.fill" iconSize="12" color="{{ gold() }}" a11yHidden="true"/>
            <text value="{{ show == null ? '' : show.rating }}" class="metaTxt"
                  a11yLabel="rated {{ show == null ? '' : show.rating }} out of 10"/>
          </hstack>


          <!-- THE SERIES BASKET. Both leaders sell this and it is the biggest single
               decision in the funnel, so every number on it comes from the server's own
               quote (`/wallet/series/:id`) rather than a client-side sum with a second copy
               of the discount rate. The button states its price; the toast reports what the
               server actually charged. -->
          <vstack class="bulkCard" visible-if="dsx.variable.bulkOn">
            <hstack spacing="10" alignItems="center">
              <image icon="lock.open.fill" iconSize="16" color="{{ gold() }}" a11yHidden="true"/>
              <vstack spacing="2" style="flex: 1; min-width: 0">
                <text value="Unlock all {{ offer.data == null ? '' : offer.data.remaining }} remaining episodes" class="bulkTitle"/>
                <text value="{{ offer.data == null ? '' : offer.data.listPrice }} coins  ·  save {{ offer.data == null ? '' : offer.data.off }}%" class="bulkWas"/>
              </vstack>
            </hstack>
            <button label="{{ dsx.variable.bulkLabel }}"
                    class="bulkBtn" on:tap="dsx.action.buyWholeSeries()"
                    a11yLabel="Unlock all remaining episodes for {{ offer.data == null ? '' : offer.data.price }} coins"/>
            <text value="Not enough coins — top up in the Store" class="bulkNote"
                  visible-if="offer.data != null && offer.data.affordable == false"/>
          </vstack>

          <!-- the receipt OUTSIDE the card: once the last episode is bought the card stands
               down (nothing left to sell), and a confirmation nested inside it would vanish
               in the same frame — the viewer would see 448 coins leave and be told nothing -->
          <hstack class="bulkReceipt" visible-if="dsx.variable.seriesToast != ''">
            <image icon="checkmark" iconSize="14" color="{{ gold() }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.seriesToast }}" class="bulkNote"/>
          </hstack>
          <hstack class="ctaRow">
            <hstack class="favBtn" on:tap="dsx.action.toggleFav()" a11yGroup="true" a11yTrait="button" a11yLabel="Toggle My List">
              <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="17"
                     color="{{ dsx.variable.favOn ? brand() : '#FFFFFF' }}" a11yHidden="true"/>
              <text value="{{ dsx.variable.favOn ? 'Saved' : 'My List' }}" class="favLabel"/>
            </hstack>
            <hstack class="favBtn" on:tap="dsx.module.route.push({ path: '/store' })"
                    a11yGroup="true" a11yTrait="button" a11yLabel="Your coins — get more in the store">
              <image icon="dollarsign.circle.fill" iconSize="17" color="{{ gold() }}" a11yHidden="true"/>
              <text value="{{ dsx.variable.walletView == null ? 0 : dsx.variable.walletView.coins + dsx.variable.walletView.bonus }}" class="favLabel"/>
            </hstack>
          </hstack>

          <!-- ══ TWO BIDI FIXES, BOTH MEASURED IN ARABIC BEFORE THEY WERE BELIEVED ══
               (1) THE RANGE LOST ITS SPACES. `1 - {{ n }}` is a number, a NEUTRAL run and
               another number; inside an RTL paragraph the Unicode bidi algorithm gives the
               spaced hyphen the paragraph level and the two numbers swap. Measured with a
               per-character Range sweep at 390px: logical "1 - 19" rendered "19 - 1" — a
               backwards range, wrong rather than merely odd. `1-19` keeps the digits in one
               run and renders "1-19"; the drawer's own range pills have always spelled it
               that way (`start + '-' + end`), so this is the outlier conforming.
               (2) THE COUNT AND ITS WORD BECAME TWO CHILDREN. `{{ n }} free` renders
               "free 5" in Arabic (a leading number takes the paragraph's RTL level), and
               it was untranslatable anyway — an interpolated composite never reaches the
               string seam. As an hstack the number is one child and "free" is a static key
               the seam DOES reach, the row mirrors like any other, and an Arabic reader
               gets "5 مجانية" reading right to left. -->
          <hstack class="gridHead" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px">
            <text value="1-{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.episodes.length }}" class="gridRange"/>
            <spacer/>
            <hstack class="gridAllRow">
              <text value="{{ dsx.variable.freeCount }}" class="gridAll"/>
              <text value="free" class="gridAll"/>
            </hstack>
          </hstack>

          <stack class="skeleton" visible-if="detail.loading" style="height: 160px"/>
          <grid bind="dsx.variable.detailView.episodes" key="id" columns="{{ dsx.variable.epCols }}" spacing="6" scroll="false">
            <vstack class="epCell" style="position: relative; justify-content: center" href="/watch/{{ vars.id }}/{{ item.idx }}"
                    a11yLabel="Episode {{ item.idx }}{{ epLocked ? ', locked' : '' }}">
              <text value="{{ item.idx }}" class="epNum"/>
              <image icon="lock.fill" iconSize="8" color="rgba(255,255,255,0.55)" visible-if="epLocked"
                     a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
            </vstack>
          </grid>
        </vstack>
      </hstack>

      <!-- ===== phone: back bar · compact hero (art + facts + Play) · plot · grid ===== -->
      <vstack style="{{ dsx.variable.shell }}" spacing="16" alignItems="stretch"
              visible-if="dsx.variable.wide == false && dsx.variable.phase != 'error' && dsx.variable.phase != 'empty'">
        <!-- a deep-linked phone has no TopNav: the back bar is the only way out -->
        <hstack class="phoneBar">
          <image icon="{{ chevBack() }}" iconSize="20" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button"/>
          <text value="{{ show == null ? 'Details' : show.title }}" class="phoneBarTitle"
                style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0"/>
        </hstack>

        <vstack spacing="16" alignItems="stretch" visible-if="dsx.variable.phase == 'loading'">
          <Skeleton height="165" radius="12"/>
          <Skeleton height="46" radius="8"/>
          <Skeleton height="120" radius="8"/>
        </vstack>

        <vstack spacing="18" alignItems="stretch" visible-if="dsx.variable.phase == 'content'">
          <hstack class="phoneHero">
            <image src="{{ show == null ? '' : show.poster }}" contentFit="cover" a11yHidden="true"
                   style="width: 110px; height: 147px; border-radius: 10px; object-fit: cover"/>
            <vstack class="phoneMeta" style="flex: 1; min-width: 0">
              <text value="{{ show == null ? '' : show.title }}" class="title" fontSize="20"
                    style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
              <hstack class="tagRow">
                <text value="{{ show == null ? '' : show.genre }}" class="tag" a11yTrait="button"
                  a11yLabel="Browse all {{ show == null ? '' : show.genre }} series"
                  href="/browse/{{ show == null ? '' : show.genre }}"/>
                <text value="EP 1–{{ show == null ? '' : show.free_until }} Free" class="tag"/>
              </hstack>
              <hstack class="playWhite" style="padding-left: 24px; padding-right: 24px" a11yGroup="true" a11yTrait="button"
                      a11yLabel="Play episode 1"
                      on:tap="dsx.module.route.push({ path: '/watch/' + vars.id + '/1' })">
                <image icon="play.fill" iconSize="13" color="#111111" a11yHidden="true"/>
                <text value="Play EP 1" class="playLabel"/>
              </hstack>
            </vstack>
          </hstack>
          <text value="{{ show == null ? '' : show.synopsis }}" class="plotBody"/>
          <hstack class="gridHead" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px">
            <text value="1-{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.episodes.length }}" class="gridRange"/>
            <spacer/>
            <hstack class="gridAllRow">
              <text value="{{ dsx.variable.freeCount }}" class="gridAll"/>
              <text value="free" class="gridAll"/>
            </hstack>
          </hstack>
          <!-- the cell is the grid's DIRECT child (a wrapper loses the column width); this
               grid is deliberately DUPLICATED from the wide panel — an inline <component>
               does not render on web yet (PLAN.md §6.12), so the two copies stay in sync
               by hand until file-component extraction is worth its own state plumbing -->
          <grid bind="dsx.variable.detailView.episodes" key="id" columns="{{ dsx.variable.epCols }}" spacing="6" scroll="false">
            <vstack class="epCell" style="position: relative; justify-content: center" href="/watch/{{ vars.id }}/{{ item.idx }}"
                    a11yLabel="Episode {{ item.idx }}{{ epLocked ? ', locked' : '' }}">
              <text value="{{ item.idx }}" class="epNum"/>
              <image icon="lock.fill" iconSize="8" color="rgba(255,255,255,0.55)" visible-if="epLocked"
                     a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
            </vstack>
          </grid>
        </vstack>
      </vstack>

      <!-- MORE LIKE THIS — the rail both category leaders put under the episode grid
           ("You Might Like" on ReelShort, "Related" on DramaBox). It is what turns a
           finished series into the next one instead of a dead end, and it is the only
           place on this screen that answers "what now?". Same-genre neighbours, this show
           excluded, served by the detail route itself (no second request). The rail hides
           entirely when there is nothing to show rather than printing an empty heading. -->
      <vstack class="relSection" style="{{ dsx.variable.shell }}"
              visible-if="dsx.variable.detailView != null && dsx.variable.detailView.related != null && dsx.variable.detailView.related.length > 0">
        <text value="More like this" class="sectionTitle"/>
        <grid bind="dsx.variable.detailView.related" key="id" columns="{{ dsx.variable.relCols }}" spacing="12" scroll="false">
          <vstack class="relCard" href="/show/{{ item.id }}"
                  a11yGroup="true" a11yLabel="{{ item.title }}">
            <image src="{{ item.poster }}" contentFit="cover" a11yHidden="true"
                   style="width: 100%; aspect-ratio: 3/4; border-radius: 8px; object-fit: cover"/>
            <text value="{{ item.title }}" class="relTitle"
                  style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"/>
          </vstack>
        </grid>
      </vstack>

    </vstack>
  </scroll>
  <!-- NO TAB BAR: /show/:id is a PUSHED route, and on the phone lane a push TRANSFORMS the
       whole frame — global chrome inside it would slide in with the page, which is exactly
       what a global bar must never do. A pushed screen is therefore full-bleed with a back
       affordance (UIKit calls this hidesBottomBarWhenPushed; every reference short-drama app
       agrees). The tab roots keep their bar and swap instantly, so it never moves there
       either. Wide viewports crossfade instead of pushing, so <TopNav> — painted identically
       by both frames over an opaque under-frame — composites STILL (PLAN.md §6.26). -->
  <!-- THE SEAM. One mount per screen, at the foot of the root; its sheet portals out of
       the layout, so a zero-height child here cannot disturb any chrome. -->
  <AuthSeam/>
</vstack>
