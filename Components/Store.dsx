<!-- Store — the SELL lane, on its own route so it is a destination a CTA can point at
     (and a modal the player can raise mid-paywall), separate from /rewards which is the
     EARN lane. Two lanes, two surfaces: this is how the category ships it.

     THE MONEY IS ONE CONTROL, ON EVERY LANE. Tapping a pack SELECTS it; <BuyButton>
     (Components/parts/BuyButton.dsx) buys the selection — Core/Store through the RevenueCat
     provider inside an iOS or Android build (App Store 3.1.1: coins are an in-app-purchase
     product), the Stripe sheet on the web storefront — and the server grants on both lanes
     (server/store.dsx). On a device the price shown is the STORE's localized string for the
     pack's product id (`store.catalog`); the server's list price is the web's answer. This
     screen owns no checkout, no settle, no recovery card and no refusal of its own any more:
     the control carries all four, once, for the coin store and the Membership page alike.
     The VIP section is a door to that page (Components/Membership.dsx). -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <expects variable="nav"/>

    <!-- the seam owns the token (<AuthSeam/> at the foot of this file); every authenticated
         read is gated on `global.auth.ok` and carries `global.auth.headers` — docs/auth.md -->
    <api as="catalog" url="/store/catalog" on:success="dsx.action.catalogLanded()"/>
    <api as="wallet" url="/wallet/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWallet = global.auth.ok == true ? wallet.data : null"/>

    <variable as="toast">return ''</variable>
    <variable as="sel">return ''</variable>        <!-- the tapped pack; empty = the first row -->
    <variable as="prices">return {}</variable>     <!-- productId -> localized price, from the store -->
    <variable as="hovId">return ''</variable>

    <!-- signed in is the seam, not the presence of a fetched JSON file (docs/auth.md) -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <variable as="authKnown" computed="true">return global.auth != null &amp;&amp; global.auth.state != null</variable>
    <variable as="signedOut" computed="true">
      return dsx.variable.authKnown &amp;&amp; dsx.variable.signedIn == false
    </variable>
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read catalogView, never catalog.data, or the blank frame returns. -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read walletView, never wallet.data, or the blank frame returns. -->
    <!-- viewer-scoped stash: a signed-out frame must not read the last balance out of
         the app-wide store (docs/auth.md) -->
    <variable as="walletView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (wallet.data != null) { return wallet.data }
      return global.cacheWallet
    </variable>
    <variable as="catalogView" computed="true">
      if (catalog.data != null) { return catalog.data }
      return global.cacheCatalog
    </variable>
    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="gutter" computed="true">return gutterOf(dsx.variable.bp)</variable>
    <variable as="vipCols" computed="true">return dsx.variable.bp == 'phone' ? 1 : 3</variable>
    <variable as="packCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 3 }
      if (dsx.variable.bp == 'tablet') { return 3 }
      return 2
    </variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 1100)</variable>
    <variable as="balance" computed="true">
      if (dsx.variable.walletView == null) { return 0 }
      return dsx.variable.walletView.coins + dsx.variable.walletView.bonus
    </variable>
    <variable as="isVip" computed="true">
      if (dsx.variable.walletView == null) { return false }
      return dsx.variable.walletView.vip === true
    </variable>
    <!-- one phase per data source: the catalogue is the screen's content -->
    <variable as="phase" computed="true">
      if (catalog.error != null) { return 'error' }
      if (dsx.variable.catalogView == null) { return 'loading' }
      return 'content'
    </variable>
    <!-- ── the selection ── the first pack is selected until a tap says otherwise, exactly
         as the Membership page treats its plans -->
    <variable as="packs" computed="true">
      const c = dsx.variable.catalogView
      if (c == null || c.packs == null) { return [] }
      return c.packs
    </variable>
    <variable as="selId" computed="true">
      if (dsx.variable.sel != '') { return dsx.variable.sel }
      const p = dsx.variable.packs
      if (p.length == 0) { return '' }
      return p[0].id
    </variable>
    <variable as="selPack" computed="true">
      for (const p of dsx.variable.packs) { if (p.id == dsx.variable.selId) { return p } }
      return null
    </variable>
    <variable as="selProductId" computed="true">
      const p = dsx.variable.selPack
      if (p == null) { return '' }
      return p.productId == null ? p.id : p.productId
    </variable>
    <variable as="selPrice" computed="true">
      const p = dsx.variable.selPack
      if (p == null) { return '' }
      const m = dsx.variable.prices
      const pid = p.productId == null ? p.id : p.productId
      if (m != null &amp;&amp; m[pid] != null) { return m[pid] }
      return p.price
    </variable>
    <!-- the verb goes through localize() so the string table reaches a component attribute -->
    <variable as="ctaLabel" computed="true">return localize('Buy for')</variable>
    <!-- the cheapest pass the catalogue sent, for the door to the Membership page -->
    <variable as="fromPrice" computed="true">
      const c = dsx.variable.catalogView
      if (c == null || c.vip == null || c.vip.length == 0) { return '' }
      let low = c.vip[0]
      for (const t of c.vip) { if (t.cents < low.cents) { low = t } }
      return low.price
    </variable>

    <!-- the card's whole look is ONE computed string (a bare {{ }} fragment beside other
         declarations is discarded — AGENTS.md); the SELECTED pack wears the select-green ring
         the Membership page's cards wear, and a pointer device gets the hover lift -->
    <formula as="packCardFx" id="item.id">
      const lift = dsx.variable.hovId == ('p-' + id) ? 'translateY(-2px)' : 'none'
      const ring = dsx.variable.selId == id ? planSelected() : 'rgba(0,0,0,0)'
      return 'border: 1.5px solid ' + ring + '; transform: ' + lift + '; transition: transform 0.18s ease, border-color 0.15s ease'
    </formula>
    <formula as="packRing" id="item.id">
      return dsx.variable.selId == id ? planSelected() : 'rgba(0,0,0,0)'
    </formula>
    <!-- the price a pack displays: the store's localized string when the build asked one,
         else the server's list price (read by BARE NAME inside the repeater) -->
    <formula as="packPrice" pid="item.productId" listed="item.price">
      const m = dsx.variable.prices
      if (m != null &amp;&amp; pid != null &amp;&amp; m[pid] != null) { return m[pid] }
      return listed
    </formula>

    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/' }) }
    </action>

    <action as="pick" id="id">
      dsx.variable.sel = id
    </action>
    <!-- the catalogue landed: stash it app-wide (one key per ENDPOINT), then ask the store
         for the localized prices of the packs it names -->
    <action as="catalogLanded">
      global.cacheCatalog = catalog.data
      dsx.action.loadPrices()
    </action>
    <action as="loadPrices">
      if (!has('store')) { return }
      const packs = dsx.variable.packs
      if (packs.length == 0) { return }
      const ids = []
      for (const row of packs) { ids.push(row.productId == null ? row.id : row.productId) }
      const r = await dsx.module.store.catalog({ provider: 'revenuecat', product: ids })
      if (r == null || r.ok === false || r.products == null) { return }
      const map = {}
      for (const p of r.products) {
        if (p.id != null && p.price != null && p.price.formatted != null) { map[p.id] = p.price.formatted }
      }
      dsx.variable.prices = map
    </action>
    <!-- the grant landed (server-side, on either lane): the wallet re-reads and the toast
         names the coins — a number the SERVER answered with, never the row's promise -->
    <action as="bought" kind="kind" coins="coins" days="days">
      wallet.refresh()
      if (coins != null) { dsx.variable.toast = 'Added ' + coins + ' coins' }
      else { dsx.variable.toast = 'This purchase was already applied.' }
    </action>
    <action as="buyFailed" message="message">
      dsx.variable.toast = message
    </action>

    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <!-- NO paddingTop on `page`: <TopNav> is the first child, so a padded page pushes the
         GLOBAL BAR down — measured at 16px here against 0 everywhere else, which made the
         bar visibly drop when a route change crossfaded Home into Store. The spacing the
         page wanted belongs BELOW the bar, on the content (12 + 16 = 28), which leaves the
         phone lane — where no bar renders — pixel-identical. -->
    <style as="page" spacing="0" paddingBottom="32" alignItems="stretch"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="32"/>

    <style as="head" alignItems="center" spacing="12"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="balancePill" background="rgba(255,255,255,0.08)" radius="16" paddingH="12" paddingV="8" spacing="6" alignItems="center"/>
    <style as="balanceNum" fontSize="14" fontWeight="semibold" color="#F6B63D"/>
    <style as="vipChip" background="#F6B63D" radius="10" paddingH="8" paddingV="4" fontSize="11" fontWeight="bold" color="#2A1D04"/>
    <style as="toastRow" background="rgba(246,182,61,0.12)" radius="10" paddingH="12" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="14" fontWeight="medium" color="#F6B63D" lineSpacing="4"/>
    <style as="sectionTitle" fontSize="24" fontWeight="bold" color="rgba(255,255,255,0.8)" tracking="-0.3"/>
    <style as="sectionNote" fontSize="13" color="rgba(255,255,255,0.45)"/>

    <style as="packCard" background="#141419" radius="12" paddingH="16" paddingV="16" spacing="8" alignItems="flex-start"/>
    <style as="packCoins" fontSize="20" fontWeight="bold" color="#FFFFFF"/>
    <style as="packLine" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="packPrice" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="packBonus" background="#FF2C55" radius="4" paddingH="6" paddingV="2" fontSize="11" fontWeight="bold" color="#FFFFFF"/>
    <style as="coinRow" spacing="6" alignItems="center"/>

    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>

    <style as="errCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="20" alignItems="center"/>

    <style as="earnCard" background="#141419" radius="14" paddingH="16" paddingV="16" spacing="12" alignItems="stretch"/>
    <style as="earnTitle" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="earnNote" fontSize="13" color="rgba(255,255,255,0.5)" lineSpacing="3"/>
    <style as="earnCta" background="rgba(255,255,255,0.1)" radius="24" paddingV="14" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <!-- the door to the plans: the membership CTA's own gold (spec 6), 52 tall, radius 14 -->
    <style as="planDoor" background="#F5D33D" radius="14" minHeight="52" paddingH="16" paddingV="12" spacing="12" alignItems="center"/>
    <style as="planDoorTitle" fontSize="17" fontWeight="bold" color="#000000"/>
    <style as="planDoorNote" fontSize="13" color="#3A2A08"/>
  </head>

  <!-- the design vocabulary (breakpoints, gutters, shells, palette) registers here.
       FIRST CHILD, always: the block registers on instantiate, and this screen reads its
       own `wide` computed on the very next line. See Components/parts/Theme.dsx. -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx). The mount is what fires app_open,
       once per session however many screens mount it. -->
  <Analytics/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">
      <TopNav active="store" visible-if="dsx.variable.wide"/>

      <vstack style="{{ dsx.variable.shell }}" alignItems="stretch" paddingTop="28">
        <hstack class="head">
          <!-- /store is a PUSHED route on every width (motion: ios), so the back control
               exists on every width too — a desktop viewer mid-paywall deserves the same
               way out as a phone -->
          <image icon="chevron.backward" iconSize="20" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button"/>
          <text value="Store" class="h1"/>
          <text value="VIP" class="vipChip" visible-if="dsx.variable.isVip"/>
          <spacer/>
          <hstack class="balancePill" visible-if="dsx.variable.walletView != null">
            <image icon="dollarsign.circle.fill" iconSize="15" color="{{ gold() }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }}" class="balanceNum"/>
          </hstack>
        </hstack>

        <!-- a toast the viewer can dismiss; a new action overwrites it -->

        <!-- A GUEST STILL SEES THE PRICES — hiding the shop from someone who has not signed
             in is the fastest way to lose them — but the screen says what buying needs, once,
             before they tap. The card is the same one every screen uses. -->
        <!-- purchases work for a device (a subject, not a login); linking keeps the coins on an
             account so they follow the viewer to another device -->
        <LinkPrompt style="margin-top: 12px"
                    icon="dollarsign.circle.fill"
                    title="Keep your coins on your account"
                    note="Browse the packs and plans freely. Signing in is what gives coins and VIP somewhere to live, so they are still yours on your next device."/>

      </vstack>

      <!-- loading: the shapes the content will land in, so arrival is a repaint -->
      <vstack class="section" visible-if="dsx.variable.phase == 'loading'">
        <vstack style="{{ dsx.variable.shell }}" spacing="14" alignItems="stretch">
          <Skeleton height="28" radius="8"/>
          <Skeleton height="132" radius="14"/>
          <Skeleton height="132" radius="14"/>
        </vstack>
      </vstack>

      <vstack class="section" visible-if="dsx.variable.phase == 'error'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="errCard">
            <text value="The store is unavailable." fontSize="14" color="#FFFFFF"/>
            <text value="Your coins and VIP are safe — this is only the price list failing to load." class="sectionNote" textAlign="center"/>
            <button label="Retry" class="retryBtn" on:tap="catalog.refresh()"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- VIP — the plans live on the Membership page (Components/Membership.dsx, spec 6),
           at the destination every crown in the app reads from Theme.dsx membershipPath() -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" spacing="4" alignItems="flex-start">
          <text value="VIP — unlock every series" class="sectionTitle"/>
          <text value="Unlimited viewing for the length of the pass. One charge, no auto-renewal." class="sectionNote"/>
        </vstack>
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <hstack class="planDoor" on:tap="dsx.module.route.push({ path: membershipPath() })"
                  a11yGroup="true" a11yTrait="button" a11yLabel="See the membership plans">
            <image icon="crown.fill" iconSize="22" color="#000000" a11yHidden="true"/>
            <vstack spacing="2" grow="width" style="flex: 1; min-width: 0" alignItems="stretch">
              <text value="{{ dsx.variable.isVip ? 'Add days to your pass' : 'See the plans' }}" class="planDoorTitle"/>
              <hstack spacing="4" alignItems="center" visible-if="dsx.variable.fromPrice != ''">
                <text value="From" class="planDoorNote"/>
                <text value="{{ dsx.variable.fromPrice }}" class="planDoorNote"/>
              </hstack>
            </vstack>
            <image icon="chevron.forward" iconSize="14" color="#000000" a11yHidden="true"/>
          </hstack>
        </vstack>
      </vstack>

      <!-- coin packs -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" spacing="4" alignItems="flex-start">
          <text value="Top up coins" class="sectionTitle"/>
          <text value="Coins unlock individual episodes. Bonus coins are spent first." class="sectionNote"/>
        </vstack>
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <grid bind="dsx.variable.catalogView.packs" key="id" columns="{{ dsx.variable.packCols }}" spacing="12" scroll="false">
            <vstack class="packCard" on:tap="dsx.action.pick()" a11yGroup="true" a11yTrait="button"
                    on:hoverStart="dsx.variable.hovId = 'p-' + item.id" on:hoverEnd="dsx.variable.hovId = ''"
                    borderWidth="1.5" borderColor="{{ packRing }}"
                    a11yLabel="Select {{ item.coins }} coins plus {{ item.free }} bonus, {{ item.price }}"
                    style="{{ packCardFx }}">
              <hstack spacing="8" alignItems="center" style="width: 100%">
                <hstack class="coinRow">
                  <image icon="dollarsign.circle.fill" iconSize="17" color="{{ gold() }}" a11yHidden="true"/>
                  <text value="{{ item.coins + item.free }}" class="packCoins"/>
                </hstack>
                <spacer/>
                <text value="{{ item.bonus }}" class="packBonus"/>
              </hstack>
              <text value="{{ item.coins }} coins + {{ item.free }} bonus" class="packLine"/>
              <text value="{{ packPrice }}" class="packPrice"/>
            </vstack>
          </grid>
          <!-- THE PURCHASE: one control, both lanes, the server grants (BuyButton.dsx) -->
          <BuyButton sku="{{ dsx.variable.selId }}" productId="{{ dsx.variable.selProductId }}" kind="coins"
                     label="{{ dsx.variable.ctaLabel }}" price="{{ dsx.variable.selPrice }}" variant="brand" surface="store"
                     on:purchased="dsx.action.bought()" on:failed="dsx.action.buyFailed()"/>
        </vstack>
      </vstack>

      <!-- RESTORE PURCHASES — App Store 3.1.1 wants it on the surface that sells, and
           <RestoreRow> calls the real routes: POST /store/restore walks this account's
           unsettled Stripe orders and grants the ones that were actually paid, and on a
           build with the store module POST /store/restore/native asks RevenueCat the same
           question about the platform store. That is the money a viewer cannot otherwise
           reach — charged while the app was closed between the payment sheet and the settle
           call. Neither route asks who the caller is; both need a subject, not a login. -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="earnCard">
            <RestoreRow on:restored="wallet.refresh()"/>
            <LegalLinks variant="line"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- the door to the EARN lane, which lives on its own screen -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="earnCard">
            <text value="Don't want to pay?" class="earnTitle"/>
            <text value="Check in daily, spin the wheel, watch a short ad or finish tasks — every one of them pays in coins." class="earnNote"/>
            <button label="Earn free coins" class="earnCta"
                    on:tap="dsx.module.route.reset({ path: '/rewards' })"/>
          </vstack>
        </vstack>
      </vstack>

    </vstack>
  </scroll>
  <!-- NO TAB BAR: /store is a PUSHED route, and on the phone lane a push TRANSFORMS the
       whole frame — global chrome inside it would slide in with the page, which is exactly
       what a global bar must never do. A pushed screen is therefore full-bleed with a back
       affordance (UIKit calls this hidesBottomBarWhenPushed; every reference short-drama app
       agrees). The tab roots keep their bar and swap instantly, so it never moves there
       either. Wide viewports crossfade instead of pushing, so <TopNav> — painted identically
       by both frames over an opaque under-frame — composites STILL (PLAN.md §6.26). -->

  <!-- THE TOAST LIVES OUTSIDE THE SCROLL. It used to sit inline near the top of the page, so
       a viewer who had scrolled down to the pack they wanted and pressed Buy got their answer
       rendered off-screen above them — measured on /store at 1440, where the refusal
       "Payments are not configured on this deployment" landed 200px out of view. A status
       message has to reach the person who caused it.
       As a SIBLING of the scroll it pins to the bottom of the screen on every renderer with
       no positioning at all: web and native both lay it out after the scroll and before the
       tab bar, which is where a snackbar belongs anyway. No `position: absolute`, so nothing
       to degrade. -->
  <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
    <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
    <image icon="xmark" iconSize="12" color="{{ gold() }}" on:tap="dsx.variable.toast = ''"
           a11yLabel="Dismiss message" a11yTrait="button"/>
  </hstack>
  <!-- THE SEAM. One mount per screen, at the foot of the root; its sheet portals out of
       the layout, so a zero-height child here cannot disturb any chrome. -->
  <AuthSeam/>
</vstack>
