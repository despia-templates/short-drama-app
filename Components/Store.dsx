<!-- Store — the SELL lane, on its own route so it is a destination a CTA can point at
     (and a modal the player can raise mid-paywall), separate from /rewards which is the
     EARN lane. Two lanes, two surfaces: this is how the category ships it.

     CHECKOUT IS REAL, AND IT IS THE WEB LANE. The server creates the Stripe PaymentIntent
     (/store/checkout), `dsx.module.stripe` opens one session over it, and entitlement is
     granted server-side after Stripe confirms — never on the client's word.
     This header used to say "and the same session settles on web, iOS and Android", which
     was true and was a store violation on two of the three: App Store 3.1.1 names in-game
     currencies and premium-content unlocks as in-app-purchase products, so a card sheet
     inside a native build is a rejection. The lane is now picked before any money moves
     (`payLane` in the head) and a native build REFUSES with the reason on screen, because
     the in-app-purchase module cannot be configured into a build yet — the whole story,
     including the backend that is already waiting for it, is in that comment.

     MONEY GETS EVERY STATE. A buy card renders its own in-flight state the moment it is
     tapped (a $9.99 tap that does nothing for a network round trip reads as broken and
     produces double-taps); a payment that Stripe confirmed but the settle call lost keeps
     the order id on screen with a Confirm button until it lands (the settle route is
     idempotent, so retrying is always safe); a signed-out viewer is told to sign in, not
     that checkout is "unavailable". When the deployment has no Stripe keys the server
     refuses with a real reason and this screen shows that reason verbatim. -->
<vstack class="screen" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <expects variable="nav"/>

    <!-- the seam owns the token (<AuthSeam/> at the foot of this file); every authenticated
         read is gated on `global.auth.ok` and carries `global.auth.headers` — docs/auth.md -->
    <api as="catalog" url="/store/catalog" on:success="global.cacheCatalog = catalog.data"/>
    <api as="wallet" url="/wallet/state" ssr="false" auto="global.auth.ok == true" headers="global.auth.headers" on:success="global.cacheWallet = global.auth.ok == true ? wallet.data : null"/>
    <api as="checkoutCall" url="/store/checkout" method="POST" auto="false" headers="global.auth.headers"/>
    <api as="settleCall" url="/store/settle" method="POST" auto="false" headers="global.auth.headers"/>
    <!-- the NATIVE lane's settle. Same trust shape as the web one: the client says WHICH
         purchase to check, the server asks RevenueCat and grants (server/store.dsx). -->
    <api as="nativeCall" url="/store/native" method="POST" auto="false" headers="global.auth.headers"/>

    <variable as="toast">return ''</variable>
    <variable as="buying">return ''</variable>       <!-- the sku currently in checkout -->
    <variable as="paying">return false</variable>    <!-- the Stripe sheet is open -->
    <variable as="order">return ''</variable>
    <variable as="settleFailed">return false</variable>
    <variable as="settleMsg">return ''</variable>
    <variable as="hovId">return ''</variable>

    <!-- signed in is the seam, not the presence of a fetched JSON file (docs/auth.md) -->
    <variable as="signedIn" computed="true">return global.auth.ok == true</variable>
    <variable as="authKnown" computed="true">return global.auth != null &amp;&amp; global.auth.state != null</variable>
    <variable as="signedOut" computed="true">
      return dsx.variable.authKnown &amp;&amp; dsx.variable.signedIn == false
    </variable>
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read catalogView, never catalog.data, or the blank frame returns. -->
    <!-- stale-then-fresh: the api cache dies with the mount (PLAN.md §6.30), so the
         last good payload lives in the app-wide store and is the FIRST PAINT while the
         refetch runs. Read walletView, never wallet.data, or the blank frame returns. -->
    <!-- viewer-scoped stash: a signed-out frame must not read the last balance out of
         the app-wide store (docs/auth.md) -->
    <variable as="walletView" computed="true">
      if (dsx.variable.signedIn == false) { return null }
      if (wallet.data != null) { return wallet.data }
      return global.cacheWallet
    </variable>
    <variable as="catalogView" computed="true">
      if (catalog.data != null) { return catalog.data }
      return global.cacheCatalog
    </variable>
    <variable as="bp" computed="true">return bpOf(dsx.screen.width)</variable>
    <variable as="wide" computed="true">return isWide(dsx.variable.bp)</variable>
    <variable as="gutter" computed="true">return gutterOf(dsx.variable.bp)</variable>
    <variable as="vipCols" computed="true">return dsx.variable.bp == 'phone' ? 1 : 3</variable>
    <variable as="packCols" computed="true">
      if (dsx.variable.bp == 'desktop') { return 3 }
      if (dsx.variable.bp == 'tablet') { return 3 }
      return 2
    </variable>
    <variable as="shell" computed="true">return shellOf(dsx.variable.bp, 1100)</variable>
    <variable as="balance" computed="true">
      if (dsx.variable.walletView == null) { return 0 }
      return dsx.variable.walletView.coins + dsx.variable.walletView.bonus
    </variable>
    <variable as="isVip" computed="true">
      if (dsx.variable.walletView == null) { return false }
      return dsx.variable.walletView.vip === true
    </variable>
    <!-- one phase per data source: the catalogue is the screen's content -->
    <variable as="phase" computed="true">
      if (catalog.error != null) { return 'error' }
      if (dsx.variable.catalogView == null) { return 'loading' }
      return 'content'
    </variable>
    <!-- ══ THE PURCHASE LANE, AND WHY IT HAS ONLY ONE ═══════════════════════════════════
         App Store Review 3.1.1, verbatim: "If you want to unlock features or functionality
         within your app, (by way of example: subscriptions, in-game currencies, game levels,
         access to premium content, or unlocking a full version), you must use in-app
         purchase." A VIP pass is premium-content access and coins are an in-game currency —
         both are named by that parenthetical, so opening a Stripe payment sheet for either
         one inside an iOS build is a rejection. Two carve-outs get cited and neither applies:
         a READER APP may not offer in-app purchase at all and may only give access to content
         bought elsewhere, which is not a storefront; and the US anti-steering carve-out
         permits a LINK OUT to your own website, never a non-Apple payment sheet inside the
         app. Google Play Payments reaches the same conclusion for the same products.

         So Stripe is the WEB lane, and a native build takes the platform store — that is the
         whole rule, and it is why this pick reads `os == 'web'` and refuses everything else
         rather than falling through to the card sheet it used to.

         WHERE THE CAPABILITY PICK WENT. The house form is `has('scheme')` first and `os`
         second (AGENTS.md, the <AdGate> precedent) — a build that HAS the module should take
         it wherever it is running. That line belongs here and is not here, because the module
         cannot be in a build at all today: see `payNote`, which does the `has('store')` probe
         so the refusal can tell an adopter which half they are missing. The day Core/Store
         compiles, this becomes `if (has('store')) { return 'iap' }` above the web test, and
         the backend it needs is already built (server/store.dsx: POST /store/native, the
         RevenueCat <webhook>, and one shared granter behind both). -->
    <variable as="payLane" computed="true">
      if (os == 'web') { return 'stripe' }
      return 'blocked'
    </variable>
    <!-- THE REFUSAL, in the viewer's words, naming WHICH half is missing — because the two
         halves are fixed by two different people. A desktop build (macos/windows/linux)
         lands here too: the Mac App Store wants in-app purchase and a direct download does
         not, and `os` alone cannot tell them apart, so this errs toward the store rule, which
         is the safe direction to be wrong in. -->
    <variable as="payNote" computed="true">
      if (dsx.variable.payLane != 'blocked') { return '' }
      const cat = dsx.variable.catalogView
      const ready = cat != null &amp;&amp; cat.native != null &amp;&amp; cat.native.ready == true
      if (has('store')) {
        if (ready == false &amp;&amp; cat != null &amp;&amp; cat.native != null &amp;&amp; cat.native.reason != '') { return cat.native.reason }
        return 'The in-app-purchase module is in this build, but the app cannot open a purchase with it yet: the one client call this needs is held by an upstream defect (Core/Store ships Components/core/PaywallVIP.dsx, which mounts a component nothing defines, so configuring the package aborts the build). Nothing is charged until it can be granted.'
      }
      return 'Purchases are off in this build, on purpose. App Store rule 3.1.1 makes coins and passes in-app-purchase products, so selling them through a card sheet inside the app would be a rejection — and the in-app-purchase module cannot be added yet (configuring Core/Store aborts the build inside the module itself). The web storefront is unaffected.'
    </variable>
    <variable as="recoverLine" computed="true">
      const why = dsx.variable.settleMsg == '' ? '' : ' The server said: ' + dsx.variable.settleMsg
      return 'Stripe confirmed your payment, but applying it to your wallet did not go through. Nothing is lost: confirm below and it lands. Order ' + dsx.variable.order + '.' + why
    </variable>

    <!-- the card's whole look is ONE computed string (a bare {{ }} fragment beside other
         declarations is discarded — AGENTS.md); hover lift and in-flight dim live here so
         a tapped card responds on the SAME FRAME as the tap -->
    <formula as="packCardFx" id="item.id">
      const lift = dsx.variable.hovId == ('p-' + id) ? 'translateY(-2px)' : 'none'
      // a card that cannot be bought must not look buyable — the notice above the grid
      // says why (payNote)
      const dim = dsx.variable.payLane == 'blocked' ? 0.45 : (dsx.variable.buying == id ? 0.55 : 1)
      return 'opacity: ' + dim + '; transform: ' + lift + '; transition: transform 0.18s ease, opacity 0.18s ease'
    </formula>
    <formula as="cardBusyLabel" id="item.id">
      if (dsx.variable.buying != id) { return '' }
      return dsx.variable.paying ? 'Complete the payment…' : 'Contacting Stripe…'
    </formula>

    <!-- THE EMIT SHELL (Components/parts/Analytics.dsx). Four lines, and they are copied
         rather than shared because a `<functions global="true">` body is the EXPRESSION
         tier: dsx.log, dsx.module.* and a global write are all silent no-ops there, measured
         (PLAN.md §6.94). The POLICY is not copied — analyticsBlocked and analyticsSink are
         pure expressions and live in that one file. -->
    <action as="track" inputs="name, props">
      if (analyticsBlocked()) { return }
      if (analyticsSink() != '') { dsx.module.posthog.capture({ event: name, properties: props }) }
      else { dsx.log('funnel', name, props) }
    </action>

    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/' }) }
    </action>

    <!-- ONE BUY. Which lane it takes is decided by `payLane`, never by this action. -->
    <action as="buy" sku="item.id" label="item.label">
      if (dsx.variable.buying != '') { return }
      // NO SIGN-IN WALL IN FRONT OF THE MONEY. This used to push /auth/signin before a guest
      // could buy a coin pack. Most viewers who pay in this category have never made an
      // account, and a login screen between a decided buyer and a payment sheet is the most
      // expensive interruption a storefront has. A purchase needs a SUBJECT, not a signed-in
      // human, and an anonymous session is a subject — so the tap goes to the payment lane
      // and a backend that has nothing to attach the purchase to says so in its own words.
      // The <SignInCard> at the top of this screen is then an offer, not a gate.
      // ── THE NATIVE PURCHASE, AND THE ONE LINE THAT CANNOT BE WRITTEN YET ──────────────
      // What belongs here is a single call to the store module —
      //   store.checkout({ product: sku, externalId: the viewer subject })
      // — and then POST /store/native with the transaction it resolves. The server half is
      // already built and waiting (server/store.dsx: settleNative, the RevenueCat receiver,
      // and one shared granter behind both).
      // It is not written because the module cannot be put in a build. Adding Core/Store to
      // the packages list was tried on 2026-09-01 and ABORTS THE COMPILE inside the module
      // itself: Components/core/PaywallVIP.dsx line 18 mounts a component nothing in the
      // module tree defines. And with no package claiming the scheme, `despia lint --strict`
      // refuses a call to it outright — which is the correct refusal, because a module
      // reference nothing claims is how a build ships a call that can only fail on a device.
      // (Spelling note: the identifiers above are deliberately written WITHOUT their engine
      // prefix. The linter reads names out of comments in an action body exactly as it reads
      // them out of code, so naming the module here the way you would call it turns this
      // paragraph into two warnings against a strict gate.)
      // So the branch below is the whole native lane today: it refuses, in the viewer own
      // words, rather than quietly opening a card sheet on a phone.
      if (dsx.variable.payLane == 'blocked') {
        dsx.variable.toast = dsx.variable.payNote
        return
      }
      dsx.variable.buying = sku
      dsx.variable.toast = ''
      dsx.variable.settleFailed = false
      dsx.action.track({ name: 'purchase_started', props: { sku: sku, lane: 'stripe' } })
      const r = await checkoutCall.send({ sku: sku })
      if (!r.ok) {
        dsx.variable.buying = ''
        dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Checkout is unavailable right now.'
        return
      }
      dsx.variable.order = r.data.order
      const opened = await dsx.module.stripe.session({
        publishable_key: r.data.publishable_key,
        payment_intent_client_secret: r.data.client_secret
      })
      if (opened == null || opened.ok === false) {
        dsx.variable.buying = ''
        dsx.variable.toast = 'The payment sheet could not open on this platform.'
        return
      }
      dsx.variable.paying = true
      const paid = await dsx.module.stripe.payment({ session: dsx.module.stripe.context.session })
      dsx.variable.paying = false
      if (paid == null || paid.status !== 'succeeded') {
        dsx.variable.buying = ''
        dsx.variable.toast = 'Payment was not completed. Nothing was charged.'
        return
      }
      await dsx.action.settle()
      dsx.variable.buying = ''
    </action>

    <!-- Settle is IDEMPOTENT server-side (the order row is the lock), so this action is
         safe to call any number of times — which is exactly why the retry card below can
         exist. Money confirmed by Stripe but not yet granted is never a dead end. -->
    <action as="settle">
      const s = await settleCall.send({ order: dsx.variable.order })
      if (s.ok) {
        // THE MONEY EVENT IS THE SETTLE, NOT THE TAP. A PaymentIntent that Stripe confirmed
        // and the server granted is the only thing a funnel may call a purchase; anything
        // earlier counts intent. `granted` false is a replayed settle, so it is not counted
        // twice — the server already told us it had applied this order.
        if (s.data.granted) { dsx.action.track({ name: 'purchase_completed', props: { lane: 'stripe', coins: s.data.coins, days: s.data.days } }) }
        dsx.variable.settleFailed = false
        dsx.variable.order = ''
        wallet.refresh()
        dsx.variable.toast = s.data.granted
          ? (s.data.coins != null ? 'Added ' + s.data.coins + ' coins' : 'VIP is active for ' + s.data.days + ' days')
          : 'This purchase was already applied.'
      } else {
        // the card, not a toast — money is never a message that scrolls away. The server
        // reason rides inside it (recoverLine) so a refusal retrying cannot fix is legible.
        dsx.variable.settleFailed = true
        dsx.variable.settleMsg = s.data != null &amp;&amp; s.data.message != null ? s.data.message : ''
        dsx.variable.toast = ''
      }
    </action>


    <style as="screen" background="#000000" alignItems="stretch" grow="true" spacing="0"/>
    <style as="scroller" alignItems="stretch"/>
    <!-- NO paddingTop on `page`: <TopNav> is the first child, so a padded page pushes the
         GLOBAL BAR down — measured at 16px here against 0 everywhere else, which made the
         bar visibly drop when a route change crossfaded Home into Store. The spacing the
         page wanted belongs BELOW the bar, on the content (12 + 16 = 28), which leaves the
         phone lane — where no bar renders — pixel-identical. -->
    <style as="page" spacing="0" paddingBottom="32" alignItems="stretch"/>
    <style as="section" spacing="14" alignItems="stretch" paddingTop="32"/>

    <style as="head" alignItems="center" spacing="12"/>
    <style as="h1" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="balancePill" background="rgba(255,255,255,0.08)" radius="16" paddingH="12" paddingV="8" spacing="6" alignItems="center"/>
    <style as="balanceNum" fontSize="14" fontWeight="semibold" color="#F6B63D"/>
    <style as="vipChip" background="#F6B63D" radius="10" paddingH="8" paddingV="4" fontSize="11" fontWeight="bold" color="#2A1D04"/>
    <style as="toastRow" background="rgba(246,182,61,0.12)" radius="10" paddingH="12" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="14" fontWeight="medium" color="#F6B63D" lineSpacing="4"/>
    <style as="sectionTitle" fontSize="24" fontWeight="bold" color="rgba(255,255,255,0.8)" tracking="-0.3"/>
    <style as="sectionNote" fontSize="13" color="rgba(255,255,255,0.45)"/>

    <style as="busyLineDark" fontSize="12" fontWeight="semibold" color="#F6B63D"/>

    <style as="packCard" background="#141419" radius="12" paddingH="16" paddingV="16" spacing="8" alignItems="flex-start"/>
    <style as="packCoins" fontSize="20" fontWeight="bold" color="#FFFFFF"/>
    <style as="packLine" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="packPrice" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="packBonus" background="#FF2C55" radius="4" paddingH="6" paddingV="2" fontSize="11" fontWeight="bold" color="#FFFFFF"/>
    <style as="coinRow" spacing="6" alignItems="center"/>

    <style as="retryCard" background="#1E1830" radius="14" paddingH="16" paddingV="16" spacing="10" alignItems="flex-start"/>
    <style as="retryTitle" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="retryBody" fontSize="13" color="rgba(255,255,255,0.65)" lineSpacing="4"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>

    <style as="errCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="20" alignItems="center"/>

    <style as="earnCard" background="#141419" radius="14" paddingH="16" paddingV="16" spacing="12" alignItems="stretch"/>
    <!-- the lane notice: the earn card's shape, tighter, and left-aligned because it is a
         paragraph rather than a call to action -->
    <style as="laneCard" background="#141419" radius="14" paddingH="16" paddingV="16" spacing="8" alignItems="flex-start"/>
    <style as="earnTitle" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="earnNote" fontSize="13" color="rgba(255,255,255,0.5)" lineSpacing="3"/>
    <style as="earnCta" background="rgba(255,255,255,0.1)" radius="24" paddingV="14" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <!-- the design vocabulary (breakpoints, gutters, shells, palette) registers here.
       FIRST CHILD, always: the block registers on instantiate, and this screen reads its
       own `wide` computed on the very next line. See Components/parts/Theme.dsx. -->
  <Theme/>
  <!-- the funnel (Components/parts/Analytics.dsx). The mount is what fires app_open,
       once per session however many screens mount it. -->
  <Analytics/>
  <scroll class="scroller" style="flex: 1; min-height: 0">
    <vstack class="page">
      <TopNav active="store" visible-if="dsx.variable.wide"/>

      <vstack style="{{ dsx.variable.shell }}" alignItems="stretch" paddingTop="28">
        <hstack class="head">
          <!-- /store is a PUSHED route on every width (motion: ios), so the back control
               exists on every width too — a desktop viewer mid-paywall deserves the same
               way out as a phone -->
          <image icon="{{ chevBack() }}" iconSize="20" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button"/>
          <text value="Store" class="h1"/>
          <text value="VIP" class="vipChip" visible-if="dsx.variable.isVip"/>
          <spacer/>
          <hstack class="balancePill" visible-if="dsx.variable.walletView != null">
            <image icon="dollarsign.circle.fill" iconSize="15" color="{{ gold() }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }}" class="balanceNum"/>
          </hstack>
        </hstack>

        <!-- a toast the viewer can dismiss; a new action overwrites it -->

        <!-- A GUEST STILL SEES THE PRICES — hiding the shop from someone who has not signed
             in is the fastest way to lose them — but the screen says what buying needs, once,
             before they tap. The card is the same one every screen uses. -->
        <SignInCard visible-if="dsx.variable.signedOut" style="margin-top: 12px"
                    icon="dollarsign.circle.fill"
                    title="Purchases land on an account"
                    note="Browse the packs and plans freely. Signing in is what gives coins and VIP somewhere to live, so they are still yours on your next device."/>

        <!-- THE RECOVERY CARD. Stripe confirmed the charge, the settle call failed
             (network blip, server restart): the order id is still here, settle is
             idempotent, and this card stays until the grant lands. Money is never
             a toast that scrolls away. -->
        <vstack class="retryCard" visible-if="dsx.variable.settleFailed" style="margin-top: 12px; border: 1px solid rgba(199,155,255,0.35)">
          <text value="Payment received — one step left" class="retryTitle"/>
          <text value="{{ dsx.variable.recoverLine }}" class="retryBody"/>
          <button label="Confirm payment" class="retryBtn" on:tap="dsx.action.settle()"/>
        
</vstack>
      </vstack>

      <!-- loading: the shapes the content will land in, so arrival is a repaint -->
      <vstack class="section" visible-if="dsx.variable.phase == 'loading'">
        <vstack style="{{ dsx.variable.shell }}" spacing="14" alignItems="stretch">
          <Skeleton height="28" radius="8"/>
          <Skeleton height="132" radius="14"/>
          <Skeleton height="132" radius="14"/>
        </vstack>
      </vstack>

      <vstack class="section" visible-if="dsx.variable.phase == 'error'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="errCard">
            <text value="The store is unavailable." fontSize="14" color="#FFFFFF"/>
            <text value="Your coins and VIP are safe — this is only the price list failing to load." class="sectionNote" textAlign="center"/>
            <button label="Retry" class="retryBtn" on:tap="catalog.refresh()"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- THE REFUSAL, WHERE THE PRICES ARE. A native build with no in-app-purchase module
           may not sell coins or passes at all (App Store 3.1.1), so this screen says so and
           dims the grids rather than quietly opening a card sheet. The seam an adopter fills
           is named in the note itself — Article 7: the degradation is named where the reader
           is. On the web lane this never renders. -->
      <vstack class="section" visible-if="dsx.variable.payLane == 'blocked' &amp;&amp; dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="laneCard">
            <text value="Purchasing is off in this build" class="earnTitle"/>
            <text value="{{ dsx.variable.payNote }}" class="earnNote"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- VIP — the ONE plan list in the app: <PlansSheet> owns the tiers, the checkout
           and the settle-recovery, mounted inline here and as a sheet from Profile/VIP -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" spacing="4" alignItems="flex-start">
          <text value="VIP — unlock every series" class="sectionTitle"/>
          <!-- "Cancel anytime" described a subscription this backend has never had. Every
               tier is a one-off charge for a dated pass (server/store.dsx storeCatalog), so
               there is nothing to cancel — and the tier cards say the same thing in their
               own notes, which is what a screen and its server agreeing looks like. -->
          <text value="Unlimited viewing for the length of the pass. One charge, no auto-renewal." class="sectionNote"/>
        </vstack>
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <PlansSheet mode="inline"
                      vip="{{ dsx.variable.isVip }}" on:purchased="wallet.refresh()"/>
        </vstack>
      </vstack>

      <!-- coin packs -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" spacing="4" alignItems="flex-start">
          <text value="Top up coins" class="sectionTitle"/>
          <text value="Coins unlock individual episodes. Bonus coins are spent first." class="sectionNote"/>
        </vstack>
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <grid bind="dsx.variable.catalogView.packs" key="id" columns="{{ dsx.variable.packCols }}" spacing="12" scroll="false">
            <vstack class="packCard" on:tap="dsx.action.buy()" a11yGroup="true" a11yTrait="button"
                    on:hoverStart="dsx.variable.hovId = 'p-' + item.id" on:hoverEnd="dsx.variable.hovId = ''"
                    a11yLabel="Buy {{ item.coins }} coins plus {{ item.free }} bonus for {{ item.price }}"
                    style="{{ packCardFx }}">
              <hstack spacing="8" alignItems="center" style="width: 100%">
                <hstack class="coinRow">
                  <image icon="dollarsign.circle.fill" iconSize="17" color="{{ gold() }}" a11yHidden="true"/>
                  <text value="{{ item.coins + item.free }}" class="packCoins"/>
                </hstack>
                <spacer/>
                <text value="{{ item.bonus }}" class="packBonus"/>
              </hstack>
              <text value="{{ item.coins }} coins + {{ item.free }} bonus" class="packLine"/>
              <text value="{{ item.price }}" class="packPrice"/>
              <text value="{{ cardBusyLabel }}" class="busyLineDark" visible-if="cardBusyLabel != ''"/>
            </vstack>
          </grid>
        </vstack>
      </vstack>

      <!-- RESTORE PURCHASES — App Store 3.1.1 wants it on the surface that sells, and
           <RestoreRow> calls POST /store/restore for real: it walks this account's unsettled
           orders, asks Stripe about each, and grants the ones that were actually paid. That
           is the money a viewer cannot otherwise reach — charged while the app was closed
           between the payment sheet and the settle call. -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="earnCard">
            <RestoreRow on:restored="wallet.refresh()"/>
            <LegalLinks variant="line"/>
          </vstack>
        </vstack>
      </vstack>

      <!-- the door to the EARN lane, which lives on its own screen -->
      <vstack class="section" visible-if="dsx.variable.phase == 'content'">
        <vstack style="{{ dsx.variable.shell }}" alignItems="stretch">
          <vstack class="earnCard">
            <text value="Don't want to pay?" class="earnTitle"/>
            <text value="Check in daily, spin the wheel, watch a short ad or finish tasks — every one of them pays in coins." class="earnNote"/>
            <button label="Earn free coins" class="earnCta"
                    on:tap="dsx.module.route.push({ path: '/rewards' })"/>
          </vstack>
        </vstack>
      </vstack>

    </vstack>
  </scroll>
  <!-- NO TAB BAR: /store is a PUSHED route, and on the phone lane a push TRANSFORMS the
       whole frame — global chrome inside it would slide in with the page, which is exactly
       what a global bar must never do. A pushed screen is therefore full-bleed with a back
       affordance (UIKit calls this hidesBottomBarWhenPushed; every reference short-drama app
       agrees). The tab roots keep their bar and swap instantly, so it never moves there
       either. Wide viewports crossfade instead of pushing, so <TopNav> — painted identically
       by both frames over an opaque under-frame — composites STILL (PLAN.md §6.26). -->

  <!-- THE TOAST LIVES OUTSIDE THE SCROLL. It used to sit inline near the top of the page, so
       a viewer who had scrolled down to the pack they wanted and pressed Buy got their answer
       rendered off-screen above them — measured on /store at 1440, where the refusal
       "Payments are not configured on this deployment" landed 200px out of view. A status
       message has to reach the person who caused it.
       As a SIBLING of the scroll it pins to the bottom of the screen on every renderer with
       no positioning at all: web and native both lay it out after the scroll and before the
       tab bar, which is where a snackbar belongs anyway. No `position: absolute`, so nothing
       to degrade. -->
  <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
    <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
    <image icon="xmark" iconSize="12" color="{{ gold() }}" on:tap="dsx.variable.toast = ''"
           a11yLabel="Dismiss message" a11yTrait="button"/>
  </hstack>
  <!-- THE SEAM. One mount per screen, at the foot of the root; its sheet portals out of
       the layout, so a zero-height child here cannot disturb any chrome. -->
  <AuthSeam/>
</vstack>
