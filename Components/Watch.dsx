<!-- Watch — the player, built to the category reference (DramaWave) surface for surface:
     a full-bleed vertical stage, `‹ EP.n` and the speed/⋯ cluster on top, the ENGAGEMENT
     RAIL down the right (bookmark · comments · share · download), a hairline scrubber, and
     the EP.n / EP.N pill that raises the episode drawer.

     The drawer is the show sheet: poster, title, All N Episodes, Follow, and Synopsis |
     Episodes tabs with the ranged 6-column grid — and on a window wide enough to hold both,
     that list is a PERSISTENT right-hand panel beside the clip instead (every reference
     player does this; the drawer is the narrow-window fallback).

     The ⋯ opens the options stack: subtitles and picture-in-picture (both real — declared
     <video> booleans), speed (real), and quality as an honest disabled readout, because the
     renderer has no quality attribute. There is no share or help sheet: Share is a direct
     call to Core/SocialShare from the rail, and the quality LADDER and language PICKER that
     used to live here were removed rather than left as controls that changed nothing.

     TRUST SHAPE (spec §3): the client never decides entitlement. `epLocked` reads
     /wallet/state, unlock spends server-side, and a locked episode never mounts a source. -->
<!-- FULL-BLEED PLAYER ROOT (the safe-area LAW, §6.50's sibling): the stage owns the
     whole window — ignoreSafeArea anchors it at y=0 so a screen-height stage cannot
     spill past the safe region — and the CHROME pays the insets back through the
     published facts (topBar pads safeTop, bottomBar pads safeBottom). In a browser the
     insets are 0, so the web page is byte-true; a standalone PWA and both native lanes
     get the same balanced clearances from one spelling. -->
<vstack background="#000000" alignItems="stretch" grow="true" spacing="0" ignoreSafeArea="true" style:web="min-height: {{ dsx.screen.height }}px">
  <head>
    <expects variable="nav"/>

    <api as="detail" url="/catalog/show/{{ vars.show }}" on:success="dsx.action.detailLanded()"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="favs" url="/viewer/list" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="thread" url="/social/comments/{{ dsx.variable.epId }}" ssr="false" auto="false"/>
    <api as="unlockCall" url="/wallet/unlock" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="progressCall" url="/viewer/progress" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="favCall" url="/viewer/favorite" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="commentCall" url="/social/comment" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="page">return 0</variable>   <!-- 0-based; the vertical pager owns it -->
    <variable as="showId">return ''</variable>
    <variable as="paused">return false</variable>
    <variable as="buffering">return false</variable>
    <variable as="wMuted">return true</variable>
    <variable as="pos">return 0</variable>
    <variable as="seekBox">return { width: 0, height: 0 }</variable>
    <variable as="tabSynBox">return { width: 0, height: 0 }</variable>
    <variable as="tabEpBox">return { width: 0, height: 0 }</variable>
    <!-- `measure` writes an element's live BORDER box (getBoundingClientRect on web, the
         StackMeasure contract natively). segBox is the segmented control's TRACK — the
         padded inside of the trough, so the quarters are exact — and the two pane boxes
         keep the drawer's depth stack exactly as tall as the pane you are looking at. -->
    <variable as="segBox">return { width: 0, height: 0 }</variable>
    <variable as="synPaneBox">return { width: 0, height: 0 }</variable>
    <variable as="epPaneBox">return { width: 0, height: 0 }</variable>
    <variable as="scrubbing">return false</variable>   <!-- true while the finger owns the bar -->
    <variable as="time">return 0</variable>
    <variable as="duration">return 0</variable>
    <variable as="speed">return 1</variable>
    <variable as="holding">return false</variable>
    <variable as="drawer">return false</variable>
    <variable as="drawerTab">return 'episodes'</variable>
    <variable as="range">return 0</variable>
    <variable as="menu">return false</variable>
    <variable as="sheet">return ''</variable>        <!-- '' | speed -->
    <variable as="comments">return false</variable>
    <variable as="draft">return ''</variable>
    <variable as="captions">return true</variable>
    <variable as="pip">return true</variable>
    <variable as="autoUnlock">return true</variable>
    <variable as="unlocking">return false</variable>
    <variable as="toast">return ''</variable>
    <variable as="favTouched">return ''</variable>
    <variable as="plotOpen">return false</variable>

    <!-- FOUR RUNGS, and the same four on every surface that offers speed.
         The ladder used to carry seven (0.5 … 3.0), which cannot fit a phone sheet, so
         the control was a horizontal SCROLLER with a visible scrollbar — a picker you
         have to drag past its own edge is not a picker. Four is what fits as a real
         segmented control at every supported width: at the narrowest supported viewport
         (320pt) the track measures 320 − 32 (sheet inset) − 28 (menu-card padding)
         − 8 (trough inset) = 252pt, so a segment is 63pt against a ~38pt label.
         ONE table drives BOTH the ⋯ menu's segment and the chip's Playback Speed list,
         so the two surfaces can never offer different ladders. Note the consequence:
         0.5×, 2.0× and 3.0× are gone from the app, and `holdStart` below (press-and-hold
         to 2×, declared but wired to no element today) therefore sets an OFF-TABLE speed
         — `speedIdx` parks the pill on 1.0× rather than off the end if it ever fires. -->
    <variable as="speedOptions">
      return [
        { id: 's075', v: 0.75, label: '0.75x' }, { id: 's1', v: 1, label: '1.0x' },
        { id: 's125', v: 1.25, label: '1.25x' }, { id: 's15', v: 1.5, label: '1.5x' }
      ]
    </variable>

    <variable as="cur" computed="true">return Number(dsx.variable.page) + 1</variable>
    <!-- the scrub readout: elapsed / total, mm:ss. `pos` is the 0-1 fraction the
         <video bind> publishes, `duration` the seconds it reports. -->
    <!-- mm:ss, and the zero-pad has to be built on a NON-NUMERIC anchor. JSE `+` is total
         arithmetic, so `'' + 4` is the NUMBER 4, not "4", and `'0' + that` is 4 again —
         three seconds rendered as "0:3" on both lanes. Growing the string from `m + ':'`
         (which can never parse as a number) keeps every later `+` a concatenation. -->
    <variable as="posLabel" computed="true">
      const t = Math.floor(dsx.variable.pos * dsx.variable.duration)
      const m = Math.floor(t / 60)
      const sec = t - m * 60
      let out = m + ':'
      if (sec < 10) { out = out + '0' }
      return out + sec
    </variable>
    <variable as="durLabel" computed="true">
      const t = Math.floor(dsx.variable.duration)
      const m = Math.floor(t / 60)
      const sec = t - m * 60
      let out = m + ':'
      if (sec < 10) { out = out + '0' }
      return out + sec
    </variable>
    <variable as="bp" computed="true">
      const s = dsx.screen.width
      if (s >= 1120) { return 'desktop' }
      if (s >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <!-- THE EPISODE PANEL LANE. Every reference player on desktop — ReelShort, Shortical,
         Stardust, FlickReels — puts the episode grid in a PERSISTENT right-hand panel beside
         the clip, with the breadcrumb, title, tags, plot and counts above it. Only when the
         window cannot hold both does the list collapse into the bottom drawer. Ours hid all
         of it behind the drawer at every width, so a 1440px window showed a 461px clip
         between two black voids and no way to see episode 12 without opening a sheet.
         416 is the measured reference width (PLAN.md's category read: "detail panel 416 with
         a 6-col episode grid"); 1120 is this app's own desktop breakpoint, and below it the
         clip plus the panel no longer fit, so the drawer takes over unchanged. -->
    <variable as="panel" computed="true">return dsx.screen.width >= 1120</variable>
    <!-- the pill printed `{{ speed }}.0x`, which reads "0.5.0x" and "1.25.0x" for four of the
         seven rungs. The option rows always used `item.label`; the pill now does too. -->
    <!-- THE PLAYER HAD NO FAILURE SURFACE AT ALL. The word "error" did not appear in this
         file: the pager binds the episode list directly, so a failed or in-flight
         /catalog/show/:id rendered an empty stage — no message, no retry, no way back except
         the browser. Same four-state shape every other screen carries (Notices.dsx is the
         model), plus `on:error` from the <video> itself, which reports a dead source, an
         unplayable asset or a CDN that neither plays nor fails within ~15s. -->
    <!-- STALE-THEN-FRESH (PLAN.md §6.30), the one screen that never had it — and the one a
         viewer pushes INTO. Reading `detail.data` raw meant every push mounted at
         phase='loading': a black panel at z-index 3 that swallows the whole chrome, then
         ~430ms later the art, then the clip. Measured on device: three distinct paints for
         one tap. The ID GUARD is the half §6.30 warns about — a stash keyed by a route param
         hands show B the art of show A without it. -->
    <variable as="detailView" computed="true">
      if (detail.data != null) { return detail.data }
      const c = global.cacheDetail
      if (c != null && c.id == vars.show) { return c.data }
      return null
    </variable>
    <!-- THE CURTAIN ON A FIRST VISIT. Home already holds every show's hero_tall, so the art
         for the show being opened is in memory before the push starts — there is no reason
         to paint black while the detail request flies. Falls through to '' when the viewer
         arrived by deep link and no shelf has been fetched. -->
    <variable as="shelfArt" computed="true">
      const h = global.cacheHome
      if (h == null) { return '' }
      const pools = [h.hero, h.latest, h.trending]
      let i = 0
      while (i < pools.length) {
        const pool = pools[i]
        if (pool != null) {
          const hit = pool.filter(x => x.id == vars.show)
          if (hit.length > 0 && hit[0].hero_tall != null) { return hit[0].hero_tall }
        }
        i = i + 1
      }
      return ''
    </variable>
    <variable as="phase" computed="true">
      if (dsx.variable.detailView != null) { return dsx.variable.detailView.episodes.length == 0 ? 'empty' : 'ready' }
      if (detail.error != null) { return 'error' }
      return 'loading'
    </variable>
    <variable as="speedLabel" computed="true">
      const match = dsx.variable.speedOptions.filter(o => o.v == dsx.variable.speed)
      return match.length == 0 ? '1.0x' : match[0].label
    </variable>
    <!-- WHICH SEGMENT THE PILL SITS ON. Equal segments are what let the indicator be pure
         arithmetic off ONE measured track — no per-segment measurement, no layout
         animation, and no `width: N%` (the native bridge drops non-100 percent lengths —
         upstream #281): the pill is `width = round(track/4)` at
         `offsetX = round(track/4 * index)`. An off-table speed falls back to the 1.0×
         rung so the pill can never park past the end of the trough. -->
    <variable as="speedIdx" computed="true">
      const opts = dsx.variable.speedOptions
      const v = dsx.variable.speed
      let found = 1
      let i = 0
      while (i < opts.length) {
        if (opts[i].v == v) { found = i }
        i = i + 1
      }
      return found
    </variable>
    <!-- ONE computed value used as the WHOLE style attribute (AGENTS.md): a clamp that
         toggles cannot be spliced into a static style string. -->
    <variable as="plotFx" computed="true">
      if (dsx.variable.plotOpen) { return 'overflow: visible' }
      return 'display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden'
    </variable>
    <variable as="showTags" computed="true">
      if (dsx.variable.detailView == null || dsx.variable.detailView.show.tags == null) { return [] }
      return dsx.variable.detailView.show.tags.map(t => ({ name: t }))
    </variable>
    <variable as="panelViews" computed="true">
      if (dsx.variable.detailView == null || dsx.variable.detailView.show.views == null || dsx.variable.detailView.show.views < 1000) { return '' }
      const v = dsx.variable.detailView.show.views
      if (v < 1000000) { return Math.round(v / 100) / 10 + 'K' }
      return Math.round(v / 100000) / 10 + 'M'
    </variable>
    <variable as="stageH" computed="true">
      if (dsx.variable.wide) { return dsx.screen.height - 62 }
      return dsx.screen.height
    </variable>
    <!-- THE CLIP BAND. The category plays a 16:9 master on a 9:16 stage: the clip is
         WIDTH 100% at its own ratio, pinned to the TOP under the transparent bar, and the
         black below it is where the chrome lives (seek, then the episode selector). Cover-
         cropping a landscape master into a portrait stage is what made every frame a
         zoomed-in detail with no composition left. -->
    <variable as="clipH" computed="true">
      const w = dsx.variable.wide ? Math.min(dsx.variable.stageMax, dsx.screen.width) : dsx.screen.width
      return Math.round(w * 9 / 16)
    </variable>
    <variable as="stageMax" computed="true">
      if (dsx.variable.bp == 'phone') { return 4096 }
      return Math.round(Math.min(461, dsx.screen.height * 0.56))
    </variable>
    <variable as="episode" computed="true">
      if (dsx.variable.detailView == null) { return null }
      const eps = dsx.variable.detailView.episodes
      const i = Number(dsx.variable.cur)
      if (i < 1 || i > eps.length) { return null }
      return eps[i - 1]
    </variable>
    <variable as="epId" computed="true">
      const e = dsx.variable.episode
      return e == null ? '' : e.id
    </variable>
    <variable as="total" computed="true">
      if (dsx.variable.detailView == null) { return 0 }
      return dsx.variable.detailView.episodes.length
    </variable>
    <variable as="epLocked" computed="true">
      const ep = dsx.variable.episode
      if (ep == null) { return false }
      if (ep.free) { return false }
      if (wallet.data == null) { return true }
      if (wallet.data.vip == true) { return false }
      return !wallet.data.unlocked.includes(ep.id)
    </variable>
    <variable as="balance" computed="true">
      if (wallet.data == null) { return 0 }
      return wallet.data.coins + wallet.data.bonus
    </variable>
    <variable as="favOn" computed="true">
      if (dsx.variable.favTouched != '') { return dsx.variable.favTouched == 'y' }
      if (favs.data == null) { return false }
      return favs.data.items.filter(x => x.show == dsx.variable.showId).length > 0
    </variable>
    <variable as="commentCount" computed="true">
      if (thread.data == null) { return 0 }
      return thread.data.count
    </variable>
    <variable as="stageArt" computed="true">
      const d = dsx.variable.detailView
      if (d != null && d.show.hero_tall != null) { return d.show.hero_tall }
      return dsx.variable.shelfArt
    </variable>
    <variable as="commentLabel" computed="true">
      const n = Number(dsx.variable.commentCount)
      if (n == 1) { return '1 comment' }
      return n + ' comments'
    </variable>
    <variable as="unlockLabel" computed="true">
      if (dsx.variable.unlocking) { return 'Unlocking…' }
      const ep = dsx.variable.episode
      return (ep == null ? '' : ep.price) + '  Unlock Now'
    </variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>
    <!-- the drawer's range pills: 1-30 · 31-60 · … built from the real episode count -->
    <variable as="ranges" computed="true">
      const n = dsx.variable.total
      const out = []
      let start = 1
      while (start <= n) {
        const end = Math.min(start + 29, n)
        out.push({ id: 'r' + start, from: start, to: end, label: start + '-' + end })
        start = end + 1
      }
      return out
    </variable>
    <variable as="visibleEps" computed="true">
      if (dsx.variable.detailView == null) { return [] }
      const rs = dsx.variable.ranges
      const i = Number(dsx.variable.range)
      if (i < 0 || i >= rs.length) { return dsx.variable.detailView.episodes }
      const r = rs[i]
      return dsx.variable.detailView.episodes.filter(e => e.idx >= r.from && e.idx <= r.to)
    </variable>
    <!-- THE SLIDING UNDERLINE. ONE rule in a coordinate space both labels share, never
         one rule per tab toggled by visible-if: a toggle JUMPS, a travelling rule reads
         as a tab bar. The width is the active label's own measured box — the same
         `measure` the two labels already published for the static rule — and the x is
         that label's leading edge inside the rail: 0 for the first, the first label's
         width plus the row's gap for the second. THE 28 IS `tabRow`'s OWN `spacing`:
         they are the same gap seen from two elements, and nothing but this line holds
         them together — change one, change the other. -->
    <variable as="tabUnderW" computed="true">
      if (dsx.variable.drawerTab == 'synopsis') { return Math.round(dsx.variable.tabSynBox.width || 0) }
      return Math.round(dsx.variable.tabEpBox.width || 0)
    </variable>
    <variable as="tabUnderX" computed="true">
      if (dsx.variable.drawerTab == 'synopsis') { return 0 }
      return Math.round(dsx.variable.tabSynBox.width || 0) + 28
    </variable>
    <!-- and the pane stack is exactly as tall as the ACTIVE pane. Both panes stay MOUNTED
         (that is what lets them cross-fade and travel instead of popping), and a depth
         stack is as tall as its tallest child — so without this a 60-episode grid would
         hang most of a screen of dead scroll under the synopsis. -->
    <variable as="paneH" computed="true">
      if (dsx.variable.drawerTab == 'synopsis') { return Math.round(dsx.variable.synPaneBox.height || 0) }
      return Math.round(dsx.variable.epPaneBox.height || 0)
    </variable>

    <formula as="gridLocked" free="item.free" epid="item.id">
      if (free) { return false }
      if (wallet.data == null) { return true }
      if (wallet.data.vip == true) { return false }
      return !wallet.data.unlocked.includes(epid)
    </formula>
    <!-- the whole style is ONE formula (a {{ }} hole spanning a ';' inside a compound
         style is shredded by the pre-interpolation split — PLAN.md §6.17): locked pages
         frost their art, unlocked pages show it plain until the clip covers it -->
    <formula as="stageArtFx" locked="gridLocked">
      const frost = locked ? '; filter: blur(16px) brightness(0.4)' : ''
      return 'width: 100%; height: ' + dsx.variable.clipH + 'px; object-fit: cover' + frost
    </formula>

    <!-- The app-wide stash §6.30 asks for, with the ID GUARD it warns about: one key per
         ENDPOINT, carrying the id it was fetched for, so the next show cannot read this
         one's payload while its own request is still in the air. -->
    <action as="detailLanded">
      global.cacheDetail = { id: vars.show, data: detail.data }
    </action>
    <action as="boot" show="vars.show" idx="vars.idx">
      dsx.variable.showId = show;
      dsx.variable.page = Number(idx) - 1;
      thread.refresh()
    </action>
    <!-- SHARE, for real. This used to be `sheet = ''; menu = true` — byte-identical to the
         ⋯ button — so tapping Share opened a sheet headed "More" with no share row in it.
         `share.url` is the declared Core/SocialShare action; its web lane uses the Web Share
         API and falls back to the clipboard on its own, so both paths are the module's.
         The URL is a PATH: there is no portable origin fact in the runtime, and a relative
         url resolves against the document on web. A native build that wants a universal
         link should prepend its own deep-link origin here.
         CALL-THEN-CHECK, not `has()`: a module chunk is loaded on FIRST USE, so
         `has('share')` is false until something has already called it — the guard would have
         refused the very first tap forever. This is the same shape PlansSheet uses for
         `stripe.session` (`opened.ok === false` → a named toast), which is the precedent in
         this template for "the module may not be in this build". -->
    <action as="doShare">
      const title = dsx.variable.detailView == null ? 'this series' : dsx.variable.detailView.show.title
      const r = await dsx.module.share.url({
        message: title + ' — EP.' + dsx.variable.cur,
        url: '/watch/' + dsx.variable.showId + '/' + dsx.variable.cur
      })
      if (r == null || r.ok === false) {
        dsx.variable.toast = 'Sharing is not available on this platform.'
      }
    </action>
    <action as="goBack">
      if (dsx.variable.nav.canPop) { dsx.module.route.pop() }
      else { dsx.module.route.replace({ path: '/' }) }
    </action>
    <action as="saveNow" epid="dsx.variable.epId" epidx="dsx.variable.cur" locked="dsx.variable.epLocked">
      if (epid == null || epid === '' || locked) { return }
      await progressCall.send({ episode: epid, show: dsx.variable.showId, idx: Number(epidx), position: dsx.variable.time })
    </action>
    <!-- THE ADDRESS BAR TRACKS THE EPISODE. `vars.idx` was read once at mount and never
         again, so watching to EP.40 left the URL on /watch/{show}/1 — a reload, a share or a
         back-then-forward all returned the viewer to episode 1, and the EP.n label disagreed
         with the URL for the whole session. REPLACE, never push: 40 episodes must not become
         40 history entries, and Back still leaves the player rather than stepping back one
         episode at a time. -->
    <action as="syncUrl">
      dsx.module.route.replace({ path: '/watch/' + dsx.variable.showId + '/' + dsx.variable.cur })
    </action>
    <action as="go" to="target">
      if (dsx.variable.detailView == null) { return }
      const n = Number(target)
      if (n < 1 || n > dsx.variable.detailView.episodes.length) { return }
      dsx.action.saveNow();
      dsx.variable.page = n - 1;
      dsx.variable.pos = 0;
      dsx.variable.paused = false;
      dsx.variable.drawer = false;
      thread.refresh();
      dsx.action.syncUrl()
    </action>
    <action as="next">dsx.action.go({ target: Number(dsx.variable.cur) + 1 })</action>
    <!-- the pager rested on a new episode: the swipe IS the navigation, so the same
         bookkeeping a tap would do runs here -->
    <action as="rest">
      dsx.action.saveNow();
      dsx.variable.pos = 0;
      dsx.variable.paused = false;
      thread.refresh();
      dsx.action.syncUrl()
    </action>
    <action as="onEnded">
      const ep = dsx.variable.episode
      if (dsx.variable.detailView == null || ep == null) { return }
      const n = Number(dsx.variable.cur) + 1
      if (n > dsx.variable.detailView.episodes.length) { dsx.variable.paused = true; return }
      const nxt = dsx.variable.detailView.episodes[n - 1]
      const nextLocked = nxt.free === false && wallet.data != null && wallet.data.vip != true && !wallet.data.unlocked.includes(nxt.id)
      if (nextLocked && dsx.variable.autoUnlock && dsx.variable.balance >= nxt.price) {
        dsx.variable.page = n - 1
        dsx.action.syncUrl()
        await dsx.action.unlockNow()
      } else {
        dsx.action.go({ target: n })
      }
    </action>
    <action as="unlockNow">
      const ep = dsx.variable.episode
      if (ep == null || dsx.variable.unlocking) { return }
      dsx.variable.unlocking = true
      const r = await unlockCall.send({ episode: ep.id })
      dsx.variable.unlocking = false
      if (r.ok) { dsx.variable.toast = 'Unlocked for ' + r.data.spent + ' coins'; dsx.variable.paused = false; wallet.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Unlock failed' }
    </action>
    <action as="toggleFav">
      const r = await favCall.send({ show: dsx.variable.showId })
      if (r.ok) { dsx.variable.favTouched = r.data.favorite ? 'y' : 'n' }
    </action>
    <action as="holdStart">
      if (dsx.variable.epLocked) { return }
      dsx.variable.holding = true; dsx.variable.speed = 2
    </action>
    <action as="holdEnd">
      if (!dsx.variable.holding) { return }
      dsx.variable.holding = false; dsx.variable.speed = 1
    </action>
    <action as="seek">dsx.variable.pos = dsx.this.fraction</action>
    <action as="openComments">
      dsx.variable.comments = true
      thread.refresh()
    </action>
    <action as="postComment">
      const text = dsx.variable.draft
      if (text == null || text === '') { return }
      const r = await commentCall.send({ show: dsx.variable.showId, episode: dsx.variable.epId, body: text })
      if (r.ok) { dsx.variable.draft = ''; thread.refresh() }
      else { dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Could not post' }
    </action>

    <!-- ── stage chrome ── -->
    <style as="chromeLayer" zIndex="2"/>
    <!-- The loading/error panel used to be an OPAQUE black stage: it sat at z-index 3 over
         everything, so even once the curtain art was known it could not be seen, and the
         whole chrome was absent until `ready` and then arrived at once (measured: the bars
         jump in ~430ms after the tap). It now paints black only when there is genuinely
         nothing behind it; with art, it is a scrim the curtain reads through. -->
    <style as="stateWrap" alignItems="center" spacing="10" paddingH="24" paddingV="20"/>
    <style as="stateWrapBare" background="#000000"/>
    <style as="stateWrapOverArt" background="rgba(0,0,0,0.38)"/>
    <style as="stateHead" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="stateBody" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="stateBtn" background="#FF2C55" radius="22" paddingH="20" paddingV="11" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="lockedLayer" zIndex="3"/>
    <style as="topBar" paddingLeading="10" paddingTrailing="14" paddingTop="12" spacing="10" alignItems="center"/>
    <style as="epLabel" fontSize="17" fontWeight="semibold" color="#FFFFFF"/>
    <style as="speedChip" spacing="5" alignItems="center" paddingH="4"/>
    <style as="speedText" fontSize="15" color="#FFFFFF"/>

    <!-- ── the engagement rail ── -->
    <style as="rail" spacing="22" alignItems="center" paddingTrailing="12"/>
    <style as="railItem" spacing="4" alignItems="center"/>
    <style as="railCount" fontSize="12" fontWeight="semibold" color="#FFFFFF"/>
    <style as="railCap" fontSize="11" color="rgba(255,255,255,0.9)"/>
    <style as="vipTag" background="#F6B63D" radius="4" paddingH="5" paddingV="1" fontSize="11" fontWeight="bold" color="#3A2A08"/>
    <!-- the corner twin: a badge riding an icon is a MARKER, not a label. 11 is the bottom
         of the type ramp and the review gate is right to hold it there — a 9pt badge reads
         as noise at arm's length. The pill stays small by trimming its PADDING instead. -->
    <style as="vipCorner" background="#F6B63D" radius="4" paddingH="4" paddingV="0" fontSize="11" fontWeight="bold" color="#3A2A08"/>
    <style as="cellTag" background="#F6B63D" paddingH="3" paddingV="0" fontSize="11" fontWeight="bold" color="#3A2A08"/>
    <style as="nowBars" alignItems="center"/>

    <!-- ── bottom: scrubber + the EP pill ── -->
    <style as="bottomBar" paddingLeading="14" paddingTrailing="14" paddingBottom="14" spacing="10" alignItems="stretch"/>
    <style as="epPill" background="rgba(255,255,255,0.12)" radius="12" paddingH="14" paddingV="12" spacing="9" alignItems="center"/>
    <style as="epPillNow" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="epPillAll" fontSize="15" color="rgba(255,255,255,0.55)"/>
    <style as="toastLine" fontSize="12" color="#F6B63D"/>
    <style as="seekTimeNow" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="seekTimeAll" fontSize="13" color="rgba(255,255,255,0.62)"/>
    <style as="speedToast" background="rgba(0,0,0,0.72)" radius="18" paddingH="14" paddingV="8" spacing="7" alignItems="center"/>
    <style as="speedToastLabel" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>

    <!-- ── the locked stage ── -->
    <style as="lockBlock" spacing="14" alignItems="center" paddingH="26"/>
    <style as="lockHead" fontSize="17" fontWeight="bold" color="#FFFFFF" textAlign="center" lineSpacing="4"/>
    <style as="unlockBtn" background="#FF2C55" radius="24" paddingV="14" paddingH="30" spacing="8" alignItems="center"/>
    <style as="unlockLabelTxt" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="lockDoors" spacing="10" alignItems="center"/>
    <style as="earnBtn" background="rgba(255,255,255,0.1)" radius="24" paddingV="14" paddingH="20" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="lockClose" width="34" height="34" radius="17" background="rgba(255,255,255,0.12)" alignItems="center"/>
    <style as="lockMetaRow" spacing="6" alignItems="center"/>
    <style as="lockMeta" fontSize="13" color="#F6B63D"/>
    <style as="autoRow" spacing="9" alignItems="center" paddingTop="2"/>
    <style as="checkBox" width="20" height="20" radius="6" alignItems="center"/>
    <style as="autoLabel" fontSize="13" color="rgba(255,255,255,0.66)"/>

    <!-- ── the desktop episode panel ── -->
    <!-- the SAME surface colour as the drawer: the panel and the drawer are one component
         wearing two layouts, so they must not read as two different materials -->
    <style as="panelScroll" background="#141414" alignItems="stretch"/>
    <style as="panelBody" spacing="12" paddingH="20" paddingTop="18" paddingBottom="28" alignItems="stretch"/>
    <style as="panelCrumbs" spacing="6" alignItems="center"/>
    <style as="crumb" fontSize="12" color="rgba(255,255,255,0.45)"/>
    <style as="crumbOn" fontSize="12" fontWeight="medium" color="rgba(255,255,255,0.8)"/>
    <style as="panelTitle" fontSize="20" fontWeight="bold" color="#FFFFFF" lineLimit="2" tracking="-0.3" lineSpacing="2"/>
    <style as="tagFlow" alignItems="flex-start"/>
    <style as="tagSoft" background="rgba(255,233,168,0.10)" radius="4" paddingH="9" paddingV="4" fontSize="12" color="#FFE9A8"/>
    <style as="panelTags" spacing="8" alignItems="center"/>
    <style as="panelPlot" fontSize="13" color="rgba(255,255,255,0.62)" lineSpacing="3"/>
    <style as="panelMore" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="panelStats" spacing="8" alignItems="center" paddingTop="2"/>
    <style as="panelStat" fontSize="13" fontWeight="medium" color="rgba(255,255,255,0.62)"/>
    <style as="panelAct" spacing="5" alignItems="center"/>
    <style as="panelRanges" spacing="16" alignItems="center" paddingTop="6"/>

    <!-- ── the episode drawer ── -->
    <!-- 15, not 18: the tab labels now sit inside a `tabHit` column that carries 3pt of
         its own top padding for the tap target, and the two together hold the measured
         18pt gap the head had before. -->
    <style as="drawerHead" spacing="14" alignItems="center" paddingH="16" paddingTop="10" paddingBottom="15"/>
    <style as="drawerTitle" fontSize="17" fontWeight="bold" color="#FFFFFF" lineLimit="2" lineSpacing="3"/>
    <style as="drawerSub" fontSize="13" color="rgba(255,255,255,0.5)"/>
    <style as="followBtn" radius="24" paddingH="24" paddingV="13" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="tabRow" spacing="28" alignItems="center" paddingH="16"/>
    <!-- the tap target, unchanged in size: the label used to share its column with the
         rule (spacing 5 + a 3pt rule = 8pt of extra target), and 3 + 5 here restores
         exactly that 8pt now that the rule has moved out into its own rail -->
    <style as="tabHit" alignItems="center" paddingTop="3" paddingBottom="5"/>
    <style as="tabTxt" fontSize="16" fontWeight="semibold"/>
    <!-- THE RAIL is the underline's coordinate space, and it carries the SAME 16pt gutter
         as the label row so that x=0 here is the first label's leading edge. -->
    <style as="tabRail" paddingH="16" paddingBottom="4"/>
    <!-- THE RULE IS ITS LABEL'S WIDTH, measured. A guessed 26pt was too short and
         grow="width" was too long — a greedy child makes the tab column greedy too, so
         the column ate the row and the rule ran past the word. `measure` writes the
         text's live box (custom-ux.md §2), which is the only spelling that tracks the
         label on every renderer and at every type size. -->
    <style as="tabUnderline" background="#FF2C55" height="3" radius="2"/>
    <style as="rangeRow" spacing="20" alignItems="center" paddingH="16" paddingTop="18" paddingBottom="12"/>
    <style as="rangeTxt" fontSize="14" fontWeight="semibold"/>
    <!-- the sheet supplies the bottom inset (and folds the safe area into it); 28 here
         was a third layer solving the same problem — PLAN.md §6.69 -->
    <style as="epGridWrap" paddingH="12" paddingBottom="8"/>
    <style as="epCell" radius="11" alignItems="center" background="#2C2C2E"/>
    <style as="epNum" fontSize="16" fontWeight="semibold"/>
    <style as="synopsisWrap" paddingH="18" paddingTop="14" paddingBottom="26" spacing="12" alignItems="flex-start"/>
    <style as="tagRow" spacing="8" alignItems="center"/>
    <style as="tag" background="rgba(255,255,255,0.1)" radius="6" paddingH="12" paddingV="6" fontSize="13" color="rgba(255,255,255,0.7)"/>
    <style as="synopsisTxt" fontSize="15" color="rgba(255,255,255,0.8)" lineSpacing="6"/>

    <!-- ── the options stack ── -->
    <!-- the sheet already insets its content 16 a side; 12 more made the card read
         narrow and the header sat flush against the grabber -->
    <style as="menuBody" paddingH="0" paddingTop="8" paddingBottom="14" spacing="0" alignItems="stretch"/>
    <style as="menuCard" background="#1C1C1E" radius="14" paddingH="14" spacing="0" alignItems="stretch"/>
    <style as="menuRow" spacing="13" alignItems="center" paddingV="13"/>
    <style as="menuLabel" fontSize="16" color="#FFFFFF"/>
    <style as="menuValue" fontSize="15" color="rgba(255,255,255,0.5)"/>
    <style as="menuHead" fontSize="20" fontWeight="bold" color="#FFFFFF" paddingH="4" paddingBottom="8" paddingTop="2"/>
    <style as="pauseBadge" padding="25" radius="42" background="rgba(0,0,0,0.45)" alignItems="center"/>
    <!-- THE SEGMENTED CONTROL. Trough 10 · inset 4 · pill 6 is the CONCENTRIC-RADIUS rule
         (an inner radius is the outer radius minus the inset), the same rule the platform
         segmented control follows at 9 · 2 · 7. The segment's 45pt height is MEASURED,
         not chosen: a 14pt label's line box is 14 × the sheet's 1.5 body leading (the
         `dsx-type-body-leading` token) = 21pt, and 12 above and below carries it to 45 —
         the 44pt tap floor of designing-an-app §7, rather than the platform control's
         tighter 32pt, because this one is hand-rolled and carries no system hit-slop. -->
    <style as="speedSeg" background="rgba(255,255,255,0.08)" radius="10" padding="4" spacing="0" alignItems="stretch"/>
    <style as="speedPill" background="rgba(255,255,255,0.16)" radius="6"/>
    <style as="speedOpt" paddingV="12" fontSize="14" textAlign="center"/>
    <style as="optRow" spacing="12" alignItems="center" paddingV="13" paddingH="12" radius="10"/>
    <style as="optLabel" fontSize="17"/>
    <style as="optNote" fontSize="13" color="rgba(255,255,255,0.5)"/>

    <!-- ── comments ── -->
    <style as="cHead" alignItems="center" paddingH="16" paddingV="12"/>
    <style as="cTitle" fontSize="17" fontWeight="bold" color="#FFFFFF"/>
    <style as="cRow" spacing="12" alignItems="flex-start" paddingH="16" paddingV="12"/>
    <style as="cAvatar" width="34" height="34" radius="17" background="#2A2A2E" alignItems="center"/>
    <style as="cAuthor" fontSize="14" color="rgba(255,255,255,0.55)"/>
    <style as="cBody" fontSize="15" color="#FFFFFF" lineSpacing="4"/>
    <style as="cMeta" fontSize="12" color="rgba(255,255,255,0.4)"/>
    <style as="cEmpty" fontSize="14" color="rgba(255,255,255,0.45)" textAlign="center" paddingV="30"/>
    <style as="cField" background="#1C1C1E" radius="22" paddingLeading="16" paddingTrailing="6" paddingV="6" spacing="8" alignItems="center"/>
    <style as="cSend" background="#FF2C55" radius="18" paddingH="16" paddingV="9" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <TopNav active="" visible-if="dsx.variable.wide"/>
  <hstack alignItems="stretch" style="flex: 1; min-height: 0; width: 100%">
    <!-- the stage centers its CAPPED pager: web spells it margin:auto on the pager; the
         native twin is the column's own cross alignment, platform-suffixed so the web
         sheet keeps stretch (align-self has no native bridge — the §6.21/§6.43 fork) -->
    <vstack alignItems="stretch" align:native="center" grow="width" style="flex: 1; min-width: 0">
      <zstack>
        <!-- THE CURTAIN. The stage's own art lives inside the pager row, so while the
             episode list is in flight there is no row, no image, and the screen is black —
             measured: 430ms of black on every push before this layer existed. Home already
             holds the show's hero_tall, so the art is in memory before the push begins.
             Sits at the bottom of the depth stack; the clip covers it as frames land. -->
        <image src="{{ dsx.variable.stageArt }}" visible-if="dsx.variable.stageArt != '' && dsx.variable.phase != 'ready'"
               contentFit="cover" a11yHidden="true"
               height="{{ dsx.variable.clipH }}" grow="width" style="width: 100%"/>
        <vstack visible-if="dsx.variable.phase != 'ready'"
                class="stateWrap {{ dsx.variable.stageArt == '' ? 'stateWrapBare' : 'stateWrapOverArt' }}"
                height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
                style="width: 100%; margin-left: auto; margin-right: auto; z-index: 3">
          <image icon="chevron.left" iconSize="22" paddingV="11" paddingH="11" color="#FFFFFF" on:tap="dsx.action.goBack()"
                 a11yLabel="Back" a11yTrait="button" style="align-self: flex-start"/>
          <spacer/>
          <spinner color="#FF2C55" visible-if="dsx.variable.phase == 'loading'"/>
          <text value="Loading the episode…" class="stateBody" visible-if="dsx.variable.phase == 'loading'"/>

          <image icon="play.rectangle.fill" iconSize="34" color="rgba(255,255,255,0.35)" a11yHidden="true"
                 visible-if="dsx.variable.phase != 'loading'"/>
          <text value="This series is unavailable." class="stateHead" visible-if="dsx.variable.phase == 'error'"/>
          <text value="Check your connection and try again." class="stateBody" visible-if="dsx.variable.phase == 'error'"/>
          <button label="Retry" class="stateBtn" on:tap="detail.refresh()" visible-if="dsx.variable.phase == 'error'"/>

          <text value="No episodes yet." class="stateHead" visible-if="dsx.variable.phase == 'empty'"/>
          <text value="This series has not published an episode." class="stateBody" visible-if="dsx.variable.phase == 'empty'"/>
          <button label="Browse series" class="stateBtn" on:tap="dsx.module.route.reset({ path: '/browse' })"
                  visible-if="dsx.variable.phase == 'empty'"/>
          <spacer/>
        </vstack>

        <!-- THE VERTICAL PAGER over episodes — swiping up is how this category moves to
             the next episode, and it is the whole feel of the surface. Only the RESTING
             page is active, so a fling never plays three soundtracks at once; the chrome
             lives outside and binds to the resting index, so it never moves with the art.
             `dismissEdge="left"` gives the edge swipe-back the reference has. -->
        <pager axis="vertical" ignoreSafeArea="true" bind="dsx.variable.detailView.episodes" key="id"
               value="dsx.variable.page" dots="false" dismissEdge="left" on:change="dsx.action.rest()"
               height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
               style="width: 100%; margin-left: auto; margin-right: auto">
          <!-- THE CLIP IS CENTRED IN A BLACK STAGE — the reference letterbox (ReelShort,
               Shortical, FlickReels all do this): a 16:9 master sits mid-screen at full
               width with black above and below, and the CHROME stays pinned to the screen's
               own edges rather than following the picture. grow="true" is load-bearing: a
               depth stack sizes from its non-greedy children, so once the clip became a
               226pt band the PAGE became 226pt too and the pager showed three at once. -->
          <zstack grow="true" on:tap="dsx.variable.paused = dsx.variable.paused == false">
            <!-- the KEY ART is every page's first paint — an episode that boots onto black
                 and pops a bright frame reads as a glitch; booting onto the show's art
                 reads as a curtain. Locked pages keep the art frosted; unlocked pages let
                 the clip (z-index 1, still under the z=2 chrome) cover it as frames land. -->
            <!-- the TALL HERO, never the poster: the 3:4 poster bakes its title at card
                 size, and covered into a full stage that type renders gigantic under the
                 chrome (the same measured flash the For-You fix names) -->
            <!-- THE CLIP BAND is its own box: art and clip share it, and it CLIPS. The
                 key art carries the show's own 3:4 ratio, so at full width it stood 536pt
                 tall and spilled a third of a screen of poster below the 226pt clip
                 (measured on device). One band, one height, overflow hidden. -->
            <zstack height="{{ dsx.variable.clipH }}" grow="width" style="overflow: hidden">
              <image src="{{ dsx.variable.stageArt == '' ? item.poster : dsx.variable.stageArt }}"
                     contentFit="cover" a11yHidden="true"
                     height="{{ dsx.variable.clipH }}" style="{{ stageArtFx }}"/>
              <!-- a locked page never mounts a source: entitlement is the server's word -->
              <video visible-if="gridLocked == false"
                     src="{{ item.video }}" active="{{ item.idx == Number(dsx.variable.cur) && dsx.variable.epLocked == false }}"
                     muted="{{ dsx.variable.wMuted }}" paused="dsx.variable.paused"
                     bind="dsx.variable.pos" time="dsx.variable.time" duration="dsx.variable.duration"
                     buffering="dsx.variable.buffering"
                     scrubbing="dsx.variable.scrubbing"
                     speed="{{ dsx.variable.speed }}" gravity="fill" audio="playback" loop="false"
                     pip="{{ dsx.variable.pip }}" subtitles="{{ dsx.variable.captions }}"
                     height="{{ dsx.variable.clipH }}" style="width: 100%; z-index: 1"
                     on:ready="dsx.variable.paused = false" on:ended="dsx.action.onEnded()"
                     on:error="dsx.variable.toast = 'This episode would not play — try another.'"
                     on:appear="dsx.action.boot()"/>
            </zstack>
            <!-- TAP-TO-PAUSE, the category standard: any tap on the stage toggles playback
                 (the zstack's on:tap above), and the paused stage wears the big center
                 glyph every reference app shows. passthrough keeps the glyph decorative —
                 the tap lands on the stage and toggles back. -->
            <!-- the badge rides a GREEDY centering layer: a bare 84pt child would SIZE the
                 depth stack (the cover law — non-greedy children form the box; measured:
                 the whole page collapsed to an 84pt strip), while a width/height-100%
                 wrapper is a covering layer that cannot. -->
            <vstack visible-if="dsx.variable.paused && item.idx == Number(dsx.variable.cur) && dsx.variable.epLocked == false"
                    passthrough="true" style="width: 100%; height: 100%; justify-content: center; align-items: center; pointer-events: none; z-index: 2">
              <vstack class="pauseBadge" enter="fade" anim="spring">
                <image icon="play.fill" iconSize="34" color="rgba(255,255,255,0.95)" a11yHidden="true"/>
              </vstack>
            </vstack>
          </zstack>
        </pager>

        <!-- ══ chrome: top bar · right rail · bottom ══ -->
        <!-- The chrome stays mounted from the first frame. Gating it on `ready` meant the
             bars were ABSENT for the whole load and then appeared together — the jump the
             founder reported. Only the error state, which owns the whole screen and offers
             its own way back, takes the chrome away. -->
        <vstack class="chromeLayer" visible-if="dsx.variable.phase != 'error'"
                height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
                style="width: 100%; margin-left: auto; margin-right: auto; justify-content: space-between; pointer-events: none">
          <hstack class="topBar" paddingTop="{{ dsx.variable.wide ? 0 : (dsx.screen.safeTop || 0) }}" style="pointer-events: auto">
            <image icon="chevron.left" iconSize="22" paddingV="11" paddingH="11" color="#FFFFFF" on:tap="dsx.action.goBack()" a11yLabel="Back" a11yTrait="button"/>
            <text value="EP.{{ dsx.variable.cur }}" class="epLabel"/>
            <spacer/>
            <hstack class="speedChip" on:tap="dsx.variable.sheet = 'speed'; dsx.variable.menu = true"
                    a11yGroup="true" a11yTrait="button" a11yLabel="Playback speed">
              <image icon="arrow.clockwise" iconSize="17" color="#FFFFFF" a11yHidden="true"/>
              <text value="{{ dsx.variable.speedLabel }}" class="speedText"/>
            </hstack>
            <image icon="ellipsis" iconSize="19" color="#FFFFFF" on:tap="dsx.variable.sheet = ''; dsx.variable.menu = true"
                   a11yLabel="More options" a11yTrait="button"/>
          </hstack>

          <!-- the rail sits mid-screen on the trailing edge, over the clip and its
               letterbox alike — the reference's own placement -->
          <hstack style="width: 100%; align-items: flex-end; pointer-events: none">
            <spacer/>
            <vstack class="rail" style="pointer-events: auto">
              <vstack class="railItem" on:tap="dsx.action.toggleFav()" a11yGroup="true" a11yTrait="button" a11yLabel="Save to My List">
                <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="27"
                       color="{{ dsx.variable.favOn ? '#FF2C55' : '#FFFFFF' }}" a11yHidden="true"/>
                <text value="{{ dsx.variable.favOn ? 'Saved' : 'Save' }}" class="railCap"/>
              </vstack>
              <!-- the shared catalog has no speech-bubble glyph (upstream #235); note.text
                   is the closest three-way match until one lands -->
              <vstack class="railItem" on:tap="dsx.action.openComments()" a11yGroup="true" a11yTrait="button" a11yLabel="Comments">
                <image icon="note.text" iconSize="26" color="#FFFFFF" a11yHidden="true"/>
                <text value="{{ dsx.variable.commentCount }}" class="railCount"/>
              </vstack>
              <vstack class="railItem" on:tap="dsx.action.doShare()" a11yGroup="true" a11yTrait="button" a11yLabel="Share">
                <image icon="square.and.arrow.up" iconSize="26" color="#FFFFFF" a11yHidden="true"/>
                <text value="Share" class="railCap"/>
              </vstack>
              <vstack class="railItem" on:tap="dsx.module.route.push({ path: '/vip' })" a11yGroup="true" a11yTrait="button" a11yLabel="Download — VIP">
                <!-- `align-self: center` is load-bearing: a column stack nested in a column
                     stack is handed `align-self: stretch` by the web sheet, and a stretch
                     with a definite cross size behaves as flex-start — so this anchor grew
                     to the rail's full 51px and the icon inside it sat at the LEFT edge
                     while "Download" under it stayed centred (measured, PLAN.md §6.21).
                     The badge is sized and offset to stay inside the rail: at `right: -14`
                     off a stretched anchor it ran to x=377 on a 375pt screen and clipped. -->
                <stack style="align-self: center; position: relative">
                  <image icon="square.and.arrow.down" iconSize="26" color="#FFFFFF" a11yHidden="true"/>
                  <text value="VIP" class="vipCorner" style="position: absolute; top: -6px; right: -11px"/>
                </stack>
                <text value="Download" class="railCap"/>
              </vstack>
            </vstack>
          </hstack>

          <!-- pinned to the screen's bottom edge, over the letterbox — the reference
               keeps the transport at the edge, not tucked under the picture -->
          <vstack class="bottomBar" paddingBottom="{{ dsx.variable.wide ? 0 : (dsx.screen.safeBottom || 0) }}" style="pointer-events: auto">
            <text value="{{ dsx.variable.toast }}" visible-if="dsx.variable.toast != ''" class="toastLine"/>
            <!-- grow="width" on the SURFACE, not just the track: web gives a block-level
                 stack the full row for free, native hugs it — so the track's own
                 grow="width" had nothing to fill and the rail never painted (measured on
                 device: no 4pt band anywhere right of the pin, while web read 362px). -->
            <!-- THE SCRUB READOUT. Always mounted, never inserted: it rises and fades on
                 the tween (opacity + offsetY + scale off `scrubbing`), so it arrives the way
                 the reference players do instead of popping in on an insertion transition —
                 and because it holds its row at opacity 0, the transport never shifts under
                 the finger when it appears. -->
            <hstack spacing="4" align="center" height="18" style="justify-content: center"
                    opacity="{{ dsx.variable.scrubbing ? 1 : 0 }}"
                    offsetY="{{ dsx.variable.scrubbing ? 0 : 7 }}"
                    scale="{{ dsx.variable.scrubbing ? 1 : 0.94 }}"
                    anim="easeOut" animDuration="0.22"
                    a11yHidden="{{ dsx.variable.scrubbing ? 'false' : 'true' }}">
              <text value="{{ dsx.variable.posLabel }}" class="seekTimeNow"/>
              <text value="/" class="seekTimeAll"/>
              <text value="{{ dsx.variable.durLabel }}" class="seekTimeAll"/>
            </hstack>
            <stack height="26" grow="width" style="justify-content: center" on:drag="dsx.action.seek()" a11yLabel="Seek"
                   on:dragStart="dsx.variable.scrubbing = true" on:dragEnd="dsx.variable.scrubbing = false"
                   a11yValue="{{ Math.round(dsx.variable.pos * 100) }} percent"
                   on:adjust="dsx.variable.pos = dsx.variable.pos + (dsx.this.direction == 'increment' ? 0.05 : -0.05)">
              <!-- THE REFERENCE SCRUBBER (custom-ux.md, PlayerScrubber): track + fill +
                   thumb off one measured box, drag/tap = seek, playback moves the fill
                   through the shared <video bind>. One markup, every renderer. -->
              <zstack grow="width" height="22" align="leading" measure="dsx.variable.seekBox">
                <vstack grow="width" height="4" radius="2" background="rgba(255,255,255,0.28)"/>
                <!-- the GLIDE: playback ticks position 4×/s and anim= tweens the change
                     linearly between ticks (custom-ux.md §3 — both renderers), so the fill
                     and thumb TRAVEL instead of stepping. While the finger owns the bar the
                     tween stands down — a scrub must track the touch, not lag it. -->
                <!-- BOTH ON THE COMPOSITOR, which is what keeps them welded AND smooth.
                     Animating the fill's `width` is a layout pass on the main thread while
                     an offsetX pin is a transform on the compositor: two pipelines, two
                     rates, and the pin visibly drifted from the edge (measured on web: an
                     11px sawtooth). Parenting the pin to the fill welded them but left the
                     motion itself steppy, because layout animation is what it is. `scaleX`
                     on a full-width bar is the CSS answer and is now a real DSX primitive
                     (transformOrigin picks the anchor) — fill and pin are both transforms,
                     so they share one pipeline, one rate, and the GPU. The right cap's
                     squash under scale is exactly where the pin sits, so it never shows.
                     The tween outruns the player's 250ms tick so motion never waits. -->
                <vstack grow="width" height="4" radius="2" background="#FFFFFF"
                        scaleX="{{ dsx.variable.pos }}" transformOrigin="leading"
                        anim="{{ dsx.variable.scrubbing ? 'none' : 'linear' }}" animDuration="0.32"/>
                <vstack width="14" height="14" radius="7" background="#FFFFFF" shadow="3"
                        offsetX="{{ (dsx.variable.pos * (dsx.variable.seekBox.width || 1)) - 7 }}"
                        anim="{{ dsx.variable.scrubbing ? 'none' : 'linear' }}" animDuration="0.32"/>
              </zstack>
            </stack>
            <!-- the pill RAISES the drawer only in the lane that has one; with the panel
                 beside the clip it is a readout, not a control that opens a duplicate list -->
            <hstack class="epPill" on:tap="dsx.variable.drawer = dsx.variable.panel == false"
                    a11yGroup="true" a11yTrait="{{ dsx.variable.panel ? 'text' : 'button' }}"
                    a11yLabel="Episode {{ dsx.variable.cur }} of {{ dsx.variable.total }}">
              <image icon="rectangle.stack.fill" iconSize="17" color="#FFFFFF" a11yHidden="true"/>
              <text value="EP.{{ dsx.variable.cur }}" class="epPillNow"/>
              <!-- the total is unknown until the episode list lands; "/ EP.0" for a beat
                   is the kind of detail that reads as a half-built app -->
              <text value="/ EP.{{ dsx.variable.total }}" class="epPillAll" visible-if="dsx.variable.total > 0"/>
              <spacer/>
              <image icon="chevron.up.chevron.down" iconSize="14" color="rgba(255,255,255,0.7)"
                     a11yHidden="true" visible-if="dsx.variable.panel == false"/>
            </hstack>
          </vstack>
        </vstack>

        <!-- ══ the locked stage ══ The dim is the BASE read on every renderer; the frost
             is the web enhancement (an unmapped declaration passes through on web and is
             dropped per-declaration native, so nothing load-bearing rides it). The X is
             the paywall's own way out — a wall the viewer cannot leave is a refund. -->
        <vstack class="lockedLayer" visible-if="dsx.variable.epLocked" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
                style="width: 100%; margin-left: auto; margin-right: auto; align-items: center; justify-content: center; backdrop-filter: blur(22px) saturate(1.15); -webkit-backdrop-filter: blur(22px) saturate(1.15)" background="rgba(0,0,0,0.45)">
          <!-- THE SAFE-AREA LAW: the stage is full-bleed, so a corner control pays the top
               inset back through the FACT — 0 in a browser tab and on the wide lane (the
               nav consumed it), real on a notched phone and in a standalone PWA. -->
          <vstack class="lockClose" style="position: absolute; top: {{ (dsx.variable.wide ? 0 : (dsx.screen.safeTop || 0)) + 14 }}px; right: 14px; justify-content: center; z-index: 1"
                  on:tap="dsx.action.goBack()" a11yTrait="button" a11yLabel="Close and go back">
            <image icon="xmark" iconSize="15" color="rgba(255,255,255,0.9)" a11yHidden="true"/>
          </vstack>
          <vstack class="lockBlock" enter="fade" anim="spring">
            <image icon="lock.fill" iconSize="26" color="rgba(255,255,255,0.85)" a11yHidden="true"/>
            <text value="This is a paid episode.
Please unlock to watch." class="lockHead"/>
            <hstack class="unlockBtn" on:tap="dsx.action.unlockNow()" a11yGroup="true" a11yTrait="button"
                    a11yLabel="Unlock this episode for {{ dsx.variable.episode == null ? '' : dsx.variable.episode.price }} coins">
              <image src="/assets/coin.svg" a11yHidden="true" style="width: 18px; height: 18px"
                     visible-if="dsx.variable.unlocking == false"/>
              <text value="{{ dsx.variable.unlockLabel }}" class="unlockLabelTxt"/>
            </hstack>
            <hstack class="lockDoors">
              <!-- pill labels NEVER wrap ("Get coins" measured 105px wide with 40px of
                   padding: the space became a break point and the label split — not a
                   renderer bug, white-space: normal is the web default; the pill idiom
                   is nowrap + hug) -->
              <button label="Get coins" class="earnBtn" style="flex: 1; white-space: nowrap" on:tap="dsx.module.route.push({ path: '/store' })"/>
              <button label="Earn free" class="earnBtn" style="flex: 1; white-space: nowrap" on:tap="dsx.module.route.push({ path: '/rewards' })"/>
            </hstack>
            <hstack class="lockMetaRow" a11yGroup="true" a11yLabel="Balance {{ dsx.variable.balance }} coins">
              <text value="Balance:" class="lockMeta"/>
              <image src="/assets/coin.svg" a11yHidden="true" style="width: 15px; height: 15px"/>
              <text value="{{ dsx.variable.balance }}" class="lockMeta"/>
            </hstack>
            <hstack class="autoRow" on:tap="dsx.variable.autoUnlock = !dsx.variable.autoUnlock"
                    a11yGroup="true" a11yTrait="button"
                    a11yLabel="Auto-unlock next episodes, {{ dsx.variable.autoUnlock ? 'on' : 'off' }}">
              <!-- the control ANIMATES rather than snapping: the box springs on toggle and
                   the tick scales in behind it (web enhancement; native gets the platform
                   control's own animation) -->
              <vstack class="checkBox" background="{{ dsx.variable.autoUnlock ? '#FF2C55' : 'rgba(255,255,255,0.08)' }}"
                      style="justify-content: center; border: 1.5px solid {{ dsx.variable.autoUnlock ? '#FF2C55' : 'rgba(255,255,255,0.32)' }}; transition: background 0.18s ease, border-color 0.18s ease, transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1); transform: scale({{ dsx.variable.autoUnlock ? 1.08 : 1 }})">
                <image icon="checkmark" iconSize="12" color="#FFFFFF" a11yHidden="true"
                       style="transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.16s ease; transform: scale({{ dsx.variable.autoUnlock ? 1 : 0.3 }}); opacity: {{ dsx.variable.autoUnlock ? 1 : 0 }}"/>
              </vstack>
              <text value="Auto-unlock next episodes" class="autoLabel"/>
            </hstack>
          </vstack>
        </vstack>
      </zstack>
    </vstack>
    <!-- ══ the DESKTOP episode panel — the shape every reference player uses ══
         A sibling of the clip column, never an overlay: it owns real estate the video was
         wasting, and it scrolls on its own so a 60-episode grid never moves the clip. It is
         the drawer's content, laid out permanently — same ranges, same 6-column grid, same
         lock and now-playing tells — so the two lanes cannot drift apart in behaviour. -->
    <scroll class="panelScroll" visible-if="dsx.variable.panel && dsx.variable.phase == 'ready'"
            style="width: 416px; flex: none; height: {{ dsx.variable.stageH }}px">
      <vstack class="panelBody">

        <hstack class="panelCrumbs">
          <text value="Home" class="crumb" a11yTrait="button"
                on:tap="dsx.module.route.reset({ path: '/' })"/>
          <text value="/" class="crumb" a11yHidden="true"/>
          <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.title }}" class="crumb"
                a11yTrait="button" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis"
                on:tap="dsx.module.route.push({ path: '/show/' + dsx.variable.showId })"/>
          <text value="/" class="crumb" a11yHidden="true"/>
          <text value="Episode {{ dsx.variable.cur }}" class="crumbOn"/>
        </hstack>

        <text value="Episode {{ dsx.variable.cur }} — {{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.title }}"
              class="panelTitle"
              style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>

        <hstack class="panelTags">
          <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.genre }}" class="tag" a11yTrait="button"
                href="/browse/{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.genre }}"/>
          <text value="EP 1–{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.free_until }} Free" class="tag"/>
        </hstack>
        <flow class="tagFlow" bind="dsx.variable.showTags" key="name" spacing="6" lineSpacing="6"
              visible-if="dsx.variable.showTags.length > 0">
          <text value="{{ item.name }}" class="tagSoft" a11yTrait="button"
                a11yLabel="Browse {{ item.name }}" href="/browse/{{ item.name }}"/>
        </flow>

        <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.synopsis }}" class="panelPlot"
              style="{{ dsx.variable.plotFx }}"/>
        <text value="{{ dsx.variable.plotOpen ? 'Show less' : 'Show more' }}" class="panelMore"
              a11yTrait="button" on:tap="dsx.variable.plotOpen = !dsx.variable.plotOpen"/>

        <hstack class="panelStats" visible-if="dsx.variable.panelViews != ''">
          <image icon="play.fill" iconSize="14" color="rgba(255,255,255,0.5)" a11yHidden="true"/>
          <text value="{{ dsx.variable.panelViews }}" class="panelStat"
                a11yLabel="{{ dsx.variable.panelViews }} views"/>
          <image icon="star.fill" iconSize="13" color="#F6B63D" a11yHidden="true"/>
          <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.rating }}" class="panelStat"
                a11yLabel="rated {{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.rating }} out of 10"/>
          <spacer/>
          <hstack class="panelAct" on:tap="dsx.action.toggleFav()" a11yGroup="true" a11yTrait="button"
                  a11yLabel="{{ dsx.variable.favOn ? 'Remove from My List' : 'Save to My List' }}">
            <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="15"
                   color="{{ dsx.variable.favOn ? '#FF2C55' : '#FFFFFF' }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.favOn ? 'Saved' : 'Save' }}" class="panelStat"/>
          </hstack>
          <hstack class="panelAct" on:tap="dsx.action.doShare()" a11yGroup="true" a11yTrait="button" a11yLabel="Share">
            <image icon="square.and.arrow.up" iconSize="15" color="#FFFFFF" a11yHidden="true"/>
            <text value="Share" class="panelStat"/>
          </hstack>
        </hstack>

        <hstack class="panelRanges">
          <list bind="dsx.variable.ranges" key="id" axis="horizontal" scroll="false" spacing="16">
            <text value="{{ item.label }}" class="rangeTxt"
                  color="{{ item.from - 1 == Number(dsx.variable.range) * 30 ? '#FF2C55' : 'rgba(255,255,255,0.6)' }}"
                  on:tap="dsx.variable.range = (item.from - 1) / 30" a11yTrait="button"/>
          </list>
          <spacer/>
          <text value="{{ dsx.variable.total }} EP" class="panelStat"/>
        </hstack>

        <!-- the cell is the DIRECT grid child: a wrapper loses the column width (AGENTS.md) -->
        <grid bind="dsx.variable.visibleEps" key="id" columns="6" spacing="8" scroll="false">
          <vstack class="epCell" style="position: relative; aspect-ratio: 1/1; justify-content: center; overflow: hidden"
                  on:tap="dsx.action.go({ target: item.idx })"
                  background="{{ item.idx == Number(dsx.variable.cur) ? '#FF2C55' : '#2C2C2E' }}"
                  a11yLabel="Episode {{ item.idx }}{{ gridLocked ? ', VIP' : '' }}" a11yTrait="button" a11yGroup="true">
            <text value="{{ item.idx }}" class="epNum" color="#FFFFFF"/>
            <text value="VIP" class="cellTag" visible-if="gridLocked"
                  style="position: absolute; top: 0; right: 0; border-bottom-left-radius: 6px"/>
            <image icon="waveform" iconSize="11" color="#FFFFFF" visible-if="item.idx == Number(dsx.variable.cur)"
                   a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
          </vstack>
        </grid>

      </vstack>
    </scroll>
  </hstack>

  <!-- ══════ the episode drawer ══════ -->
  <sheet present="dsx.variable.drawer" detents="half,full" background="#141414"
         on:dismiss="dsx.variable.drawer = false">
    <scroll style="flex: 1; min-height: 0">
      <vstack alignItems="stretch">
        <hstack class="drawerHead">
          <image src="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.poster }}" contentFit="cover" a11yHidden="true"
                 style="width: 52px; height: 69px; border-radius: 8px; object-fit: cover"/>
          <vstack spacing="4" style="flex: 1; min-width: 0">
            <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.title }}" class="drawerTitle"
                  style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden"/>
            <text value="All {{ dsx.variable.total }} Episodes" class="drawerSub"/>
          </vstack>
          <button label="{{ dsx.variable.favOn ? 'Following' : 'Follow' }}" class="followBtn"
                  background="{{ dsx.variable.favOn ? '#8E1637' : '#FF2C55' }}" on:tap="dsx.action.toggleFav()"/>
        </hstack>

        <!-- THE TABS ARE A TAB BAR, so the rule TRAVELS. Each label used to own a rule
             that visible-if switched on and off, which is a jump cut — the ink vanished
             under one word and reappeared under the other. The rule now lives once, in
             its own rail below the labels, and moves between them on offsetX (a
             compositor transform) while its width morphs to the label it lands on. Both
             are bindable transforms the value-tween carries on every renderer:
             web through a CSS transition, iOS through StackNodeView's anim tween
             (dev@ca2b0c78). -->
        <!-- labels and rail are ONE band with `spacing="0"`: they are two children where
             there used to be one, and the drawer column's default 8pt gap would otherwise
             float the rule 13pt under its label instead of the measured 5. -->
        <vstack spacing="0" alignItems="stretch">
          <hstack class="tabRow">
            <vstack class="tabHit" on:tap="dsx.variable.drawerTab = 'synopsis'" a11yTrait="button"
                    a11yLabel="Synopsis{{ dsx.variable.drawerTab == 'synopsis' ? ', selected' : '' }}">
              <text value="Synopsis" class="tabTxt" measure="dsx.variable.tabSynBox"
                    color="{{ dsx.variable.drawerTab == 'synopsis' ? '#FF2C55' : 'rgba(255,255,255,0.75)' }}"/>
            </vstack>
            <vstack class="tabHit" on:tap="dsx.variable.drawerTab = 'episodes'" a11yTrait="button"
                    a11yLabel="Episodes{{ dsx.variable.drawerTab == 'episodes' ? ', selected' : '' }}">
              <text value="Episodes" class="tabTxt" measure="dsx.variable.tabEpBox"
                    color="{{ dsx.variable.drawerTab == 'episodes' ? '#FF2C55' : 'rgba(255,255,255,0.75)' }}"/>
            </vstack>
          </hstack>
          <zstack class="tabRail" grow="width" align="leading" style="width: 100%">
            <stack class="tabUnderline" width="{{ dsx.variable.tabUnderW }}"
                   offsetX="{{ dsx.variable.tabUnderX }}" anim="easeOut" animDuration="0.2"/>
          </zstack>
        </vstack>
        <stack height="1" background="rgba(255,255,255,0.08)" style="width: 100%"/>

        <!-- ══ THE TWO PANES CROSS-FADE — they do not swap ══
             Both stay MOUNTED in one depth stack and change only opacity and offsetX,
             the two things that tween identically on both lanes (a CSS transition on
             web, StackNodeView's anim value-tween on iOS — dev@ca2b0c78). The travel is
             16pt in the DIRECTION of the switch: Synopsis is the LEFT tab, so it leaves
             to the left and Episodes arrives from the right. 16 is not a taste number —
             it is the framework's own declared slide distance (element-motion.ts
             `motionFrom`, the web twin of SwiftUI `.move(edge:)`).

             `keep="true"` is what makes a mounted-but-hidden pane HONEST, and it is the
             only spelling that does it on both lanes: the framework fades it on the
             curve declared here, turns hit-testing off (`allowsHitTesting(false)` /
             `pointer-events: none`) and marks it aria-hidden + inert. Without it, 60
             invisible episode cells sit over the synopsis and swallow the genre chip's
             tap. (`passthrough=` cannot do this job: both renderers read it as a RAW
             literal `=== "true"`, so it is not bindable.)

             WHY NOT `transition=`: an insert/remove cannot cross-fade — the outgoing
             pane is already gone when the incoming one paints — and `transition="slide-*"`
             is the one token whose lanes genuinely differ (native moves the whole
             container edge, web moves 16px; documented in element-motion.ts).
             WHY THE MEASURED HEIGHT: a depth stack is as tall as its tallest child and
             both children are always mounted, so `paneH` holds the stack to the pane you
             are looking at. `position: absolute` would be the other way to keep the idle
             pane out of the box and it CANNOT be used here: the native detacher is a
             raw-literal sniff (StackAbsolutePlane.isAbsolute), so a computed
             `position: absolute` stays in flow on iOS and Android and only web collapses.
             `overflow: hidden` is the WEB half of that height: a fixed native frame
             already reports its own size to the scroller, but a CSS box lets an
             overflowing child extend the SCROLLER's extent, so the idle pane would put
             its full height back as dead scroll. The native twin is the frame itself. -->
        <zstack height="{{ dsx.variable.paneH }}" grow="width" align="topLeading"
                style="width: 100%; overflow: hidden">

          <!-- Synopsis -->
          <vstack keep="true" visible-if="dsx.variable.drawerTab == 'synopsis'"
                  anim="easeOut" animDuration="0.2" grow="width" alignItems="stretch"
                  measure="dsx.variable.synPaneBox" style="width: 100%">
            <vstack class="synopsisWrap" grow="width" style="width: 100%"
                    offsetX="{{ dsx.variable.drawerTab == 'synopsis' ? 0 : -16 }}"
                    anim="easeOut" animDuration="0.2">
              <hstack class="tagRow">
                <!-- THE GENRE CHIP IS A ROUTE, the same one the desktop panel's chip
                     takes: /browse/:genre is declared in dsx.config.json and the Browse
                     screen filters on genre OR tag, so "Revenge" lands on a real result
                     set. `href` is the link idiom for a chip whose text stays plain
                     (a <button> is for a CTA that owns its background).
                     "Series" stays INERT deliberately: it is a FORMAT, not a genre and
                     not a tag, so /browse/Series would route to an empty Browse — a
                     control that reaches nothing is worse than a label. -->
                <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.genre }}" class="tag"
                      a11yTrait="button"
                      a11yLabel="Browse {{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.genre }}"
                      href="/browse/{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.genre }}"/>
                <text value="Series" class="tag"/>
              </hstack>
              <text value="{{ dsx.variable.detailView == null ? '' : dsx.variable.detailView.show.synopsis }}" class="synopsisTxt"/>
            </vstack>
          </vstack>

          <!-- Episodes -->
          <vstack keep="true" visible-if="dsx.variable.drawerTab == 'episodes'"
                  anim="easeOut" animDuration="0.2" grow="width" alignItems="stretch"
                  measure="dsx.variable.epPaneBox" style="width: 100%">
            <vstack alignItems="stretch" grow="width" style="width: 100%"
                    offsetX="{{ dsx.variable.drawerTab == 'episodes' ? 0 : 16 }}"
                    anim="easeOut" animDuration="0.2">
              <hstack class="rangeRow">
                <list bind="dsx.variable.ranges" key="id" axis="horizontal" scroll="false" spacing="18">
                  <text value="{{ item.label }}" class="rangeTxt"
                        color="{{ item.from - 1 == Number(dsx.variable.range) * 30 ? '#FF2C55' : 'rgba(255,255,255,0.6)' }}"
                        on:tap="dsx.variable.range = (item.from - 1) / 30" a11yTrait="button"/>
                </list>
                <spacer/>
                <hstack spacing="6" alignItems="center" on:tap="dsx.module.route.push({ path: '/vip' })"
                        a11yGroup="true" a11yTrait="button" a11yLabel="Download episodes — VIP">
                  <image icon="square.and.arrow.down" iconSize="20" color="#FFFFFF" a11yHidden="true"/>
                  <text value="VIP" class="vipTag"/>
                </hstack>
              </hstack>
              <vstack class="epGridWrap">
                <!-- the cell is the DIRECT grid child: a wrapper here loses the column width
                     (AGENTS.md). The VIP tag overlays by position, flow-fallback on native. -->
                <grid bind="dsx.variable.visibleEps" key="id" columns="6" spacing="8" scroll="false">
                  <vstack class="epCell" style="position: relative; aspect-ratio: 1/1; justify-content: center; overflow: hidden"
                          on:tap="dsx.action.go({ target: item.idx })"
                          background="{{ item.idx == Number(dsx.variable.cur) ? '#FF2C55' : '#2C2C2E' }}"
                          a11yLabel="Episode {{ item.idx }}{{ gridLocked ? ', VIP' : '' }}" a11yTrait="button" a11yGroup="true">
                    <text value="{{ item.idx }}" class="epNum" color="#FFFFFF"/>
                    <!-- the corner tab: flush to the cell's own corner, never over the numeral -->
                    <text value="VIP" class="cellTag" visible-if="gridLocked"
                          style="position: absolute; top: 0; right: 0; border-bottom-left-radius: 6px"/>
                    <!-- the now-playing tell the reference puts on the current cell -->
                    <image icon="waveform" iconSize="11" color="#FFFFFF" visible-if="item.idx == Number(dsx.variable.cur)"
                           a11yHidden="true" style="position: absolute; top: 4px; right: 5px"/>
                  </vstack>
                </grid>
              </vstack>
            </vstack>
          </vstack>
        </zstack>
      </vstack>
    </scroll>
  </sheet>

  <!-- ══════ options: the ⋯ stack ══════ -->
  <sheet present="dsx.variable.menu" detents="content" background="#141414"
         on:dismiss="dsx.variable.menu = false; dsx.variable.sheet = ''">
    <vstack class="menuBody" enter="slide-bottom" anim="spring">
      <!-- root -->
      <vstack visible-if="dsx.variable.sheet == ''" alignItems="stretch">
        <text value="More" class="menuHead"/>
        <vstack class="menuCard">
          <!-- SUBTITLES IS REAL: `<video subtitles>` is a declared boolean, so this toggle
               reaches the player. The eleven-language PICKER that used to live behind this
               row was not — `<video>` has no track or language attribute — so a viewer chose
               "Tamil" and got whatever the asset carried. The picker is gone; the switch that
               works stayed (PLAN.md §6.36). -->
          <hstack class="menuRow" a11yGroup="true" a11yLabel="Subtitles">
            <image icon="globe" iconSize="20" color="#FFFFFF" a11yHidden="true"/>
            <text value="Subtitles" class="menuLabel" style="flex: 1"/>
            <toggle bind="dsx.variable.captions" color="#FF2C55" a11yLabel="Subtitles"/>
          </hstack>
          <stack height="1" background="rgba(255,255,255,0.07)" style="width: 100%"/>
          <!-- QUALITY IS NAMED, NOT FAKED (Article 7, the AdGate precedent). `<video>` has no
               quality attribute, so the 240p–1080p ladder this row used to open changed
               nothing — and it priced 1080p behind VIP, which made it a paywall on a no-op.
               The row stays as an honest disabled readout; the ask is filed upstream. -->
          <hstack class="menuRow" a11yGroup="true" a11yLabel="Quality: adaptive. A quality ladder needs renderer support and is not available in this build.">
            <image icon="slider.horizontal.3" iconSize="20" color="rgba(255,255,255,0.4)" a11yHidden="true"/>
            <vstack spacing="2" style="flex: 1">
              <text value="Quality" class="menuLabel" color="rgba(255,255,255,0.4)"/>
              <text value="Adaptive — one rendition in this build" class="optNote"/>
            </vstack>
          </hstack>
          <stack height="1" background="rgba(255,255,255,0.07)" style="width: 100%"/>
          <vstack spacing="10" alignItems="stretch" paddingV="13">
            <hstack spacing="14" alignItems="center">
              <image icon="arrow.clockwise" iconSize="20" color="#FFFFFF" a11yHidden="true"/>
              <text value="Speed" class="menuLabel"/>
            </hstack>
            <!-- A REAL SEGMENTED CONTROL, AND IT MOVES LIKE ONE.
                 Seven pills never fit a 390 sheet (measured: 3.0x ran 27px past the
                 viewport), so this was a horizontal SCROLLER — a control with a
                 scrollbar through it, and a selection that only REPAINTED: tap a rung
                 and the highlight teleported. Four rungs fit the row at every supported
                 width, so the scroller is gone and the segments are equal quarters
                 (`flex: 1` = `1 1 0%`, which divides the track EVENLY — the catalog's
                 `grow="width"` alone is `flex-grow: 1` with an auto basis, so "0.75x"
                 would take more room than "1.0x"; both spellings are written, the
                 attribute for the native lane and the raw literal for the web sheet).
                 THE INDICATOR IS ONE ELEMENT that travels: a constant width and an
                 offsetX computed off the measured track, both compositor transforms on
                 one element, so they cannot drift from each other and the same markup
                 tweens on web and on iOS (dev@ca2b0c78). Never `width: N%` — the native
                 bridge drops non-100 percent lengths (upstream #281).
                 zIndex ON THE LABEL ROW is load-bearing: the pill carries a transform,
                 and a transformed sibling paints ABOVE later plain siblings (the
                 badgeWrap law) — without it the pill covers the labels it sits under. -->
            <vstack class="speedSeg">
              <zstack grow="width" align="leading" measure="dsx.variable.segBox" style="width: 100%">
                <vstack class="speedPill" grow="height" style="height: 100%"
                        width="{{ Math.round((dsx.variable.segBox.width || 0) / 4) }}"
                        offsetX="{{ Math.round((dsx.variable.segBox.width || 0) / 4 * dsx.variable.speedIdx) }}"
                        anim="easeOut" animDuration="0.22"/>
                <list bind="dsx.variable.speedOptions" key="id" axis="horizontal" scroll="false"
                      spacing="0" grow="width" zIndex="1" style="width: 100%">
                  <text value="{{ item.label }}" class="speedOpt" grow="width" style="flex: 1"
                        color="{{ item.v == dsx.variable.speed ? '#FFFFFF' : 'rgba(255,255,255,0.55)' }}"
                        on:tap="dsx.variable.speed = item.v" a11yTrait="button"
                        a11yLabel="{{ item.label }} speed{{ item.v == dsx.variable.speed ? ', selected' : '' }}"/>
                </list>
              </zstack>
            </vstack>
          </vstack>
          <stack height="1" background="rgba(255,255,255,0.07)" style="width: 100%"/>
          <hstack class="menuRow" a11yGroup="true" a11yLabel="Picture in picture">
            <image icon="rectangle.stack.fill" iconSize="20" color="#FFFFFF" a11yHidden="true"/>
            <text value="Picture in Picture" class="menuLabel" style="flex: 1"/>
            <toggle bind="dsx.variable.pip" color="#FF2C55" a11yLabel="Picture in picture"/>
          </hstack>
        </vstack>
      </vstack>

      <!-- speed -->
      <vstack visible-if="dsx.variable.sheet == 'speed'" alignItems="stretch">
        <hstack alignItems="center" paddingBottom="8">
          <image icon="chevron.left" iconSize="19" paddingV="12" paddingH="12" color="#FFFFFF" on:tap="dsx.variable.sheet = ''" a11yLabel="Back" a11yTrait="button"/>
          <text value="Playback Speed" class="menuHead"/>
        </hstack>
        <list bind="dsx.variable.speedOptions" key="id" scroll="false" spacing="2">
          <hstack class="optRow" on:tap="dsx.variable.speed = item.v" a11yTrait="button" a11yLabel="{{ item.label }}"
                  background="{{ item.v == dsx.variable.speed ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0)' }}">
            <image icon="checkmark" iconSize="15" color="#FF2C55" visible-if="item.v == dsx.variable.speed" a11yHidden="true"/>
            <text value="{{ item.label }}" class="optLabel" color="#FFFFFF"/>
          </hstack>
        </list>
      </vstack>
    </vstack>
  </sheet>

  <!-- ══════ comments ══════ -->
  <sheet present="dsx.variable.comments" detents="half,full" background="#141414"
         on:dismiss="dsx.variable.comments = false">
    <vstack alignItems="stretch" style="flex: 1; min-height: 0">
      <hstack class="cHead">
        <text value="{{ dsx.variable.commentLabel }}" class="cTitle" style="flex: 1"/>
      </hstack>
      <stack height="1" background="rgba(255,255,255,0.08)" style="width: 100%"/>
      <scroll style="flex: 1; min-height: 0">
        <vstack alignItems="stretch">
          <text class="cEmpty" visible-if="thread.data != null && thread.data.count == 0"
                value="No comments yet — be the first."/>
          <list bind="thread.data.rows" key="id" scroll="false" spacing="0">
            <hstack class="cRow">
              <vstack class="cAvatar" style="justify-content: center">
                <image icon="person.fill" iconSize="16" color="rgba(255,255,255,0.5)" a11yHidden="true"/>
              </vstack>
              <vstack spacing="5" style="flex: 1; min-width: 0">
                <text value="{{ item.author }}" class="cAuthor"/>
                <text value="{{ item.body }}" class="cBody"/>
                <text value="{{ item.likes }} likes" class="cMeta"/>
              </vstack>
            </hstack>
          </list>
        </vstack>
      </scroll>
      <hstack style="padding: 12px 16px 20px 16px">
        <hstack class="cField" style="flex: 1">
          <textfield bind="dsx.variable.draft" placeholder="Enter your comment here..." color="#FFFFFF"
                     style="flex: 1" on:submit="dsx.action.postComment()"/>
          <button label="Submit" class="cSend" on:tap="dsx.action.postComment()"/>
        </hstack>
      </hstack>
    </vstack>
  </sheet>
</vstack>
