<!-- Watch — the vertical player. Phone: full-bleed video with in-stage chrome. Wide:
     the category-standard two-column face — the 9:16 stage on the left, and the details
     panel on the right (breadcrumb · episode H1 · plot · tags · My List · the numbered
     episode grid with lock badges, current episode tinted red).

     TRUST SHAPE (product spec §3): the client never decides entitlement — `epLocked`
     reads /wallet/state, the Unlock button calls the server, and the video only mounts
     an unlocked source. Auto-unlock spends server-side too; this surface just asks.
     Native lane swaps this file for VerticalPlayerStack — same payload, same events
     (upstream #215: its web facet). -->
<vstack background="#000000" alignItems="stretch" style="min-height: {{ dsx.screen.height }}px">
  <head>
    <!-- route /watch/:show/:idx — params arrive as vars.show / vars.idx -->
    <api as="detail" url="/catalog/show/{{ vars.show }}"/>
    <api as="session" url="/dev-session.json" ssr="false"/>
    <api as="wallet" url="/wallet/state" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="favs" url="/viewer/list" ssr="false" needs="session" headers="dsx.variable.authHeaders"/>
    <api as="unlockCall" url="/wallet/unlock" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="progressCall" url="/viewer/progress" method="POST" auto="false" headers="dsx.variable.authHeaders"/>
    <api as="favCall" url="/viewer/favorite" method="POST" auto="false" headers="dsx.variable.authHeaders"/>

    <variable as="cur">return 1</variable>
    <variable as="showId">return ''</variable>   <!-- vars.* is markup scope; actions read this mirror -->
    <variable as="paused">return false</variable>
    <variable as="wMuted">return true</variable>   <!-- web autoplay policy: start muted, one tap for sound -->
    <variable as="pos">return 0</variable>          <!-- 0–1 position fraction (video bind) -->
    <variable as="time">return 0</variable>
    <variable as="duration">return 0</variable>
    <variable as="speed">return 1</variable>
    <variable as="drawer">return false</variable>
    <variable as="autoUnlock">return true</variable>   <!-- on by default: the category standard -->
    <variable as="unlocking">return false</variable>
    <variable as="toast">return ''</variable>
    <variable as="favTouched">return ''</variable>
    <variable as="holding">return false</variable>    <!-- hold-to-2x is active -->
    <variable as="menu">return false</variable>       <!-- the ⋯ options sheet -->
    <variable as="captions">return true</variable>
    <variable as="lang">return 'English'</variable>  <!-- '' until toggled; then 'y' / 'n' -->

    <variable as="bp" computed="true">
      const s = dsx.screen.width
      if (s >= 1120) { return 'desktop' }
      if (s >= 768) { return 'tablet' }
      return 'phone'
    </variable>
    <variable as="wide" computed="true">return dsx.variable.bp != 'phone'</variable>
    <!-- the stage loses the nav's height on wide viewports -->
    <variable as="stageH" computed="true">
      if (dsx.variable.wide) { return dsx.screen.height - 62 }
      return dsx.screen.height
    </variable>
    <!-- The stage is ONE interpolated number fed to the catalog's maxWidth, not a CSS
         chunk spliced into style= (see Discover for why). -->
    <variable as="stageMax" computed="true">
      if (dsx.variable.bp == 'phone') { return 4096 }
      return Math.round(Math.min(461, dsx.screen.height * 0.56))
    </variable>

    <variable as="episode" computed="true">
      if (detail.data == null) { return null }
      const eps = detail.data.episodes
      const i = Number(dsx.variable.cur)
      if (i < 1 || i > eps.length) { return null }
      return eps[i - 1]
    </variable>
    <variable as="epLocked" computed="true">
      const ep = dsx.variable.episode
      if (ep == null) { return false }
      if (ep.free) { return false }
      if (wallet.data == null) { return true }
      return !wallet.data.unlocked.includes(ep.id)
    </variable>
    <variable as="balance" computed="true">
      if (wallet.data == null) { return 0 }
      return wallet.data.coins + wallet.data.bonus
    </variable>
    <variable as="unlockLabel" computed="true">
      if (dsx.variable.unlocking) { return 'Unlocking…' }
      const ep = dsx.variable.episode
      return (ep == null ? '' : ep.price) + '  Unlock Now'
    </variable>
    <variable as="favOn" computed="true">
      if (dsx.variable.favTouched != '') { return dsx.variable.favTouched == 'y' }
      if (favs.data == null) { return false }
      return favs.data.items.filter(x => x.show == dsx.variable.showId).length > 0
    </variable>
    <variable as="authHeaders" computed="true">
      if (session.data == null) { return {} }
      return { authorization: 'Bearer ' + session.data.viewer.token }
    </variable>

    <formula as="gridLocked" free="item.free" epid="item.id">
      if (free) { return false }
      if (wallet.data == null) { return true }
      return !wallet.data.unlocked.includes(epid)
    </formula>

    <action as="boot" show="vars.show" idx="vars.idx">
      dsx.variable.showId = show;
      dsx.variable.cur = Number(idx)
    </action>
    <action as="saveNow" epid="dsx.variable.episode == null ? '' : dsx.variable.episode.id" epidx="dsx.variable.cur" locked="dsx.variable.epLocked">
      if (epid == null || epid === '' || locked) { return }
      await progressCall.send({ episode: epid, show: dsx.variable.showId, idx: Number(epidx), position: dsx.variable.time })
    </action>
    <action as="go" to="target">
      if (detail.data == null) { return }
      const n = Number(target)
      if (n < 1 || n > detail.data.episodes.length) { return }
      dsx.action.saveNow();
      dsx.variable.cur = n;
      dsx.variable.pos = 0;
      dsx.variable.paused = false;
      dsx.variable.drawer = false
    </action>
    <action as="next">
      dsx.action.go({ target: Number(dsx.variable.cur) + 1 })
    </action>
    <action as="onEnded">
      const ep = dsx.variable.episode
      if (detail.data == null || ep == null) { return }
      const n = Number(dsx.variable.cur) + 1
      if (n > detail.data.episodes.length) { dsx.variable.paused = true; return }
      const nxt = detail.data.episodes[n - 1]
      const nextLocked = nxt.free === false && wallet.data != null && !wallet.data.unlocked.includes(nxt.id)
      if (nextLocked && dsx.variable.autoUnlock && dsx.variable.balance >= nxt.price) {
        dsx.variable.cur = n;
        await dsx.action.unlockNow()
      } else {
        dsx.action.go({ target: n })
      }
    </action>
    <action as="unlockNow">
      const ep = dsx.variable.episode
      if (ep == null || dsx.variable.unlocking) { return }
      dsx.variable.unlocking = true
      const r = await unlockCall.send({ episode: ep.id })
      dsx.variable.unlocking = false
      if (r.ok) {
        dsx.variable.toast = 'Unlocked for ' + r.data.spent + ' coins'
        dsx.variable.paused = false
        wallet.refresh()
      } else {
        dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Unlock failed'
      }
    </action>
    <action as="toggleFav">
      const r = await favCall.send({ show: dsx.variable.showId })
      if (r.ok) { dsx.variable.favTouched = r.data.favorite ? 'y' : 'n' }
    </action>
    <!-- HOLD TO 2x — the category-standard gesture. DSX exposes on:longpress (one-shot)
         but no press-RELEASE event, so release is recovered from on:dragEnd and the next
         tap; both are wired so the speed can never stick. Gap filed upstream. -->
    <action as="holdStart">
      if (dsx.variable.epLocked) { return }
      dsx.variable.holding = true
      dsx.variable.speed = 2
      dsx.variable.toast = 'Playing at 2x'
    </action>
    <action as="holdEnd">
      if (!dsx.variable.holding) { return }
      dsx.variable.holding = false
      dsx.variable.speed = 1
      dsx.variable.toast = ''
    </action>
    <action as="cycleSpeed">
      const s = dsx.variable.speed
      dsx.variable.speed = s == 1 ? 1.5 : (s == 1.5 ? 2 : 1)
    </action>
    <action as="seek">
      dsx.variable.pos = dsx.this.fraction
    </action>

    <!-- The blurred backdrop carries a filter, which makes it a stacking context; the
         chrome and the paywall declare their order explicitly so the lock screen always
         composites above the frame it is dimming. -->
    <style as="chromeLayer" zIndex="2"/>
    <style as="lockedLayer" zIndex="3"/>
    <style as="back" fontSize="24" color="#FFFFFF" paddingH="8"/>
    <style as="topBar" paddingLeading="12" paddingTrailing="14" paddingTop="12" spacing="10" alignItems="center"/>
    <style as="topMeta" spacing="1"/>
    <style as="showTitle" fontSize="15" fontWeight="semibold" color="#FFFFFF" lineLimit="1"/>
    <style as="epLine" fontSize="12" color="rgba(255,255,255,0.66)"/>
    <style as="chip" background="rgba(255,255,255,0.16)" radius="14" paddingH="10" paddingV="6" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="bottomBar" paddingLeading="14" paddingTrailing="14" paddingBottom="16" spacing="10" alignItems="stretch"/>
    <style as="bottomRow" alignItems="flex-end" spacing="12"/>
    <style as="bottomCol" spacing="4"/>
    <style as="sideRail" spacing="16" alignItems="center"/>

    <!-- the locked stage (the category's own vocabulary: paid episode · unlock · earn) -->
    <style as="lockBlock" spacing="14" alignItems="center" paddingH="26"/>
    <style as="lockHead" fontSize="17" fontWeight="bold" color="#FFFFFF" textAlign="center" lineSpacing="4"/>
    <style as="unlockBtn" background="#E52E2E" radius="24" paddingV="13" paddingH="30" spacing="8" alignItems="center"/>
    <style as="earnBtn" background="rgba(255,255,255,0.1)" radius="24" paddingV="12" paddingH="26" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="lockMeta" fontSize="13" color="#F7C948"/>
    <style as="unlockLabel" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
    <style as="lockMetaRow" spacing="6" alignItems="center"/>
    <style as="chipIcon" background="rgba(255,255,255,0.16)" radius="16" paddingH="10" paddingV="9" alignItems="center"/>
    <style as="gridAllRow" spacing="4" alignItems="center"/>
    <style as="autoRow" spacing="9" alignItems="center" paddingTop="2"/>
    <style as="checkBox" width="18" height="18" radius="5" alignItems="center"/>
    <style as="autoLabel" fontSize="13" color="rgba(255,255,255,0.66)"/>

    <!-- the wide details panel -->
    <style as="panel" spacing="16" paddingTrailing="32" paddingTop="24" paddingBottom="30" alignItems="stretch"/>
    <style as="crumb" fontSize="13" color="rgba(255,255,255,0.45)"/>
    <style as="crumbOn" fontSize="13" fontWeight="medium" color="#FFFFFF"/>
    <style as="crumbRow" spacing="7" alignItems="center"/>
    <style as="panelH1" fontSize="20" fontWeight="bold" color="rgba(255,255,255,0.9)" lineSpacing="6"/>
    <style as="plotHead" fontSize="16" color="rgba(255,255,255,0.9)"/>
    <style as="plotBody" fontSize="14" color="rgba(255,255,255,0.6)" lineSpacing="5" lineLimit="4"/>
    <style as="tagRow" spacing="8" alignItems="center"/>
    <style as="tag" background="rgba(255,255,255,0.1)" radius="16" paddingH="16" paddingV="7" fontSize="14" color="rgba(255,255,255,0.7)"/>
    <style as="statRow" spacing="26" alignItems="center" paddingV="8"/>
    <style as="statCol" spacing="4" alignItems="center"/>
    <style as="statCap" fontSize="12" color="rgba(255,255,255,0.6)"/>
    <style as="gridHead" alignItems="center" paddingTop="6"/>
    <style as="gridRange" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="gridAll" fontSize="13" color="rgba(255,255,255,0.55)"/>
    <style as="epCell" radius="8" alignItems="center" height="46"/>
    <style as="epNum" fontSize="14" fontWeight="semibold"/>
    <style as="toastLine" fontSize="12" color="#F7C948"/>

    <style as="speedToast" background="rgba(0,0,0,0.72)" radius="18" paddingH="14" paddingV="8" spacing="7" alignItems="center"/>
    <style as="speedToastLabel" fontSize="13" fontWeight="semibold" color="#FFFFFF"/>
    <style as="menuBody" paddingH="18" paddingTop="6" paddingBottom="20" spacing="4" alignItems="stretch"/>
    <style as="menuRow" spacing="13" alignItems="center" paddingV="14"/>
    <style as="menuLabel" fontSize="15" color="#FFFFFF"/>
    <style as="menuNote" fontSize="12" color="rgba(255,255,255,0.45)"/>
    <style as="drawerGrid" paddingLeading="16" paddingTrailing="16" paddingTop="8"/>
    <style as="drawerCell" radius="9" alignItems="center" paddingV="12"/>
  </head>

  <TopNav active="home" visible-if="dsx.variable.wide"/>
  <hstack alignItems="stretch" style="flex: 1; min-height: 0; width: 100%">

    <!-- ================= THE STAGE ================= -->
    <vstack alignItems="stretch" style="flex: 1; min-width: 0">
      <zstack>
      <!-- the morph target: the card's poster flies into this rect (U03 shared element),
           then the video fades over it. Same id on both ends is the whole contract. -->
      <image src="{{ detail.data == null ? '' : detail.data.show.poster }}" contentFit="cover"
             shared="poster-{{ vars.show }}" a11yHidden="true"
             height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
             style="width: 100%; margin-left: auto; margin-right: auto; object-fit: cover"/>

      <!-- the picture (only when entitled; a locked episode never mounts its source) -->
      <video visible-if="dsx.variable.episode != null && dsx.variable.epLocked == false"
             src="{{ dsx.variable.episode == null ? '' : dsx.variable.episode.video }}"
             active="{{ dsx.variable.epLocked == false }}" muted="{{ dsx.variable.wMuted }}"
             paused="dsx.variable.paused" bind="dsx.variable.pos"
             time="dsx.variable.time" duration="dsx.variable.duration"
             speed="{{ dsx.variable.speed }}" gravity="fill" audio="playback"
             height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto"
             on:ready="dsx.variable.paused = false"
             on:ended="dsx.action.onEnded()" on:appear="dsx.action.boot()"/>

      <!-- locked backdrop: the poster, dimmed -->
      <image visible-if="dsx.variable.epLocked" src="{{ dsx.variable.episode == null ? '' : dsx.variable.episode.poster }}"
             height="{{ dsx.variable.stageH }}" contentFit="cover"
             maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto; filter: blur(16px) brightness(0.4)" a11yHidden="true"/>

      <!-- tap to pause/play across the middle -->
      <!-- the gesture surface: tap pauses, HOLD runs 2x. `user-select: none` keeps a long
           press from selecting text on the web (the native lanes never select here). -->
      <stack visible-if="dsx.variable.epLocked == false" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
             style="width: 100%; margin-left: auto; margin-right: auto; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none"
             on:tap="dsx.action.holdEnd(); dsx.variable.paused = !dsx.variable.paused"
             on:longpress="dsx.action.holdStart()"
             on:dragEnd="dsx.action.holdEnd()"
             a11yLabel="Play or pause. Hold for double speed."
             a11yValue="{{ dsx.variable.speed }}x"
             on:adjust="dsx.action.cycleSpeed()"/>

      <!-- the 2x indicator -->
      <vstack class="chromeLayer" visible-if="dsx.variable.holding" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
              style="width: 100%; margin-left: auto; margin-right: auto; align-items: center; justify-content: flex-start; padding-top: 84px; pointer-events: none">
        <hstack class="speedToast">
          <image icon="forward.fill" iconSize="13" color="#FFFFFF" a11yHidden="true"/>
          <text value="2x speed" class="speedToastLabel"/>
        </hstack>
      </vstack>
      <vstack class="chromeLayer" visible-if="dsx.variable.paused" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto; align-items: center; justify-content: center; pointer-events: none">
        <image icon="play.fill" iconSize="34" color="rgba(255,255,255,0.9)" a11yHidden="true"/>
      </vstack>

      <!-- immersive chrome scrims: the picture runs edge to edge and the controls sit on
           blurred bands rather than a dimmed frame (the category's full-screen feel) -->
      <vstack class="chromeLayer" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}"
              style="width: 100%; margin-left: auto; margin-right: auto; justify-content: space-between; pointer-events: none">
        <stack style="width: 100%; height: 112px; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%); mask-image: linear-gradient(180deg, #000 45%, transparent 100%); background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 100%)"/>
        <stack style="width: 100%; height: 168px; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); -webkit-mask-image: linear-gradient(0deg, #000 45%, transparent 100%); mask-image: linear-gradient(0deg, #000 45%, transparent 100%); background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%)"/>
      </vstack>

      <!-- chrome -->
      <vstack class="chromeLayer" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto; justify-content: space-between; pointer-events: none">
        <hstack class="topBar" style="pointer-events: auto">
          <image icon="xmark" iconSize="20" color="#FFFFFF" class="back"
                 on:tap="dsx.module.route.pop()" a11yLabel="Close player" a11yTrait="button"/>
          <vstack class="topMeta" style="flex: 1">
            <text value="{{ detail.data == null ? '' : detail.data.show.title }}" class="showTitle"/>
            <text value="EP {{ dsx.variable.cur }}{{ detail.data == null ? '' : ' / ' + detail.data.episodes.length }}" class="epLine"/>
          </vstack>
          <vstack class="chipIcon" on:tap="dsx.variable.wMuted = !dsx.variable.wMuted"
                  a11yLabel="{{ dsx.variable.wMuted ? 'Unmute' : 'Mute' }}" a11yTrait="button">
            <image icon="{{ dsx.variable.wMuted ? 'speaker.slash.fill' : 'waveform' }}" iconSize="16" color="#FFFFFF" a11yHidden="true"/>
          </vstack>
          <button label="{{ dsx.variable.speed }}x" class="chip"
                  on:tap="dsx.action.cycleSpeed()" a11yLabel="Playback speed"/>
          <vstack class="chipIcon" on:tap="dsx.variable.menu = true" a11yLabel="Player options" a11yTrait="button">
            <image icon="ellipsis" iconSize="16" color="#FFFFFF" a11yHidden="true"/>
          </vstack>
        </hstack>

        <vstack class="bottomBar" style="pointer-events: auto">
          <hstack class="bottomRow">
            <vstack class="bottomCol" style="flex: 1">
              <text value="{{ dsx.variable.episode == null ? '' : dsx.variable.episode.title }}" fontSize="13" fontWeight="semibold" color="#FFFFFF" lines="1"/>
              <text value="{{ dsx.variable.toast }}" visible-if="dsx.variable.toast != ''" class="toastLine"/>
            </vstack>
            <vstack class="sideRail">
              <image icon="rectangle.stack.fill" iconSize="21" color="#FFFFFF" on:tap="dsx.variable.drawer = true" a11yLabel="Episodes" a11yTrait="button" visible-if="dsx.variable.wide == false"/>
              <image icon="forward.fill" iconSize="21" color="#FFFFFF" on:tap="dsx.action.next()" a11yLabel="Next episode" a11yTrait="button"/>
            </vstack>
          </hstack>
          <!-- custom scrubber: on:drag seeks through the shared position fraction -->
          <stack height="26" style="justify-content: center" on:drag="dsx.action.seek()" a11yLabel="Seek"
                 a11yValue="{{ Math.round(dsx.variable.pos * 100) }} percent"
                 on:adjust="dsx.variable.pos = dsx.variable.pos + (dsx.this.direction == 'increment' ? 0.05 : -0.05)">
            <stack height="4" radius="2" background="rgba(255,255,255,0.25)" style="width: 100%">
              <stack height="4" radius="2" background="#E52E2E" style="width: {{ dsx.variable.pos * 100 }}%"/>
            </stack>
          </stack>
        </vstack>
      </vstack>

      <!-- THE LOCKED STAGE — "This is a paid episode." (unlock spends server-side) -->
      <vstack class="lockedLayer" visible-if="dsx.variable.epLocked" height="{{ dsx.variable.stageH }}" maxWidth="{{ dsx.variable.stageMax }}" style="width: 100%; margin-left: auto; margin-right: auto; align-items: center; justify-content: center" background="rgba(0,0,0,0.45)">
        <vstack class="lockBlock">
          <image icon="lock.fill" iconSize="26" color="rgba(255,255,255,0.85)" a11yHidden="true"/>
          <text value="This is a paid episode.
Please unlock to watch." class="lockHead"/>
          <hstack class="unlockBtn" a11yGroup="true" a11yTrait="button"
                  a11yLabel="Unlock this episode for {{ dsx.variable.episode == null ? '' : dsx.variable.episode.price }} coins"
                  on:tap="dsx.action.unlockNow()">
            <image icon="dollarsign.circle.fill" iconSize="17" color="#FFFFFF" a11yHidden="true"
                   visible-if="dsx.variable.unlocking == false"/>
            <text value="{{ dsx.variable.unlockLabel }}" class="unlockLabel"/>
          </hstack>
          <button label="Earn Free Coins in Rewards" class="earnBtn"
                  on:tap="dsx.module.route.push({ path: '/rewards' })"/>
          <hstack class="lockMetaRow" a11yGroup="true"
                  a11yLabel="Price {{ dsx.variable.episode == null ? '' : dsx.variable.episode.price }} coins, balance {{ dsx.variable.balance }} coins">
            <text value="Price:" class="lockMeta"/>
            <image icon="dollarsign.circle.fill" iconSize="14" color="#F6B63D" a11yHidden="true"/>
            <text value="{{ dsx.variable.episode == null ? '' : dsx.variable.episode.price }}" class="lockMeta"/>
            <text value="·" class="lockMeta"/>
            <text value="Balance:" class="lockMeta"/>
            <image icon="dollarsign.circle.fill" iconSize="14" color="#F6B63D" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }}" class="lockMeta"/>
          </hstack>
          <hstack class="autoRow" on:tap="dsx.variable.autoUnlock = !dsx.variable.autoUnlock"
                  a11yGroup="true" a11yTrait="button"
                  a11yLabel="Auto-unlock next episodes, {{ dsx.variable.autoUnlock ? 'on' : 'off' }}">
            <vstack class="checkBox" background="{{ dsx.variable.autoUnlock ? '#E52E2E' : 'rgba(255,255,255,0.08)' }}"
                    style="border: 1.5px solid {{ dsx.variable.autoUnlock ? '#E52E2E' : 'rgba(255,255,255,0.3)' }}">
              <image icon="checkmark" iconSize="11" color="#FFFFFF" visible-if="dsx.variable.autoUnlock" a11yHidden="true"/>
            </vstack>
            <text value="Auto-unlock next episodes" class="autoLabel"/>
          </hstack>
          <text value="{{ dsx.variable.toast }}" visible-if="dsx.variable.toast != ''" class="toastLine"/>
        </vstack>
      </vstack>
      </zstack>
    </vstack>

    <!-- ================= THE DETAILS PANEL (wide only) ================= -->
    <scroll visible-if="dsx.variable.wide" style="width: 416px; min-width: 416px; height: {{ dsx.variable.stageH }}px">
      <vstack class="panel">
        <hstack class="crumbRow">
          <text value="Home" class="crumb" href="/"/>
          <text value="/" class="crumb"/>
          <text value="{{ detail.data == null ? '' : detail.data.show.title }}" class="crumb" href="/show/{{ vars.show }}"/>
          <text value="/" class="crumb"/>
          <text value="Episode {{ dsx.variable.cur }}" class="crumbOn"/>
        </hstack>

        <text value="Episode {{ dsx.variable.cur }} - {{ detail.data == null ? '' : detail.data.show.title }}" class="panelH1"/>

        <vstack spacing="7" alignItems="flex-start">
          <text value="Plot of Episode {{ dsx.variable.cur }}" class="plotHead"/>
          <text value="{{ detail.data == null ? '' : detail.data.show.synopsis }}" class="plotBody"/>
        </vstack>

        <hstack class="tagRow">
          <text value="{{ detail.data == null ? '' : detail.data.show.genre }}" class="tag"/>
          <text value="Series" class="tag"/>
          <text value="EP 1–{{ detail.data == null ? '' : detail.data.show.free_until }} Free" class="tag"/>
        </hstack>

        <hstack class="statRow" style="border-top: 1px solid rgba(255,255,255,0.07); border-bottom: 1px solid rgba(255,255,255,0.07)">
          <vstack class="statCol" on:tap="dsx.action.toggleFav()" a11yLabel="Toggle My List" a11yTrait="button">
            <image icon="{{ dsx.variable.favOn ? 'bookmark.fill' : 'bookmark' }}" iconSize="20"
                   color="{{ dsx.variable.favOn ? '#E52E2E' : '#FFFFFF' }}" a11yHidden="true"/>
            <text value="{{ dsx.variable.favOn ? 'In My List' : 'My List' }}" class="statCap"/>
          </vstack>
          <vstack class="statCol" href="/rewards" a11yLabel="Your balance — open Rewards">
            <image icon="dollarsign.circle.fill" iconSize="20" color="#F7C948" a11yHidden="true"/>
            <text value="{{ dsx.variable.balance }} coins" class="statCap"/>
          </vstack>
        </hstack>

        <hstack class="gridHead">
          <text value="1 - {{ detail.data == null ? '' : detail.data.episodes.length }}" class="gridRange"/>
          <spacer/>
          <hstack class="gridAllRow" href="/show/{{ vars.show }}" a11yGroup="true" a11yLabel="All episodes">
            <text value="All Episodes" class="gridAll"/>
            <image icon="chevron.right" iconSize="12" color="rgba(255,255,255,0.55)" a11yHidden="true"/>
          </hstack>
        </hstack>

        <!-- cells are DIRECT grid children (the column-sizing rule targets them); the
             padlock overlays by position on web and degrades to flow on native -->
        <grid bind="detail.data.episodes" key="id" columns="6" spacing="6" scroll="false">
          <vstack class="epCell" style="position: relative; justify-content: center" on:tap="dsx.action.go({ target: item.idx })"
                  background="{{ item.idx == Number(dsx.variable.cur) ? 'rgba(229,46,46,0.28)' : 'rgba(255,255,255,0.1)' }}"
                  a11yLabel="Episode {{ item.idx }}{{ gridLocked ? ', locked' : '' }}" a11yTrait="button">
            <text value="{{ item.idx }}" class="epNum"
                  color="{{ item.idx == Number(dsx.variable.cur) ? '#F2607A' : '#FFFFFF' }}"/>
            <image icon="lock.fill" iconSize="8" color="rgba(255,255,255,0.55)" visible-if="gridLocked"
                   a11yHidden="true" style="position: absolute; top: 3px; right: 4px"/>
          </vstack>
        </grid>
      </vstack>
    </scroll>
  </hstack>

  <!-- player options: captions · language · speed · download. `detents="content"` hugs
       the rows. Download is a NATIVE-lane capability and says so rather than faking. -->
  <sheet present="dsx.variable.menu" detents="content" title="Player options" background="#141419"
         on:dismiss="dsx.variable.menu = false">
    <vstack class="menuBody">
      <hstack class="menuRow" on:tap="dsx.variable.captions = !dsx.variable.captions"
              a11yGroup="true" a11yTrait="button"
              a11yLabel="Captions, {{ dsx.variable.captions ? 'on' : 'off' }}">
        <image icon="note.text" iconSize="18" color="rgba(255,255,255,0.75)" a11yHidden="true"/>
        <text value="Captions" class="menuLabel" style="flex: 1"/>
        <vstack class="checkBox" background="{{ dsx.variable.captions ? '#E52E2E' : 'rgba(255,255,255,0.08)' }}"
                style="border: 1.5px solid {{ dsx.variable.captions ? '#E52E2E' : 'rgba(255,255,255,0.3)' }}">
          <image icon="checkmark" iconSize="11" color="#FFFFFF" visible-if="dsx.variable.captions" a11yHidden="true"/>
        </vstack>
      </hstack>

      <hstack class="menuRow">
        <image icon="globe" iconSize="18" color="rgba(255,255,255,0.75)" a11yHidden="true"/>
        <text value="Audio &amp; subtitles" class="menuLabel" style="flex: 1"/>
        <picker bind="dsx.variable.lang" options="English,Español,Português,Deutsch,Français"
                color="#E52E2E" a11yLabel="Language"/>
      </hstack>

      <hstack class="menuRow">
        <image icon="speedometer" iconSize="18" color="rgba(255,255,255,0.75)" a11yHidden="true"/>
        <text value="Playback speed" class="menuLabel" style="flex: 1"/>
        <segmented bind="dsx.variable.speed" options="1,1.5,2" color="#E52E2E" a11yLabel="Playback speed"/>
      </hstack>

      <hstack class="menuRow" style="opacity: 0.5">
        <image icon="square.and.arrow.down" iconSize="18" color="rgba(255,255,255,0.75)" a11yHidden="true"/>
        <vstack spacing="2" style="flex: 1">
          <text value="Download episode" class="menuLabel"/>
          <text value="Offline downloads run in the iOS and Android apps" class="menuNote"/>
        </vstack>
      </hstack>
    </vstack>
  </sheet>

  <!-- episode drawer (phone) -->
  <sheet present="dsx.variable.drawer" detents="half,full" title="Episodes" background="#141419"
         on:dismiss="dsx.variable.drawer = false">
    <scroll style="flex: 1; min-height: 0">
      <vstack class="drawerGrid">
      <grid bind="detail.data.episodes" key="id" columns="5" spacing="9" scroll="false">
        <vstack class="drawerCell"
                background="{{ item.idx == Number(dsx.variable.cur) ? '#E52E2E' : '#1E1E24' }}"
                on:tap="dsx.action.go({ target: item.idx })" a11yLabel="Episode {{ item.idx }}">
          <text value="{{ item.idx }}" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
        </vstack>
        </grid>
      </vstack>
    </scroll>
  </sheet>
</vstack>
