<!-- PersonalNav — the personal-center sidebar (wide viewports): identity card, account
     balance with the red Get Coins CTA, then the section menu — Wallet · My List ·
     Rewards — with the active row tinted brand red. Mounted by Profile and MyList so
     the two pages read as ONE center.

     DATA COMES DOWN AS ATTRIBUTES. The first version fetched its own session and wallet,
     so every wide Profile render fired the session endpoint and /wallet/state twice — once
     for the page, once for its own sidebar. A part renders what its owner already knows;
     it does not shop for its own facts. (A component attribute whose whole value is one
     {{ }} carries the VALUE, so numbers arrive as numbers.)

     The identity half of that is now <AuthSeam>'s published `global.auth`, so a caller
     passes `uid` from one place rather than from its own session block — and My List, which
     used to mount this with NO attributes at all and therefore read "Signed out" beside a
     signed-in viewer's own list (audit G11), passes them too.

     Lateral moves inside the center REPLACE: Wallet → My list → Wallet through href
     would stack three entries and turn the back gesture into a tour of the sidebar. -->
<vstack class="side" style="width: 300px; min-width: 300px">
  <head>
    <attribute as="active" default="'wallet'"/>   <!-- wallet | list | rewards -->
    <attribute as="uid" default="''"/>
    <attribute as="coins" default="null"/>        <!-- null = still loading: render an em dash, never a fake 0 -->
    <attribute as="bonus" default="null"/>
    <attribute as="vip" default="false"/>

    <variable as="hovRow">return ''</variable>
    <variable as="menu" computed="true">
      return [
        { key: 'wallet',  label: 'Wallet',  icon: 'dollarsign.circle.fill', path: '/profile' },
        { key: 'list',    label: 'My list', icon: 'play.rectangle.fill',    path: '/list' },
        { key: 'rewards', label: 'Rewards', icon: 'gift.fill',              path: '/rewards' }
      ]
    </variable>

    <formula as="rowBg" key="item.key">
      if (dsx.attribute.active == key) { return '#1F1F26' }
      if (dsx.variable.hovRow == key) { return 'rgba(255,255,255,0.05)' }
      return 'rgba(0,0,0,0)'
    </formula>
    <formula as="rowTint" key="item.key">
      return dsx.attribute.active == key ? brand() : 'rgba(255,255,255,0.6)'
    </formula>
    <formula as="rowInk" key="item.key">
      return dsx.attribute.active == key ? brand() : '#FFFFFF'
    </formula>

    <style as="side" spacing="14" alignItems="stretch"/>
    <style as="card" background="#141419" radius="12" paddingH="16" paddingV="16" spacing="14" alignItems="stretch"/>
    <style as="idRow" spacing="12" alignItems="center"/>
    <style as="avatar" background="#232329" radius="24" width="48" height="48" alignItems="center"/>
    <style as="who" spacing="4"/>
    <style as="whoName" fontSize="16" fontWeight="bold" color="#FFFFFF"/>
    <style as="whoNote" fontSize="12" color="rgba(255,255,255,0.45)"/>
    <style as="vipChip" background="#F6B63D" radius="10" paddingH="8" paddingV="4" fontSize="11" fontWeight="bold" color="#2A1D04"/>

    <style as="balCap" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="balRow" alignItems="center"/>
    <style as="balCol" spacing="4" alignItems="center"/>
    <style as="balNum" fontSize="20" fontWeight="bold" color="#FFFFFF"/>
    <style as="balSub" fontSize="12" color="rgba(255,255,255,0.5)"/>
    <style as="balDiv" background="rgba(255,255,255,0.1)" width="1" height="34"/>
    <style as="topupBtn" background="#FF2C55" radius="21" paddingV="12" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>

    <style as="menu" background="#141419" radius="12" paddingH="8" paddingV="8" spacing="2" alignItems="stretch"/>
    <style as="menuRow" radius="9" paddingH="12" paddingV="12" spacing="11" alignItems="center"/>
    <style as="menuLabel" fontSize="15" fontWeight="medium"/>
  </head>

  <!-- SELF-SUFFICIENT: this part calls the shared design vocabulary (Components/parts/
       Theme.dsx), and a caller must not have to remember to register it first. The
       block is app-wide and last-write-wins, so a second mount costs a 0x0 stack. -->
  <Theme/>
  <!-- identity -->
  <vstack class="card">
    <hstack class="idRow">
      <vstack class="avatar" style="justify-content: center">
        <image icon="person.crop.circle" iconSize="26" color="rgba(255,255,255,0.6)" a11yHidden="true"/>
      </vstack>
      <vstack class="who" style="flex: 1; min-width: 0">
        <text value="Viewer" class="whoName"/>
        <text value="{{ dsx.attribute.uid == '' ? 'Signed out' : 'UID ' + dsx.attribute.uid }}" class="whoNote"/>
      </vstack>
      <text value="VIP" class="vipChip" visible-if="dsx.attribute.vip"/>
    </hstack>
  </vstack>

  <!-- account balance -->
  <vstack class="card">
    <text value="Account Balance" class="balCap"/>
    <hstack class="balRow" style="justify-content: space-evenly">
      <vstack class="balCol">
        <hstack spacing="6" alignItems="center">
          <image icon="dollarsign.circle.fill" iconSize="16" color="{{ coin() }}" a11yHidden="true"/>
          <text value="{{ dsx.attribute.coins == null ? '—' : dsx.attribute.coins }}" class="balNum"/>
        </hstack>
        <text value="Coins" class="balSub"/>
      </vstack>
      <stack class="balDiv"/>
      <vstack class="balCol">
        <hstack spacing="6" alignItems="center">
          <image icon="dollarsign.circle.fill" iconSize="16" color="{{ coin() }}" a11yHidden="true"/>
          <text value="{{ dsx.attribute.bonus == null ? '—' : dsx.attribute.bonus }}" class="balNum"/>
        </hstack>
        <text value="Bonus" class="balSub"/>
      </vstack>
    </hstack>
    <button label="Get Coins" class="topupBtn"
            on:tap="dsx.module.route.push({ path: '/store' })" a11yLabel="Get coins — open the store"/>
  </vstack>

  <!-- section menu -->
  <vstack class="menu">
    <list bind="dsx.variable.menu" key="key" scroll="false" spacing="2">
      <hstack class="menuRow" a11yTrait="button" a11yGroup="true" a11yLabel="{{ item.label }}"
              on:tap="dsx.module.route.replace({ path: item.path })"
              on:hoverStart="dsx.variable.hovRow = item.key" on:hoverEnd="dsx.variable.hovRow = ''"
              background="{{ rowBg }}" style="transition: background-color 0.15s ease">
        <image icon="{{ item.icon }}" iconSize="18" color="{{ rowTint }}" a11yHidden="true"/>
        <text value="{{ item.label }}" class="menuLabel" color="{{ rowInk }}"/>
      </hstack>
    </list>
  </vstack>
</vstack>
