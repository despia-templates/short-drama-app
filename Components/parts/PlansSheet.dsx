<!-- PlansSheet — the VIP paywall as a SHEET, which is what a paywall is.

     A price list is an interruption, not a destination: it belongs over the screen that
     raised the question, dismissible in one gesture, returning the viewer exactly where
     they were. Pushing a whole route to show three prices costs the viewer their place
     and buries the answer under a page of benefits they did not ask for. (designing-an-app
     §8: "present it as a sheet the user can dismiss".)

     SELF-CONTAINED, LIKE <SearchOverlay>. The host passes its own trigger as CHILDREN —
     Profile's gold card, VIP's CTA, a row anywhere — and this file wraps it in the tap
     that opens the sheet. No screen plumbs `present` state through to a child, and every
     trigger in the app raises the identical surface.

     ONE VIP CHECKOUT, HERE. The sequence (server PaymentIntent → one `dsx.module.stripe`
     session → server-side settle) is money code, so it exists once: this component is
     mounted by Profile and VIP as a sheet AND by Store as its inline VIP section
     (`mode="inline"`), so all three buy through the same lines. A settle that Stripe
     confirmed but the network lost keeps its order id on screen with an idempotent
     Confirm — the recovery card travels with the flow it belongs to.

     AND IT IS THE WEB LANE. Stripe inside a native build is an App Store 3.1.1 violation
     for exactly the products this sheet sells; `payLane` in the head decides that before
     any money moves, and carries the whole argument. -->
<!-- WHAT IT SELLS IS A DATED PASS, not a subscription. Nothing on this backend renews and
     nothing can be cancelled, so no copy here says otherwise — the tier notes come from the
     server and say "One charge for N days. No auto-renewal." in as many words.

     The catalogue is fetched LAZILY: a price list nobody opened costs nothing. -->
<vstack alignItems="stretch">
  <head>
    <attribute as="mode" default="'sheet'"/>      <!-- sheet | inline -->
    <!-- THE SEAM IS THE DEFAULT (see <AuthSeam>): a host no longer plumbs headers down
         per mount, and the three surfaces that raise this sheet all buy with one session. -->
    <attribute as="headers" default="global.auth.headers"/>
    <attribute as="vip" default="false"/>         <!-- is the viewer already a member -->
    <attribute as="vipUntil" default="''"/>

    <event as="purchased" payload="days"/>
    <event as="failed" payload="message"/>

    <api as="catalog" url="/store/catalog" auto="false"/>
    <api as="checkoutCall" url="/store/checkout" method="POST" auto="false" headers="dsx.attribute.headers"/>
    <api as="settleCall" url="/store/settle" method="POST" auto="false" headers="dsx.attribute.headers"/>
    <!-- the NATIVE lane's settle: the store module took the money, this is what turns it
         into entitlement. Server-verified like every other grant (server/store.dsx
         settleNative) — the client is never the authority on either lane. -->
    <api as="nativeCall" url="/store/native" method="POST" auto="false" headers="dsx.attribute.headers"/>

    <variable as="open">return false</variable>
    <variable as="buying">return ''</variable>
    <variable as="paying">return false</variable>
    <variable as="order">return ''</variable>
    <variable as="settleFailed">return false</variable>
    <variable as="settleMsg">return ''</variable>
    <variable as="toast">return ''</variable>
    <variable as="hovId">return ''</variable>

    <variable as="isInline" computed="true">return dsx.attribute.mode == 'inline'</variable>
    <variable as="phase" computed="true">
      if (catalog.error != null) { return 'error' }
      if (catalog.data == null) { return 'loading' }
      return 'content'
    </variable>
    <!-- ══ THE PURCHASE LANE, AND WHY IT HAS ONLY ONE ═══════════════════════════════════
         App Store Review 3.1.1, verbatim: "If you want to unlock features or functionality
         within your app, (by way of example: subscriptions, in-game currencies, game levels,
         access to premium content, or unlocking a full version), you must use in-app
         purchase." A VIP pass is premium-content access and coins are an in-game currency —
         both are named by that parenthetical, so opening a Stripe payment sheet for either
         one inside an iOS build is a rejection. Two carve-outs get cited and neither applies:
         a READER APP may not offer in-app purchase at all and may only give access to content
         bought elsewhere, which is not a storefront; and the US anti-steering carve-out
         permits a LINK OUT to your own website, never a non-Apple payment sheet inside the
         app. Google Play Payments reaches the same conclusion for the same products.

         So Stripe is the WEB lane, and a native build takes the platform store — that is the
         whole rule, and it is why this pick reads `os == 'web'` and refuses everything else
         rather than falling through to the card sheet it used to.

         WHERE THE CAPABILITY PICK WENT. The house form is `has('scheme')` first and `os`
         second (AGENTS.md, the <AdGate> precedent) — a build that HAS the module should take
         it wherever it is running. That line belongs here and is not here, because the module
         cannot be in a build at all today: see `payNote`, which does the `has('store')` probe
         so the refusal can tell an adopter which half they are missing. The day Core/Store
         compiles, this becomes `if (has('store')) { return 'iap' }` above the web test, and
         the backend it needs is already built (server/store.dsx: POST /store/native, the
         RevenueCat <webhook>, and one shared granter behind both). -->
    <variable as="payLane" computed="true">
      if (os == 'web') { return 'stripe' }
      return 'blocked'
    </variable>
    <!-- THE REFUSAL, in the viewer's words, naming WHICH half is missing — because the two
         halves are fixed by two different people. A desktop build (macos/windows/linux)
         lands here too: the Mac App Store wants in-app purchase and a direct download does
         not, and `os` alone cannot tell them apart, so this errs toward the store rule, which
         is the safe direction to be wrong in. -->
    <variable as="payNote" computed="true">
      if (dsx.variable.payLane != 'blocked') { return '' }
      const cat = catalog.data
      const ready = cat != null &amp;&amp; cat.native != null &amp;&amp; cat.native.ready == true
      if (has('store')) {
        if (ready == false &amp;&amp; cat != null &amp;&amp; cat.native != null &amp;&amp; cat.native.reason != '') { return cat.native.reason }
        return 'The in-app-purchase module is in this build, but the app cannot open a purchase with it yet: the one client call this needs is held by an upstream defect (Core/Store ships Components/core/PaywallVIP.dsx, which mounts a component nothing defines, so configuring the package aborts the build). Nothing is charged until it can be granted.'
      }
      return 'Purchases are off in this build, on purpose. App Store rule 3.1.1 makes coins and passes in-app-purchase products, so selling them through a card sheet inside the app would be a rejection — and the in-app-purchase module cannot be added yet (configuring Core/Store aborts the build inside the module itself). The web storefront is unaffected.'
    </variable>
    <variable as="recoverLine" computed="true">
      const why = dsx.variable.settleMsg == '' ? '' : ' The server said: ' + dsx.variable.settleMsg
      return 'Stripe confirmed your payment, but applying it did not go through. Nothing is lost: confirm below and it lands. Order ' + dsx.variable.order + '.' + why
    </variable>
    <!-- WHAT A PLAN IS, SAID WHERE THE PRICE IS. This line used to read "Cancel anytime",
         which described a subscription this backend has never had: `createCheckout` opens a
         one-off PaymentIntent and `settleOrder` stamps a dated `vip_until`, so there is
         nothing to cancel and nothing that renews. The server now ships the same truth in
         every tier note (server/store.dsx storeCatalog); this is its one-line form for the
         sheet header. "Buying again adds days" is literal: settleOrder extends from the
         current expiry rather than from today, so a second pass never burns the first. -->
    <variable as="statusLine" computed="true">
      if (dsx.attribute.vip == false) { return 'A one-time charge for a dated pass — no auto-renewal. Your coins stay yours.' }
      if (dsx.attribute.vipUntil == '') { return 'VIP is active — buying again adds days to it.' }
      return 'VIP is active until ' + dsx.attribute.vipUntil + ' — buying again adds days to it.'
    </variable>

    <formula as="tierFx" id="item.id" best="item.best">
      const lift = dsx.variable.hovId == id ? 'translateY(-2px)' : 'none'
      // a card that cannot be bought must not look buyable: the blocked lane dims the whole
      // grid, and the notice above it says why (payNote)
      const dim = dsx.variable.payLane == 'blocked' ? 0.45 : (dsx.variable.buying == id ? 0.55 : 1)
      const ring = best ? '#FF2C55' : 'rgba(0,0,0,0)'
      const glow = dsx.variable.hovId == id ? '0 10px 30px rgba(230,190,110,0.25)' : 'none'
      return 'background: linear-gradient(160deg, #F7E3AE 0%, #E8C77A 55%, #DDB35E 100%); border: 2px solid ' + ring + '; opacity: ' + dim + '; transform: ' + lift + '; box-shadow: ' + glow + '; transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease'
    </formula>
    <formula as="tierBusy" id="item.id">
      if (dsx.variable.buying != id) { return '' }
      return dsx.variable.paying ? 'Complete the payment…' : 'Contacting Stripe…'
    </formula>

    <action as="openPlans">
      dsx.variable.toast = ''
      if (catalog.data == null) { catalog.refresh() }
      dsx.variable.open = true
    </action>
    <action as="load">
      if (catalog.data == null) { catalog.refresh() }
    </action>

    <action as="buy" sku="item.id">
      if (dsx.variable.buying != '') { return }
      // NO SIGN-IN WALL IN FRONT OF THE MONEY. This used to push /auth/signin before a guest
      // could buy anything, and that is backwards for this product: most viewers who pay
      // have never made an account, and a login screen between a decided buyer and a payment
      // sheet is the single most expensive interruption a storefront can have. A purchase
      // needs a SUBJECT, not a signed-in human — an anonymous session is a subject, and the
      // backend routes ask for exactly that (`auth="required"` verifies a token, it does not
      // ask who is holding it). So the tap goes straight to the payment lane, and if the
      // session plane has nothing to attach the purchase to, the SERVER says so and the
      // refusal is printed verbatim — the sign-in card already on the screen is then an
      // offer, not a gate. The upsell belongs AFTER the money lands ("sign in so you do not
      // lose access"), and that is <AuthSeam> work, handed off.
      // App Store 3.1.2 still wants a current subscriber to be able to sign in on a
      // subscription surface — that is <RestoreRow> and the sign-in card, both below.
      // THE LANE REFUSES BEFORE IT CHARGES. See `payLane` for the rule and `payNote` for the
      // words; the point is that nothing here silently falls back to a card sheet on a
      // platform where that is a store violation.
      // ── THE NATIVE PURCHASE, AND THE ONE LINE THAT CANNOT BE WRITTEN YET ──────────────
      // What belongs here is a single call to the store module —
      //   store.checkout({ product: sku, externalId: the viewer subject })
      // — and then POST /store/native with the transaction it resolves. The server half is
      // already built and waiting (server/store.dsx: settleNative, the RevenueCat receiver,
      // and one shared granter behind both).
      // It is not written because the module cannot be put in a build. Adding Core/Store to
      // the packages list was tried on 2026-09-01 and ABORTS THE COMPILE inside the module
      // itself: Components/core/PaywallVIP.dsx line 18 mounts a component nothing in the
      // module tree defines. And with no package claiming the scheme, `despia lint --strict`
      // refuses a call to it outright — which is the correct refusal, because a module
      // reference nothing claims is how a build ships a call that can only fail on a device.
      // (Spelling note: the identifiers above are deliberately written WITHOUT their engine
      // prefix. The linter reads names out of comments in an action body exactly as it reads
      // them out of code, so naming the module here the way you would call it turns this
      // paragraph into two warnings against a strict gate.)
      // So the branch below is the whole native lane today: it refuses, in the viewer own
      // words, rather than quietly opening a card sheet on a phone.
      if (dsx.variable.payLane == 'blocked') {
        dsx.variable.toast = dsx.variable.payNote
        dsx.event('failed', { message: dsx.variable.toast })
        return
      }
      dsx.variable.buying = sku
      dsx.variable.toast = ''
      dsx.variable.settleFailed = false
      const r = await checkoutCall.send({ sku: sku })
      if (!r.ok) {
        dsx.variable.buying = ''
        dsx.variable.toast = r.data != null && r.data.message != null ? r.data.message : 'Checkout is unavailable right now.'
        dsx.event('failed', { message: dsx.variable.toast })
        return
      }
      dsx.variable.order = r.data.order
      const opened = await dsx.module.stripe.session({
        publishable_key: r.data.publishable_key,
        payment_intent_client_secret: r.data.client_secret
      })
      if (opened == null || opened.ok === false) {
        dsx.variable.buying = ''
        dsx.variable.toast = 'The payment sheet could not open on this platform.'
        return
      }
      dsx.variable.paying = true
      const paid = await dsx.module.stripe.payment({ session: dsx.module.stripe.context.session })
      dsx.variable.paying = false
      if (paid == null || paid.status !== 'succeeded') {
        dsx.variable.buying = ''
        dsx.variable.toast = 'Payment was not completed. Nothing was charged.'
        return
      }
      await dsx.action.settle()
      dsx.variable.buying = ''
    </action>


    <!-- ONE SETTLE FOR BOTH LANES, because both fail in the same place: the money is taken
         and the grant has not landed. Each is idempotent server-side — the ledger row keyed
         on the order id (Stripe) or the store transaction (native) is the exactly-once lock
         — which is exactly what lets the recovery card exist: retrying is always safe. -->
    <action as="settle">
      const s = await settleCall.send({ order: dsx.variable.order })
      if (s.ok) {
        dsx.variable.settleFailed = false
        dsx.variable.order = ''
        dsx.variable.open = false
        dsx.event('purchased', { days: s.data.days })
      } else {
        // THE CARD, NOT A TOAST — money is never a message that scrolls away. The server
        // reason rides INSIDE the card (recoverLine) so a refusal that retrying cannot fix
        // is at least legible, instead of a bare Confirm button the viewer taps forever.
        dsx.variable.settleFailed = true
        dsx.variable.settleMsg = s.data != null &amp;&amp; s.data.message != null ? s.data.message : ''
        dsx.variable.toast = ''
      }
    </action>

    <style as="trigger" alignItems="stretch"/>
    <style as="sheetBody" spacing="14" alignItems="stretch" paddingH="16" paddingTop="6" paddingBottom="22"/>
    <style as="head" alignItems="center" spacing="12"/>
    <style as="title" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.3"/>
    <style as="status" fontSize="13" color="rgba(255,255,255,0.55)" lineSpacing="3"/>
    <style as="closeBtn" width="32" height="32" radius="16" background="rgba(255,255,255,0.1)" alignItems="center"/>

    <style as="tier" radius="14" paddingH="16" paddingV="16" spacing="8" alignItems="flex-start"/>
    <style as="tierName" fontSize="15" fontWeight="semibold" color="#3A2A08"/>
    <style as="tierPrice" fontSize="24" fontWeight="bold" color="#2A1D04"/>
    <style as="tierNote" fontSize="12" color="rgba(42,29,4,0.7)"/>
    <style as="tierBadge" background="#FF2C55" radius="4" paddingH="8" paddingV="4" fontSize="11" fontWeight="bold" color="#FFFFFF"/>
    <style as="perk" spacing="6" alignItems="center"/>
    <style as="perkText" fontSize="12" fontWeight="medium" color="#2A1D04"/>
    <style as="busyLine" fontSize="12" fontWeight="semibold" color="#2A1D04"/>

    <style as="toastRow" background="rgba(246,182,61,0.12)" radius="10" paddingH="12" paddingV="10" spacing="10" alignItems="center"/>
    <style as="toastLine" fontSize="13" fontWeight="medium" color="#F6B63D" lineSpacing="3"/>
    <style as="retryCard" background="#1E1830" radius="14" paddingH="16" paddingV="16" spacing="10" alignItems="flex-start"/>
    <!-- the LANE notice: same rhythm as the recovery card, deliberately not the same colour —
         nothing has gone wrong here, the build is simply not allowed to sell this way -->
    <style as="laneCard" background="#141419" radius="14" paddingH="16" paddingV="16" spacing="8" alignItems="flex-start"/>
    <style as="laneTitle" fontSize="14" fontWeight="bold" color="#FFFFFF"/>
    <style as="retryTitle" fontSize="15" fontWeight="bold" color="#FFFFFF"/>
    <style as="retryBody" fontSize="13" color="rgba(255,255,255,0.65)" lineSpacing="4"/>
    <style as="retryBtn" background="#FF2C55" radius="20" paddingH="20" paddingV="12" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
    <style as="benefitsLink" fontSize="13" fontWeight="semibold" color="#F6B63D" textAlign="center" paddingV="6"/>
    <style as="errCard" background="#141419" radius="14" spacing="10" paddingH="16" paddingV="20" alignItems="center"/>
  </head>

  <!-- the host's own trigger markup, wrapped in the tap that raises the sheet -->
  <vstack class="trigger" visible-if="dsx.variable.isInline == false"
          on:tap="dsx.action.openPlans()" a11yTrait="button" a11yLabel="See VIP plans">
    <slot/>
  </vstack>

  <!-- INLINE: the same tiers as a section (Store mounts this) -->
  <vstack alignItems="stretch" spacing="14" visible-if="dsx.variable.isInline" on:appear="dsx.action.load()">
    <vstack spacing="12" alignItems="stretch" visible-if="dsx.variable.phase == 'loading'">
      <Skeleton height="132" radius="14"/>
      <Skeleton height="132" radius="14"/>
    </vstack>
    <vstack class="errCard" visible-if="dsx.variable.phase == 'error'">
      <text value="VIP plans could not be loaded." fontSize="14" color="#FFFFFF"/>
      <button label="Retry" class="retryBtn" on:tap="catalog.refresh()"/>
    </vstack>
    <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
      <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
      <image icon="xmark" iconSize="12" color="#F6B63D" on:tap="dsx.variable.toast = ''"
             a11yLabel="Dismiss message" a11yTrait="button"/>
    </hstack>
    <!-- THE REFUSAL, WHERE THE PRICE IS. App Store 3.1.1 makes coins and passes in-app-
         purchase products, so a native build with no IAP module may not sell them at all —
         and this template says that on the purchase surface rather than quietly opening a
         card sheet. The seam is two lines of dsx.config.json plus one backend secret; the
         note names both (Article 7: the degradation is named where the viewer reads it). -->
    <vstack class="laneCard" visible-if="dsx.variable.payLane == 'blocked'">
      <text value="Purchasing is off in this build" class="laneTitle"/>
      <text value="{{ dsx.variable.payNote }}" class="retryBody"/>
    </vstack>
    <vstack class="retryCard" visible-if="dsx.variable.settleFailed" style="border: 1px solid rgba(199,155,255,0.35)">
      <text value="Payment received — one step left" class="retryTitle"/>
      <text value="{{ dsx.variable.recoverLine }}" class="retryBody"/>
      <button label="Confirm payment" class="retryBtn" on:tap="dsx.action.settle()"/>
    </vstack>
    <grid bind="catalog.data.vip" key="id" columns="{{ dsx.attribute.mode == 'inline' && dsx.screen.width >= 768 ? 3 : 1 }}" spacing="14" scroll="false"
          visible-if="dsx.variable.phase == 'content'">
      <vstack class="tier" on:tap="dsx.action.buy()" a11yGroup="true" a11yTrait="button"
              on:hoverStart="dsx.variable.hovId = item.id" on:hoverEnd="dsx.variable.hovId = ''"
              a11yLabel="Buy {{ item.label }} for {{ item.price }}" style="{{ tierFx }}">
        <hstack spacing="8" alignItems="center" style="width: 100%">
          <text value="{{ item.label }}" class="tierName"/>
          <spacer/>
          <text value="{{ item.badge }}" class="tierBadge" visible-if="item.badge != ''"/>
        </hstack>
        <text value="{{ item.price }}" class="tierPrice"/>
        <text value="{{ item.note }}" class="tierNote"/>
        <hstack class="perk">
          <image icon="checkmark" iconSize="11" color="#2A1D04" a11yHidden="true"/>
          <text value="Unlimited viewing" class="perkText"/>
        </hstack>
        <hstack class="perk">
          <image icon="checkmark" iconSize="11" color="#2A1D04" a11yHidden="true"/>
          <!-- was "1080p, no ads". 1080p is a paywall on a no-op: the quality ladder was
               deleted in Phase 1 because <video> has no quality attribute on any renderer
               (upstream #270), and selling it here re-erected the same paywall one screen
               from where it was removed. This row now names what the server actually
               grants — unlockEpisode prices at 0 while vip_until is in the future. -->
          <text value="Every episode at 0 coins, no ads" class="perkText"/>
        </hstack>
        <text value="{{ tierBusy }}" class="busyLine" visible-if="tierBusy != ''"/>
      </vstack>
    </grid>
  </vstack>

  <!-- SHEET: content-height, so the plans sit over the screen that asked for them -->
  <sheet present="dsx.variable.open" detents="content" background="#141414"
         on:dismiss="dsx.variable.open = false">
    <vstack class="sheetBody">
      <hstack class="head">
        <vstack spacing="4" style="flex: 1; min-width: 0" alignItems="stretch">
          <text value="Go VIP" class="title"/>
          <text value="{{ dsx.variable.statusLine }}" class="status"/>
        </vstack>
        <vstack class="closeBtn" style="justify-content: center" on:tap="dsx.variable.open = false"
                a11yTrait="button" a11yLabel="Close plans">
          <image icon="xmark" iconSize="14" color="#FFFFFF" a11yHidden="true"/>
        </vstack>
      </hstack>

      <hstack class="toastRow" visible-if="dsx.variable.toast != ''">
        <text value="{{ dsx.variable.toast }}" class="toastLine" style="flex: 1"/>
        <image icon="xmark" iconSize="12" color="#F6B63D" on:tap="dsx.variable.toast = ''"
               a11yLabel="Dismiss message" a11yTrait="button"/>
      </hstack>

      <!-- THE REFUSAL, WHERE THE PRICE IS. App Store 3.1.1 makes coins and passes in-app-
           purchase products, so a native build with no IAP module may not sell them at all —
           and this template says that on the purchase surface rather than quietly opening a
           card sheet. The seam is two lines of dsx.config.json plus one backend secret; the
           note names both (Article 7: the degradation is named where the viewer reads it). -->
      <vstack class="laneCard" visible-if="dsx.variable.payLane == 'blocked'">
        <text value="Purchasing is off in this build" class="laneTitle"/>
        <text value="{{ dsx.variable.payNote }}" class="retryBody"/>
      </vstack>
      <vstack class="retryCard" visible-if="dsx.variable.settleFailed" style="border: 1px solid rgba(199,155,255,0.35)">
        <text value="Payment received — one step left" class="retryTitle"/>
        <text value="{{ dsx.variable.recoverLine }}" class="retryBody"/>
        <button label="Confirm payment" class="retryBtn" on:tap="dsx.action.settle()"/>
      </vstack>

      <vstack spacing="12" alignItems="stretch" visible-if="dsx.variable.phase == 'loading'">
        <Skeleton height="120" radius="14"/>
        <Skeleton height="120" radius="14"/>
      </vstack>

      <vstack class="errCard" visible-if="dsx.variable.phase == 'error'">
        <text value="VIP plans could not be loaded." fontSize="14" color="#FFFFFF"/>
        <button label="Retry" class="retryBtn" on:tap="catalog.refresh()"/>
      </vstack>

      <list bind="catalog.data.vip" key="id" scroll="false" spacing="12" visible-if="dsx.variable.phase == 'content'">
        <vstack class="tier" on:tap="dsx.action.buy()" a11yGroup="true" a11yTrait="button"
                a11yLabel="Buy {{ item.label }} for {{ item.price }}" style="{{ tierFx }}">
          <hstack spacing="8" alignItems="center" style="width: 100%">
            <text value="{{ item.label }}" class="tierName"/>
            <spacer/>
            <text value="{{ item.badge }}" class="tierBadge" visible-if="item.badge != ''"/>
          </hstack>
          <text value="{{ item.price }}" class="tierPrice"/>
          <text value="{{ item.note }}" class="tierNote"/>
          <hstack class="perk">
            <image icon="checkmark" iconSize="11" color="#2A1D04" a11yHidden="true"/>
            <text value="Unlimited viewing" class="perkText"/>
          </hstack>
          <text value="{{ tierBusy }}" class="busyLine" visible-if="tierBusy != ''"/>
        </vstack>
      </list>

      <!-- SIGN IN OR RESTORE, on the surface that sells the subscription — App Store 3.1.2
           asks for exactly this pair, and both are real: the tier tap raises the sign-in
           sheet for a guest, and this row calls POST /store/restore. -->
      <RestoreRow variant="compact" visible-if="dsx.variable.phase == 'content'"/>

      <!-- Terms + Privacy beside the price, which is where Apple requires them. -->
      <LegalLinks variant="line" visible-if="dsx.variable.phase == 'content'"/>

      <!-- the full page still exists for the benefit story; the sheet just isn't it -->
      <text value="See everything VIP includes" class="benefitsLink"
            visible-if="dsx.variable.phase == 'content'" a11yTrait="button"
            on:tap="dsx.variable.open = false; dsx.module.route.push({ path: '/vip' })"/>
    </vstack>
  </sheet>
</vstack>
