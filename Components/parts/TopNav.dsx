<!-- TopNav — the wide-viewport navigation, styled to the category standard (the
     ReelShort-class bar): logo mark + wordmark, bold white links with the active one in
     brand red, then the utility cluster — search, history, profile — and the red pill
     CTA. Phones get the bottom <TabBar> instead; same five destinations either way.

     Icons resolve per renderer from the shared catalog (Boxicons on web, SF Symbols on
     iOS, Material Symbols on Android) — one name, never a per-platform fork. -->
<hstack class="nav" style="width: 100%; border-bottom: 1px solid rgba(255,255,255,0.06)">
  <head>
    <attribute as="active" default="'home'"/>

    <variable as="on" computed="true">'#FF2D55'</variable>
    <variable as="off" computed="true">'#FFFFFF'</variable>

    <style as="nav" background="#000000" paddingV="15" alignItems="center"/>
    <style as="inner" alignItems="center" spacing="28" paddingLeading="32" paddingTrailing="32"/>
    <style as="brand" spacing="9" alignItems="center"/>
    <style as="logoBox" background="#FF2D55" radius="9" alignItems="center" width="30" height="30"/>
    <style as="logoGlyph" fontSize="13" fontWeight="heavy" color="#FFFFFF"/>
    <style as="wordmark" fontSize="20" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>
    <style as="links" spacing="30" alignItems="center"/>
    <style as="link" fontSize="15" fontWeight="semibold"/>
    <style as="tools" spacing="20" alignItems="center"/>
    <style as="cta" background="#FF2D55" radius="19" paddingH="18" paddingV="9" fontSize="15" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <hstack class="inner" style="width: 100%; max-width: 1400px; margin-left: auto; margin-right: auto">
    <hstack class="brand" href="/" a11yLabel="Short Drama — home">
      <vstack class="logoBox" style="justify-content: center">
        <text value="▶" class="logoGlyph" a11yHidden="true"/>
      </vstack>
      <text value="ShortDrama" class="wordmark"/>
    </hstack>

    <hstack class="links">
      <text value="Home" class="link" href="/"
            color="{{ dsx.attribute.active == 'home' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="Discover" class="link" href="/discover"
            color="{{ dsx.attribute.active == 'discover' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="Rewards" class="link" href="/rewards"
            color="{{ dsx.attribute.active == 'rewards' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="My List" class="link" href="/list"
            color="{{ dsx.attribute.active == 'list' ? dsx.variable.on : dsx.variable.off }}"/>
    </hstack>

    <spacer/>

    <hstack class="tools">
      <image icon="magnifyingglass" iconSize="21" href="/search" a11yLabel="Search"
             color="{{ dsx.attribute.active == 'search' ? dsx.variable.on : dsx.variable.off }}"/>
      <image icon="clock.fill" iconSize="20" href="/list" a11yLabel="Watch history"
             color="rgba(255,255,255,0.88)"/>
      <image icon="person.crop.circle" iconSize="23" href="/profile" a11yLabel="Profile"
             color="{{ dsx.attribute.active == 'profile' ? dsx.variable.on : dsx.variable.off }}"/>
    </hstack>
    <text value="Get Coins" class="cta" href="/rewards" a11yLabel="Get coins — open Rewards"/>
  </hstack>
</hstack>
