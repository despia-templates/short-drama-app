<!-- TopNav — the wide-viewport bar, built to the category reference measured live at
     1440×900: 80px tall, TRANSPARENT and sticky so the hero art runs underneath it,
     18px/700 links with the active one in brand red, then the utility cluster and the
     red CTA pill. Phones get <TabBar>; same destinations either way.

     Search is an OVERLAY (<SearchOverlay/> owns its trigger and its cover sheet), never
     a route — the storefront stays mounted behind it.

     Icons resolve per renderer from the shared catalog (Boxicons on web, SF Symbols on
     iOS, Material Symbols on Android). No emoji anywhere: an emoji is a font-dependent
     glyph, not an icon, and it cannot carry a per-platform twin. -->
<hstack class="nav" style="width: 100%; position: sticky; top: 0; z-index: 50">
  <head>
    <attribute as="active" default="'home'"/>

    <variable as="on" computed="true">'#FF2C55'</variable>
    <variable as="off" computed="true">'rgba(255,255,255,0.95)'</variable>

    <style as="nav" background="rgba(0,0,0,0)" height="80" alignItems="center"/>
    <style as="inner" alignItems="center" spacing="30" paddingLeading="86" paddingTrailing="86"/>
    <style as="brand" spacing="10" alignItems="center"/>
    <style as="logoBox" background="#FF2C55" radius="9" alignItems="center" width="32" height="32"/>
    <style as="wordmark" fontSize="22" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>
    <style as="links" spacing="30" alignItems="center"/>
    <style as="link" fontSize="18" fontWeight="bold"/>
    <style as="tools" spacing="22" alignItems="center"/>
    <style as="cta" background="#FF2C55" radius="20" paddingH="22" paddingV="10" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <hstack class="inner" style="width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto">
    <hstack class="brand" on:tap="dsx.module.route.reset({ path: '/' })" a11yGroup="true" a11yTrait="button" a11yLabel="Short Drama — home">
      <vstack class="logoBox" style="justify-content: center">
        <image icon="play.fill" iconSize="15" color="#FFFFFF" a11yHidden="true"/>
      </vstack>
      <text value="ShortDrama" class="wordmark"/>
    </hstack>

    <hstack class="links">
      <text value="Home" class="link" on:tap="dsx.module.route.reset({ path: '/' })" a11yTrait="button"
            color="{{ dsx.attribute.active == 'home' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="Discover" class="link" on:tap="dsx.module.route.reset({ path: '/discover' })" a11yTrait="button"
            color="{{ dsx.attribute.active == 'discover' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="Rewards" class="link" on:tap="dsx.module.route.reset({ path: '/rewards' })" a11yTrait="button"
            color="{{ dsx.attribute.active == 'rewards' ? dsx.variable.on : dsx.variable.off }}"/>
      <text value="My List" class="link" on:tap="dsx.module.route.reset({ path: '/list' })" a11yTrait="button"
            color="{{ dsx.attribute.active == 'list' ? dsx.variable.on : dsx.variable.off }}"/>
    </hstack>

    <spacer/>

    <hstack class="tools">
      <SearchOverlay size="21"/>
      <image icon="clock.fill" iconSize="20" on:tap="dsx.module.route.reset({ path: '/list' })" a11yTrait="button" a11yLabel="Watch history"
             color="rgba(255,255,255,0.95)"/>
      <image icon="person.crop.circle" iconSize="23" on:tap="dsx.module.route.reset({ path: '/profile' })" a11yTrait="button" a11yLabel="Profile"
             color="{{ dsx.attribute.active == 'profile' ? dsx.variable.on : dsx.variable.off }}"/>
    </hstack>
    <text value="Get Coins" class="cta" on:tap="dsx.module.route.push({ path: '/store' })" a11yTrait="button" a11yLabel="Get coins — open the store"/>
  </hstack>
</hstack>
