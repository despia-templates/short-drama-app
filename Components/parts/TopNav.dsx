<!-- TopNav — the wide-viewport bar, built to the category reference measured live at
     1440×900: 64px tall, TRANSPARENT and sticky so the hero art runs underneath it
     (re-measured 2026-08-30 against my-drama 64 · shortical 64 · flextv 63 — 80 was ours
     alone, and it cost the hero 16px of stage on every wide screen),
     18px/700 links with the active one in brand red, then the utility cluster and the
     red CTA pill. Phones get <TabBar>; same destinations either way.

     EVERY WIDE ROUTE HAS A HOME HERE. The link row mirrors the phone tab bar (Home ·
     For You · VIP · My List) plus Rewards, so `active=` always has something to light —
     a route whose nav never highlights reads as "you are nowhere". The Store is not a
     link: it is a pushed destination the CTA pill owns, and it lights nothing on purpose.

     Get Coins = BUY = /store, everywhere in the app. Earning is /rewards and is named
     "Rewards". Two verbs, two destinations, never crossed.

     A pointer device gets pointer affordances: links and tools carry a hover state
     (color shift via the hov pattern) beside the framework's universal pressed dim.

     Search is an OVERLAY (<SearchOverlay/> owns its trigger and its cover sheet), never
     a route — the storefront stays mounted behind it. Icons resolve per renderer from
     the shared catalog; no emoji anywhere. -->
<hstack chrome="true" class="nav" style="{{ dsx.variable.navBox }}">
  <head>
    <attribute as="active" default="'home'"/>
    <!-- A TRANSPARENT BAR IS ONLY CORRECT OVER ART. The bar is transparent so the Home hero
         runs underneath it — but on every other route that means page TEXT scrolls visibly
         THROUGH the nav. Measured on /store at 1440: the page's own back row and a toast
         both rendered across the links, and neither was legible.
         `overArt` DEFAULTS TO FALSE, so a caller that forgets it gets a readable bar — never
         a broken one. Only a screen with art behind the bar opts in.

         WHY THIS IS NOT SCROLL-DRIVEN, which is what the category does. The obvious shape is
         transparent at rest and solid once scrolled, off `on:scroll`'s `atTop`. It does not
         work on the page a viewer LANDS on: a server-rendered screen's outermost <scroll> is
         hydrated without `applyScrollBehaviour`, so it has no scroll plane, none of the
         scroll-linked custom properties, and no `on:scroll` dispatch at all — while the identical component mounted
         by a client-side route change has every one of them. Measured both ways on the same
         document (PLAN.md §6.40). A handler that fires only after the viewer navigates away
         and back is exactly the inert control this template deletes on sight, so the bar is
         static and the transparent lane carries a gradient scrim instead: over art it reads
         as the hero's own vignette, and it guarantees the links stay legible against whatever
         scrolls beneath. Three lines to make it scroll-aware the day the plane hydrates. -->
    <attribute as="overArt" default="false"/>

    <variable as="hov">return ''</variable>
    <variable as="on" computed="true">brand()</variable>
    <!-- the bar owns its own breakpoint: measured at 1440 (gutter 86 · gaps 30), and at
         768 the same numbers put the wordmark under "Home" and the tools under "My List"
         — tablet drops the wordmark (the logo square carries the brand) and tightens -->
    <variable as="isDesktop" computed="true">return dsx.screen.width >= 1120</variable>
    <variable as="pad" computed="true">return dsx.variable.isDesktop ? 86 : 40</variable>
    <variable as="gap" computed="true">return dsx.variable.isDesktop ? 30 : 20</variable>
    <variable as="innerBox" computed="true">
      const p = dsx.variable.pad
      const g = dsx.variable.gap
      return 'width: 100%; max-width: 1440px; margin-left: auto; margin-right: auto; padding-left: ' + p + 'px; padding-right: ' + p + 'px; gap: ' + g + 'px'
    </variable>
    <variable as="off" computed="true">'rgba(255,255,255,0.95)'</variable>
    <!-- A MARKUP ATTRIBUTE ARRIVES AS A STRING unless the caller interpolates a value:
         `overArt="true"` is the four characters, while `default="false"` is a JSE expression
         and is the boolean. Comparing one to the other with `== true` is false for the
         string, so the bar stayed solid on Home with no error anywhere. Accept both
         spellings rather than making every caller write `overArt="{{ true }}"`. -->
    <variable as="clear" computed="true">
      const oa = dsx.attribute.overArt
      return oa === true || oa === 'true'
    </variable>
    <!-- the scrim is the drawer's own #141414 at 0.92 over a hairline, and the blur is a web
         enhancement that degrades to the flat colour everywhere else -->
    <variable as="navBox" computed="true">
      const base = 'width: 100%; position: sticky; top: 0; z-index: 50; '
      if (dsx.variable.clear) {
        return base + 'background-image: linear-gradient(180deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.3) 62%, rgba(0,0,0,0) 100%)'
      }
      return base + 'background-color: rgba(20,20,20,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.07)'
    </variable>
    <variable as="links" computed="true">
      return [
        { key: 'home',     label: 'Home',    path: '/' },
        { key: 'discover', label: 'For You', path: '/discover' },
        { key: 'browse',   label: 'Browse',  path: '/browse' },
        { key: 'vip',      label: 'VIP',     path: '/vip' },
        { key: 'rewards',  label: 'Rewards', path: '/rewards' },
        { key: 'list',     label: 'My List', path: '/list' }
      ]
    </variable>

    <!-- one formula answers every link's color: active wins, then hover, then rest -->
    <formula as="linkTint" key="item.key">
      if (dsx.attribute.active == key) { return dsx.variable.on }
      if (dsx.variable.hov == key) { return brandSoft() }
      return dsx.variable.off
    </formula>

    <style as="nav" background="rgba(0,0,0,0)" height="64" alignItems="center"/>
    <style as="inner" alignItems="center"/>
    <style as="brand" spacing="10" alignItems="center"/>
    <style as="logoBox" background="#FF2C55" radius="9" alignItems="center" width="32" height="32"/>
    <style as="wordmark" fontSize="22" fontWeight="bold" color="#FFFFFF" tracking="-0.4"/>
    <style as="links" spacing="30" alignItems="center"/>
    <style as="link" fontSize="18" fontWeight="bold"/>
    <style as="tools" spacing="22" alignItems="center"/>
    <style as="cta" background="#FF2C55" radius="20" paddingH="22" paddingV="10" fontSize="14" fontWeight="semibold" color="#FFFFFF"/>
  </head>

  <!-- SELF-SUFFICIENT: this part calls the shared design vocabulary (Components/parts/
       Theme.dsx), and a caller must not have to remember to register it first. The
       block is app-wide and last-write-wins, so a second mount costs a 0x0 stack. -->
  <Theme/>
  <hstack class="inner" style="{{ dsx.variable.innerBox }}">
    <hstack class="brand" on:tap="dsx.module.route.reset({ path: '/' })" a11yGroup="true" a11yTrait="button" a11yLabel="Short Drama — home">
      <vstack class="logoBox" style="justify-content: center">
        <image icon="play.fill" iconSize="15" color="#FFFFFF" a11yHidden="true"/>
      </vstack>
      <text value="ShortDrama" class="wordmark" visible-if="dsx.variable.isDesktop"/>
    </hstack>

    <hstack class="links">
      <list bind="dsx.variable.links" key="key" axis="horizontal" scroll="false" spacing="{{ dsx.variable.gap }}">
        <text value="{{ item.label }}" class="link" a11yTrait="button"
              on:tap="dsx.module.route.reset({ path: item.path })"
              on:hoverStart="dsx.variable.hov = item.key" on:hoverEnd="dsx.variable.hov = ''"
              color="{{ linkTint }}"
              style="transition: color 0.15s ease"/>
      </list>
    </hstack>

    <spacer/>

    <hstack class="tools">
      <SearchOverlay size="21"/>
      <image icon="person.crop.circle" iconSize="23" on:tap="dsx.module.route.reset({ path: '/profile' })" a11yTrait="button" a11yLabel="Profile"
             color="{{ dsx.attribute.active == 'profile' ? dsx.variable.on : dsx.variable.off }}"/>
      <!-- the CTA lives inside the tools cluster so the 22px rhythm owns its gap too -->
      <text value="Get Coins" class="cta" on:tap="dsx.module.route.push({ path: '/store' })" a11yTrait="button" a11yLabel="Get coins — open the store"/>
    </hstack>
  </hstack>
</hstack>
