{
  "name": "Short Drama",
  "entry": "App",
  "outDir": "dist",
  "routes": [
    {
      "path": "/",
      "component": "shortdrama.App",
      "meta": {
        "title": "Short Drama \u2014 binge-worthy vertical series"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/discover",
      "component": "shortdrama.Discover",
      "meta": {
        "title": "Discover \u2014 Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/vip",
      "component": "shortdrama.Vip",
      "meta": {
        "title": "VIP \u2014 Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/store",
      "component": "shortdrama.Store",
      "meta": {
        "title": "Store \u2014 Short Drama"
      }
    },
    {
      "path": "/rewards",
      "component": "shortdrama.Rewards",
      "meta": {
        "title": "Rewards \u2014 Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/list",
      "component": "shortdrama.MyList",
      "meta": {
        "title": "My List \u2014 Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/profile",
      "component": "shortdrama.Profile",
      "meta": {
        "title": "Profile \u2014 Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/notices",
      "component": "shortdrama.Notices",
      "meta": {
        "title": "Notifications \u2014 Short Drama"
      }
    },
    {
      "path": "/account",
      "component": "shortdrama.Account",
      "meta": {
        "title": "Account \u2014 Short Drama"
      }
    },
    {
      "path": "/auth/:pane",
      "component": "shortdrama.Auth",
      "meta": {
        "title": "Account \u2014 Short Drama"
      }
    },
    {
      "path": "/browse/:genre",
      "component": "shortdrama.Browse",
      "meta": {
        "title": "Browse \u2014 Short Drama"
      }
    },
    {
      "path": "/browse",
      "component": "shortdrama.Browse",
      "meta": {
        "title": "Browse \u2014 Short Drama"
      }
    },
    {
      "path": "/show/:id",
      "component": "shortdrama.Show",
      "meta": {
        "title": "Show \u2014 Short Drama"
      }
    },
    {
      "path": "/watch/:show/:idx",
      "component": "shortdrama.Watch",
      "meta": {
        "title": "Watch \u2014 Short Drama"
      }
    },
    {
      "path": "/admin",
      "component": "shortdrama.Admin",
      "meta": {
        "title": "Manage \u2014 Short Drama"
      }
    }
  ],
  "router": {
    "transition": "ios",
    "swipeBack": true,
    "motionBreakpoint": 768,
    "wide": "dsx"
  },
  "packages": [
    "../despia_dsx/despia-framework/ClosedSource/DSX/Modules/Core/Payments/Stripe",
    "../despia_dsx/despia-framework/ClosedSource/DSX/Modules/Core/SocialShare"
  ],
  "modules": [
    "stripe",
    "share"
  ]
}
