{
  "name": "Short Drama",
  "entry": "App",
  "outDir": "dist",
  "routes": [
    {
      "path": "/",
      "component": "shortdrama.App",
      "meta": {
        "title": "Short Drama — binge-worthy vertical series"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/discover",
      "component": "shortdrama.Discover",
      "meta": {
        "title": "Discover — Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/vip",
      "component": "shortdrama.Vip",
      "meta": {
        "title": "VIP — Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/store",
      "component": "shortdrama.Store",
      "meta": {
        "title": "Store — Short Drama"
      }
    },
    {
      "path": "/rewards",
      "component": "shortdrama.Rewards",
      "meta": {
        "title": "Rewards — Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/list",
      "component": "shortdrama.MyList",
      "meta": {
        "title": "My List — Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/profile",
      "component": "shortdrama.Profile",
      "meta": {
        "title": "Profile — Short Drama"
      },
      "motion": {
        "mobile": "none",
        "wide": "dsx"
      }
    },
    {
      "path": "/notices",
      "component": "shortdrama.Notices",
      "meta": {
        "title": "Notifications — Short Drama"
      }
    },
    {
      "path": "/browse/:genre",
      "component": "shortdrama.Browse",
      "meta": {
        "title": "Browse — Short Drama"
      }
    },
    {
      "path": "/browse",
      "component": "shortdrama.Browse",
      "meta": {
        "title": "Browse — Short Drama"
      }
    },
    {
      "path": "/show/:id",
      "component": "shortdrama.Show",
      "meta": {
        "title": "Show — Short Drama"
      }
    },
    {
      "path": "/watch/:show/:idx",
      "component": "shortdrama.Watch",
      "meta": {
        "title": "Watch — Short Drama"
      }
    },
    {
      "path": "/admin",
      "component": "shortdrama.Admin",
      "meta": {
        "title": "Manage — Short Drama"
      }
    }
  ],
  "router": {
    "transition": "ios",
    "swipeBack": true,
    "motionBreakpoint": 768,
    "wide": "dsx"
  },
  "packages": [
    "../despia_dsx/despia-framework/ClosedSource/DSX/Modules/Core/Payments/Stripe"
  ],
  "modules": [
    "stripe"
  ]
}
