<!-- admin.dsx — the Manage View's backend: operator verbs over the catalogue, stats and
     the notice board, each also served as an MCP tool (the <tool> rows), so the same
     declared action answers the bridge UI, ChatGPT/Claude, and curl.
     AUTHORITY: the platform's own model, nothing custom, in TWO planes — and it is worth
     being exact, because the first version of this header was wrong in a way that shipped a
     draft leak.
       · THE ROUTE GATEWAY reads the JWT's `role` claim. `reach=""` (see the route rows)
         makes a row internal: service-role identity or DSX_INTERNAL_KEY, everyone else 404.
         This is what actually keeps a viewer out.
       · POSTGRES RLS reads the database role. show/episode/notice are
         ownership="public-read": SELECT is `using (true)`, and there is NO write policy, so
         writes deny by default. Crucially, `runAs` sets `set local role authenticated` for
         EVERY user-scope query regardless of the token's `role` claim — a declared action
         never runs as service_role — so these write actions fail closed for the operator
         too. That is PLAN.md §6.7, and it is why scripts/serve.mjs carries hand-written
         internal twins that reach `serviceRepo()` directly.
     The header used to say the reads "succeed only for a caller whose JWT carries a service
     role claim". They did not: auth="required" admits any signed-in viewer, and `using
     (true)` then handed them the unpublished catalogue. Fixed at the gateway, below.
     When role-scoped auth (auth="role:operator") lands upstream (PLAN.md §6.2), these rows
     change one attribute and a finer-than-service operator role becomes possible. -->
<server>
  <head>
    <entity as="notice" ownership="public-read">
      <field as="title" type="text"/>
      <field as="message" type="text"/>
      <field as="segment" type="text"/>   <!-- all | vip | lapsed — the push audience -->
      <field as="kind" type="text"/>      <!-- push | banner -->
    </entity>

    <!-- THERE IS NO COUNT OP, AND `limit` IS CLAMPED TO 100. `list` takes a page size and
         silently caps it (repo.ts LIST_LIMIT — a deliberate anti-exfiltration ceiling), so a
         dashboard that asks for 1000 rows and reports `.length` reports 100 no matter how
         many exist. The numbers here are therefore PAGE counts, and each carries whether the
         page was full, so the Manage screen can render "100+" instead of a confident lie.
         Upstream: an entity needs `count` (and `list` needs to admit truncation) — PLAN.md §6. -->
    <action as="adminStats">
      const shows = await dsx.module.data.show.list({ limit: 100 })
      const eps = await dsx.module.data.episode.list({ limit: 100 })
      const notices = await dsx.module.data.notice.list({ limit: 100 })
      const all = shows.ok ? shows.data : []
      const epRows = eps.ok ? eps.data : []
      const noticeRows = notices.ok ? notices.data : []
      return {
        shows: all.length,
        live: all.filter(s => s.state === 'live').length,
        drafts: all.filter(s => s.state === 'draft').length,
        episodes: epRows.length,
        notices: noticeRows.length,
        capped: all.length >= 100 || epRows.length >= 100 || noticeRows.length >= 100
      }
    </action>

    <action as="adminListShows">
      const shows = await dsx.module.data.show.list({ limit: 100 })
      // one bounded read per show: a catalogue-wide episode list stops at the 100-row
      // ceiling without saying so, and every show past it would report 0 episodes here
      const counts = {}
      for (const s of (shows.ok ? shows.data : [])) {
        const mine = await dsx.module.data.episode.list({ filters: { show: s.id }, limit: 100 })
        counts[s.id] = mine.ok ? mine.data.length : 0
      }
      const rows = (shows.ok ? shows.data : [])
        .sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
        .map(s => ({ id: s.id, title: s.title, genre: s.genre, state: s.state, featured: s.featured === true, freeUntil: s.free_until, episodes: counts[s.id] == null ? 0 : counts[s.id], poster: s.poster }))
      return { rows: rows }
    </action>

    <action as="adminUpsertShow" inputs="id, title, synopsis, genre, poster, cover, titleArt, hero, heroTall, state, freeUntil, featured, views, rating, tags, hot, isNew, original, comingSoon, releaseAt">
      if (title == null || title === '') { throw { reason: 'invalid', message: 'title is required' } }
      const values = {
        title: title,
        synopsis: synopsis == null ? '' : synopsis,
        genre: genre == null || genre === '' ? 'Drama' : genre,
        poster: poster == null ? '' : poster,
        cover: cover == null ? '' : cover,
        title_art: titleArt == null ? '' : titleArt,
        hero: hero == null ? '' : hero,
        hero_tall: heroTall == null ? '' : heroTall,
        state: state == null || state === '' ? 'draft' : state,
        free_until: freeUntil == null ? 8 : freeUntil,
        featured: featured === true,
        views: views == null ? 0 : views,
        rating: rating == null ? '' : rating,
        tags: tags == null ? '' : tags,
        // the reference home badges and the coming-soon pair are OPERATOR facts: a show is
        // HOT or NEW or ORIGINAL because this action was told so, never because of a rank
        hot: hot === true,
        is_new: isNew === true,
        original: original === true,
        coming_soon: comingSoon === true
      }
      // never `field: null` in a data.create — the key is written only when a date was sent
      if (releaseAt != null && releaseAt !== '') { values.release_at = releaseAt }
      if (id) {
        const done = await dsx.module.data.show.update({ id: id, values: values })
        if (!done.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
        return { id: id, updated: true }
      }
      const made = await dsx.module.data.show.create(values)
      if (!made.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { id: made.data.id, created: true }
    </action>

    <action as="adminUpsertEpisode" inputs="id, show, idx, title, videoUrl, poster, duration, price, state">
      if (show == null || show === '') { throw { reason: 'invalid', message: 'show is required' } }
      const order = idx == null ? 1 : idx
      const values = {
        show: show, idx: order,
        title: title == null || title === '' ? ('Episode ' + order) : title,
        video_url: videoUrl == null ? '' : videoUrl,
        poster: poster == null ? '' : poster,
        duration: duration == null ? 75 : duration,
        price: price == null ? 60 : price,
        state: state == null || state === '' ? 'live' : state
      }
      if (id) {
        const done = await dsx.module.data.episode.update({ id: id, values: values })
        if (!done.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
        return { id: id, updated: true }
      }
      const made = await dsx.module.data.episode.create(values)
      if (!made.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { id: made.data.id, created: true }
    </action>

    <action as="adminPublish" inputs="show, state">
      if (state !== 'live' && state !== 'draft') { throw { reason: 'invalid', message: 'state must be live or draft' } }
      const done = await dsx.module.data.show.update({ id: show, values: { state: state } })
      if (!done.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { show: show, state: state }
    </action>

    <action as="adminFeature" inputs="show, featured">
      const done = await dsx.module.data.show.update({ id: show, values: { featured: featured === true } })
      if (!done.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { show: show, featured: featured === true }
    </action>

    <!-- THE LIMITED OFFER (server/store.dsx, the `offer` entity): one row per sku, upserted, so
         a re-run moves the window rather than stacking rows. `endsAt` in the past is how an
         operator ends an offer early — the price list stops applying it on the next read. -->
    <action as="adminUpsertOffer" inputs="sku, endsAt, cents, productId">
      if (sku == null || sku === '') { throw { reason: 'invalid', message: 'sku is required' } }
      if (endsAt == null || endsAt === '') { throw { reason: 'invalid', message: 'endsAt is required' } }
      const values = {
        sku: sku, ends_at: endsAt,
        cents: cents == null ? 0 : cents,
        product_id: productId == null ? '' : productId
      }
      const have = await dsx.module.data.offer.list({ filters: { sku: sku }, limit: 100 })
      const rows = have.ok ? have.data : []
      if (rows.length > 0) {
        const done = await dsx.module.data.offer.update({ id: rows[0].id, values: values })
        if (!done.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
        return { id: rows[0].id, updated: true }
      }
      const made = await dsx.module.data.offer.create(values)
      if (!made.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { id: made.data.id, created: true }
    </action>

    <action as="adminNotice" inputs="title, message, segment, kind">
      if (title == null || title === '') { throw { reason: 'invalid', message: 'title is required' } }
      const made = await dsx.module.data.notice.create({ title: title, message: message == null ? '' : message, segment: segment == null || segment === '' ? 'all' : segment, kind: kind == null || kind === '' ? 'push' : kind })
      if (!made.ok) { throw { reason: 'forbidden', message: 'operator authority required' } }
      return { id: made.data.id, queued: true }
    </action>
  </head>

  <!-- ══ WHY EVERY ROW BELOW CARRIES `reach=""` ══════════════════════════════════════════
       THE DEFECT. `auth="required"` was the whole door, and for the two READS that was no
       door at all. `show`, `episode` and `notice` are ownership="public-read", whose SELECT
       policy is literally `using (true)` — so a plain viewer token passed the route's auth
       gate and then passed RLS, and `POST /admin/stats` returned the DRAFT COUNT while
       `POST /admin/shows` returned every unpublished title, its artwork and its free-episode
       window. The public reads filter `state: 'live'` in APPLICATION code (catalog.dsx), not
       in a policy, so the admin reads simply do not run that filter. Embargoed content was
       one authenticated request away, and the file header above claimed the opposite.
       (The WRITES were never exposed the same way — RLS has no write policy for public-read,
       so they fail closed for everyone. Including, today, the operator: `runAs` sets
       `set local role authenticated` for every user-scope query regardless of the token's
       `role` claim, so a declared action cannot write these tables at all. That is §6.7, and
       it is why scripts/serve.mjs carries the hand-written internal twins.)

       THE FIX, in the declared grammar. `reach=""` makes a row INTERNAL: host.ts's gateway
       admits only a caller whose verified identity carries a service role, or one presenting
       DSX_INTERNAL_KEY, and answers everyone else 404 — never 403, which would confirm to a
       prober that the endpoint exists. A viewer token now gets the same answer as a typo.
       Note this is the ROUTE gateway (the JWT's `role` claim), which is a different plane
       from the Postgres role RLS sees; the reads still run as `authenticated` and still work.

       WHAT THIS DOES NOT CLOSE, said out loud: the `<tool>` rows below. createMcpFace checks
       `auth === "required"` and a non-null identity and nothing else — it has no notion of
       `reach` and no role check — so the same two reads are still reachable over /mcp by any
       authenticated caller. scripts/serve.mjs, which owns the local /mcp mount, now gates the
       whole face on the same service-role-or-internal-key test. The upstream ask (a `<tool>`
       row needs the route gateway's authority model) is PLAN.md §6.84.

       RATE: the writes are not held to a human cadence because a legitimate operator bulk-
       imports — the seeder writes 352 episode rows in one run. 600/m is ten a second, which
       admits any import and still bounds a runaway agent holding an operator token. -->
  <route method="POST" path="/admin/stats"    action="adminStats"         auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/shows"    action="adminListShows"     auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/show"     action="adminUpsertShow"    auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/episode"  action="adminUpsertEpisode" auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/publish"  action="adminPublish"       auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/feature"  action="adminFeature"       auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/notice"   action="adminNotice"        auth="required" reach="" rate="600/m"/>
  <route method="POST" path="/admin/offer"    action="adminUpsertOffer"   auth="required" reach="" rate="600/m"/>

  <tool action="adminStats"         description="Catalogue and operations counters for this deployment." auth="required"/>
  <tool action="adminListShows"     description="List every show with state, episode count and pricing window." auth="required"/>
  <tool action="adminUpsertShow"    description="Create or update a show (title, synopsis, genre, posters, free window, featured)." auth="required" mutates="show"/>
  <tool action="adminUpsertEpisode" description="Create or update an episode (video URL, order, price, state)." auth="required" mutates="episode"/>
  <tool action="adminPublish"       description="Publish or unpublish a show (state live|draft)." auth="required" mutates="show"/>
  <tool action="adminNotice"        description="Send a notice: a push-style announcement to a viewer segment." auth="required" mutates="notice"/>
  <tool action="adminUpsertOffer"   description="Set a limited offer on a membership sku: the countdown end, the offer price in cents (0 = countdown only), an optional store product id." auth="required" mutates="offer"/>
</server>
