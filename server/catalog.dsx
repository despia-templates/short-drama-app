<!-- catalog.dsx — the public catalogue: shows and episodes, and the shaped reads the
     screens consume (home shelves, discover feed, show detail). Reads are auth="none"
     (a drama storefront is public); every WRITE goes through admin.dsx behind the
     operator key. No CRUD write route exists on this document on purpose. -->
<server>
  <head>
    <entity as="show" ownership="public-read">
      <field as="title" type="text"/>
      <field as="synopsis" type="text"/>
      <field as="genre" type="text"/>
      <field as="poster" type="text"/>
      <field as="hero" type="text"/>
      <field as="hero_tall" type="text"/>  <!-- the phone frame is 0.75:1, the desktop band 3:1 -->
      <field as="state" type="text"/>          <!-- draft | live -->
      <field as="free_until" type="integer"/>  <!-- episodes 1..N are free -->
      <field as="featured" type="boolean"/>
      <field as="views" type="integer"/>       <!-- demo social proof; see scripts/catalogue.mjs -->
      <field as="rating" type="text"/>         <!-- "9.4" — display only, never a gate -->
      <!-- MANY tags, one genre. Stored comma-joined in one column rather than a join table:
           tags are read on every catalogue query and written only by the operator, so a
           second table would cost a join on the hot path to buy nothing this app needs.
           Split on read, never trusted for authority — they are discovery labels. -->
      <field as="tags" type="text"/>
      <!-- THE REFERENCE HOME'S FIELDS (docs/design/reference-ui-spec.md §1–§2b). `cover` is
           the 2:3 key art every card on that home is built on — `poster` stays the 3:4 card
           the desktop lane and the older screens measure against, because art is authored at
           the ratio it is displayed at (AGENTS.md) and one file cannot serve both. `title_art`
           is the show's logo image, for the player's episodes sheet. The three booleans are
           the badges, set by the operator (never derived from a rank at paint time). A show
           with `coming_soon` is live in the catalogue and absent from every watchable rail,
           Browse, Search and the reel; `release_at` is what Remind Me counts down to. -->
      <field as="cover" type="text"/>
      <field as="title_art" type="text"/>
      <field as="hot" type="boolean"/>
      <field as="is_new" type="boolean"/>
      <field as="original" type="boolean"/>
      <field as="coming_soon" type="boolean"/>
      <field as="release_at" type="timestamptz"/>
      <index on="state"/>
    </entity>

    <entity as="episode" ownership="public-read">
      <field as="show" type="uuid"/>
      <field as="idx" type="integer"/>
      <field as="title" type="text"/>
      <field as="video_url" type="text"/>
      <field as="poster" type="text"/>
      <field as="duration" type="integer"/>    <!-- seconds -->
      <field as="price" type="integer"/>       <!-- coins; 0 = free regardless of index -->
      <field as="state" type="text"/>          <!-- draft | live -->
      <index on="show"/>
    </entity>

    <action as="homeShelves">
      const shows = await dsx.module.data.show.list({ filters: { state: 'live' }, limit: 100 })
      if (!shows.ok) { throw { reason: 'unavailable', message: 'catalogue unavailable' } }
      // EPISODE COUNTS, ONE BOUNDED READ PER SHOW. This used to be a single
      // `episode.list({ limit: 1000 })` — and `limit` is CLAMPED to 100 (repo.ts LIST_LIMIT,
      // a deliberate anti-exfiltration ceiling) with no truncation flag, no offset and no
      // count op, so the read stopped at row 100 and every show past it rendered "EP 0" on a
      // shipped storefront. Nothing failed; the number was just wrong. A per-show read is
      // inside the contract for any show under the ceiling, which is what a show is.
      // Upstream: `list` needs to say when it truncated, and needs a way to page (PLAN.md §6).
      const counts = {}
      for (const s of shows.data) {
        const mine = await dsx.module.data.episode.list({ filters: { show: s.id, state: 'live' }, limit: 100 })
        counts[s.id] = mine.ok ? mine.data.length : 0
      }
      const card = (s, i) => ({
        id: s.id, title: s.title, genre: s.genre, poster: s.poster, hero: s.hero, hero_tall: s.hero_tall,
        // the 2:3 art, falling back to the 3:4 poster for a row seeded before the field existed
        // — a frame with no art at all is worse than one cropped a quarter
        cover: s.cover == null || s.cover === '' ? s.poster : s.cover,
        titleArt: s.title_art == null ? '' : s.title_art,
        synopsis: s.synopsis, free_until: s.free_until, featured: s.featured === true,
        hot: s.hot === true, isNew: s.is_new === true, original: s.original === true,
        comingSoon: s.coming_soon === true, releaseAt: s.release_at == null ? '' : s.release_at,
        views: s.views == null ? 0 : s.views, rating: s.rating == null ? '' : s.rating,
        tags: s.tags == null || s.tags === '' ? [] : s.tags.split(',').map(t => t.trim()).filter(t => t !== ''),
        // the same tags as ROWS for a nested repeater: a repeater row is a dict, never a
        // scalar (`item` is the row SCOPE), so a chip list bound to an array of strings
        // renders "[object Object]" — the New Titles row and the coming-soon sheet read these
        chips: (s.tags == null || s.tags === '' ? [] : s.tags.split(',').map(t => t.trim()).filter(t => t !== ''))
          .slice(0, 3).map(t => ({ name: t })),
        episodes: counts[s.id] == null ? 0 : counts[s.id],
        rank: i + 1
      })
      // Each row may appear on several rails; the wire serializer elides a dict it has
      // already written (identity cycle-guard — upstream ledger), so every rail carries
      // value COPIES, never shared references.
      // A COMING-SOON SHOW IS ON ITS OWN RAIL AND NOWHERE ELSE: it has no live episode, so a
      // card for it on a watchable rail is a tap that lands on an empty grid.
      const rows = shows.data.filter(s => s.coming_soon !== true)
      const upcoming = shows.data.filter(s => s.coming_soon === true)
        .sort((a, b) => (a.release_at == null ? '' : a.release_at) < (b.release_at == null ? '' : b.release_at) ? -1 : 1)
      const featured = rows.filter(s => s.featured === true).slice(0, 5).map((s, i) => card(s, i))
      // JSE collections are value-typed (the Swift model): reading byGenre[g] hands back a
      // copy, so mutate-in-place is a silent no-op — group by WRITE-BACK instead.
      const byGenre = {}
      for (const s of rows) {
        const g = s.genre == null || s.genre === '' ? 'Drama' : s.genre
        byGenre[g] = (byGenre[g] == null ? [] : byGenre[g]).concat([card(s, 0)])
      }
      const shelves = Object.entries(byGenre).map(([genre, items]) => ({ genre: genre, items: items }))
      const trending = rows.filter(s => s.featured === true).concat(rows.filter(s => s.featured !== true))
      // THE REFERENCE HOME (spec §1–§2). `grid` is the Hot tab's Trending Now grid — the whole
      // live catalogue, HOT titles first and then by play count, because a 3-column grid wants
      // every title and the reader scrolls. `picks` is the Picks tab (the operator's featured
      // set), `newTitles` the New tab's vertical list (the NEW badge is the membership test),
      // `comingSoon` its rail, soonest premiere first.
      const viewsOf = (s) => s.views == null ? 0 : s.views
      const grid = rows.filter(s => s.hot === true).sort((a, b) => viewsOf(b) - viewsOf(a))
        .concat(rows.filter(s => s.hot !== true).sort((a, b) => viewsOf(b) - viewsOf(a)))
      return {
        hero: featured,
        latest: rows.slice(0, 12).map((s, i) => card(s, i)),
        trending: trending.slice(0, 10).map((s, i) => card(s, i)),
        shelves: shelves,
        grid: grid.map((s, i) => card(s, i)),
        picks: rows.filter(s => s.featured === true).map((s, i) => card(s, i)),
        newTitles: rows.filter(s => s.is_new === true).sort((a, b) => a.created_at < b.created_at ? 1 : -1).map((s, i) => card(s, i)),
        comingSoon: upcoming.map((s, i) => card(s, i))
      }
    </action>

    <!-- BROWSE — the destination every "View all" and every genre chip lands on, and the
         one structural surface the category leaders have that this template did not:
         DramaBox ships /genres (a chip row over a result grid) and ReelShort ships
         /shelf/<name> + /tags/<tag>. One action answers both shapes: the chip row is the
         genres actually present WITH their counts (never a hardcoded list that can drift
         from the catalogue), and `genre` filters the grid. 'all' is the unfiltered view. -->
    <action as="browseCatalog" inputs="genre">
      const shows = await dsx.module.data.show.list({ filters: { state: 'live' }, limit: 100 })
      const rows = shows.ok ? shows.data : []
      // the chips are DERIVED from the catalogue, so a new genre appears the day a show
      // carries it. Value-typed collections: group by WRITE-BACK, never mutate a read.
      const tally = {}
      for (const s of rows) {
        const g = s.genre == null || s.genre === '' ? 'Drama' : s.genre
        tally[g] = (tally[g] == null ? 0 : tally[g]) + 1
      }
      const genres = Object.entries(tally)
        .map(([name, n]) => ({ name: name, count: n }))
        .sort((a, b) => b.count - a.count)
      // THE TAG CHIPS, counted the same way. A show carries one genre and many tags, and
      // browse filters on EITHER — a chip is a chip to the viewer, and the reference apps
      // make no visible distinction. Tags with a single title are dropped: a chip that
      // narrows to one result is a dead end wearing the clothes of a filter.
      const tagTally = {}
      for (const s of rows) {
        const list = s.tags == null || s.tags === '' ? [] : s.tags.split(',').map(t => t.trim())
        for (const t of list) {
          if (t !== '' && tally[t] == null) { tagTally[t] = (tagTally[t] == null ? 0 : tagTally[t]) + 1 }
        }
      }
      const tags = Object.entries(tagTally)
        .map(([name, n]) => ({ name: name, count: n }))
        .filter(t => t.count > 1)
        .sort((a, b) => b.count - a.count)
      const want = genre == null || genre === '' ? 'all' : genre
      const matches = (row) => {
        if ((row.genre == null || row.genre === '' ? 'Drama' : row.genre) === want) { return true }
        const list = row.tags == null || row.tags === '' ? [] : row.tags.split(',').map(t => t.trim())
        return list.includes(want)
      }
      const picked = want === 'all' ? rows : rows.filter(row => matches(row))
      // one bounded episode query per show — the same shape homeShelves uses; a single
      // unbounded read would be clamped at 100 rows without saying so (PLAN.md §6.20)
      const counts = {}
      for (const s of picked) {
        const eps = await dsx.module.data.episode.list({ filters: { show: s.id, state: 'live' }, limit: 100 })
        counts[s.id] = eps.ok ? eps.data.length : 0
      }
      return {
        active: want,
        genres: genres,
        tags: tags,
        total: picked.length,
        items: picked.map(row => ({
          id: row.id, title: row.title, genre: row.genre, poster: row.poster,
          synopsis: row.synopsis, free_until: row.free_until,
          views: row.views == null ? 0 : row.views, rating: row.rating == null ? '' : row.rating,
          tags: row.tags == null || row.tags === '' ? [] : row.tags.split(',').map(t => t.trim()).filter(t => t !== ''),
          episodes: counts[row.id] == null ? 0 : counts[row.id]
        }))
      }
    </action>

    <action as="discoverFeed">
      const shows = await dsx.module.data.show.list({ filters: { state: 'live' }, limit: 50 })
      if (!shows.ok) { throw { reason: 'unavailable', message: 'catalogue unavailable' } }
      // one bounded read per show, for the same reason homeShelves does it: a catalogue-wide
      // episode list silently stops at the 100-row ceiling and the shows past it vanish
      const byShow = {}
      for (const s of shows.data) {
        const mine = await dsx.module.data.episode.list({ filters: { show: s.id, state: 'live' }, limit: 100 })
        for (const e of (mine.ok ? mine.data : [])) {
          const cur = byShow[e.show]
          if (cur == null || e.idx < cur.idx) { byShow[e.show] = e }
        }
      }
      // The discover reel autoplays each show's FIRST episode, which is free by construction
      // (idx 1 is inside any free_until >= 1). It is checked rather than assumed: an operator
      // can set free_until to 0, and this route is auth="none" — an unchecked `video_url`
      // here would be the same leak showDetail just closed, wearing a different name. A card
      // whose first episode is not free carries no source and the reel shows its poster.
      const cards = shows.data
        .map(s => ({ show: s, first: byShow[s.id] == null ? null : byShow[s.id] }))
        .filter(c => c.first !== null)
        .map(c => {
          const isFree = c.first.price === 0 || c.first.idx <= c.show.free_until
          const sep = c.first.video_url != null && c.first.video_url.includes('?') ? '&' : '?'
          return {
            show: c.show.id, title: c.show.title, synopsis: c.show.synopsis,
            genre: c.show.genre, poster: c.show.poster, hero: c.show.hero, hero_tall: c.show.hero_tall,
            video: isFree && c.first.video_url != null && c.first.video_url !== ''
              ? c.first.video_url + sep + 'ep=' + c.first.id : null,
            featured: c.show.featured === true
          }
        })
      const front = cards.filter(c => c.featured)
      const rest = cards.filter(c => c.featured !== true)
      return { cards: front.concat(rest) }
    </action>

    <action as="showDetail" inputs="id">
      if (id == null || id === '') { throw { reason: 'invalid', message: 'id is required' } }
      const s = await dsx.module.data.show.get({ id: id })
      if (!s.ok) { throw { reason: 'not_found', message: 'no such show' } }
      // 100 is the platform ceiling (repo.ts LIST_LIMIT); asking for more is silently
      // clamped, so the number written here is the real one
      const eps = await dsx.module.data.episode.list({ filters: { show: id, state: 'live' }, limit: 100 })
      const list = (eps.ok ? eps.data : []).sort((a, b) => a.idx - b.idx)
      // THE PAYWALL PROTECTS THE MEDIA, NOT THE PLAYER. This action is auth="none" — the
      // storefront is public and server-rendered — and it used to return `video_url` for
      // EVERY episode, free and paid alike. The client hid the locked ones; the URLs were in
      // the JSON and in the SSR html, so `curl /catalog/show/:id | jq '.episodes[].video'`
      // handed a stranger all 24 paid episodes and `GET /media/bride.mp4` answered 200 with
      // no token. Entitlement was enforced in MARKUP, which is not enforcement.
      // The grid still needs every episode's METADATA (title, index, duration, price, lock
      // state) — that is what a locked cell renders — so the shape here is: metadata always,
      // SOURCE only for an episode that is free to everyone. A paid episode's source comes
      // from GET /wallet/play/:episode (auth="required"), which re-runs the free/VIP/unlock
      // check server-side and answers with a short-lived, ticketed URL.
      // The `?ep=` on a free source is not decoration: the origin (and, in a real
      // deployment, the CDN rule that replaces it) needs to know WHICH episode a media
      // request is claiming, because one file can back many episodes — in this demo three
      // MP4s stand in for 352. Without it a free episode's id would open every file.
      const episodes = list.map(e => {
        const isFree = e.price === 0 || e.idx <= s.data.free_until
        const sep = e.video_url != null && e.video_url.includes('?') ? '&' : '?'
        return {
          id: e.id, idx: e.idx, title: e.title, poster: e.poster, duration: e.duration,
          video: isFree && e.video_url != null && e.video_url !== '' ? e.video_url + sep + 'ep=' + e.id : null,
          locked: isFree === false,
          free: isFree,
          price: e.price
        }
      })
      // "More like this" — the same-genre neighbours, minus this show. Both category
      // leaders put a related rail under the episode grid; it is what turns one finished
      // series into the next one. Bounded like every other read here (LIST_LIMIT is 100
      // and never says when it clamped), and a show with no genre falls back to the
      // newest rows rather than returning an empty rail.
      const genre = s.data.genre == null || s.data.genre === '' ? '' : s.data.genre
      // `await` is a STATEMENT here, never a ternary branch: every other await in this file
      // is a plain assignment, and the conditional-await spelling returned a pool whose
      // `.ok` was false (related came back empty for a genre with two live shows).
      // `await` is a STATEMENT here, never a ternary branch. ISOLATED 2026-08-30: with the
      // identical `let pool`, the conditional-await spelling returns a pool whose `.ok` is
      // falsy and this rail came back EMPTY for a genre with two live shows — no error, no
      // log, just no data. Statement form works. Upstream: PLAN.md §6.31.
      let pool = null
      if (genre === '') {
        pool = await dsx.module.data.show.list({ filters: { state: 'live' }, limit: 100 })
      } else {
        pool = await dsx.module.data.show.list({ filters: { state: 'live', genre: genre }, limit: 100 })
      }
      const related = (pool.ok ? pool.data : [])
        .filter(row => row.id !== id)
        .slice(0, 12)
        .map(row => ({ id: row.id, title: row.title, genre: row.genre, poster: row.poster }))
      // the ROW carries tags comma-joined; every consumer wants the array, and the card
      // helper already parses them — the detail payload must not be the one place that
      // hands back a raw string (the Show and Watch tag rows read `.tags` as a list).
      const showOut = { ...s.data }
      showOut.tags = s.data.tags == null || s.data.tags === ''
        ? []
        : s.data.tags.split(',').map(t => t.trim()).filter(t => t !== '')
      // the reference fields in the shape the screens read (camelCase, never null): the
      // player's episodes sheet centres `titleArt`, the badges read the three flags
      showOut.cover = s.data.cover == null || s.data.cover === '' ? s.data.poster : s.data.cover
      showOut.titleArt = s.data.title_art == null ? '' : s.data.title_art
      showOut.hot = s.data.hot === true
      showOut.isNew = s.data.is_new === true
      showOut.original = s.data.original === true
      showOut.comingSoon = s.data.coming_soon === true
      showOut.releaseAt = s.data.release_at == null ? '' : s.data.release_at
      return { show: showOut, episodes: episodes, related: related }
    </action>

    <action as="searchShows" inputs="q">
      const term = (q == null ? '' : String(q)).trim().toLowerCase()
      const all = await dsx.module.data.show.list({ filters: { state: 'live' }, limit: 100 })
      if (!all.ok) { throw { reason: 'unavailable', message: 'catalogue unavailable' } }
      // a coming-soon series has nothing to watch yet: it lives on the New tab's rail only
      const shows = { ok: true, data: all.data.filter(s => s.coming_soon !== true) }
      const hit = (s) => {
        if (term === '') { return true }
        const t = (s.title == null ? '' : s.title).toLowerCase()
        const g = (s.genre == null ? '' : s.genre).toLowerCase()
        const y = (s.synopsis == null ? '' : s.synopsis).toLowerCase()
        return t.includes(term) || g.includes(term) || y.includes(term)
      }
      // count only the rows that are actually returned — one bounded read each, and never
      // a catalogue-wide list, which the 100-row ceiling would truncate without saying so
      const picked = shows.data.filter(hit).slice(0, 24)
      let items = []
      for (const s of picked) {
        const mine = await dsx.module.data.episode.list({ filters: { show: s.id, state: 'live' }, limit: 100 })
        items = items.concat([{
          id: s.id, title: s.title, genre: s.genre, poster: s.poster,
          synopsis: s.synopsis, episodes: mine.ok ? mine.data.length : 0, rank: items.length + 1
        }])
      }
      return { q: term, items: items }
    </action>
  </head>

  <!-- RATE CEILINGS ON A PUBLIC SURFACE, and the one thing that had to be true first.
       An anonymous caller is bucketed by whatever `clientAddress` reports, and when that is
       null EVERY anonymous caller shares ONE bucket per route (host.ts) — so a limit
       declared before the origin supplied an address would have been a GLOBAL limit on the
       storefront, i.e. a self-inflicted outage rather than a defence. scripts/serve.mjs now
       supplies it (x-forwarded-for, then the socket), which is the precondition for these
       numbers meaning anything.
       They are deliberately generous, because these four are the SSR path as well as the
       API path and a household behind one NAT is one address:
         · home / browse / show  240/m — a cold load is 3 requests plus a re-fetch on every
           tab revisit (§6.30: <api cache> dies with the mount). 4/s per address.
         · discover 120/m — 1 + N reads over 50 shows, the second-heaviest public read.
         · search    60/m — the cheapest way to burn the `data:reads` ceiling: `auth="none"`
           and 1 + N bounded reads for up to 24 matches, so ~25 reads per call. 60/m caps one
           address at ~1,500 reads/min against 2.5M/day. This is the route the audit named
           first and the only public one where the limit is a real defence rather than a
           courtesy. -->
  <route method="GET" path="/catalog/home"     action="homeShelves"  auth="none" rate="240/m"/>
  <route method="GET" path="/catalog/discover" action="discoverFeed" auth="none" rate="120/m"/>
  <route method="GET" path="/catalog/show/:id" action="showDetail"   auth="none" rate="240/m"/>
  <route method="GET" path="/catalog/browse/:genre" action="browseCatalog" auth="none" rate="240/m"/>
  <route method="POST" path="/catalog/search"   action="searchShows"  auth="none" rate="60/m"/>
</server>
