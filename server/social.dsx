<!-- social.dsx — the comment thread under an episode. The category's player rail is built
     around it (a count you can see, a sheet you can open, a field you can type in), so it
     is real here: rows in Postgres, RLS-scoped writes, public reads.

     ownership="public-read" — anyone can read a thread, only the author's own row is
     writable through the generated CRUD. The listing action shapes the wire payload so a
     screen never sees a raw row. -->
<server>
  <head>
    <entity as="comment" ownership="public-read">
      <field as="show" type="uuid"/>
      <field as="episode" type="uuid"/>
      <field as="author" type="text"/>
      <field as="body" type="text"/>
      <field as="likes" type="integer"/>
      <index on="episode"/>
    </entity>

    <!-- The viewer's inbox. Notices are broadcast rows (ownership=public-read, declared in
         admin.dsx and written only through the operator surface); this read shapes them
         for the inbox — banner kinds first, newest first, the audience segment carried so
         a client can filter locally when it knows the viewer is VIP. Read-state is the
         CLIENT's memory (a lastSeen timestamp), because a per-viewer read receipt is a
         write amplification this demo does not need. -->
    <action as="listNotices">
      const rows = await dsx.module.data.notice.list({ limit: 100 })
      if (!rows.ok) { return { rows: [] } }
      const shaped = rows.data
        .sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
        .map(n => ({ id: n.id, title: n.title, message: n.message, segment: n.segment, kind: n.kind, at: n.created_at }))
      return { rows: shaped }
    </action>

    <action as="listComments" inputs="episode">
      if (episode == null || episode === '') { throw { reason: 'invalid', message: 'episode is required' } }
      const rows = await dsx.module.data.comment.list({ filters: { episode: episode }, limit: 100 })
      if (!rows.ok) { return { count: 0, rows: [] } }
      const out = []
      for (const c of rows.data) {
        out.push({ id: c.id, author: c.author, body: c.body, likes: c.likes == null ? 0 : c.likes, at: c.created_at })
      }
      return { count: out.length, rows: out }
    </action>

    <action as="countComments" inputs="episode">
      if (episode == null || episode === '') { return { count: 0 } }
      // no count op and a 100-row page ceiling: `capped` is what lets the UI render "99+"
      const rows = await dsx.module.data.comment.list({ filters: { episode: episode }, limit: 100 })
      const n = rows.ok ? rows.data.length : 0
      return { count: n, capped: n >= 100 }
    </action>

    <action as="postComment" inputs="show, episode, body">
      const text = body == null ? '' : String(body).trim()
      if (text === '') { throw { reason: 'invalid', message: 'say something first' } }
      if (text.length > 500) { throw { reason: 'invalid', message: 'comments are capped at 500 characters' } }
      const made = await dsx.module.data.comment.create({
        show: show, episode: episode, author: 'You', body: text, likes: 0
      })
      if (!made.ok) { throw { reason: 'conflict', message: 'could not post that' } }
      return { id: made.data.id, body: text }
    </action>
  </head>

  <!-- RATE CEILINGS.
         · comments 120/m — a public read the player opens per episode; anonymous callers
           share a bucket per address (scripts/serve.mjs supplies clientAddress).
         · notices   60/m — a public read of one small table.
         · comment   10/m — the write. Nobody types ten distinct comments a minute, and this
           is the app's only UGC surface, so the ceiling is the first line of spam defence
           until the moderation set lands (the audit's G15: no filter, no report, no block,
           no delete-own — all four are App Store 1.2 requirements and none of them exist). -->
  <route method="GET"  path="/social/comments/:episode" action="listComments"  auth="none"     rate="120/m"/>
  <route method="GET"  path="/social/notices"            action="listNotices"   auth="none"     rate="60/m"/>
  <route method="POST" path="/social/comment"           action="postComment"   auth="required" rate="10/m"/>
</server>
