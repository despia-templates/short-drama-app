<!-- store.dsx — the SELL lane, for real. Stripe objects are server-created (the module's
     law): the client never sees a secret key, only the publishable key and the one
     client_secret for its own intent. Coins and VIP are granted HERE, after the intent is
     confirmed with Stripe — never on the client's say-so, which is the same trust shape as
     episode unlocking.

     TWO LANES, PICKED BY CAPABILITY, ONE GRANT. The header used to say this backend served
     the same Stripe order to web, iOS and Android — which was true, and was an App Store
     3.1.1 violation in the iOS build (see `settleNative` for the guideline, verbatim, and
     for why the carve-outs do not rescue it). Stripe is now the WEB lane; a native build
     buys through the platform store and settles at `settleNative`. Both lanes end in the
     same three writes — order row, ledger row, wallet fold — keyed on the same exactly-once
     ledger lock, so entitlement still has exactly one writer and a replay on either lane
     grants nothing twice. -->

<server>
  <head>
    <secret as="STRIPE_KEY" env="STRIPE_KEY"/>
    <secret as="STRIPE_PUBLISHABLE" env="STRIPE_PUBLISHABLE"/>
    <!-- THE NATIVE LANE. Stripe is the WEB lane only: App Store 3.1.1 names in-game
         currencies and premium-content unlocks as in-app-purchase products, so coins and
         the VIP pass must go through the platform store inside a native build. This key is
         what lets the backend VERIFY such a purchase (see `settleNative` for why RevenueCat
         is the only provider a declared action can reach), and its absence is what makes
         `storeCatalog.native.ready` false so the app refuses to open a purchase it could
         not honour. Unset in this template on purpose — a placeholder here would read as a
         wired integration. -->
    <secret as="REVENUECAT_KEY" env="REVENUECAT_KEY"/>
    <!-- The INBOUND half. RevenueCat authenticates its webhook by echoing a shared value in
         `Authorization` — no signature over the body — which is why `verify="bearer"` exists
         in the scheme table at all, and why the framework names it for what it is. Rotate by
         listing a second env name on the <webhook> row. -->
    <secret as="REVENUECAT_WEBHOOK_SECRET" env="REVENUECAT_WEBHOOK_SECRET"/>
    <!-- THE SANDBOX SWITCH, for a DEVELOPMENT deployment only. A sandbox purchase is free
         and infinitely repeatable, so by default all three server-to-server paths below
         (settleNative, the webhook drain, restoreNative) skip one — granting it would be a
         coin faucet for every TestFlight tester. Set this to exactly `1` on a dev origin
         and the same three paths grant sandbox transactions, which is what lets a developer
         run a StoreKit-configuration purchase in the simulator on day one and watch the
         coins land. Never on production — docs/monetization.md says so in bold. -->
    <secret as="REVENUECAT_ALLOW_SANDBOX" env="REVENUECAT_ALLOW_SANDBOX"/>
    <egress host="api.stripe.com"/>
    <egress host="api.revenuecat.com"/>

    <entity as="order" ownership="owner">
      <field as="sku" type="text"/>
      <field as="kind" type="text"/>          <!-- vip | coins -->
      <field as="amount_cents" type="integer"/>
      <field as="coins" type="integer"/>      <!-- coins granted (0 for vip) -->
      <field as="bonus" type="integer"/>
      <field as="days" type="integer"/>       <!-- vip days (0 for coins) -->
      <field as="status" type="text"/>        <!-- created | paid | failed -->
      <field as="intent" type="text"/>
      <index on="intent"/>
    </entity>

    <!-- ══ A LIMITED OFFER IS A ROW, NOT A LITERAL ═══════════════════════════════════════
         The category's membership cards wear a countdown ("05:59:59") and a coupon modal
         (docs/design/reference-ui-spec.md §10), and both are SERVER-DRIVEN here: an operator
         writes one of these rows and the price list below carries `offerEndsAt` on the tier it
         names while `ends_at` is in the future, and a top-level `offer` for the coupon. When
         the clock passes, both vanish from the payload with no build and no client change.

         AND IT IS A REAL PRICE, OR IT IS NOTHING. A countdown beside a price that does not
         change is the dark pattern every reviewer knows, so `cents` is the offer PRICE and it
         flows into the SAME table every lane charges from: `createCheckout` reads
         `storeCatalog` for the Stripe amount, `grantStore` for the days — so the web lane
         charges exactly the number the card shows for as long as the badge is up, and an order
         opened at the offer price settles at the offer price after it ends (the row records
         its cents). On a native build Apple or Google charge the STORE product's own price:
         `product_id` lets an operator point the tier at an introductory product created in
         the console for the offer window, and the card shows that product's localized price
         (Membership `planPrice`), so what is displayed is what is charged on that lane too.
         `cents` at 0 means "countdown only": the tier keeps its price and its arithmetic and
         the badge simply says when the list price stops being guaranteed.

         WRITTEN ONLY BY THE OPERATOR (public-read: viewers read, nothing user-scoped writes —
         server/admin.dsx adminUpsertOffer, mirrored by the serve.mjs twin the seed calls).
         One row per sku; a re-seed moves the window forward rather than stacking rows. -->
    <entity as="offer" ownership="public-read">
      <field as="sku" type="text"/>            <!-- the tier it discounts (vip_pass_30) -->
      <field as="ends_at" type="timestamptz"/> <!-- the countdown's zero; past = no offer -->
      <field as="cents" type="integer"/>       <!-- the offer price; 0 = countdown only -->
      <field as="product_id" type="text"/>     <!-- the store product for the window, or empty -->
      <index on="sku"/>
    </entity>

    <!-- ══ THE PRICE TABLE. ONE COPY. THIS ONE. ═══════════════════════════════════════════
         There were three, and they had already drifted: `storeCatalog` served
         `vip_weekly`/`coins_500`, `createCheckout` re-typed the same rows to price the
         charge, and `rewardsState` in server/engage.dsx served a THIRD copy with ids
         (`weekly`/`p500`) that no checkout sku matched and a `best` flag that contradicted
         this one. The production audit filed it as a blocker (H2) for the obvious reason:
         the price a screen DISPLAYS and the price a card is CHARGED were two literals with
         nothing holding them together. The engage.dsx copy is deleted (nothing read it);
         `createCheckout` and `settleNative` now read THIS action through a sibling call.
         An operator still changes price without a build, and the client still cannot invent
         one: every purchase is looked up by sku, never by posted amount.

         ── WHAT A VIP PLAN ACTUALLY IS HERE, NOW SAID IN THE DATA ────────────────────────
         These three rows used to read `note: 'Auto-renew. Cancel anytime.'` on two tiers and
         'then $14.99/week' on the third. All three strings were false, and false in the one
         way a store listing must never be: `createCheckout` opens a ONE-OFF PaymentIntent
         and `settleOrder` stamps `vip_until = (current expiry or now) + days`. There is no
         Stripe Subscription object anywhere in this backend, no renewal job, no cancel path
         — nothing here can charge a second time, so nothing here may promise to. A viewer
         reading "cancel anytime" would go looking for a cancel control that cannot exist,
         and a reviewer reading it would look for the subscription disclosures Apple requires
         beside an auto-renewing price and find a product that does not renew.
         Components/Vip.dsx had already stopped repeating the claim and said so in its own
         copy (a deliberate loud bridge, Article 7) — a screen arguing with its own server is
         not shippable, so the server tells the truth and the bridge comes down.

         The product IS a dated pass, so the LABEL is the product: "7-day pass", not "Weekly
         VIP". The ids moved with it (`vip_pass_7`, not `vip_weekly`) because the sku is also
         the product id an adopter creates in App Store Connect and Play Console for the
         native lane below, and "weekly" on a non-renewing product is a mislabel there too.
         Old `vip_weekly` order rows still settle correctly: `settleOrder` grants from the
         days recorded ON THE ROW, never from the sku.

         AND THE PASS SEMANTICS ARE WHAT KEEP THE NATIVE LANE HONEST. A dated pass is a
         CONSUMABLE, so it has no renewal, no grace period, no billing retry and no
         refund-driven revocation to stay in step with — one purchase, one grant, done. That
         matters because the inbound edge this app declares is a `verify="bearer"` RevenueCat
         receiver: enough to be told a purchase happened, and nothing like enough to run an
         auto-renewing subscription, whose whole lifecycle arrives as App Store Server
         Notifications (`verify="apple"`) and Play RTDN (`verify="play"`) — both refused BY
         NAME by the build today, with the missing work named. Selling a subscription here
         would mean learning about renewals, cancellations and refunds only when the customer
         complains. A pass has no such events to miss.

         BADGES ARE ARITHMETIC OR THEY ARE GONE. "21% OFF" priced $11.99 against the
         "$14.99/week" that never existed, and "POPULAR" measured nothing this app counts.
         "BEST VALUE" survives because it is checkable from the row it sits on: 19999/365 is
         55c a day against 1199/7 = 171c and 2499/30 = 83c. The "% OFF" badge the Membership
         page paints is the same discipline made general: `off` and `refPrice` are DERIVED
         below from the shortest pass's per-day rate, so a badge can only ever say what the
         row's own cents support.

         `productId` IS THE STORE PRODUCT IDENTIFIER — the id an adopter creates in App Store
         Connect and Play Console and attaches to the RevenueCat project (docs/monetization.md).
         It defaults to the sku so a fresh clone works with one id per row; an adopter who
         already has store ids changes THIS field and leaves the sku alone, because the sku is
         also the order row's key and the Stripe lane's lookup. Every native-lane path
         (`settleNative`, the webhook drain, `restoreNative`) reaches the row through
         `grantStore`, which matches either spelling. -->
    <action as="storeCatalog">
      // `native.ready` is the one fact that decides whether the app may open a NATIVE store
      // purchase, and it is a SERVER fact on purpose: the client can see whether the IAP
      // module is in its build, but only the backend knows whether a receipt from it can be
      // verified and granted. False here means the purchase surface refuses BEFORE Apple or
      // Google takes money this deployment could not honour. See `settleNative`.
      const rc = await dsx.module.secret.read({ name: 'REVENUECAT_KEY' })
      const verifier = rc.ok && rc.data != null && rc.data !== ''
      // `renews` is the BILLING SHAPE of the row, and every row here is false: a dated pass is
      // one charge and stops. A deployment that sells a renewing subscription (a StoreKit
      // auto-renewable, a Play subscription, a Stripe Subscription) sets it true on that row and
      // the screens print the category's subscription copy for it — "Subscribe now" on the
      // CTA, "Auto-renewal · Cancel anytime" under it (docs/design/reference-ui-spec.md §10) —
      // instead of the pass sentence. The flag is a fact the granter must honour before a row
      // wears it: `grantStore` adds days once, and renewing is a webhook the adopter wires.
      const vip = [
        { id: 'vip_pass_7',   productId: 'vip_pass_7',   label: '7-day pass',   period: '7 days',   price: '$11.99',  cents: 1199,  days: 7,   note: 'One charge for 7 days. No auto-renewal.',   badge: '',           best: false, renews: false },
        { id: 'vip_pass_30',  productId: 'vip_pass_30',  label: '30-day pass',  period: '30 days',  price: '$24.99',  cents: 2499,  days: 30,  note: 'One charge for 30 days. No auto-renewal.',  badge: '',           best: false, renews: false },
        { id: 'vip_pass_365', productId: 'vip_pass_365', label: '365-day pass', period: '365 days', price: '$199.99', cents: 19999, days: 365, note: 'One charge for 365 days. No auto-renewal.', badge: 'BEST VALUE', best: true,  renews: false }
      ]
      // THE LIVE OFFER, if the operator wrote one (the `offer` entity above). Applied to the
      // tier BEFORE the reference-price arithmetic, so the badge percentage, the struck price
      // and every lane's charge all derive from the price the card actually shows. `list` is
      // bounded and public-read; an expired row is simply not applied, and the newest window
      // wins when two rows name one sku. Fields are read with `== null` guards because a
      // stored null is the NSNull sentinel on the client lanes and this body mirrors the idiom.
      const nowMs = Date.now()
      const offerRows = await dsx.module.data.offer.list({ limit: 100 })
      const liveOffers = {}
      for (const o of (offerRows.ok ? offerRows.data : [])) {
        if (o.sku == null || o.sku === '') { continue }
        if (o.ends_at == null || o.ends_at === '') { continue }
        if (new Date(o.ends_at).getTime() <= nowMs) { continue }
        const cur = liveOffers[o.sku]
        if (cur == null || o.ends_at > cur.ends_at) { liveOffers[o.sku] = o }
      }
      // COLLECTIONS ARE VALUE-TYPED: a loop variable is a copy, so the rows are REBUILT with
      // the offer folded in rather than mutated in place (AGENTS.md, the write-back idiom).
      let coupon = null
      const priced = []
      for (const t of vip) {
        const o = liveOffers[t.id]
        if (o == null) { priced.push({ ...t, offerEndsAt: '', listCents: t.cents, listPrice: t.price }); continue }
        let cents = t.cents
        let shown = t.price
        let pid = t.productId
        if (o.cents != null && o.cents > 0 && o.cents < t.cents) {
          cents = o.cents
          const whole = Math.floor(o.cents / 100)
          const rest = o.cents - whole * 100
          shown = '$' + whole
          shown = shown + '.'
          if (rest < 10) { shown = shown + '0' }
          shown = shown + rest
          if (o.product_id != null && o.product_id !== '') { pid = o.product_id }
          // the coupon modal: the FIRST discounted offer, with the regular price it beats
          if (coupon == null) {
            coupon = { sku: t.id, productId: pid, label: t.label, period: t.period, days: t.days,
                       price: shown, regular: t.price, endsAt: o.ends_at }
          }
        }
        priced.push({ ...t, cents: cents, price: shown, productId: pid, offerEndsAt: o.ends_at, listCents: t.cents, listPrice: t.price })
      }
      // THE REFERENCE PRICE IS ARITHMETIC. The first (shortest) pass sets the per-day rate; a
      // longer pass is compared against what its days would cost at that rate, and `off` is
      // the whole-percent saving, 0 when there is none. The Membership page paints the badge
      // and the struck price from these two fields and never types a percentage itself.
      // The dollar string is grown from a non-numeric anchor on purpose: JSE + is total
      // arithmetic, so a bare zero-pad would collapse to a number (AGENTS.md).
      const perDay = priced[0].cents / priced[0].days
      const tiers = []
      for (const t of priced) {
        const refCents = Math.round(perDay * t.days)
        const off = refCents > t.cents ? Math.round((1 - t.cents / refCents) * 100) : 0
        let refPrice = ''
        if (off > 0) {
          const whole = Math.floor(refCents / 100)
          const rest = refCents - whole * 100
          refPrice = '$' + whole
          refPrice = refPrice + '.'
          if (rest < 10) { refPrice = refPrice + '0' }
          refPrice = refPrice + rest
        }
        tiers.push({ ...t, refCents: refCents, off: off, refPrice: refPrice })
      }
      return {
        vip: tiers,
        // the coupon modal's facts, or null: a surface that shows only when this is a row
        offer: coupon,
        packs: [
          { id: 'coins_500',   productId: 'coins_500',   coins: 500,   free: 25,    cents: 499,  price: '$4.99',  bonus: '+5%' },
          { id: 'coins_1000',  productId: 'coins_1000',  coins: 1000,  free: 100,   cents: 999,  price: '$9.99',  bonus: '+10%' },
          { id: 'coins_2000',  productId: 'coins_2000',  coins: 2000,  free: 400,   cents: 1999, price: '$19.99', bonus: '+20%' },
          { id: 'coins_3000',  productId: 'coins_3000',  coins: 3000,  free: 900,   cents: 2999, price: '$29.99', bonus: '+30%' },
          { id: 'coins_5000',  productId: 'coins_5000',  coins: 5000,  free: 2500,  cents: 4999, price: '$49.99', bonus: '+50%' },
          { id: 'coins_10000', productId: 'coins_10000', coins: 10000, free: 10000, cents: 9999, price: '$99.99', bonus: '+100%' }
        ],
        native: {
          ready: verifier,
          reason: verifier
            ? ''
            : 'Set REVENUECAT_KEY on this deployment: the server verifies every store purchase with RevenueCat before it grants (server/store.dsx settleNative, docs/monetization.md).'
        }
      }
    </action>

    <!-- Open ONE checkout: a Stripe PaymentIntent created here, plus the order row that
         will be granted when it settles. The client gets the publishable key and its own
         client_secret — nothing else. -->
    <!-- OPENING A CHECKOUT IS EXPENSIVE AND WAS UNBOUNDED. Every tap of "buy" created a
         Stripe PaymentIntent, abandoned or not, against a 25,000/day egress ceiling shared
         by every customer of the deployment (`<egress host="api.stripe.com"/>` above) — so
         one authenticated viewer in a loop could take payments down for everyone. Three
         things fix that together, and they are three different mechanisms on purpose:

           1 · `rate="6/h"` on the route (below) — the ceiling on how often ONE caller may
               ask at all.
           2 · REUSE of the caller's own open order for the same sku (here) — the ceiling on
               how many INTENTS a legitimate retry can create. A viewer who taps buy, gets
               distracted, and taps again gets the same intent back, not a second one.
           3 · `Idempotency-Key` on the Stripe POST (here) — the ceiling on what a TRANSPORT
               retry can create. A timeout that was actually delivered returns the original
               intent instead of charging a second time. Stripe keys are honoured for 24h.

         The key is the ORDER ROW ID, which is why the row is now created BEFORE the Stripe
         call rather than after it: an idempotency key has to exist before the request it
         protects. The row is created with an empty `intent` and updated with the real one;
         the partial unique index in policies.local.sql is written `where intent <> ''`
         precisely so those pre-intent rows do not all collide with each other. -->
    <action as="createCheckout" inputs="sku">
      // THE TABLE IS READ, NOT RE-TYPED. This lookup decides what the customer is charged,
      // and the old comment here argued that made it too important to depend on a
      // cross-action hop — which had it exactly backwards: a second literal copy of the
      // prices is not safety, it is the drift the audit found (H2). A sibling action
      // resolves the MODULE ENVELOPE, so this reads `.data` like any other module call
      // (AGENTS.md; an older note claiming siblings return void is false). It costs ONE of
      // the 64 calls a request gets, in an action that already spends about six.
      // NOTE the local is `picked`, never `item`: `item` is the reserved ROW-SCOPE name,
      // and a local `let item` in an action is silently shadowed — reads return the whole
      // scope object, so `item == null` is false for a null (upstream #242).
      const cat = await dsx.action.storeCatalog()
      if (!cat.ok || cat.data == null) { throw { reason: 'unavailable', message: 'the price list is unavailable' } }
      let picked = null
      for (const v of cat.data.vip) {
        if (v.id === sku || v.productId === sku) { picked = { kind: 'vip', cents: v.cents, coins: 0, bonus: 0, days: v.days, label: v.label } }
      }
      for (const p of cat.data.packs) {
        if (p.id === sku || p.productId === sku) { picked = { kind: 'coins', cents: p.cents, coins: p.coins, bonus: p.free, days: 0, label: p.coins + ' coins' } }
      }
      if (picked == null) { throw { reason: 'invalid', message: 'unknown item' } }

      const key = await dsx.module.secret.read({ name: 'STRIPE_KEY' })
      const pub = await dsx.module.secret.read({ name: 'STRIPE_PUBLISHABLE' })
      if (!key.ok || key.data == null || key.data === '') {
        throw { reason: 'unavailable', message: 'Payments are not configured on this deployment — set STRIPE_KEY and STRIPE_PUBLISHABLE.' }
      }
      const publishable = pub.ok && pub.data != null ? pub.data : ''

      // 2 · REUSE. An order this viewer opened for this sku in the last 15 minutes and never
      // settled is the SAME purchase attempt; hand back its intent instead of minting
      // another. `list` is owner-scoped by RLS, so this can only ever see the caller's own
      // rows, and it is bounded at the platform's 100 (PLAN.md §6.20) — which is far more
      // open orders than any real buyer accumulates.
      const OPEN_MS = 15 * 60000
      const mineOpen = await dsx.module.data.order.list({ filters: { sku: sku, status: 'created' }, limit: 100 })
      let reuse = null
      for (const row of (mineOpen.ok ? mineOpen.data : [])) {
        if (row.intent == null || row.intent === '') { continue }
        // STRIPE ROWS ONLY. `intent` is a provider-qualified id now that a native store
        // purchase also lands in this table (settleNative writes `revenuecat:<txn>`), and
        // handing one of those to api.stripe.com would be a guaranteed 404 on the money
        // path. Stripe PaymentIntent ids are `pi_` by construction.
        if (!row.intent.startsWith('pi_')) { continue }
        if (row.amount_cents !== picked.cents) { continue }   // the price changed under them — open a fresh one
        if (Date.now() - new Date(row.created_at).getTime() > OPEN_MS) { continue }
        if (reuse == null || row.created_at > reuse.created_at) { reuse = row }
      }
      if (reuse != null) {
        const back = await fetch('https://api.stripe.com/v1/payment_intents/' + reuse.intent, {
          method: 'GET', headers: { authorization: 'Bearer ' + key.data }
        })
        // Only reuse an intent Stripe still considers open. A cancelled or already-succeeded
        // one falls through and a fresh checkout is opened, which is the honest answer — the
        // alternative is handing the client a client_secret that its payment sheet refuses.
        if (back.ok && back.data != null && back.data.client_secret != null
            && back.data.status !== 'canceled' && back.data.status !== 'succeeded') {
          return {
            order: reuse.id, label: picked.label, amount_cents: reuse.amount_cents,
            publishable_key: publishable, client_secret: back.data.client_secret, reused: true
          }
        }
      }

      // The ORDER ROW FIRST, so there is something to key the idempotent charge on. `intent`
      // is deliberately omitted rather than passed as null (house rule: never `field: null`
      // in create values) and lands as the column default.
      const row = await dsx.module.data.order.create({
        sku: sku, kind: picked.kind, amount_cents: picked.cents,
        coins: picked.coins, bonus: picked.bonus, days: picked.days,
        status: 'created'
      })
      if (!row.ok) { throw { reason: 'conflict', message: 'could not open the order' } }

      const body = 'amount=' + picked.cents + '&currency=usd&automatic_payment_methods[enabled]=true'
        + '&metadata[sku]=' + sku + '&metadata[order]=' + row.data.id
      const res = await fetch('https://api.stripe.com/v1/payment_intents', {
        method: 'POST',
        headers: {
          authorization: 'Bearer ' + key.data,
          'content-type': 'application/x-www-form-urlencoded',
          // 3 · the transport guard. Same key ⇒ same intent, for 24h, even if this request
          // is delivered twice because the first response was lost.
          'idempotency-key': 'dsx-order-' + row.data.id
        },
        body: body
      })
      if (!res.ok || res.data == null || res.data.client_secret == null) {
        // the order row is left `created` with no intent: settleOrder refuses it, restore
        // skips it, and reuse ignores it (the `intent === ''` guard above). It is a
        // recorded failed attempt, not a dangling charge.
        throw { reason: 'upstream', message: 'the payment provider refused the checkout' }
      }

      const stamped = await dsx.module.data.order.update({ id: row.data.id, values: { intent: res.data.id } })
      if (!stamped.ok) {
        // The charge exists at Stripe and we cannot record which one it is. Refuse loudly
        // rather than return a client_secret we could never settle — the idempotency key
        // means the viewer's retry lands on the SAME intent, so no second charge is created.
        throw { reason: 'unavailable', message: 'the order could not be recorded — please try again' }
      }

      return {
        order: row.data.id,
        label: picked.label,
        amount_cents: picked.cents,
        publishable_key: publishable,
        client_secret: res.data.client_secret
      }
    </action>

    <!-- SETTLE: ask STRIPE what happened, never the client. Three things this used to get
         wrong, all of them ways to grant twice or grant wrongly:

         (a) THE REPLAY. `status === 'paid'` was a read-then-write with nothing behind it —
             two settles that arrived together both read 'created' and both granted. There is
             no transaction seam in a declared action (PLAN.md §6.38) and no compare-and-swap
             in `data.update`, so the lock has to be a UNIQUE INSERT, and the right row to
             insert is the one this grant already had to write: the LEDGER row. It carries
             `ref = <order id>` (it used to carry the sku, which repeats across purchases),
             and policies.local.sql puts a partial unique index on
             (owner_id, kind, source, ref) for source in ('pack','vip'). So the ledger — the
             thing this document already claims is the single source of truth for money — is
             now literally the exactly-once record it claimed to be. Write it FIRST; if it
             refuses, someone already granted this order.
             The residual, named: ledger written, wallet update failed ⇒ the fold under-
             reports and the ledger over-reports. That direction is recoverable by replaying
             the fold; the other direction is money created from nothing.

         (b) THE AMOUNT. Nothing checked that the intent Stripe confirmed was for the amount
             this order recorded. An intent can be modified after creation, and the grant is
             sized from the ORDER row — so without this check a 499-cent confirmation could
             be presented against a 9,999-cent order. Currency is checked with it: `usd` is
             hardcoded in createCheckout (the audit's H3), and a mismatch here means the two
             have drifted.

         (c) THE OTHER VIEWER'S ORDER. `order.get` is owner-scoped by RLS, so this was never
             actually reachable — but the check below is written anyway, because "RLS makes
             it impossible" is exactly the sentence that stops being true when someone moves
             an entity to public-read. -->
    <action as="settleOrder" inputs="order">
      if (order == null || order === '') { throw { reason: 'invalid', message: 'order is required' } }
      const row = await dsx.module.data.order.get({ id: order })
      if (!row.ok || row.data == null) { throw { reason: 'not_found', message: 'no such order' } }
      if (row.data.status === 'paid') { return { granted: false, already: true } }
      if (row.data.intent == null || row.data.intent === '') {
        throw { reason: 'conflict', message: 'this checkout never reached the payment provider' }
      }

      const key = await dsx.module.secret.read({ name: 'STRIPE_KEY' })
      if (!key.ok) { throw { reason: 'unavailable', message: 'payments are not configured' } }
      const res = await fetch('https://api.stripe.com/v1/payment_intents/' + row.data.intent, {
        method: 'GET',
        headers: { authorization: 'Bearer ' + key.data }
      })
      if (!res.ok || res.data == null) { throw { reason: 'upstream', message: 'could not verify the payment' } }
      if (res.data.status !== 'succeeded') {
        await dsx.module.data.order.update({ id: order, values: { status: 'failed' } })
        throw { reason: 'conflict', message: 'the payment did not complete' }
      }
      // (b) — what was CONFIRMED must be what was ORDERED, or nothing is granted
      if (res.data.amount !== row.data.amount_cents || res.data.currency !== 'usd') {
        await dsx.module.data.order.update({ id: order, values: { status: 'failed' } })
        throw { reason: 'conflict', message: 'the confirmed payment does not match this order' }
      }

      // the grant, inlined for the same reason as the price table (#242)
      const mine = await dsx.module.data.wallet.list({ limit: 1 })
      let w = mine.ok && mine.data.length > 0 ? mine.data[0] : null
      if (w == null) {
        const made = await dsx.module.data.wallet.create({ coins: 0, bonus: 0 })
        if (made.ok) { w = made.data } else {
          const again = await dsx.module.data.wallet.list({ limit: 1 })
          w = again.ok && again.data.length > 0 ? again.data[0] : null
        }
      }
      if (w == null) { throw { reason: 'conflict', message: 'no wallet' } }
      const o = row.data
      if (o.kind === 'coins') {
        // (a) — THE LOCK. `kind` is part of the unique key, which is why the two rows of a
        // pack (purchased coins + the pack's free bonus) do not collide with each other.
        const lc = await dsx.module.data.ledger.create({ kind: 'coin', amount: o.coins, source: 'pack', ref: o.id })
        if (!lc.ok) { return { granted: false, already: true } }
        await dsx.module.data.order.update({ id: order, values: { status: 'paid' } })
        if (o.bonus > 0) {
          await dsx.module.data.ledger.create({ kind: 'bonus', amount: o.bonus, source: 'pack', ref: o.id })
        }
        const paid = await dsx.module.data.wallet.update({ id: w.id, values: { coins: w.coins + o.coins, bonus: w.bonus + o.bonus } })
        if (!paid.ok) { throw { reason: 'unavailable', message: 'the balance could not be updated — contact support with this order id' } }
        return { granted: true, coins: o.coins, bonus: o.bonus }
      }
      const lv = await dsx.module.data.ledger.create({ kind: 'coin', amount: 0, source: 'vip', ref: o.id })
      if (!lv.ok) { return { granted: false, already: true } }
      await dsx.module.data.order.update({ id: order, values: { status: 'paid' } })
      // VIP EXTENDS, it never truncates: a member who buys a second pass mid-term must not
      // lose the days they already hold. (Stamping `now + days` did exactly that.)
      const from = w.vip_until != null && new Date(w.vip_until).getTime() > Date.now()
        ? new Date(w.vip_until).getTime()
        : Date.now()
      const until = new Date(from + o.days * 86400000).toISOString()
      const paid = await dsx.module.data.wallet.update({ id: w.id, values: { vip_until: until } })
      if (!paid.ok) { throw { reason: 'unavailable', message: 'the membership could not be updated — contact support with this order id' } }
      return { granted: true, vipUntil: until, days: o.days }
    </action>

    <!-- ══ SETTLE A NATIVE STORE PURCHASE ══════════════════════════════════════════════════
         App Store Review 3.1.1, verbatim: "If you want to unlock features or functionality
         within your app, (by way of example: subscriptions, in-game currencies, game levels,
         access to premium content, or unlocking a full version), you must use in-app
         purchase." Coins and the VIP pass are BOTH named by that parenthetical. Selling them
         through Stripe inside an iOS build is a rejection, and reader-app status does not
         rescue it: a reader app may not offer IAP at all and may only give access to content
         bought elsewhere — it may not run a storefront. The US anti-steering carve-out is
         real and does not rescue it either: it permits a LINK OUT to your own website; it
         does not permit a non-Apple payment sheet inside the app. Google Play Payments says
         the same thing for the same products.

         So the purchase LANE is picked by capability (Components/Store.dsx and
         Components/parts/PlansSheet.dsx, the AdGate pattern): `has(store)` on a native build
         takes the store module, the web takes Stripe. This action is the SERVER half of that
         lane, and it exists because the client half must never be the authority — the same
         law the Stripe lane obeys three actions up. A grant here is sized from the price
         table, keyed on the provider transaction, and locked by the same ledger row.

         ── WHAT CAN AND CANNOT BE VERIFIED FROM A DECLARED ACTION, MEASURED ────────────────
         A declared action has `fetch`, `<secret>` and a declared `<egress>` host list. That
         is enough for a bearer-token REST call and nothing else, which decides the provider:

           Apple App Store Server API — NOT REACHABLE. Auth is an ES256-signed JWT built from
             a .p8 private key, and verifying a StoreKit JWS transaction directly means
             checking an x5c chain against Apple root CAs. There is no signing primitive in
             the server action plane.
           Google Play Developer API — NOT REACHABLE, same reason: an OAuth2 access token
             minted from an RS256 service-account assertion.
           RevenueCat REST v1 — REACHABLE. `Authorization: Bearer <secret key>`, one GET.
             RevenueCat has already validated the receipt with Apple or Google before it
             answers, which is exactly why the store module reports `receipt: null` on the
             revenuecat provider, and why `store.checkout` defaults to it.

         Hence REVENUECAT_KEY, and hence `storeCatalog.native.ready`: with no key this
         deployment REFUSES TO OPEN a native purchase at all rather than taking money at
         Apple that it could not then grant. That refusal is the honest failure; granting on
         the client word is not, and neither is a lane that silently keeps selling through
         Stripe on a phone.

         ── THIS CODE FAILS CLOSED, AND HAS NOT BEEN RUN AGAINST A LIVE ACCOUNT ─────────────
         Named rather than implied (Article 7): the RevenueCat read below was written from
         the documented v1 subscriber shape and has not been exercised against a real
         sandbox purchase in this template, because there is no RevenueCat project behind it.
         Every branch refuses on anything it does not positively recognise, so a wrong field
         guess REFUSES A LEGITIMATE PURCHASE — recoverable, and visible immediately — rather
         than granting an illegitimate one. An adopter must put one sandbox purchase through
         this action before shipping, and PLAN.md 6.87 records the ask.

         ── THE PRICE ON A NATIVE LANE IS THE STORE PRICE ───────────────────────────────────
         `amount_cents` on the row is the table price, and it is the ENTITLEMENT record, not
         the receipt: on this lane Apple and Google charge their own localized tier and the
         money lives in their console. The grant is sized from `coins`/`days` for exactly the
         reason the Stripe lane is — the client never sends an amount. -->
    <action as="settleNative" inputs="sku, transaction, provider">
      if (sku == null || sku === '') { throw { reason: 'invalid', message: 'sku is required' } }
      if (transaction == null || transaction === '') { throw { reason: 'invalid', message: 'a store transaction id is required' } }

      const rc = await dsx.module.secret.read({ name: 'REVENUECAT_KEY' })
      if (!rc.ok || rc.data == null || rc.data === '') {
        throw { reason: 'unavailable', message: 'This deployment cannot verify a store receipt, so it will not grant one. Set REVENUECAT_KEY (see server/store.dsx settleNative).' }
      }

      // THE CALLER, TAKEN FROM A ROW RATHER THAN FROM THE REQUEST. There is no "who am I"
      // call in the server action plane — identity is implicit, applied by RLS when a query
      // runs — so the caller id is read off a row the caller owns: `owner_id` on their own
      // wallet, stamped by the database from the verified subject and unreachable from the
      // wire. It matters more here than anywhere else in this file, because it is also the
      // RevenueCat app_user_id: it is the thing that stops viewer A redeeming a transaction
      // belonging to viewer B. Taking it from the request body would make every other
      // account a redeemable receipt.
      // NOTE what this does NOT require: a signed-in human. It requires a SUBJECT. An
      // anonymous session satisfies it exactly as a signed-in one does, which is the whole
      // point of buying without a login.
      const mine = await dsx.module.data.wallet.list({ limit: 1 })
      let w = mine.ok && mine.data.length > 0 ? mine.data[0] : null
      if (w == null) {
        const made = await dsx.module.data.wallet.create({ coins: 0, bonus: 0 })
        if (made.ok) { w = made.data } else {
          const again = await dsx.module.data.wallet.list({ limit: 1 })
          w = again.ok && again.data.length > 0 ? again.data[0] : null
        }
      }
      if (w == null) { throw { reason: 'conflict', message: 'no wallet' } }
      const uid = w.owner_id
      if (uid == null || uid === '') {
        throw { reason: 'unavailable', message: 'this purchase cannot be attributed to an account, so it will not be granted' }
      }

      const seen = await fetch('https://api.revenuecat.com/v1/subscribers/' + encodeURIComponent(uid), {
        method: 'GET',
        headers: { authorization: 'Bearer ' + rc.data, accept: 'application/json' }
      })
      if (!seen.ok || seen.data == null || seen.data.subscriber == null) {
        throw { reason: 'upstream', message: 'could not verify the purchase with the store' }
      }
      // A dated pass and a coin pack are both CONSUMABLES (see the price table header), so
      // both land in `non_subscriptions`, keyed by product id — an array of every purchase of
      // that product on this account. The reported transaction must be one of them. Both id
      // spellings are read: RevenueCat carries its OWN id as `id` and the store transaction
      // as `store_transaction_id`, and which of the two the module reported depends on
      // whether it was talking to RevenueCat or to StoreKit directly.
      const bought = seen.data.subscriber.non_subscriptions
      const runs = bought == null || bought[sku] == null ? [] : bought[sku]
      let store_txn = ''
      // SANDBOX DOES NOT PAY, and this guard was on the WEBHOOK path only — which made the
      // two server-to-server paths disagree about the same purchase. A sandbox purchase is
      // free and infinitely repeatable, so a pull path that grants on one is a coin faucet
      // for anyone who can run a sandbox transaction, which on iOS is every TestFlight
      // tester. `storeEvent` has skipped these since it was written (`ev.environment`);
      // the REST document carries the same fact per run as `is_sandbox`. The ONE exception
      // is the development switch declared in the head: REVENUECAT_ALLOW_SANDBOX=1 lets a
      // dev origin grant a sandbox transaction so a simulator purchase can be watched landing.
      const sb = await dsx.module.secret.read({ name: 'REVENUECAT_ALLOW_SANDBOX' })
      const allowSandbox = sb.ok && sb.data === '1'
      let sandboxOnly = false
      for (const one of runs) {
        if (one.id === transaction || one.store_transaction_id === transaction) {
          const sandboxRefused = one.is_sandbox === true && !allowSandbox
          if (sandboxRefused) { sandboxOnly = true }
          // THE KEY IS THE STORE TRANSACTION, on both paths. The webhook reports
          // `event.transaction_id` and this REST document reports `store_transaction_id`,
          // and they are the same identifier — which is what makes the two grant paths
          // collapse onto ONE ledger row instead of crediting twice. Preferring it here,
          // rather than the id the client happened to report, is what keeps that true.
          if (!sandboxRefused) {
            store_txn = one.store_transaction_id == null || one.store_transaction_id === ''
              ? transaction
              : one.store_transaction_id
          }
        }
      }
      // NAMED, not swallowed: a tester whose sandbox purchase is refused must be told WHY,
      // or they file a bug against the grant path that is working correctly.
      if (store_txn === '' && sandboxOnly) {
        throw { reason: 'conflict', message: 'This is a sandbox purchase. Sandbox purchases are free and repeatable, so this deployment does not grant them. A development origin may set REVENUECAT_ALLOW_SANDBOX=1 (docs/monetization.md).' }
      }
      if (store_txn === '') {
        throw { reason: 'conflict', message: 'the store has no record of this purchase on your account' }
      }

      const done = await dsx.action.grantStore({
        owner: uid, sku: sku, transaction: store_txn,
        provider: provider == null || provider === '' ? 'revenuecat' : provider
      })
      if (!done.ok || done.data == null) { throw { reason: 'unavailable', message: 'the purchase could not be applied — it will land when the store callback arrives' } }
      return done.data
    </action>

    <!-- ══ THE INBOUND EDGE: RevenueCat tells us, we do not ask ═══════════════════════════
         The house rule for money, and it is not negotiable: no coin grant originates from a
         client. Every credit comes from a server-to-server exchange this backend verified.
         There are exactly two of those on this lane and they are BOTH server-to-server —
         the callback below (RevenueCat pushes), and `settleNative` above (we pull the same
         fact from RevenueCat over the same trust boundary, so the customer is not left
         staring at a spinner while a webhook queues). Neither one takes the client word for
         anything except WHICH purchase to go and check.

         `<webhook>` is a generated receiver, not a route an author writes: the row fixes
         POST, the raw body, no `auth` (a sender holds no account, so the credential IS the
         header — `auth="required"` would 401 every delivery while the endpoint looked
         healthy) and a rate ceiling, because every hand-written version of those gets one of
         them wrong silently. It enqueues; the worker drains; the drain is where the work is,
         so a sender timeout can never decide whether the grant was written.

         `verify="bearer"` is named for what it is: RevenueCat echoes a shared secret in
         `Authorization` and nothing binds it to the body, so the body rests on TLS alone.
         It is in the scheme table precisely because some senders offer nothing better and an
         author who cannot declare it hand-rolls a public POST that is worse. `apple` and
         `play` are refused BY NAME by the build (an x5c chain to Apple root CA; an OIDC
         bearer against Google rotating JWKS) — which is the second reason RevenueCat is the
         bridge rather than a convenience: it is the only one of the three whose callback
         this backend can actually authenticate today.

         `idField="event.id"` is required by the build for a scheme with no signed uniqueness:
         without the sender own event id, two distinct events with identical bytes would
         collapse into one queue row. -->
    <action as="storeEvent" inputs="body">
      // ONE MESSAGE, ONE EVENT. The envelope the receiver enqueues is
      // { received_at, signed_at?, source, scheme, body } and `body` is RevenueCat payload:
      // { api_version, event: { id, type, app_user_id, product_id, transaction_id, store,
      //   environment, ... } }.
      if (body == null || body.event == null) { return { skipped: 'no event' } }
      const ev = body.event
      const kind = ev.type == null ? '' : ev.type

      // ONLY the event that means "a one-off product was bought". Everything this app sells
      // is a consumable — a coin pack, or a dated pass (see the price table header) — so
      // NON_RENEWING_PURCHASE is the whole vocabulary. TEST, TRANSFER, CANCELLATION,
      // BILLING_ISSUE and the subscription family are ACKED and skipped rather than guessed
      // at: a grant path that accepts an event type it does not sell is a grant path nobody
      // can reason about. Returning acks the message; throwing would retry it forever.
      if (kind !== 'NON_RENEWING_PURCHASE') { return { skipped: kind } }

      // SANDBOX DOES NOT PAY. A sandbox purchase is free and infinitely repeatable, so
      // granting on one is a hole with a queue in front of it. It is skipped rather than
      // failed, so an adopter testing in sandbox sees `skipped: sandbox` in the drain —
      // unless the deployment is a development origin that set REVENUECAT_ALLOW_SANDBOX=1,
      // the one declared way to let a simulator purchase land (head, docs/monetization.md).
      if (ev.environment != null && ev.environment !== 'PRODUCTION') {
        const sb = await dsx.module.secret.read({ name: 'REVENUECAT_ALLOW_SANDBOX' })
        if (!(sb.ok && sb.data === '1')) { return { skipped: 'sandbox' } }
      }

      const owner = ev.app_user_id
      const sku = ev.product_id
      const txn = ev.transaction_id
      if (owner == null || owner === '' || sku == null || sku === '' || txn == null || txn === '') {
        // A malformed delivery is not retryable — the same bytes will arrive the same way —
        // so it is acked with a reason rather than dead-lettered after N attempts.
        return { skipped: 'incomplete' }
      }
      const done = await dsx.action.grantStore({ owner: owner, sku: sku, transaction: txn, provider: 'revenuecat' })
      if (!done.ok) {
        // THROW = RETRY. This is the one branch that must not swallow: a wallet write that
        // failed on a database blip is money the customer paid for, and the queue is the
        // thing that will bring it back.
        throw { reason: 'unavailable', message: 'the grant did not land' }
      }
      return done.data
    </action>

    <!-- ══ THE ONLY GRANTER ON THE NATIVE LANE ════════════════════════════════════════════
         Both server-to-server paths above end here, and that is the point: one derivation of
         the price, one derivation of the idempotency key, one order row, one ledger lock, one
         wallet fold. Two granters with two copies of this logic is how a webhook and a pull
         end up crediting the same purchase twice.

         `owner` IS A TRUSTED ARGUMENT and only these two callers may supply it: `settleNative`
         reads it off the caller own wallet row (RLS-stamped, unreachable from the wire) and
         `storeEvent` reads it from a delivery the receiver already authenticated. It is NEVER
         a route input — there is deliberately no `<route>` pointing at this action.

         WHY IT RUNS UNDER TWO DIFFERENT SCOPES AND WRITES `owner_id` EXPLICITLY. A queue drain
         dispatches internally, with the connection role untouched and no `auth.uid()` to
         default from, so a row created without an owner would belong to nobody. Naming it is
         also correct on the viewer path, where it equals the verified subject and satisfies
         the RLS check rather than bypassing it. -->
    <action as="grantStore" inputs="owner, sku, transaction, provider">
      if (owner == null || owner === '') { throw { reason: 'invalid', message: 'owner is required' } }
      if (transaction == null || transaction === '') { throw { reason: 'invalid', message: 'transaction is required' } }

      // the SAME table the storefront displays and the Stripe lane charges (H2)
      const cat = await dsx.action.storeCatalog()
      if (!cat.ok || cat.data == null) { throw { reason: 'unavailable', message: 'the price list is unavailable' } }
      // `sku` here is whatever the STORE called the product — RevenueCat reports the store
      // product identifier — so the row is matched on `productId` first and on the
      // catalogue id second, and the order row is written under the CATALOGUE id so support
      // reads one spelling whichever lane sold it.
      let picked = null
      for (const v of cat.data.vip) {
        if (v.id === sku || v.productId === sku) { picked = { id: v.id, kind: 'vip', cents: v.cents, coins: 0, bonus: 0, days: v.days } }
      }
      for (const p of cat.data.packs) {
        if (p.id === sku || p.productId === sku) { picked = { id: p.id, kind: 'coins', cents: p.cents, coins: p.coins, bonus: p.free, days: 0 } }
      }
      // A product the price table does not sell is not granted. On the webhook path this is
      // also the guard against a product id created in App Store Connect that nobody added
      // here — it fails loudly in the drain rather than crediting a guess.
      if (picked == null) { throw { reason: 'invalid', message: 'unknown item' } }

      const tag = (provider == null || provider === '' ? 'store' : provider) + ':' + transaction
      const mine = await dsx.module.data.wallet.list({ filters: { owner_id: owner }, limit: 1 })
      let w = mine.ok && mine.data.length > 0 ? mine.data[0] : null
      if (w == null) {
        const made = await dsx.module.data.wallet.create({ owner_id: owner, coins: 0, bonus: 0 })
        if (made.ok) { w = made.data } else {
          const again = await dsx.module.data.wallet.list({ filters: { owner_id: owner }, limit: 1 })
          w = again.ok && again.data.length > 0 ? again.data[0] : null
        }
      }
      if (w == null) { throw { reason: 'unavailable', message: 'no wallet for this purchase' } }

      // THE ORDER ROW IS THE ENTITLEMENT RECORD, NOT THE RECEIPT. On this lane Apple or
      // Google charged their own localized tier and the money lives in their console;
      // `amount_cents` is the list price from our table so support can read what was sold.
      // `intent` carries the provider-qualified transaction, which is also the FIRST of the
      // two locks: `unique (intent) where intent <> ''` in policies.local.sql.
      const row = await dsx.module.data.order.create({
        owner_id: owner, sku: picked.id, kind: picked.kind, amount_cents: picked.cents,
        coins: picked.coins, bonus: picked.bonus, days: picked.days,
        status: 'created', intent: tag
      })
      if (!row.ok) { return { granted: false, already: true } }

      if (picked.kind === 'coins') {
        // THE SECOND LOCK, and the authoritative one: the ledger row keyed
        // (owner_id, kind, source, ref) with ref = the store transaction. Written BEFORE the
        // wallet, refused by the database on a replay — the same idiom the Stripe lane uses,
        // because a declared action has no transaction seam and no compare-and-swap.
        const lc = await dsx.module.data.ledger.create({ owner_id: owner, kind: 'coin', amount: picked.coins, source: 'pack', ref: tag })
        if (!lc.ok) { return { granted: false, already: true } }
        await dsx.module.data.order.update({ id: row.data.id, values: { status: 'paid' } })
        if (picked.bonus > 0) {
          await dsx.module.data.ledger.create({ owner_id: owner, kind: 'bonus', amount: picked.bonus, source: 'pack', ref: tag })
        }
        const paid = await dsx.module.data.wallet.update({ id: w.id, values: { coins: w.coins + picked.coins, bonus: w.bonus + picked.bonus } })
        if (!paid.ok) { throw { reason: 'unavailable', message: 'the balance could not be updated — contact support with this order id' } }
        return { granted: true, coins: picked.coins, bonus: picked.bonus, order: row.data.id }
      }

      const lv = await dsx.module.data.ledger.create({ owner_id: owner, kind: 'coin', amount: 0, source: 'vip', ref: tag })
      if (!lv.ok) { return { granted: false, already: true } }
      await dsx.module.data.order.update({ id: row.data.id, values: { status: 'paid' } })
      // EXTENDS, never truncates — the same rule as settleOrder
      const from = w.vip_until != null && new Date(w.vip_until).getTime() > Date.now()
        ? new Date(w.vip_until).getTime()
        : Date.now()
      const until = new Date(from + picked.days * 86400000).toISOString()
      const paid = await dsx.module.data.wallet.update({ id: w.id, values: { vip_until: until } })
      if (!paid.ok) { throw { reason: 'unavailable', message: 'the membership could not be updated — contact support with this order id' } }
      return { granted: true, vipUntil: until, days: picked.days, order: row.data.id }
    </action>

    <!-- RESTORE. App Store 3.1.1: "you should make sure you have a restore mechanism for any
         restorable in-app purchases." Most of it is already true by construction — VIP and
         every unlock are SERVER-side, account-scoped rows, so a reinstall that signs back in
         has its entitlements without asking. The gap this closes is the other one: an order
         the provider CHARGED and this backend never granted, because the app was closed or
         offline between the payment sheet's success and the settle call. That money is taken
         and invisible, and the viewer has no way to ask for it.
         This walks the caller's own unsettled orders, asks Stripe about each, and settles the
         ones that succeeded. It is exactly-once for the same reason settleOrder is: the same
         ledger unique index refuses a second grant.
         NOT THIS LANE: a NATIVE store purchase never creates a `pi_` order, so this sweep
         skips it by construction. Its twin is `restoreNative` immediately below. -->

    <action as="restoreOrders">
      const open = await dsx.module.data.order.list({ filters: { status: 'created' }, limit: 100 })
      const rows = open.ok ? open.data : []
      // EVERY RETURN CARRIES THE WHOLE SHAPE. Two of these used to be short — no `vipDays`,
      // no `done` — and a caller adding the two lanes together read `undefined` off one of
      // them. JSE `+` is TOTAL ARITHMETIC, so that does not throw; it quietly answers the
      // wrong number about somebody money. Caught by the resumability assertion in verify.
      if (rows.length === 0) { return { checked: 0, restored: 0, coins: 0, bonus: 0, vipDays: 0, orders: [], done: true, remaining: 0 } }
      const key = await dsx.module.secret.read({ name: 'STRIPE_KEY' })
      if (!key.ok) { throw { reason: 'unavailable', message: 'payments are not configured' } }

      const mine = await dsx.module.data.wallet.list({ limit: 1 })
      let w = mine.ok && mine.data.length > 0 ? mine.data[0] : null
      if (w == null) {
        const made = await dsx.module.data.wallet.create({ coins: 0, bonus: 0 })
        if (made.ok) { w = made.data } else {
          const again = await dsx.module.data.wallet.list({ limit: 1 })
          w = again.ok && again.data.length > 0 ? again.data[0] : null
        }
      }
      if (w == null) { throw { reason: 'unavailable', message: 'wallet unavailable' } }

      let coins = 0
      let bonus = 0
      let vipDays = 0
      let restored = 0
      let checked = 0
      const done = []
      // Bounded by the ACTION CALL CAP (actions.ts ACTION_CALL_CAP = 64) as much as by the
      // list: a viewer with dozens of abandoned checkouts gets the oldest ones on the next
      // call rather than a deadline error on this one.
      for (const o of rows.slice(0, 20)) {
        if (o.intent == null || o.intent === '') { continue }
        // Stripe rows only — the same guard as the reuse loop in createCheckout. A native
        // store order carries `revenuecat:<txn>` here, and its restore lane is the store
        // module (see settleNative), not a PaymentIntent read.
        if (!o.intent.startsWith('pi_')) { continue }
        checked = checked + 1
        const res = await fetch('https://api.stripe.com/v1/payment_intents/' + o.intent, {
          method: 'GET', headers: { authorization: 'Bearer ' + key.data }
        })
        if (!res.ok || res.data == null) { continue }
        if (res.data.status !== 'succeeded') { continue }
        if (res.data.amount !== o.amount_cents || res.data.currency !== 'usd') { continue }
        if (o.kind === 'coins') {
          const lc = await dsx.module.data.ledger.create({ kind: 'coin', amount: o.coins, source: 'pack', ref: o.id })
          if (!lc.ok) { continue }                       // already granted — the ledger said so
          await dsx.module.data.order.update({ id: o.id, values: { status: 'paid' } })
          if (o.bonus > 0) {
            await dsx.module.data.ledger.create({ kind: 'bonus', amount: o.bonus, source: 'pack', ref: o.id })
          }
          coins = coins + o.coins
          bonus = bonus + o.bonus
        } else {
          const lv = await dsx.module.data.ledger.create({ kind: 'coin', amount: 0, source: 'vip', ref: o.id })
          if (!lv.ok) { continue }
          await dsx.module.data.order.update({ id: o.id, values: { status: 'paid' } })
          vipDays = vipDays + o.days
        }
        restored = restored + 1
        done.push({ order: o.id, sku: o.sku, kind: o.kind })
      }
      if (restored === 0) { return { checked: checked, restored: 0, coins: 0, bonus: 0, vipDays: 0, orders: [], done: rows.length <= 20, remaining: rows.length > 20 ? rows.length - 20 : 0 } }
      let vipUntil = w.vip_until
      if (vipDays > 0) {
        const from = w.vip_until != null && new Date(w.vip_until).getTime() > Date.now()
          ? new Date(w.vip_until).getTime()
          : Date.now()
        vipUntil = new Date(from + vipDays * 86400000).toISOString()
      }
      // ONE fold write for the whole restore: the ledger rows above are the record, and the
      // wallet is the cache being brought back into agreement with them.
      const values = { coins: w.coins + coins, bonus: w.bonus + bonus }
      if (vipDays > 0) { values.vip_until = vipUntil }
      const paid = await dsx.module.data.wallet.update({ id: w.id, values: values })
      if (!paid.ok) { throw { reason: 'unavailable', message: 'the balance could not be updated — contact support' } }
      return { checked: checked, restored: restored, coins: coins, bonus: bonus, vipDays: vipDays, vipUntil: vipUntil,
               orders: done, done: rows.length <= 20, remaining: rows.length > 20 ? rows.length - 20 : 0 }
    </action>

    <!-- ══ RESTORE, THE NATIVE TWIN — AND IT NEEDS NO LOGIN ═══════════════════════════════
         `restoreOrders` above asks Stripe about orders this backend opened. Nothing on the
         native lanes opens one: a StoreKit or Play purchase reaches this backend only as a
         RevenueCat transaction, through `settleNative` (we pull) or the webhook (they push).
         So the sweep for that lane has to ask RevenueCat what the CALLER already owns, and
         grant whatever this deployment has not granted yet. That is this action.

         ── IT REQUIRES A SUBJECT, NOT A SIGNED-IN HUMAN, AND THAT IS THE WHOLE POINT ───────
         The founder is explicit that most revenue here will come from viewers who never make
         an account, so a restore behind a login strands exactly the buyer it exists for. This
         action takes NO argument. The caller id is read off `owner_id` on their own wallet
         row — stamped by Postgres from the verified subject, unreachable from the wire — and
         that same value IS the RevenueCat `app_user_id` (see `settleNative`). An anonymous
         session satisfies `auth="required"` exactly as a signed-in one does.

         ── WHAT THIS CAN AND CANNOT RECOVER, WHICH IS THE HONEST HALF ─────────────────────
         RECOVERS: a purchase RevenueCat recorded against THIS subject that this deployment
         never granted — the app was killed, offline, or the settle call was lost between
         Apple taking the money and the grant landing. That is the same money-taken-and-
         invisible failure `restoreOrders` closes one lane over, and it is the failure a
         restore button is actually for.

         DOES NOT RECOVER: a purchase made under a DIFFERENT subject — the reinstall case.
         And the reason is a product truth rather than a missing feature, so it is worth
         being exact, because the tempting fix is a coin faucet:

           · Apple keys a receipt to an APPLE ID and Google keys a purchase token to a GOOGLE
             ACCOUNT. Neither is per-device, so the platform genuinely CAN recognise a
             returning buyer with no app account. That constraint is the mechanism, not the
             obstacle.
           · But every product this app sells is a CONSUMABLE — coin packs by nature, and the
             VIP pass by design (see the price table header: no renewal, no grace period, no
             billing retry, which is what makes a `verify="bearer"` receiver sufficient). The
             platforms do not restore consumables: StoreKit leaves them out of
             `currentEntitlements`, and Play stops returning a purchase token once the pack is
             CONSUMED, which a coin pack must be or the viewer can never buy it again.
             RevenueCat keeps the history regardless, which is why this sweep can see it at
             all — but seeing it is not the same as being allowed to replay it.
           · AND REPLAYING IT WOULD BE WRONG. A consumable was already DELIVERED. Someone who
             bought 1,000 coins and spent 400 holds a balance of 600, not a 1,000-coin
             receipt; re-granting the transaction mints 1,000 fresh coins on every reinstall.
             `unique (intent)` in policies.local.sql already refuses that — the transaction
             grants once, to one owner, for good — and that refusal is the correct answer,
             not a limitation to route around.

         So a reinstall is an IDENTITY problem, not a purchase problem: the coins are safe, on
         the subject that bought them, and the job is to reach that subject. Anonymously the
         only durable handle is the store account itself, which means deriving the subject
         from something that survives a reinstall — an auth-seam decision, named in the UI by
         <RestoreRow>, in the deploy checklist, and in PLAN.md §6.86. It is deliberately NOT
         faked here.

         ── BOUNDED AND RESUMABLE ─────────────────────────────────────────────────────────
         A request gets 64 module calls (ACTION_CALL_CAP). `grantStore` spends about eight of
         them per purchase, so this grants at most five per call and returns `done` — the
         caller loops. A blown budget is a 503 with the work half-finished, which on this path
         means a customer whose restore stopped in the middle of their own money. The route's
         `rate` is sized to the SWEEP rather than to the intent for the same reason. -->
    <action as="restoreNative">
      const rc = await dsx.module.secret.read({ name: 'REVENUECAT_KEY' })
      if (!rc.ok || rc.data == null || rc.data === '') {
        throw { reason: 'unavailable', message: 'This build cannot reach the store to check your purchases, so it has nothing it could restore. The deployment needs REVENUECAT_KEY (server/store.dsx settleNative names what it does with it).' }
      }

      // the caller, taken from a row rather than from the request — the same reasoning as
      // settleNative, and the reason this action takes no arguments at all
      const mine = await dsx.module.data.wallet.list({ limit: 1 })
      let w = mine.ok && mine.data.length > 0 ? mine.data[0] : null
      if (w == null) {
        const made = await dsx.module.data.wallet.create({ coins: 0, bonus: 0 })
        if (made.ok) { w = made.data } else {
          const again = await dsx.module.data.wallet.list({ limit: 1 })
          w = again.ok && again.data.length > 0 ? again.data[0] : null
        }
      }
      if (w == null) { throw { reason: 'unavailable', message: 'wallet unavailable' } }
      const uid = w.owner_id
      if (uid == null || uid === '') {
        throw { reason: 'unavailable', message: 'this session cannot be matched to a store account, so there is nothing to restore onto' }
      }

      const seen = await fetch('https://api.revenuecat.com/v1/subscribers/' + encodeURIComponent(uid), {
        method: 'GET',
        headers: { authorization: 'Bearer ' + rc.data, accept: 'application/json' }
      })
      // AN UNREACHABLE STORE IS NOT AN EMPTY ONE. The store module own docs make the same
      // point about its offline behaviour, and it matters most here: answering "nothing to
      // restore" to a paying customer whose network blipped is the one wrong answer.
      if (!seen.ok || seen.data == null || seen.data.subscriber == null) {
        throw { reason: 'upstream', message: 'The store could not be reached. Your purchases are safe — try again when you are back online.' }
      }

      // WHAT IS ALREADY GRANTED, in ONE query rather than one per purchase. `grantStore`
      // would refuse a replay anyway (two database locks stand behind it), but paying eight
      // module calls to be told so would burn the request budget on work already done.
      const held = await dsx.module.data.order.list({ filters: { status: 'paid' }, limit: 100 })
      const already = (held.ok ? held.data : []).map(o => o.intent)

      const bought = seen.data.subscriber.non_subscriptions
      // sandbox does not pay — the same rule the webhook and settleNative apply, with the
      // same one development switch (head)
      const sb = await dsx.module.secret.read({ name: 'REVENUECAT_ALLOW_SANDBOX' })
      const allowSandbox = sb.ok && sb.data === '1'
      const pending = []
      for (const pair of Object.entries(bought == null ? {} : bought)) {
        const sku = pair[0]
        for (const run of pair[1]) {
          if (run.is_sandbox === true && !allowSandbox) { continue }
          const txn = run.store_transaction_id == null || run.store_transaction_id === ''
            ? run.id
            : run.store_transaction_id
          if (txn == null || txn === '') { continue }
          if (already.includes('revenuecat:' + txn)) { continue }
          pending.push({ sku: sku, transaction: txn })
        }
      }

      const CAP = 5
      let coins = 0
      let bonus = 0
      let vipDays = 0
      let vipUntil = w.vip_until
      let restored = 0
      let handled = 0
      const orders = []
      for (const one of pending) {
        if (handled >= CAP) { continue }
        handled = handled + 1
        const got = await dsx.action.grantStore({
          owner: uid, sku: one.sku, transaction: one.transaction, provider: 'revenuecat'
        })
        // A SKU THE PRICE TABLE DOES NOT SELL IS SKIPPED, NOT FATAL. RevenueCat answers with
        // every product ever bought on this account, which can include one an operator
        // retired. Failing the whole sweep on it would strand the purchases either side.
        if (!got.ok || got.data == null) { continue }
        if (got.data.granted !== true) { continue }
        if (got.data.coins != null) { coins = coins + got.data.coins }
        if (got.data.bonus != null) { bonus = bonus + got.data.bonus }
        if (got.data.days != null) { vipDays = vipDays + got.data.days }
        if (got.data.vipUntil != null) { vipUntil = got.data.vipUntil }
        restored = restored + 1
        orders.push({ order: got.data.order, sku: one.sku })
      }

      // `done` false means the budget ran out with purchases left, and the caller runs it
      // again — never a half-answer presented as a whole one
      return {
        checked: pending.length, restored: restored,
        coins: coins, bonus: bonus, vipDays: vipDays, vipUntil: vipUntil,
        orders: orders, done: pending.length <= CAP, remaining: pending.length - handled
      }
    </action>

  </head>

  <!-- RATE CEILINGS on the money lane. Each number answers "what does one call COST, and how
       many can a real customer need?", never "what feels safe":
         · catalog   120/m — a public read of a constant table; SSR hits it too, and
                     anonymous callers share a bucket per address (scripts/serve.mjs supplies
                     clientAddress), so this must clear a whole household behind one NAT.
         · checkout    6/h — each call can create a Stripe PaymentIntent against the
                     deployment-wide 25,000/day egress ceiling. Six an hour means one
                     credential needs 170 days to exhaust it, so no single caller can take
                     payments down for every customer. A real buyer opens one or two.
         · settle     20/h — a read-back plus a grant. The Store's recovery card retries on
                     purpose, and a viewer may settle several orders in a session; twenty
                     covers every legitimate case and bounds a replay loop.
         · native     20/h — the same shape as settle, one lane over: one RevenueCat read
                     plus the same grant. Sized to the RETRY, not to the intent — a native
                     purchase whose settle is lost is money already taken at Apple, so the
                     app must be able to keep asking (AGENTS.md: size the rate to the sweep).
         · restore     6/h — up to twenty Stripe reads per call. It is a deliberate,
                     user-initiated action, not something a screen polls.
         · restore
           (native)   20/h — ONE RevenueCat read plus at most five grants, and it is
                     RESUMABLE: a viewer with more than five ungranted purchases has to be
                     able to call it again and finish. Sized to the SWEEP, not to the intent
                     — `6/h` here would lock a customer out of their own money on pass two,
                     which is the mistake AGENTS.md records against an account deletion. -->

  <route method="GET"  path="/store/catalog"  action="storeCatalog"   auth="none"     rate="120/m"/>
  <!-- THE SAME TABLE UNDER THE NAME THE DESIGN SPEC USES (docs/design/reference-ui-spec.md §10:
       `offer` and `offerEndsAt` ride "/store/plans"). One action, two paths, so the screens
       keep reading /store/catalog and a reader of the spec finds the field where it says. -->
  <route method="GET"  path="/store/plans"    action="storeCatalog"   auth="none"     rate="120/m"/>
  <route method="POST" path="/store/checkout" action="createCheckout" auth="required" rate="6/h"/>
  <route method="POST" path="/store/settle"   action="settleOrder"    auth="required" rate="20/h"/>
  <route method="POST" path="/store/native"   action="settleNative"   auth="required" rate="20/h"/>
  <!-- THE RECEIVER AND ITS DRAIN. No `<route>` names `grantStore` or `storeEvent`, and that
       is the design: the only ways into the granter are a caller re-verifying their own
       purchase (settleNative) and a delivery this backend authenticated. `queue=` is drained
       by the worker below — a webhook whose queue nobody drains verifies, enqueues, answers
       200, and sits there forever while the sender dashboard shows every delivery green, so
       the build refuses that pairing outright. `rate` is the only ceiling on an endpoint a
       stranger may call at will. -->
  <webhook as="revenuecat" queue="store_events" verify="bearer"
           secret="REVENUECAT_WEBHOOK_SECRET" idField="event.id" rate="600/m"/>
  <worker as="drain-store-events" queue="store_events" action="storeEvent"
          schedule="* * * * *" idempotencyKey="event"/>
  <route method="POST" path="/store/restore"  action="restoreOrders"  auth="required" rate="6/h"/>
  <!-- TWO RESTORE ROUTES, ONE VERB, AND NEITHER ASKS WHO YOU ARE. `auth="required"` verifies
       a token; it does not ask for a human behind it, so an anonymous session reaches both.
       They are separate routes rather than one because the QUESTION differs: the Stripe lane
       asks a payment provider about orders this backend opened, the native lane asks
       RevenueCat what the store says this subject owns. A screen picks by capability and
       says which one it ran (Components/parts/RestoreRow.dsx). -->
  <route method="POST" path="/store/restore/native" action="restoreNative" auth="required" rate="20/h"/>
</server>
