<!-- viewer.dsx — the signed-in viewer's own rows: watch progress and favorites.
     ownership="owner" means Postgres RLS scopes every read and write to the caller;
     the routes below are the generated CRUD, already caller-scoped. -->
<server>
  <head>
    <entity as="progress" ownership="owner">
      <field as="episode" type="uuid"/>
      <field as="show" type="uuid"/>
      <field as="idx" type="integer"/>
      <field as="position" type="real"/>   <!-- seconds into the episode -->
      <field as="day" type="text"/>        <!-- YYYY-MM-DD of the last watch, for daily tasks -->
      <index on="show"/>
      <index on="episode"/>
    </entity>

    <entity as="favorite" ownership="owner">
      <field as="show" type="uuid"/>
      <index on="show"/>
    </entity>

    <!-- ONE ROW PER EPISODE, ENFORCED. This is a read-then-write like every other guard in
         the backend, and it races the same way: the player saves on episode change and the
         swipe path can fire twice, so two creates both passed the "do I have a row?" check
         and the viewer ended up with two progress rows for one episode. That is not just
         untidy — `rewardsState` counts progress rows to drive the "watch 3 episodes today"
         task, so a duplicate row is a free task claim. `unique (owner_id, episode)` in
         policies.local.sql makes the second create fail; the loser re-reads and updates,
         which is what it wanted to do in the first place. -->
    <action as="saveProgress" inputs="episode, show, idx, position">
      if (episode == null || episode === '' || show == null || show === '') { throw { reason: 'invalid', message: 'episode and show are required' } }
      const day = new Date().toISOString().slice(0, 10)
      const mine = await dsx.module.data.progress.list({ filters: { episode: episode }, limit: 1 })
      if (mine.ok && mine.data.length > 0) {
        const done = await dsx.module.data.progress.update({ id: mine.data[0].id, values: { position: position, day: day, idx: idx } })
        if (!done.ok) { throw { reason: 'unavailable', message: 'progress could not be saved' } }
        return { updated: true }
      }
      const made = await dsx.module.data.progress.create({ episode: episode, show: show, idx: idx, position: position, day: day })
      if (made.ok) { return { created: true } }
      const again = await dsx.module.data.progress.list({ filters: { episode: episode }, limit: 1 })
      if (!again.ok || again.data.length === 0) { throw { reason: 'unavailable', message: 'progress could not be saved' } }
      const done = await dsx.module.data.progress.update({ id: again.data[0].id, values: { position: position, day: day, idx: idx } })
      if (!done.ok) { throw { reason: 'unavailable', message: 'progress could not be saved' } }
      return { updated: true }
    </action>

    <action as="continueWatching">
      const rows = await dsx.module.data.progress.list({ limit: 100 })
      if (!rows.ok) { return { items: [] } }
      const byShow = {}
      for (const r of rows.data) {
        const cur = byShow[r.show]
        if (cur == null || r.created_at > cur.created_at) { byShow[r.show] = r }
      }
      const picks = Object.values(byShow)
      const items = []
      for (const p of picks.slice(0, 12)) {
        const s = await dsx.module.data.show.get({ id: p.show })
        const e = await dsx.module.data.episode.get({ id: p.episode })
        if (s.ok) {
          // pct drives the resume bar on the card — the one affordance a
          // continue-watching rail lives or dies on
          const dur = e.ok && e.data.duration > 0 ? e.data.duration : 75
          const pct = Math.min(100, Math.round((p.position / dur) * 100))
          // eps feeds the category-standard "EP.3 / EP.49" line under the card
          const all = await dsx.module.data.episode.list({ filters: { show: p.show, state: 'live' }, limit: 100 })
          items.push({
            show: p.show, title: s.data.title, poster: s.data.poster,
            episode: p.episode, idx: p.idx, position: p.position, pct: pct,
            eps: all.ok ? all.data.length : 0
          })
        }
      }
      return { items: items }
    </action>

    <!-- A DOUBLE-TAP USED TO STICK. Two concurrent adds both passed the "do I have one?"
         read and wrote two rows; the next tap deleted one, so the heart stayed filled and no
         amount of tapping could clear it. `unique (owner_id, show)` in policies.local.sql
         makes the second create fail, and the loser reports the state that is actually true. -->
    <action as="toggleFavorite" inputs="show">
      if (show == null || show === '') { throw { reason: 'invalid', message: 'show is required' } }
      const mine = await dsx.module.data.favorite.list({ filters: { show: show }, limit: 1 })
      if (mine.ok && mine.data.length > 0) {
        const gone = await dsx.module.data.favorite.delete({ id: mine.data[0].id })
        if (!gone.ok) { throw { reason: 'unavailable', message: 'could not update My List' } }
        return { favorite: false }
      }
      const made = await dsx.module.data.favorite.create({ show: show })
      if (!made.ok) { return { favorite: true, already: true } }
      return { favorite: true }
    </action>

    <!-- ACCOUNT DELETION — App Store 5.1.1(v), and the rule is specific about the shape:
         "Offer to delete the entire account record, along with associated personal data…
         only offering to temporarily deactivate or disable an account is insufficient."
         Self-service, in-app, no support ticket: the regulated-industry carve-out of
         5.1.1(ix) is banking, healthcare, gambling, cannabis, air travel and crypto, and a
         drama app is in none of them.

         EVERY owner-scoped entity in this backend is swept, not just this document's two —
         a viewer's data does not respect file boundaries, and a deletion that leaves the
         wallet behind is the "deactivate" the rule refuses. RLS scopes each read and delete
         to the caller, so this cannot reach another account even if the id were wrong.

         PAGED, because LIST_LIMIT clamps a read to 100 and says nothing (AGENTS.md): a
         viewer with 300 unlocks would otherwise keep 200 of them and the call would report
         success. Each entity drains until a page comes back empty, and the loop is bounded
         so a delete that silently fails can never spin forever — it reports what is left
         instead, because a half-deletion reported as success is the worst outcome here.

         An unspent coin balance is NOT grounds to refuse: the wallet goes with everything
         else, and the UI says so before the viewer confirms.

         WHY THIS IS UNROLLED INSTEAD OF A LOOP OVER TABLE NAMES. Both obvious spellings
         PROBED FALSE on this origin, and both fail SILENTLY as success — the worst possible
         failure for a deletion:
           · `dsx.module.data[name]` — a bracket read on the module namespace resolves the
             whole expression to NULL, so `await` yields null, every `.ok` reads false, and a
             loop over 12 table names deletes nothing and returns `{deleted:true}`. Measured:
             literal path 5 rows, bracket read NULL. (AGENTS.md records bracket-read MUTATION
             as a no-op; this is the read side, on the module namespace.)
           · passing the table object into a lambda — `const n = await count(dsx.module.data
             .favorite)` — returns ok with ZERO rows, because the object loses the caller's
             RLS scope when it travels as a value. Measured: literal 5, via-lambda 0.
         So every table below is named literally. Verbose beats a deletion that lies.

         ══ THE TWO ALL-READ TABLES NEED A FILTER, AND THAT IS NOT A DETAIL ═══════════════
         `comment` and `report` are ownership="public-read" (server/social.dsx says why), so
         an unfiltered `list` here returns EVERY viewer rows, not the caller. The sweep then
         (a) burns its whole delete budget attempting rows RLS will not give it, and (b) never
         reaches `done`, because the page it re-reads next pass is identical. Worse, a delete
         that RLS filtered away comes back `ok` — the statement is `delete … returning id`, so
         a hidden row simply matches nothing — and the old code counted every one of those as
         a row removed. MEASURED on this origin before the fix: a viewer who owned NOTHING
         looped /viewer/delete eight times, reported "removed 2" every pass and never
         finished, because two other people had left comments. In-app account deletion was
         broken for any deployment that had ever been commented on, which is 5.1.1(v).
         Both tables now carry a DECLARED owner column (`author_id` / `reporter_id`, filled by
         Postgres from the verified subject — server/policies.local.sql), so the sweep can
         name the caller rows in a query instead of scanning. `sub` is what it filters on, and
         `sub` comes from the CLIENT — deliberately, and safely: it is used ONLY as a list
         filter, and every delete underneath still runs as the caller identity, so a forged
         subject enumerates rows it cannot delete and removes nothing. It cannot delete
         another account data; it can only fail to delete its own. When it is absent the two
         passes are skipped and `done` says so rather than claiming an empty account. -->


    <action as="deleteAccount" inputs="confirm, sub">
      if (confirm !== 'DELETE') { throw { reason: 'invalid', message: 'confirmation required' } }
      // BOUNDED AND RESUMABLE. A request gets 64 module calls (ACTION_CALL_CAP, and a spec can
      // only lower it) — twelve list calls plus one delete per row blows that on any real
      // account, and a blown budget is a 503 with the account HALF DELETED, which is the one
      // outcome worse than not starting. Measured: the first attempt removed 20 unlocks and
      // then aborted, leaving the wallet and My List behind.
      //
      // So each call sweeps up to DELETES_PER_CALL rows and reports `done`. `done` is true only
      // when every table listed empty in the same pass, so the caller loops until it flips and
      // the account is provably empty rather than presumed so.
      const DELETES_PER_CALL = 45
      let budget = DELETES_PER_CALL
      let removed = 0
      let stuck = []
      let done = true
      if (budget > 0) {
        const pg_playticket = await dsx.module.data.playticket.list({ limit: 100 })
        if (pg_playticket.ok && pg_playticket.data.length > 0) {
          done = false
          let i_playticket = 0
          while (i_playticket < pg_playticket.data.length && budget > 0) {
            const g_playticket = await dsx.module.data.playticket.delete({ id: pg_playticket.data[i_playticket].id })
            if (g_playticket.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['playticket']); i_playticket = pg_playticket.data.length }
            budget = budget - 1
            i_playticket = i_playticket + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_unlock = await dsx.module.data.unlock.list({ limit: 100 })
        if (pg_unlock.ok && pg_unlock.data.length > 0) {
          done = false
          let i_unlock = 0
          while (i_unlock < pg_unlock.data.length && budget > 0) {
            const g_unlock = await dsx.module.data.unlock.delete({ id: pg_unlock.data[i_unlock].id })
            if (g_unlock.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['unlock']); i_unlock = pg_unlock.data.length }
            budget = budget - 1
            i_unlock = i_unlock + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_ledger = await dsx.module.data.ledger.list({ limit: 100 })
        if (pg_ledger.ok && pg_ledger.data.length > 0) {
          done = false
          let i_ledger = 0
          while (i_ledger < pg_ledger.data.length && budget > 0) {
            const g_ledger = await dsx.module.data.ledger.delete({ id: pg_ledger.data[i_ledger].id })
            if (g_ledger.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['ledger']); i_ledger = pg_ledger.data.length }
            budget = budget - 1
            i_ledger = i_ledger + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_wallet = await dsx.module.data.wallet.list({ limit: 100 })
        if (pg_wallet.ok && pg_wallet.data.length > 0) {
          done = false
          let i_wallet = 0
          while (i_wallet < pg_wallet.data.length && budget > 0) {
            const g_wallet = await dsx.module.data.wallet.delete({ id: pg_wallet.data[i_wallet].id })
            if (g_wallet.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['wallet']); i_wallet = pg_wallet.data.length }
            budget = budget - 1
            i_wallet = i_wallet + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_order = await dsx.module.data.order.list({ limit: 100 })
        if (pg_order.ok && pg_order.data.length > 0) {
          done = false
          let i_order = 0
          while (i_order < pg_order.data.length && budget > 0) {
            const g_order = await dsx.module.data.order.delete({ id: pg_order.data[i_order].id })
            if (g_order.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['order']); i_order = pg_order.data.length }
            budget = budget - 1
            i_order = i_order + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_progress = await dsx.module.data.progress.list({ limit: 100 })
        if (pg_progress.ok && pg_progress.data.length > 0) {
          done = false
          let i_progress = 0
          while (i_progress < pg_progress.data.length && budget > 0) {
            const g_progress = await dsx.module.data.progress.delete({ id: pg_progress.data[i_progress].id })
            if (g_progress.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['progress']); i_progress = pg_progress.data.length }
            budget = budget - 1
            i_progress = i_progress + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_favorite = await dsx.module.data.favorite.list({ limit: 100 })
        if (pg_favorite.ok && pg_favorite.data.length > 0) {
          done = false
          let i_favorite = 0
          while (i_favorite < pg_favorite.data.length && budget > 0) {
            const g_favorite = await dsx.module.data.favorite.delete({ id: pg_favorite.data[i_favorite].id })
            if (g_favorite.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['favorite']); i_favorite = pg_favorite.data.length }
            budget = budget - 1
            i_favorite = i_favorite + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_checkin = await dsx.module.data.checkin.list({ limit: 100 })
        if (pg_checkin.ok && pg_checkin.data.length > 0) {
          done = false
          let i_checkin = 0
          while (i_checkin < pg_checkin.data.length && budget > 0) {
            const g_checkin = await dsx.module.data.checkin.delete({ id: pg_checkin.data[i_checkin].id })
            if (g_checkin.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['checkin']); i_checkin = pg_checkin.data.length }
            budget = budget - 1
            i_checkin = i_checkin + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_spin = await dsx.module.data.spin.list({ limit: 100 })
        if (pg_spin.ok && pg_spin.data.length > 0) {
          done = false
          let i_spin = 0
          while (i_spin < pg_spin.data.length && budget > 0) {
            const g_spin = await dsx.module.data.spin.delete({ id: pg_spin.data[i_spin].id })
            if (g_spin.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['spin']); i_spin = pg_spin.data.length }
            budget = budget - 1
            i_spin = i_spin + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_taskclaim = await dsx.module.data.taskclaim.list({ limit: 100 })
        if (pg_taskclaim.ok && pg_taskclaim.data.length > 0) {
          done = false
          let i_taskclaim = 0
          while (i_taskclaim < pg_taskclaim.data.length && budget > 0) {
            const g_taskclaim = await dsx.module.data.taskclaim.delete({ id: pg_taskclaim.data[i_taskclaim].id })
            if (g_taskclaim.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['taskclaim']); i_taskclaim = pg_taskclaim.data.length }
            budget = budget - 1
            i_taskclaim = i_taskclaim + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_adview = await dsx.module.data.adview.list({ limit: 100 })
        if (pg_adview.ok && pg_adview.data.length > 0) {
          done = false
          let i_adview = 0
          while (i_adview < pg_adview.data.length && budget > 0) {
            const g_adview = await dsx.module.data.adview.delete({ id: pg_adview.data[i_adview].id })
            if (g_adview.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['adview']); i_adview = pg_adview.data.length }
            budget = budget - 1
            i_adview = i_adview + 1
          }
        }
      } else { done = false }

      if (budget > 0) {
        const pg_block = await dsx.module.data.block.list({ limit: 100 })
        if (pg_block.ok && pg_block.data.length > 0) {
          done = false
          let i_block = 0
          while (i_block < pg_block.data.length && budget > 0) {
            const g_block = await dsx.module.data.block.delete({ id: pg_block.data[i_block].id })
            if (g_block.ok) { removed = removed + 1 }
            else { stuck = stuck.concat(['block']); i_block = pg_block.data.length }
            budget = budget - 1
            i_block = i_block + 1
          }
        }
      } else { done = false }

      // ── the two ALL-READ tables. Same shape, one difference that decides whether this
      //    works at all: the list is FILTERED to the caller declared owner column, and the
      //    delete is judged on its returned DATA rather than on `ok` (see the header).
      const me = sub == null ? '' : String(sub)
      if (budget > 0 && me !== '') {
        const pg_comment = await dsx.module.data.comment.list({ filters: { author_id: me }, limit: 100 })
        if (pg_comment.ok && pg_comment.data.length > 0) {
          done = false
          let i_comment = 0
          while (i_comment < pg_comment.data.length && budget > 0) {
            const g_comment = await dsx.module.data.comment.delete({ id: pg_comment.data[i_comment].id })
            if (g_comment.ok && g_comment.data != null) { removed = removed + 1 }
            else { stuck = stuck.concat(['comment']); i_comment = pg_comment.data.length }
            budget = budget - 1
            i_comment = i_comment + 1
          }
        }
      } else { done = false }

      if (budget > 0 && me !== '') {
        const pg_report = await dsx.module.data.report.list({ filters: { reporter_id: me }, limit: 100 })
        if (pg_report.ok && pg_report.data.length > 0) {
          done = false
          let i_report = 0
          while (i_report < pg_report.data.length && budget > 0) {
            const g_report = await dsx.module.data.report.delete({ id: pg_report.data[i_report].id })
            if (g_report.ok && g_report.data != null) { removed = removed + 1 }
            else { stuck = stuck.concat(['report']); i_report = pg_report.data.length }
            budget = budget - 1
            i_report = i_report + 1
          }
        }
      } else { done = false }

      // `scoped` is the honest half of the answer: with no subject to filter on, the two
      // all-read tables were not swept and this account is NOT provably empty.
      return { deleted: done, done: done, removed: removed, stuck: stuck, scoped: me !== '' }
    </action>

    <action as="myList">
      const favs = await dsx.module.data.favorite.list({ limit: 100 })
      const items = []
      for (const f of (favs.ok ? favs.data : [])) {
        const s = await dsx.module.data.show.get({ id: f.show })
        // the reference cell's fields ride along (docs/design/reference-ui-spec.md §5 draws
        // My List with the §1 cell): the 2:3 cover, the three badges and the play count
        if (s.ok) {
          items.push({
            show: f.show, title: s.data.title, poster: s.data.poster, genre: s.data.genre,
            cover: s.data.cover == null || s.data.cover === '' ? s.data.poster : s.data.cover,
            hot: s.data.hot === true, isNew: s.data.is_new === true, original: s.data.original === true,
            views: s.data.views == null ? 0 : s.data.views
          })
        }
      }
      return { items: items }
    </action>
  </head>

  <!-- RATE CEILINGS.
         · progress 240/m — the player is meant to gain a periodic save (the audit's S6, ~1
           per 15s of playback) on top of the save-on-episode-change it has today. 4/s leaves
           room for that and for a swipe binge, and still bounds a runaway <watch> loop —
           which is the realistic failure here, not an attacker.
         · continue  60/m — up to 1 + 3N reads per call (a show get, an episode get and an
           episode list per progress row): the single most read-amplifying route in the app
           at ~37 reads a call, against a 2.5M/day read ceiling. 60/m is ~2,200 reads/min from
           one caller; more than that is a loop, not a viewer.
         · favorite  60/m · list 60/m — cheap owner reads/writes behind a tap. -->
  <route method="POST" path="/viewer/progress"  action="saveProgress"     auth="required" rate="240/m"/>
  <route method="GET"  path="/viewer/continue"  action="continueWatching" auth="required" rate="60/m"/>
  <route method="POST" path="/viewer/favorite"  action="toggleFavorite"   auth="required" rate="60/m"/>
  <route method="GET"  path="/viewer/list"      action="myList"           auth="required" rate="60/m"/>
  <!-- 60/h, and the number follows the ACTION not the intent. Deletion is one decision, so
       3/h looked right — but a request gets 64 module calls, so a large account is SWEPT
       across several passes and 3/h rate-limited the viewer out of finishing their own
       deletion. Measured: pass 1 refused, account left half-empty. 60 passes clears ~2700
       rows, still refuses a scripted wipe, and cannot strand someone mid-delete. -->
  <route method="POST" path="/viewer/delete"    action="deleteAccount"    auth="required" rate="60/h"/>
</server>
